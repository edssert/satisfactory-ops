{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000"
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run data:check)",
      "Bash(npm test)",
      "Bash(node scripts/shoot.mjs:*)",
      "Bash(node scripts/check-coverage.mjs:*)",
      "Bash(node .claude/skills/visual-verify/scripts/squeeze.mjs:*)",
      "Bash(node .claude/skills/visual-verify/scripts/shot-el.mjs:*)",
      "Bash(node .claude/skills/no-js-fallback/scripts/nojs.mjs:*)",
      "Bash(node .claude/skills/external-data-claim/scripts/field-scope.mjs:*)",
      "Bash(curl -s https://satisfactory.wiki.gg/api.php:*)",
      "Bash(curl -s https://raw.githubusercontent.com/:*)",
      "Bash(curl -s https://api.github.com/:*)"
    ]
  }
}
