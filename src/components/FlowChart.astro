---
/**
 * FlowChart — 공정 흐름도. **축척이 없다.**
 *
 * 모델을 바꿨다. 앞선 판본은 기계를 점으로 두고 기계끼리 화살표를 이었는데,
 * 그러면 45:15 같은 비정수 분배가 분배기 하나로 갈라지는 것처럼 그려진다. 실제로는 그렇게 안 된다.
 *
 * 초반 공장의 표준은 **매니폴드**이고, 공식 위키의 정의는 이렇다:
 *   "Manifold refers to a fill method where Conveyor Splitters or Conveyor Mergers are aligned
 *    in a series (that is, one after another), usually parallel to the arrangement of buildings."
 *   — 즉 컨베이어 분배기를 **일렬로 이어 붙여** 기계 배열과 나란히 놓는 채움 방식이다.
 *   (satisfactory.wiki.gg/wiki/Manifold)
 *
 * 그 줄 하나를 상자 하나로 그리고, 기계는 그 줄에 붙는다. 그래프가 아니라 세로로 쌓은 층이다:
 *
 *     [기계] [기계]          같은 일을 하는 기계도 각자 상자를 갖는다 (×2 로 뭉치지 않는다)
 *   ══ 철 주괴 60/분 ══       분배기를 일렬로 이어 붙인 줄. 유량은 여기 적는다
 *     [기계] [기계] [기계]
 *
 * 유량은 연결선이 아니라 **벨트 줄과 기계 상자 안**에 적는다.
 * 선에 라벨을 달면 어느 기계가 얼마를 내는지 눈으로 따라갈 수 없다.
 */
import '../styles/flow.css';
import { NODE_W, GAP_X, PAD, chipWidth, fmtRate } from '../lib/flow-layout';

/** 네 줄(기계·입력·출력·클럭)을 담아야 하므로 flow-layout 기본값보다 높다 */
const NODE_H = 96;

export interface MachineBox {
  /** 기계 이름. 같은 기계가 여러 대면 상자를 여러 개 만든다 */
  ko: string;
  /** 아이콘용 건물 클래스 */
  machineId?: string;
  /**
   * 상자는 네 줄이다 — 기계 이름 / 들어가는 것 / 나오는 것 / 클럭.
   * 저장 컨테이너처럼 만들지 않는 것은 `note` 만 쓴다. 보관하는 물건에 분당은 뜻이 없다.
   */
  inputs?: { ko: string; perMinute: number }[];
  /** 단위는 기본이 "/분"이다. 발전기처럼 MW 를 내는 것은 unit 을 바꾼다 */
  output?: { ko: string; perMinute: number; unit?: string };
  /** 100 이면 적지 않는다 */
  clock?: number;
  /** 기계가 아닌 것(저장 컨테이너 등)에 붙이는 한 줄 */
  note?: string;
  /**
   * 이 기계의 산출이 아래 줄로 가는가. 기본값 true.
   * 철판처럼 그 자리에서 끝나는 것은 false — 아니면 없는 연결선이 그려진다.
   */
  feedsNext?: boolean;
}

export interface BusLine {
  itemKo: string;
  itemId?: string;
  perMinute: number;
  /** 이 줄의 성격 — 예: "분배기 직렬", "병합기로 합침" */
  note?: string;
  /**
   * 이 줄에서 **밖으로 빠지는 양**. 철봉 30 중 10 만 나사로 가고 20 은 그대로 납품되는 것처럼,
   * 아래로 안 내려가고 여기서 끝나는 몫을 적는다.
   */
  deliver?: { ko: string; perMinute: number };
}

export type Row = { kind: 'machines'; boxes: MachineBox[] } | { kind: 'bus'; bus: BusLine };

interface Props {
  rows: Row[];
  caption?: string;
  index?: number;
}
const { rows, caption, index = 1 } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bIcon = `${base}/assets/buildings-png`;
const iIcon = `${base}/assets/items`;

const BUS_H = 34;
const ROW_GAP = 40;

const widest = Math.max(...rows.map((r) => (r.kind === 'machines' ? r.boxes.length : 1)), 1);
const width = PAD * 2 + widest * NODE_W + (widest - 1) * GAP_X;
const centerX = width / 2;

/** 위에서부터 층을 쌓는다 */
let cursor = PAD;
const placed = rows.map((row) => {
  const h = row.kind === 'machines' ? NODE_H : BUS_H;
  const at = { row, y: cursor, h };
  cursor += h + ROW_GAP;
  return at;
});
const height = cursor - ROW_GAP + PAD;

/** 기계 상자를 가운데 정렬해 x 를 매긴다 */
const boxX = (count: number, i: number) => {
  const total = count * NODE_W + (count - 1) * GAP_X;
  return (width - total) / 2 + i * (NODE_W + GAP_X);
};

const busX1 = PAD;
const busX2 = width - PAD;

/** 층과 층 사이를 잇는 선의 x 좌표들 */
function connectors(row: Row): number[] {
  if (row.kind === 'machines') {
    return row.boxes
      .map((b, i) => ({ b, x: boxX(row.boxes.length, i) + NODE_W / 2 }))
      .filter(({ b }) => b.feedsNext !== false)
      .map(({ x }) => x);
  }
  return [centerX];
}
---

<figure class="fc">
  <svg
    class="fc-svg"
    style={`max-width:${width}px`}
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={caption ?? '공정 흐름도'}
  >
    <defs>
      <marker
        id={`fc-arrow-${index}`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="5"
        markerHeight="5"
        orient="auto-start-reverse"
      >
        <path d="M0,1 L9,5 L0,9 z" class="fc-arrowhead" />
      </marker>
    </defs>

    {
      placed.map((p, ri) => {
        const next = placed[ri + 1];
        if (!next) return null;
        const y1 = p.y + p.h;
        const y2 = next.y;
        /* 벨트 줄이 한쪽에 있으면 그 줄은 가로로 길므로, 기계 쪽 상자마다 한 줄씩 내린다 */
        const xs =
          p.row.kind === 'machines' ? connectors(p.row) : connectors(next.row);
        return xs.map((x) => (
          <path
            d={`M${x},${y1} L${x},${y2}`}
            class="fc-link"
            marker-end={`url(#fc-arrow-${index})`}
          />
        ));
      })
    }

    {
      placed.map((p) => {
        if (p.row.kind === 'bus') {
          const b = p.row.bus;
          const label = `${b.itemKo} ${fmtRate(b.perMinute)}/분`;
          const w = chipWidth(label);
          return (
            <g class="fc-bus">
              <rect x={busX1} y={p.y} width={busX2 - busX1} height={p.h} rx="4" />
              <rect
                x={centerX - w / 2}
                y={p.y + 2}
                width={w}
                height={p.h - 4}
                rx="3"
                class="fc-buschip"
              />
              {b.itemId && (
                <image
                  href={`${iIcon}/${b.itemId}.png`}
                  x={centerX - w / 2 + 5}
                  y={p.y + 5}
                  width="24"
                  height="24"
                />
              )}
              <text
                x={centerX - w / 2 + (b.itemId ? 33 : 11)}
                y={p.y + p.h / 2 + 5}
                class="fc-bustext"
              >
                {label}
              </text>
              {b.note && !b.deliver && (
                <text x={busX2 - 8} y={p.y + p.h / 2 + 4} class="fc-busnote" text-anchor="end">
                  {b.note}
                </text>
              )}
              {b.deliver && (
                <>
                  <rect
                    x={busX2 - chipWidth(`${b.deliver.ko} ${fmtRate(b.deliver.perMinute)}/분 납품`, false) - 6}
                    y={p.y + 3}
                    width={chipWidth(`${b.deliver.ko} ${fmtRate(b.deliver.perMinute)}/분 납품`, false)}
                    height={p.h - 6}
                    rx="3"
                    class="fc-deliver"
                  />
                  <text
                    x={busX2 - 12}
                    y={p.y + p.h / 2 + 4}
                    class="fc-delivertext"
                    text-anchor="end"
                  >
                    {b.deliver.ko} {fmtRate(b.deliver.perMinute)}/분 납품
                  </text>
                </>
              )}
            </g>
          );
        }

        const boxes = p.row.boxes;
        return boxes.map((m, i) => {
          const x = boxX(boxes.length, i);
          const tx = x + (m.machineId ? 62 : 12);
          return (
            <g class="fc-node">
              <rect x={x} y={p.y} width={NODE_W} height={NODE_H} rx="3" />
              {m.machineId && (
                <image
                  href={`${bIcon}/${m.machineId}.png`}
                  x={x + 7}
                  y={p.y + 15}
                  width="48"
                  height="48"
                  preserveAspectRatio="xMidYMid meet"
                />
              )}
              <text x={tx} y={p.y + 24} class="fc-name">{m.ko}</text>
              {m.inputs && m.inputs.length > 0 && (
                <text x={tx} y={p.y + 45} class="fc-io">
                  <tspan class="fc-iolabel">넣음</tspan>
                  {m.inputs.map((g, gi) => (
                    <>
                      {gi > 0 && <tspan class="fc-iosep"> · </tspan>}
                      <tspan> {g.ko} </tspan>
                      <tspan class="fc-num">{fmtRate(g.perMinute)}/분</tspan>
                    </>
                  ))}
                </text>
              )}
              {m.output && (
                <text x={tx} y={p.y + 64} class="fc-io">
                  <tspan class="fc-iolabel">냄</tspan>
                  <tspan> {m.output.ko} </tspan>
                  <tspan class="fc-num">
                    {fmtRate(m.output.perMinute)}
                    {m.output.unit ?? '/분'}
                  </tspan>
                </text>
              )}
              {m.note && <text x={tx} y={p.y + 45} class="fc-product">{m.note}</text>}
              {m.clock != null && (
                <text x={tx} y={p.y + 83} class="fc-sub">클럭 {fmtRate(m.clock)}%</text>
              )}
            </g>
          );
        });
      })
    }
  </svg>

  {caption && <figcaption class="fc-cap">{caption}</figcaption>}
</figure>
