---
/**
 * FlowChart — 공정 흐름도. **축척이 없다.**
 *
 * 앞서 실패한 것은 실척 배치도였다: 폭 32 m 안에 기계를 실제 치수로 넣으려다 기계가 50 px짜리
 * 조각이 되고, 아이콘이 뭉개지고, 벨트가 미로가 됐다. 그건 "어디에 놓는가"를 답하려던 그림이다.
 *
 * 이 그림은 다른 질문에 답한다: **무엇이 무엇을 먹어 무엇이 되는가, 분당 몇 개씩.**
 * 그래서 좌표를 버리고 계층 그래프로 그린다 — 원자재가 위, 완제품이 아래, 단계마다 한 줄.
 * mermaid 의 flowchart 와 같은 성격이다.
 *
 * 배치는 플레이어가 정한다. 이 그림은 비율과 흐름만 보여준다.
 */

export interface FlowNode {
  id: string;
  /** 기계 이름 */
  machineKo: string;
  /** 몇 대 */
  count: number;
  /** 클럭 (100 이면 표시하지 않는다) */
  clock?: number;
  /** 아이콘용 건물 클래스 */
  machineId?: string;
  /**
   * 이 노드에서 밖으로 나가는 산출. 노드 아래에 칩으로 붙는다.
   * 철봉처럼 **일부는 납품하고 일부는 다음 공정으로** 가는 경우, 이 칩과 아래로 가는
   * 화살표가 같이 그려져 갈라지는 것이 보인다.
   */
  out?: { itemKo: string; itemId?: string; perMinute: number };
  /** 몇 번째 계층인가 (0 = 맨 위) */
  layer: number;
}

export interface FlowEdge {
  from: string;
  to: string;
  /** 무엇이 흐르는가 */
  itemKo: string;
  itemId?: string;
  perMinute: number;
  /** 갈라지는 지점인가 — 분배기가 필요하다 */
  split?: boolean;
}

interface Props {
  nodes: FlowNode[];
  edges: FlowEdge[];
  /** 맨 위로 들어오는 것 */
  input?: { itemKo: string; itemId?: string; perMinute: number; note?: string };
  /** 맨 아래로 나가는 것 */
  output?: { itemKo: string; itemId?: string; perMinute: number };
  caption?: string;
  index?: number;
}
const { nodes, edges, input, output, caption, index = 1 } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bIcon = `${base}/assets/buildings-png`;
const iIcon = `${base}/assets/items`;

// ── 계층 배치. 좌표가 아니라 순서만 정한다.
const NODE_W = 176;
const NODE_H = 66;
const GAP_X = 26;
const GAP_Y = 86;
const PAD = 28;
const CHIP_H = 30;

const layers = [...new Set(nodes.map((n) => n.layer))].sort((a, b) => a - b);
const byLayer = layers.map((l) => nodes.filter((n) => n.layer === l));
const maxPerLayer = Math.max(...byLayer.map((r) => r.length), 1);

/** 레이어를 건너뛰는 연결이 있으면 옆으로 우회할 여백이 필요하다 */
const hasSkip = edges.some((e) => {
  const a = nodes.find((n) => n.id === e.from);
  const b = nodes.find((n) => n.id === e.to);
  return a && b && Math.abs(b.layer - a.layer) > 1;
});
const SIDE = hasSkip ? 92 : 0;
const width = PAD * 2 + SIDE * 2 + maxPerLayer * NODE_W + (maxPerLayer - 1) * GAP_X;
const centerX = width / 2;

/** 입력 칩이 맨 위에 한 줄, 그 아래 계층들, 맨 아래 출력 칩 */
const topOffset = input ? PAD + CHIP_H + GAP_Y : PAD;
const placed = new Map<string, { x: number; y: number; n: FlowNode }>();
byLayer.forEach((row, li) => {
  const total = row.length * NODE_W + (row.length - 1) * GAP_X;
  row.forEach((n, k) => {
    placed.set(n.id, {
      x: (width - total) / 2 + k * (NODE_W + GAP_X),
      y: topOffset + li * (NODE_H + GAP_Y),
      n,
    });
  });
});
const bottomY = topOffset + layers.length * (NODE_H + GAP_Y) - GAP_Y;
/** 노드별 출력 칩이 있으면 아래쪽 여유가 더 필요하다 */
const hasNodeOut = nodes.some((n) => n.out);
const height =
  bottomY + (output ? GAP_Y + CHIP_H : hasNodeOut ? CHIP_H + PAD : 0) + PAD;

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));

/** 라벨 칩 폭 — 한글 12 px, 나머지 7 px로 어림 */
const chipW = (t: string, withIcon = true) => {
  let w = withIcon ? 34 : 12;
  for (const ch of t) w += /[가-힣]/.test(ch) ? 12 : 7;
  return Math.ceil(w);
};

/**
 * 레이어를 건너뛰는 연결은 **옆으로 우회**시킨다.
 *
 * 곧장 내려가면 중간 레이어의 유량 칩 위를 지나가 겹친다 — 철봉이 나사를 건너뛰고 회전자로
 * 갈 때 실제로 그랬다. 블록 바깥으로 빼서 내려보내면 겹칠 것이 없다.
 */
const bypass = (x1: number, y1: number, x2: number, y2: number, side: number) => {
  const r = 14;
  return (
    `M ${x1} ${y1} L ${x1} ${y1 + 18}` +
    ` Q ${x1} ${y1 + 18 + r} ${x1 + (side > 0 ? r : -r)} ${y1 + 18 + r}` +
    ` L ${side - (side > 0 ? r : -r)} ${y1 + 18 + r}` +
    ` Q ${side} ${y1 + 18 + r} ${side} ${y1 + 18 + r * 2}` +
    ` L ${side} ${y2 - 18 - r}` +
    ` Q ${side} ${y2 - 18} ${side + (x2 > side ? r : -r)} ${y2 - 18}` +
    ` L ${x2 - (x2 > side ? r : -r)} ${y2 - 18}` +
    ` Q ${x2} ${y2 - 18} ${x2} ${y2 - 18 + r}` +
    ` L ${x2} ${y2}`
  );
};

/** 위에서 아래로 내려가는 연결선. 어긋나면 가운데서 한 번 꺾는다. */
const link = (x1: number, y1: number, x2: number, y2: number) => {
  if (Math.abs(x1 - x2) < 1) return `M ${x1} ${y1} L ${x2} ${y2}`;
  const my = (y1 + y2) / 2;
  const r = Math.min(14, Math.abs(x2 - x1) / 2, Math.abs(y2 - y1) / 2);
  const d = x2 > x1 ? 1 : -1;
  return (
    `M ${x1} ${y1} L ${x1} ${my - r}` +
    ` Q ${x1} ${my} ${x1 + d * r} ${my}` +
    ` L ${x2 - d * r} ${my}` +
    ` Q ${x2} ${my} ${x2} ${my + r}` +
    ` L ${x2} ${y2}`
  );
};

/** 같은 출발점에서 여러 갈래로 나가면 분배기가 필요하다 */
const outCount = new Map<string, number>();
for (const e of edges) outCount.set(e.from, (outCount.get(e.from) ?? 0) + 1);
---

<figure class="fc">
  <svg
    class="fc-svg"
    width={width}
    height={height}
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={caption ?? '공정 흐름도'}
  >
    <defs>
      <marker
        id={`fc-arrow-${index}`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="fc-arrowhead" />
      </marker>
    </defs>

    {/* ── 입력 (채굴기에서 들어오는 것) */}
    {input && (
      <g>
        {(() => {
          const t = `${input.itemKo} ${fmt(input.perMinute)}/분`;
          const w = chipW(t);
          return (
            <>
              <rect x={centerX - w / 2} y={PAD} width={w} height={CHIP_H} rx="4" class="fc-chip" />
              {input.itemId && (
                <image href={`${iIcon}/${input.itemId}.png`} x={centerX - w / 2 + 4} y={PAD + 3} width="24" height="24" />
              )}
              <text x={centerX - w / 2 + (input.itemId ? 32 : 10)} y={PAD + 20} class="fc-chiptext">{t}</text>
            </>
          );
        })()}
        {byLayer[0]?.map((n) => {
          const p = placed.get(n.id)!;
          return (
            <path
              d={link(centerX, PAD + CHIP_H, p.x + NODE_W / 2, p.y)}
              class="fc-link"
              fill="none"
              marker-end={`url(#fc-arrow-${index})`}
            />
          );
        })}
        {(byLayer[0]?.length ?? 0) > 1 && (
          <g class="fc-hub">
            <circle cx={centerX} cy={PAD + CHIP_H + 20} r="13" />
            <text x={centerX} y={PAD + CHIP_H + 24} text-anchor="middle">분</text>
          </g>
        )}
      </g>
    )}

    {/* ── 연결선 */}
    {edges.map((e) => {
      const a = placed.get(e.from);
      const b = placed.get(e.to);
      if (!a || !b) return null;
      const x1 = a.x + NODE_W / 2;
      const y1 = a.y + NODE_H;
      const x2 = b.x + NODE_W / 2;
      const y2 = b.y;
      // 레이어를 두 칸 이상 건너뛰면 옆으로 우회한다
      const skips = Math.abs(b.n.layer - a.n.layer) > 1;
      const sideX = a.x < width / 2 ? PAD - 8 : width - PAD + 8;
      const d = skips ? bypass(x1, y1, x2, y2, sideX) : link(x1, y1, x2, y2);
      const t = `${e.itemKo} ${fmt(e.perMinute)}/분`;
      const w = chipW(t);
      /*
        라벨을 중점에 두면 갈래가 둘일 때 분배기 원 위에서 서로 겹친다.
        목적지 쪽(70%)으로 내리면 갈래마다 가로로 벌어져 겹칠 일이 없다.
      */
      const mx = skips ? sideX : x1 + (x2 - x1) * 0.7;
      const my = skips ? (y1 + y2) / 2 : y1 + (y2 - y1) * 0.72;
      return (
        <g>
          <path d={d} class="fc-link" fill="none" marker-end={`url(#fc-arrow-${index})`} />
          <rect x={mx - w / 2} y={my - CHIP_H / 2} width={w} height={CHIP_H} rx="4" class="fc-chip" />
          {e.itemId && (
            <image href={`${iIcon}/${e.itemId}.png`} x={mx - w / 2 + 4} y={my - CHIP_H / 2 + 3} width="24" height="24" />
          )}
          <text x={mx - w / 2 + (e.itemId ? 32 : 10)} y={my + 5} class="fc-chiptext">{t}</text>
        </g>
      );
    })}

    {/* ── 분배기 표시: 한 노드에서 두 갈래 이상 나갈 때 */}
    {[...outCount.entries()]
      .filter(([, c]) => c > 1)
      .map(([id]) => {
        const a = placed.get(id);
        if (!a) return null;
        return (
          <g class="fc-hub">
            <circle cx={a.x + NODE_W / 2} cy={a.y + NODE_H + 20} r="13" />
            <text x={a.x + NODE_W / 2} y={a.y + NODE_H + 24} text-anchor="middle">분</text>
          </g>
        );
      })}

    {/* ── 기계 상자 */}
    {[...placed.values()].map(({ x, y, n }) => (
      <g class="fc-node">
        <rect x={x} y={y} width={NODE_W} height={NODE_H} rx="6" />
        {n.machineId && (
          <image href={`${bIcon}/${n.machineId}.png`} x={x + 8} y={y + 8} width="50" height="50" preserveAspectRatio="xMidYMid meet" />
        )}
        <text x={x + (n.machineId ? 66 : 12)} y={y + 26} class="fc-name">
          {n.machineKo} <tspan class="fc-count">×{n.count}</tspan>
        </text>
        {/*
          상자에는 **기계와 클럭만** 적는다. 산출은 이미 화살표 칩과 출력 칩에 있다.
          둘 다 적었더니 글자가 상자를 넘어갔다 — 미니멀한 그림에서 글자가 넘치면 그것부터 눈에 띈다.
        */}
        <text x={x + (n.machineId ? 66 : 12)} y={y + 46} class="fc-sub">
          {n.clock != null && n.clock < 100 ? `${fmt(n.clock)}%` : '100%'}
        </text>
      </g>
    ))}

    {/* ── 노드별 산출 칩 — 그 기계에서 밖으로 나가는 것 */}
    {[...placed.values()]
      .filter(({ n }) => n.out)
      .map(({ x, y, n }) => {
        const o = n.out!;
        const t = `${o.itemKo} ${fmt(o.perMinute)}/분`;
        const w = chipW(t);
        const cx = x + NODE_W / 2;
        const cy = y + NODE_H + 30;
        return (
          <g>
            <path d={`M ${cx} ${y + NODE_H} L ${cx} ${cy - 2}`} class="fc-link" fill="none" marker-end={`url(#fc-arrow-${index})`} />
            <rect x={cx - w / 2} y={cy} width={w} height={CHIP_H} rx="4" class="fc-chip is-out" />
            {o.itemId && <image href={`${iIcon}/${o.itemId}.png`} x={cx - w / 2 + 4} y={cy + 3} width="24" height="24" />}
            <text x={cx - w / 2 + (o.itemId ? 32 : 10)} y={cy + 20} class="fc-chiptext is-out">{t}</text>
          </g>
        );
      })}

    {/* ── 출력 */}
    {output && (
      <g>
        {byLayer[byLayer.length - 1]?.map((n) => {
          const p = placed.get(n.id)!;
          return (
            <path
              d={link(p.x + NODE_W / 2, p.y + NODE_H, centerX, bottomY + GAP_Y)}
              class="fc-link"
              fill="none"
              marker-end={`url(#fc-arrow-${index})`}
            />
          );
        })}
        {(byLayer[byLayer.length - 1]?.length ?? 0) > 1 && (
          <g class="fc-hub is-merge">
            <circle cx={centerX} cy={bottomY + GAP_Y / 2} r="13" />
            <text x={centerX} y={bottomY + GAP_Y / 2 + 4} text-anchor="middle">병</text>
          </g>
        )}
        {(() => {
          const t = `${output.itemKo} ${fmt(output.perMinute)}/분`;
          const w = chipW(t);
          return (
            <>
              <rect x={centerX - w / 2} y={bottomY + GAP_Y} width={w} height={CHIP_H} rx="4" class="fc-chip is-out" />
              {output.itemId && (
                <image href={`${iIcon}/${output.itemId}.png`} x={centerX - w / 2 + 4} y={bottomY + GAP_Y + 3} width="24" height="24" />
              )}
              <text x={centerX - w / 2 + (output.itemId ? 32 : 10)} y={bottomY + GAP_Y + 20} class="fc-chiptext is-out">{t}</text>
            </>
          );
        })()}
      </g>
    )}
  </svg>
  {caption && <figcaption class="fc-cap">{caption}</figcaption>}
</figure>
