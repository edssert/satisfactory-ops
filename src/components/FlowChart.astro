---
/**
 * FlowChart — 공정 흐름도. **축척이 없다.**
 *
 * 모델을 다시 바꿨다. 앞선 판본은 줄과 줄 사이를 무조건 한 점으로 모았다가 다시 뿌렸다.
 * 그러면 제련기 두 대가 병합기로 합쳐졌다가 제작기 세 대로 갈라지는 그림이 나오는데,
 * 실제로는 그렇게 짓지 않는다 — 제련기 #1(철 주괴 30/분)은 제작기 #1(철 주괴 30/분)이
 * 통째로 먹으므로 벨트 한 줄로 직결하면 된다. 있지도 않은 병합기를 그린 셈이다.
 *
 * 그래서 연결을 자동으로 만들지 않고 간선을 명시한다. `links` 가 정본이다.
 *
 *   분배기 — 한 기계의 산출이 두 곳 이상으로 갈릴 때만 그린다
 *   병합기 — 한 기계의 투입구로 같은 물건이 두 줄 이상 들어올 때만 그린다
 *            (물건이 다르면 투입구가 따로라 병합기가 필요 없다.
 *             저장 컨테이너는 벨트 두 줄까지 직접 받는다)
 *
 * 유량은 연결선이 아니라 기계 상자 안에 적는다. 예외는 갈라지는 지점뿐이다 —
 * 15/분이 10과 5로 갈리면 어느 쪽이 얼만지 상자만 봐선 알 수 없어서 가지에 적는다.
 */
import '../styles/flow.css';
import { NODE_W, GAP_X, PAD, fmtRate } from '../lib/flow-layout';

/** 네 줄(기계·투입·산출·클럭)이 들어가야 하므로 flow-layout 기본값보다 높다 */
const NODE_H = 88;
const NODE_H_BY = 108;
const STORE_H = 92;
/** 분배기·병합기가 들어갈 자리를 줄 사이에 확보한다 */
const ROW_GAP = 68;
const BRANCH_DY = 28;
const ATTACH = 32;
/** 필렛 반지름 */
const R = 9;

export interface MachineBox {
  /** 기계 이름. 같은 기계가 여러 대면 상자를 각각 만든다 */
  ko: string;
  /** 아이콘용 건물 클래스 */
  machineId?: string;
  inputs?: { ko: string; perMinute: number }[];
  /** 단위는 기본이 "/분". 발전기처럼 MW 를 내는 것은 unit 을 바꾼다 */
  output?: { ko: string; perMinute: number; unit?: string };
  /**
   * 같이 나오는데 안 쓰는 것. 정제소가 플라스틱을 내면서 중유 잔여물을 함께 낸다.
   * 이걸 안 그리면 "왜 라인이 멈추나"를 그림이 설명하지 못한다.
   */
  byproduct?: { ko: string; perMinute: number };
  /** 100 이면 적지 않는다 */
  clock?: number;
  /** 기계가 아닌 것(저장 컨테이너 등)에 붙이는 한 줄 */
  note?: string;
  /** 설 자리(열 번호, 0부터). 없으면 그 줄 안에서 가운데 정렬 */
  col?: number;
}

/** 라인의 끝. 무엇이 분당 몇 개씩 들어오는지 */
export interface StoreBox {
  itemKo: string;
  itemId?: string;
  perMinute: number;
  col?: number;
}

export type Row =
  | { kind: 'machines'; boxes: MachineBox[] }
  | { kind: 'storage'; label: string; boxes: StoreBox[] };

/** 상자 좌표 — [행, 그 행에서 몇 번째] */
export type At = [number, number];

export interface Link {
  from: At;
  to: At;
  /** 갈라지는 지점에서만 적는다. 안 적으면 어느 가지가 얼만지 알 수 없다 */
  perMinute?: number;
  /** 주 산출이 아니라 부산물을 나르는 줄 */
  byproduct?: boolean;
}

interface Props {
  rows: Row[];
  links: Link[];
  caption?: string;
  index?: number;
  /** 투입이 둘 이상이라 한 줄이 긴 그림. 상자를 넓힌다 */
  wide?: boolean;
}
const { rows, links, caption, index = 1, wide = false } = Astro.props;

/** 이 그림에서 쓸 상자 너비 */
const BOX_W = wide ? 244 : NODE_W;
/** 되돌아오는 줄이 도는 바깥 통로의 너비 */
const LOOP_LANE = 34;

/* 부산물 줄이 하나라도 있으면 그림 전체의 상자를 높인다 — 상자마다 높이가 다르면 줄이 어긋난다 */
const anyByproduct = rows.some(
  (r) => r.kind === 'machines' && r.boxes.some((b) => (b as MachineBox).byproduct)
);
const BOX_H = anyByproduct ? NODE_H_BY : NODE_H;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bIcon = `${base}/assets/buildings-png`;
const iIcon = `${base}/assets/items`;

/* ---------------------------------------------------------------- 배치 */

const cols = Math.max(
  1,
  ...rows.map((r) =>
    Math.max(r.boxes.length, ...r.boxes.map((b: { col?: number }) => (b.col ?? 0) + 1))
  )
);
/* 되돌아오는 줄은 상자 바깥으로 돈다. 그만큼 그림이 넓어야 잘리지 않는다 */
const hasLoop = links.some((l) => l.to[0] < l.from[0]);
const width =
  PAD * 2 + cols * BOX_W + (cols - 1) * GAP_X + (hasLoop ? LOOP_LANE + PAD : 0);

let cursor = PAD;
const placed = rows.map((row) => {
  const h = row.kind === 'storage' ? STORE_H : BOX_H;
  const at = { row, y: cursor, h };
  cursor += h + ROW_GAP;
  return at;
});
const height = cursor - ROW_GAP + PAD;

/** 상자가 놓이는 영역. 되돌림 통로는 이 영역 바깥이다 */
const FIELD_W = width - (hasLoop ? LOOP_LANE + PAD : 0);

function boxLeft(ri: number, bi: number): number {
  const row = rows[ri]!;
  const b = row.boxes[bi] as { col?: number } | undefined;
  if (b?.col != null) return PAD + b.col * (BOX_W + GAP_X);
  const n = row.boxes.length;
  const total = n * BOX_W + (n - 1) * GAP_X;
  return (FIELD_W - total) / 2 + bi * (BOX_W + GAP_X);
}
const boxCx = (ri: number, bi: number) => boxLeft(ri, bi) + BOX_W / 2;
const boxRight = (ri: number, bi: number) => boxLeft(ri, bi) + BOX_W;
const rowTop = (ri: number) => placed[ri]!.y;
const rowBottom = (ri: number) => placed[ri]!.y + placed[ri]!.h;

/* ---------------------------------------------------------------- 간선 */

const key = (a: At) => `${a[0]}:${a[1]}`;
const outs = new Map<string, Link[]>();
const ins = new Map<string, Link[]>();
/** 되돌아오는 줄 — 아래에서 위로 간다 */
const isLoop = (l: Link) => l.to[0] < l.from[0];
/** 같은 줄에서 옆으로 넘기는 줄 (물 추출기 → 정제소처럼) */
const isSide = (l: Link) => l.to[0] === l.from[0];

for (const l of links) {
  if (isLoop(l) || isSide(l)) continue;
  const sk = key(l.from);
  const dk = key(l.to);
  if (!outs.has(sk)) outs.set(sk, []);
  if (!ins.has(dk)) ins.set(dk, []);
  outs.get(sk)!.push(l);
  ins.get(dk)!.push(l);
}

/** 이 간선이 나르는 물건. 병합기가 필요한지 판단하는 데 쓴다 */
function carried(l: Link): string {
  const row = rows[l.from[0]]!;
  if (row.kind !== 'machines') return '';
  const b = row.boxes[l.from[1]] as MachineBox | undefined;
  return (l.byproduct ? b?.byproduct?.ko : b?.output?.ko) ?? '';
}

/**
 * 병합기가 필요한가. 같은 물건이 한 투입구로 두 줄 이상 들어올 때만이다.
 * 물건이 다르면 기계의 투입구가 따로라 그냥 각각 꽂는다.
 * 저장 컨테이너는 벨트 두 줄까지 직접 받으므로 세 줄부터 병합기를 그린다.
 */
function isMerge(k: string): boolean {
  const inc = ins.get(k) ?? [];
  const ri = Number(k.split(':')[0]);
  if (rows[ri]!.kind === 'storage') return inc.length >= 3;
  if (inc.length < 2) return false;
  return new Set(inc.map(carried)).size === 1;
}

/** 들어오는 줄이 여럿이면 투입구를 나눠 꽂는다 — 한 점에 겹치면 어느 줄인지 안 보인다 */
function dstX(l: Link): number {
  const k = key(l.to);
  const inc = ins.get(k) ?? [];
  if (isMerge(k) || inc.length <= 1) return boxCx(l.to[0], l.to[1]);
  const i = inc.indexOf(l);
  return boxLeft(l.to[0], l.to[1]) + (BOX_W * (i + 1)) / (inc.length + 1);
}

/** 가로로 도는 높이를 hy 로 못박은 꺾인 선. 꺾임은 필렛으로 돌린다 */
function elbow(x1: number, y1: number, x2: number, y2: number, hy: number): string {
  if (Math.abs(x1 - x2) < 1.5) return `M${x1},${y1} L${x2},${y2}`;
  const dir = x2 > x1 ? 1 : -1;
  const r = Math.max(2, Math.min(R, Math.abs(x2 - x1) / 2, Math.abs(hy - y1), Math.abs(y2 - hy)));
  return (
    `M${x1},${y1} L${x1},${hy - r} ` +
    `Q${x1},${hy} ${x1 + r * dir},${hy} ` +
    `L${x2 - r * dir},${hy} ` +
    `Q${x2},${hy} ${x2},${hy + r} ` +
    `L${x2},${y2}`
  );
}

/**
 * 되돌아오는 줄. 상자 오른쪽으로 나가 바깥 통로를 타고 올라가서 목표 상자 오른쪽으로 들어간다.
 * 위아래 화살표만 있는 그림에 순환을 억지로 넣으면 선이 상자를 가로지른다.
 */
function loopPath(l: Link): string {
  const lane = FIELD_W + LOOP_LANE / 2;
  const y0 = rowTop(l.from[0]) + placed[l.from[0]]!.h / 2;
  const y1 = rowTop(l.to[0]) + placed[l.to[0]]!.h / 2;
  const x0 = boxRight(l.from[0], l.from[1]);
  const x1 = boxRight(l.to[0], l.to[1]);
  const r = Math.min(R, Math.abs(y1 - y0) / 2);
  const dir = y1 > y0 ? 1 : -1;
  return (
    `M${x0},${y0} L${lane - r},${y0} ` +
    `Q${lane},${y0} ${lane},${y0 + r * dir} ` +
    `L${lane},${y1 - r * dir} ` +
    `Q${lane},${y1} ${lane - r},${y1} ` +
    `L${x1},${y1}`
  );
}

const edges = links.map((l) => {
  if (isSide(l)) {
    /* 상자 옆면끼리 곧장 — 아래로 내려갔다 올라오면 남의 상자를 가로지른다 */
    const y = rowTop(l.from[0]) + placed[l.from[0]]!.h / 2;
    const right = boxLeft(l.to[0], l.to[1]) > boxLeft(l.from[0], l.from[1]);
    return {
      d: right
        ? `M${boxRight(l.from[0], l.from[1])},${y} L${boxLeft(l.to[0], l.to[1])},${y}`
        : `M${boxLeft(l.from[0], l.from[1])},${y} L${boxRight(l.to[0], l.to[1])},${y}`,
      skips: false,
      arrow: true,
      byproduct: !!l.byproduct,
      loop: false,
      rate: null as { x: number; y: number; v: number } | null,
    };
  }
  if (isLoop(l)) {
    return {
      d: loopPath(l),
      skips: false,
      arrow: true,
      byproduct: !!l.byproduct,
      loop: true,
      rate: null as { x: number; y: number; v: number } | null,
    };
  }
  /* 부산물 줄은 갈라짐으로 세지 않는다 — 물건이 달라 분배기가 아니라 다른 배출구다 */
  const sameKind = (outs.get(key(l.from)) ?? []).filter((o) => !!o.byproduct === !!l.byproduct);
  const split = sameKind.length >= 2;
  const merge = isMerge(key(l.to));
  const sx = l.byproduct
    ? boxLeft(l.from[0], l.from[1]) + BOX_W * 0.8
    : boxCx(l.from[0], l.from[1]);
  const ex = merge ? boxCx(l.to[0], l.to[1]) : dstX(l);
  const y0 = rowBottom(l.from[0]) + (split ? BRANCH_DY : 0);
  const y1 = rowTop(l.to[0]) - (merge ? BRANCH_DY : 0);
  const hy = split ? y0 + ATTACH / 2 + 4 : merge ? y1 - ATTACH / 2 - 4 : (y0 + y1) / 2;
  return {
    d: elbow(sx, y0, ex, y1, hy),
    byproduct: !!l.byproduct,
    loop: false,
    /* 중간 줄을 들르지 않고 지나가는 벨트는 점선으로 — 그 줄에 꽂힌 게 아님을 드러낸다 */
    skips: l.to[0] > l.from[0] + 1,
    arrow: !merge,
    /* 갈라지는 지점에서만 유량을 적는다 */
    rate: split && l.perMinute != null ? { x: ex + 7, y: hy - 6, v: l.perMinute } : null,
  };
});

/** 분배기 실물이 설 자리 */
const splitters = [...outs.entries()]
  .filter(([, v]) => v.filter((o) => !o.byproduct).length >= 2)
  .map(([k]) => {
    const [ri, bi] = k.split(':').map(Number) as [number, number];
    return { x: boxCx(ri, bi), y: rowBottom(ri) + BRANCH_DY };
  });

/** 병합기 실물이 설 자리 */
const mergers = [...ins.keys()].filter(isMerge).map((k) => {
  const [ri, bi] = k.split(':').map(Number) as [number, number];
  return { x: boxCx(ri, bi), y: rowTop(ri) - BRANCH_DY, top: rowTop(ri) };
});
---

<figure class="fc">
  <svg
    class="fc-svg"
    style={`max-width:${width}px`}
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={caption || '공정 흐름도'}
  >
    <defs>
      <marker
        id={`fc-arrow-${index}`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="5"
        markerHeight="5"
        orient="auto-start-reverse"
      >
        <path d="M0,1 L9,5 L0,9 z" class="fc-arrowhead"></path>
      </marker>
    </defs>

    {
      edges.map((e) => (
        <path
          d={e.d}
          class={
            `fc-link${e.skips ? ' is-skip' : ''}` +
            `${e.byproduct ? ' is-by' : ''}${e.loop ? ' is-loop' : ''}`
          }
          fill="none"
          marker-end={e.arrow ? `url(#fc-arrow-${index})` : undefined}
        />
      ))
    }

    {/* 분배기로 들어가는 토막 · 병합기에서 기계로 나가는 토막 */}
    {
      splitters.map((s) => (
        <path d={`M${s.x},${s.y - BRANCH_DY} L${s.x},${s.y}`} class="fc-link" fill="none" />
      ))
    }
    {
      mergers.map((m) => (
        <path
          d={`M${m.x},${m.y} L${m.x},${m.top}`}
          class="fc-link"
          fill="none"
          marker-end={`url(#fc-arrow-${index})`}
        />
      ))
    }

    {/* 실물을 분기점에 얹는다. 선 위에 올려 두고 한참 아래에서 갈라지면 그냥 통과한 그림이 된다 */}
    {
      splitters.map((s) => (
        <image
          href={`${bIcon}/Build_ConveyorAttachmentSplitter_C.png`}
          x={s.x - ATTACH / 2}
          y={s.y - ATTACH / 2}
          width={ATTACH}
          height={ATTACH}
          preserveAspectRatio="xMidYMid meet"
        />
      ))
    }
    {
      mergers.map((m) => (
        <image
          href={`${bIcon}/Build_ConveyorAttachmentMerger_C.png`}
          x={m.x - ATTACH / 2}
          y={m.y - ATTACH / 2}
          width={ATTACH}
          height={ATTACH}
          preserveAspectRatio="xMidYMid meet"
        />
      ))
    }

    {
      edges.map((e) =>
        e.rate ? (
          <text x={e.rate.x} y={e.rate.y} class="fc-branchrate">
            {fmtRate(e.rate.v)}/분
          </text>
        ) : null
      )
    }

    {
      placed.map((p, ri) => {
        if (p.row.kind === 'storage') {
          const label = p.row.label;
          return (
            <g class="fc-store">
              <line x1={PAD} y1={p.y - 18} x2={width - PAD} y2={p.y - 18} class="fc-storeline" />
              <text x={PAD} y={p.y - 24} class="fc-storelabel">
                {label}
              </text>
              {p.row.boxes.map((b, bi) => {
                const x = boxLeft(ri, bi);
                return (
                  <g>
                    <rect x={x} y={p.y} width={BOX_W} height={STORE_H} rx="3" class="fc-storebox" />
                    {b.itemId && (
                      <image
                        href={`${iIcon}/${b.itemId}.png`}
                        x={x + 14}
                        y={p.y + 24}
                        width="40"
                        height="40"
                      />
                    )}
                    <text x={x + 66} y={p.y + 40} class="fc-name">
                      {b.itemKo}
                    </text>
                    <text x={x + 66} y={p.y + 62} class="fc-storerate">
                      {fmtRate(b.perMinute)}/분
                    </text>
                  </g>
                );
              })}
            </g>
          );
        }

        return p.row.boxes.map((m, bi) => {
          const x = boxLeft(ri, bi);
          const tx = x + (m.machineId ? 62 : 12);
          return (
            <g class="fc-node">
              <rect x={x} y={p.y} width={BOX_W} height={BOX_H} rx="3" />
              {m.machineId && (
                <image
                  href={`${bIcon}/${m.machineId}.png`}
                  x={x + 7}
                  y={p.y + 15}
                  width="48"
                  height="48"
                  preserveAspectRatio="xMidYMid meet"
                />
              )}
              <text x={tx} y={p.y + 24} class="fc-name">
                {m.ko}
              </text>
              {m.inputs && m.inputs.length > 0 && (
                <text x={tx} y={p.y + 45} class="fc-io">
                  <tspan class="fc-iolabel">넣음</tspan>
                  {m.inputs.map((g, gi) => (
                    <>
                      {gi > 0 && <tspan class="fc-iosep"> · </tspan>}
                      <tspan> {g.ko} </tspan>
                      <tspan class="fc-num">{fmtRate(g.perMinute)}/분</tspan>
                    </>
                  ))}
                </text>
              )}
              {m.output && (
                <text x={tx} y={p.y + 64} class="fc-io">
                  <tspan class="fc-iolabel">냄</tspan>
                  <tspan> {m.output.ko} </tspan>
                  <tspan class="fc-num">
                    {fmtRate(m.output.perMinute)}
                    {m.output.unit ?? '/분'}
                  </tspan>
                </text>
              )}
              {m.byproduct && (
                <text x={tx} y={p.y + (m.note && m.inputs?.length ? 101 : 83)} class="fc-io fc-by">
                  <tspan class="fc-iolabel">남음</tspan>
                  <tspan> {m.byproduct.ko} </tspan>
                  <tspan class="fc-num">{fmtRate(m.byproduct.perMinute)}/분</tspan>
                </text>
              )}
              {m.note && (
                <text
                  x={tx}
                  y={p.y + (m.inputs?.length ? 83 : 45)}
                  class="fc-product"
                >
                  {m.note}
                </text>
              )}
              {/*
                * 100% 는 기본값이라 적지 않는다. 적으면 상자마다 같은 글자가 반복돼 잡음이 된다.
                * 자리는 이름 줄 오른쪽 — 아래 줄은 설명이 쓰고, 둘이 같은 줄을 다투면 글자가 뭉갠다.
                */}
              {m.clock != null && m.clock < 100 && (
                <text x={x + BOX_W - 10} y={p.y + 24} class="fc-sub" text-anchor="end">
                  {fmtRate(m.clock)}%
                </text>
              )}
            </g>
          );
        });
      })
    }
  </svg>

  {caption && caption.length > 0 && <figcaption class="fc-cap">{caption}</figcaption>}
</figure>
