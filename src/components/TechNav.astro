---
/**
 * TechNav — 도감 안의 화면들을 오가는 띠.
 *
 * 게임도 이것들이 서로 다른 화면이다. 한 페이지에 쭉 늘어놓으면
 * 지금 무엇을 보고 있는지가 사라진다.
 */
import { shopTabs, tech } from '../lib/tech';

interface Props {
  here: 'tiers' | 'mam' | 'shop' | 'recipes' | 'reference' | null;
}
const { here } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shopCount = shopTabs().tabs.reduce((a, t) => a + t.count, 0);

const links = [
  {
    key: 'tiers',
    ko: '티어',
    href: `${base}/dex/tiers/0/`,
    n: tech.$counts.hub + tech.$counts.milestones,
  },
  { key: 'mam', ko: 'MAM', href: `${base}/dex/mam/`, n: tech.$counts.mam },
  { key: 'shop', ko: '싱크 상점', href: `${base}/dex/shop/`, n: shopCount },
  { key: 'recipes', ko: '대체 제작법', href: `${base}/dex/recipes/`, n: null },
  { key: 'reference', ko: '표', href: `${base}/dex/reference/`, n: null },
];
---

<nav class="tnav" aria-label="도감">
  <a class="tnav-home" href={`${base}/dex/`}>도감</a>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} aria-current={here === l.key ? 'page' : undefined}>
          {l.ko}
          {l.n != null && <span class="n">{l.n}</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tnav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s5);
    align-items: baseline;
    margin-bottom: var(--s6);
    padding-bottom: var(--s3);
    border-bottom: var(--hair) solid var(--line-strong);
  }
  .tnav-home {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-decoration: none;
  }
  .tnav-home:hover { color: var(--ink); }
  .tnav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tnav li a {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    padding: 6px 14px;
    border: var(--hair) solid transparent;
    border-radius: 4px;
    color: var(--ink-2);
    font-size: var(--t-body-s);
    text-decoration: none;
  }
  .tnav li a:hover { border-color: var(--line-strong); color: var(--ink); }
  /* 지금 보고 있는 화면. 게임의 탭도 강조색으로 채운다 */
  .tnav li a[aria-current='page'] {
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }
  .tnav .n { color: var(--ink-3); font-family: var(--font-mono); font-size: 11px; }
  .tnav li a[aria-current='page'] .n { color: var(--on-accent); opacity: 0.75; }
</style>
