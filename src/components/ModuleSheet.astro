---
/**
 * ModuleSheet — 모듈 도면 한 장. 채굴기에서 완제품까지.
 *
 * 형식은 커뮤니티 모듈 시트를 따른다: 왼쪽에 배치도, 오른쪽에 건물 목록과 특징.
 *
 * **글자를 도형 안에 넣지 않는다.** 제련기 폭은 6 m = 토대 1칸이고, 거기에 '제련기'를
 * 써 넣으면 무슨 짓을 해도 넘친다. 세 번 실패한 뒤 실제 도면 관행을 따랐다 —
 * 도형에는 번호만 붙이고 설명은 옆의 표에 적는다. 그러면 넘칠 글자가 없다.
 *
 * 상호작용이 없으므로 Astro 컴포넌트다. 브라우저로 JS를 보내지 않는다.
 */
import type { ModulePlan } from '../lib/module-plan.ts';
import { symbolFor, drawSymbol, iconOf } from '../lib/machine-symbol.ts';

interface Props {
  plan: ModulePlan;
  /** 도면 제목 밑에 붙는 한 줄 */
  subtitle?: string;
  /** 이 모듈을 어디에 세우는가 */
  where?: { cell: string; note: string };
  index?: number;
}
const { plan, subtitle, where, index = 1 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconBase = `${base}/assets/buildings-png`;
const itemIconBase = `${base}/assets/items`;

/**
 * 직각 경로에 둥근 모서리를 넣는다.
 *
 * 커뮤니티의 잘 만든 도면들은 벨트를 각진 꺾임이 아니라 둥근 곡선으로 그린다 — 실제 벨트가
 * 그렇게 휘고, 눈으로 따라가기도 쉽다. 라우터가 낸 꺾임점을 그대로 이으면 딱딱하다.
 */
const roundedPath = (pts: { x: number; y: number }[], r: number): string => {
  if (pts.length < 2) return '';
  const P = pts.map((p) => ({ x: p.x * PX, y: p.y * PX }));
  let d = `M ${P[0]!.x} ${P[0]!.y}`;
  for (let i = 1; i < P.length - 1; i++) {
    const prev = P[i - 1]!;
    const cur = P[i]!;
    const next = P[i + 1]!;
    const len1 = Math.hypot(cur.x - prev.x, cur.y - prev.y);
    const len2 = Math.hypot(next.x - cur.x, next.y - cur.y);
    const rr = Math.min(r, len1 / 2, len2 / 2);
    const a = { x: cur.x + ((prev.x - cur.x) / (len1 || 1)) * rr, y: cur.y + ((prev.y - cur.y) / (len1 || 1)) * rr };
    const b = { x: cur.x + ((next.x - cur.x) / (len2 || 1)) * rr, y: cur.y + ((next.y - cur.y) / (len2 || 1)) * rr };
    d += ` L ${a.x} ${a.y} Q ${cur.x} ${cur.y} ${b.x} ${b.y}`;
  }
  const last = P[P.length - 1]!;
  d += ` L ${last.x} ${last.y}`;
  return d;
};

/** 팔각형 — 분배기·병합기 허브 */
const octagon = (cx: number, cy: number, r: number): string => {
  const k = r * 0.4142;
  return (
    `M ${cx - k} ${cy - r} L ${cx + k} ${cy - r} L ${cx + r} ${cy - k} L ${cx + r} ${cy + k}` +
    ` L ${cx + k} ${cy + r} L ${cx - k} ${cy + r} L ${cx - r} ${cy + k} L ${cx - r} ${cy - k} Z`
  );
};

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));

/** 라벨 배경 폭. 한글은 글자당 약 11 px, 숫자·기호는 6.2 px로 어림한다. */
const labelWidth = (t: string) => {
  let w = 12;
  for (const ch of t) w += /[가-힣]/.test(ch) ? 11 : 6.2;
  return Math.ceil(w);
};

/*
 * 축척. 토대 1칸(8 m) = 72 px.
 * 34 px으로 그렸더니 도면 전체가 188 px이 되어 아무것도 안 보였다. 폭은 항상 토대 4칸(32 m)
 * 기준이므로 72 px이면 288 px — 화면에서 읽을 수 있고 모바일에서도 가로 스크롤이 짧다.
 */
const PX = 72;
const PAD_L = 132; // 왼쪽: 채굴기 스트립 자리 (모듈 밖, 노드 위에 있다)
/*
 * 오른쪽 여백은 **벨트 라벨 레인**이다.
 * 라벨을 토대 안 오른쪽 끝에 붙였더니 폭을 넘겨 '콘크리트 40/분'이 '리트 40/분'으로,
 * '철 주괴'가 '주괴'로 잘렸다. 도면 관행대로 라벨은 도면 밖에 두고 지시선으로 잇는다.
 */
/*
 * 라벨은 **간선 벨트에만** 붙인다.
 * 분기(분배기 → 각 기계)까지 라벨을 달았더니 같은 문구가 기계 수만큼 반복되면서
 * 도면이 글자로 덮이고 서로 겹쳤다. 분기의 유량은 옆 표의 '대당 산출'로 알 수 있다.
 */
const trunkBelts = plan.belts
  .map((b, i) => ({ b, i }))
  .filter(({ b }) => !b.branch);
const beltLabels = new Map<number, string>(
  trunkBelts.map(({ b, i }) => [i, `${b.itemKo} ${fmt(b.perMinute)}/분${b.lines > 1 ? ` ×${b.lines}줄` : ''}`])
);
const PAD_T = 20;
const PAD_B = 46; // 축척 자리
const LANE_W = Math.max(90, ...[...beltLabels.values()].map(labelWidth)) + 26;
const FLOOR_W = plan.foundation.wTiles * PX;
const FLOOR_H = plan.foundation.hTiles * PX;
const W = FLOOR_W + PAD_L + LANE_W;
const H = FLOOR_H + PAD_T + PAD_B;

/** 채굴기 — 모듈 토대 밖, 노드 위에 있다. 왼쪽 스트립에 그린다. */
const miners = plan.mining.flatMap((m) =>
  m.assignments.map((a) => ({ ...a, itemKo: m.itemKo }))
);



/**
 * 도형에 붙는 번호. 오른쪽 표의 키가 된다.
 * 채굴기가 1번부터다 — 도면은 채굴기에서 시작하고, 그게 제일 먼저 짓는 건물이다.
 */
const minerTagBase = 1;
const tagged = plan.placements
  .filter((p) => p.kind === 'machine')
  .map((p, i) => ({ ...p, tag: miners.length + minerTagBase + i }));

const attachments = plan.placements.filter((p) => p.kind === 'splitter' || p.kind === 'merger');

/** 표: 번호 → 무엇. 채굴기가 먼저 온다. */
interface ScheduleRow {
  tag: number;
  machine: string;
  makes: string;
  clock: number;
  perMachine: number | null;
  kind: string;
  detail: string;
}
const minerRows: ScheduleRow[] = miners.map((m, i) => ({
  tag: minerTagBase + i,
  machine: m.extractorKo,
  makes: m.itemKo,
  clock: m.clockPercent,
  perMachine: m.ratePerMinute,
  kind: 'extractor' as const,
  detail: `${m.cell} ${m.purityKo} 노드`,
}));
const schedule = minerRows.concat(tagged.map((t) => {
  const g = t.group != null ? plan.groups[t.group] : null;
  const [machine, item] = t.label.split('\n');
  return {
    tag: t.tag,
    machine: machine ?? '',
    makes: g ? g.itemKo : (item ?? ''),
    clock: t.clockPercent ?? 100,
    perMachine: g ? g.outPerMachinePerMinute : null,
    kind: t.kind,
    detail: '',
  };
}));

---

<figure class="ms">
  <figcaption class="ms-head">
    <p class="ms-num">모듈 {String(index).padStart(2, '0')}</p>
    <h3>
      {plan.targetKo} <span class="ms-rate">{fmt(plan.targetPerMinute)}/분</span>
    </h3>
    {subtitle && <p class="ms-sub">{subtitle}</p>}
  </figcaption>

  <div class="ms-body">
    {/*
      도면(SVG)을 걷어냈다.
      여러 번 다시 만들었지만 실제로 지을 수 있는 그림이 되지 못했다 — 벨트가 기계를 가로지르고,
      라벨이 잘리고, 배치가 공장이 아니라 뭉치가 됐다. 못 그리는 것을 그린 척하는 것보다
      **정확한 좌표와 순서표**를 주는 편이 낫다. 그것만으로 손으로 지을 수 있다.

      커뮤니티의 좋은 도면들은 게임 안에서 찍은 스크린샷을 합성한 것이고(파일 헤더에 Adobe 표식,
      벨트의 초록 접속 표시는 건설 도구를 들었을 때만 나오는 UI다), 그 품질은 게임 렌더 없이는
      나오지 않는다. docs/research/drawing-tools-visual.md 참조.
    */}
    <div class="ms-panel">
      {where && (
        <section class="ms-where">
          <h4>어디에</h4>
          <p>
            <span class="n">{where.cell}</span> — {where.note}
          </p>
        </section>
      )}

      <section>
        <h4>번호별 설비</h4>
        <table class="ms-schedule">
          <tbody>
            {schedule.map((s) => (
              <tr>
                <td class="ms-t"><span class="ms-tagcell">{s.tag}</span></td>
                <td>
                  {s.machine}
                  {s.detail && <span class="muted"> · {s.detail}</span>}
                </td>
                <td class="n">{s.makes}</td>
                <td class="n">
                  {s.perMachine != null ? `${fmt(s.perMachine)}/분` : ''}
                  {s.clock < 100 && <span class="muted"> {fmt(s.clock)}%</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section>
        <h4>건물 목록</h4>
        <ul class="ms-bom">
          {plan.bom.map((b) => (
            <li>
              <span class="ms-bom-ko">{b.ko}</span>
              {b.count > 0 && <span class="n">×{b.count}</span>}
              {b.note && <span class="ms-bom-note">{b.note}</span>}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h4>공정 비율</h4>
        <table class="ms-ratio">
          <thead>
            <tr>
              <th>만드는 것</th>
              <th class="n">정확값</th>
              <th class="n">짓는 수</th>
              <th class="n">클럭</th>
              <th class="n">대당 산출</th>
              <th class="n">합계</th>
            </tr>
          </thead>
          <tbody>
            {plan.groups.map((g) => (
              <tr>
                <td>{g.itemKo}</td>
                <td class="n">{fmt(g.exact)}대</td>
                <td class="n">{g.built}대</td>
                <td class="n">{fmt(g.clockPercent)}%</td>
                <td class="n">{fmt(g.outPerMachinePerMinute)}/분</td>
                <td class="n">{fmt(g.outPerMinute)}/분</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="ms-note">
          정확값이 소수인 곳은 <strong>올려 짓고 다운클럭</strong>합니다. 반 대를 지을 수는 없고,
          올려 지은 뒤 100%로 두면 앞 공정이 못 따라와 굶습니다.
        </p>
        <p class="ms-note">
          클럭은 <strong>%로 맞추지 않아도 됩니다</strong> — 기계 UI에서 목표 산출을 개/분으로
          바로 넣을 수 있습니다. 위의 <strong>대당 산출</strong> 값을 그대로 적으면 반올림 오차 없이
          정확히 맞습니다. 88.89% 같은 값을 손으로 맞추는 것보다 이쪽이 쉽습니다.
        </p>
      </section>

      <section>
        <h4>채굴</h4>
        <ul class="ms-mining">
          {plan.mining.map((m) => (
            <li>
              <span class="ms-bom-ko">{m.itemKo}</span>
              <span class="n">{fmt(m.demandPerMinute)}/분</span>
              <span class="muted">
                {m.assignments
                  .map((a) => `${a.cell} ${a.purityKo}${a.clockPercent < 100 ? ` ${fmt(a.clockPercent)}%` : ''}`)
                  .join(' · ')}
              </span>
              {m.shortfallPerMinute > 0 && (
                <span class="ms-short">{fmt(m.shortfallPerMinute)}/분 부족</span>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section class="ms-build">
        <h4>손으로 짓는 순서</h4>
        <p class="ms-note">
          청사진 설계소는 티어 <span class="n">4</span>에 열립니다. 그 전에는 아래대로 하나씩 세웁니다.
          위치는 <strong>토대 왼쪽 위 모서리</strong>가 기준입니다. 도면이 흐릿해도 이 표만 정확하면
          지어집니다.
        </p>
        <ol class="ms-steps">
          {plan.buildSteps.map((st) => (
            <li>
              <div class="ms-step-head">
                <span class="ms-step-what">{st.what}</span>
                {st.count > 1 && <span class="n">×{st.count}</span>}
              </div>
              <div class="ms-step-where">{st.where}</div>
              {st.facing && <div class="ms-step-facing">{st.facing}</div>}
              {st.setting && st.setting !== '100%' && (
                <div class="ms-step-setting">{st.setting}</div>
              )}
              {st.why && <p class="ms-step-why">{st.why}</p>}
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h4>벨트 연결 목록</h4>
        <p class="ms-note">
          번호는 도면의 번호와 같습니다. 접속부의 정확한 높이·좌우 위치는 게임 데이터에 없어서
          <strong>어느 기계에서 어느 기계로</strong>만 적습니다 — 실제로 벨트를 놓을 때는 게임이
          접속부에 붙여 주므로 이 정보로 충분합니다.
        </p>
        <table class="ms-links">
          <thead>
            <tr><th>품목</th><th class="n">유량</th><th>어디서</th><th>어디로</th></tr>
          </thead>
          <tbody>
            {plan.belts.map((b) => (
              <tr class={b.branch ? 'is-branch' : undefined}>
                <td>{b.itemKo}{b.branch && <span class="muted"> (분기)</span>}</td>
                <td class="n">
                  {fmt(b.perMinute)}/분
                  {b.lines > 1 && <span class="muted"> ×{b.lines}줄</span>}
                </td>
                <td>{b.fromLabel}</td>
                <td>{b.toLabel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section>
        <h4>특징</h4>
        <ul class="ms-features">
          {plan.features.map((f) => <li>{f}</li>)}
        </ul>
      </section>

      {plan.notes.length > 0 && (
        <section>
          <h4>주의</h4>
          <ul class="ms-features is-warn">
            {plan.notes.map((n) => <li>{n}</li>)}
          </ul>
        </section>
      )}
    </div>
  </div>
</figure>
