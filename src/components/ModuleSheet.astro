---
/**
 * ModuleSheet — 모듈 도면 한 장. 채굴기에서 완제품까지.
 *
 * 형식은 커뮤니티 모듈 시트를 따른다: 왼쪽에 배치도, 오른쪽에 건물 목록과 특징.
 *
 * **글자를 도형 안에 넣지 않는다.** 제련기 폭은 6 m = 토대 1칸이고, 거기에 '제련기'를
 * 써 넣으면 무슨 짓을 해도 넘친다. 세 번 실패한 뒤 실제 도면 관행을 따랐다 —
 * 도형에는 번호만 붙이고 설명은 옆의 표에 적는다. 그러면 넘칠 글자가 없다.
 *
 * 상호작용이 없으므로 Astro 컴포넌트다. 브라우저로 JS를 보내지 않는다.
 */
import type { ModulePlan } from '../lib/module-plan.ts';
import { symbolFor, drawSymbol, iconOf } from '../lib/machine-symbol.ts';

interface Props {
  plan: ModulePlan;
  /** 도면 제목 밑에 붙는 한 줄 */
  subtitle?: string;
  /** 이 모듈을 어디에 세우는가 */
  where?: { cell: string; note: string };
  index?: number;
}
const { plan, subtitle, where, index = 1 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconBase = `${base}/assets/buildings-png`;
const itemIconBase = `${base}/assets/items`;

/**
 * 직각 경로에 둥근 모서리를 넣는다.
 *
 * 커뮤니티의 잘 만든 도면들은 벨트를 각진 꺾임이 아니라 둥근 곡선으로 그린다 — 실제 벨트가
 * 그렇게 휘고, 눈으로 따라가기도 쉽다. 라우터가 낸 꺾임점을 그대로 이으면 딱딱하다.
 */
const roundedPath = (pts: { x: number; y: number }[], r: number): string => {
  if (pts.length < 2) return '';
  const P = pts.map((p) => ({ x: p.x * PX, y: p.y * PX }));
  let d = `M ${P[0]!.x} ${P[0]!.y}`;
  for (let i = 1; i < P.length - 1; i++) {
    const prev = P[i - 1]!;
    const cur = P[i]!;
    const next = P[i + 1]!;
    const len1 = Math.hypot(cur.x - prev.x, cur.y - prev.y);
    const len2 = Math.hypot(next.x - cur.x, next.y - cur.y);
    const rr = Math.min(r, len1 / 2, len2 / 2);
    const a = { x: cur.x + ((prev.x - cur.x) / (len1 || 1)) * rr, y: cur.y + ((prev.y - cur.y) / (len1 || 1)) * rr };
    const b = { x: cur.x + ((next.x - cur.x) / (len2 || 1)) * rr, y: cur.y + ((next.y - cur.y) / (len2 || 1)) * rr };
    d += ` L ${a.x} ${a.y} Q ${cur.x} ${cur.y} ${b.x} ${b.y}`;
  }
  const last = P[P.length - 1]!;
  d += ` L ${last.x} ${last.y}`;
  return d;
};

/** 팔각형 — 분배기·병합기 허브 */
const octagon = (cx: number, cy: number, r: number): string => {
  const k = r * 0.4142;
  return (
    `M ${cx - k} ${cy - r} L ${cx + k} ${cy - r} L ${cx + r} ${cy - k} L ${cx + r} ${cy + k}` +
    ` L ${cx + k} ${cy + r} L ${cx - k} ${cy + r} L ${cx - r} ${cy + k} L ${cx - r} ${cy - k} Z`
  );
};

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));

/** 라벨 배경 폭. 한글은 글자당 약 11 px, 숫자·기호는 6.2 px로 어림한다. */
const labelWidth = (t: string) => {
  let w = 12;
  for (const ch of t) w += /[가-힣]/.test(ch) ? 11 : 6.2;
  return Math.ceil(w);
};

/*
 * 축척. 토대 1칸(8 m) = 72 px.
 * 34 px으로 그렸더니 도면 전체가 188 px이 되어 아무것도 안 보였다. 폭은 항상 토대 4칸(32 m)
 * 기준이므로 72 px이면 288 px — 화면에서 읽을 수 있고 모바일에서도 가로 스크롤이 짧다.
 */
const PX = 72;
const PAD_L = 132; // 왼쪽: 채굴기 스트립 자리 (모듈 밖, 노드 위에 있다)
/*
 * 오른쪽 여백은 **벨트 라벨 레인**이다.
 * 라벨을 토대 안 오른쪽 끝에 붙였더니 폭을 넘겨 '콘크리트 40/분'이 '리트 40/분'으로,
 * '철 주괴'가 '주괴'로 잘렸다. 도면 관행대로 라벨은 도면 밖에 두고 지시선으로 잇는다.
 */
/*
 * 라벨은 **간선 벨트에만** 붙인다.
 * 분기(분배기 → 각 기계)까지 라벨을 달았더니 같은 문구가 기계 수만큼 반복되면서
 * 도면이 글자로 덮이고 서로 겹쳤다. 분기의 유량은 옆 표의 '대당 산출'로 알 수 있다.
 */
const trunkBelts = plan.belts
  .map((b, i) => ({ b, i }))
  .filter(({ b }) => !b.branch);
const beltLabels = new Map<number, string>(
  trunkBelts.map(({ b, i }) => [i, `${b.itemKo} ${fmt(b.perMinute)}/분${b.lines > 1 ? ` ×${b.lines}줄` : ''}`])
);
const PAD_T = 20;
const PAD_B = 46; // 축척 자리
const LANE_W = Math.max(90, ...[...beltLabels.values()].map(labelWidth)) + 26;
const FLOOR_W = plan.foundation.wTiles * PX;
const FLOOR_H = plan.foundation.hTiles * PX;
const W = FLOOR_W + PAD_L + LANE_W;
const H = FLOOR_H + PAD_T + PAD_B;

/** 채굴기 — 모듈 토대 밖, 노드 위에 있다. 왼쪽 스트립에 그린다. */
const miners = plan.mining.flatMap((m) =>
  m.assignments.map((a) => ({ ...a, itemKo: m.itemKo }))
);



/**
 * 도형에 붙는 번호. 오른쪽 표의 키가 된다.
 * 채굴기가 1번부터다 — 도면은 채굴기에서 시작하고, 그게 제일 먼저 짓는 건물이다.
 */
const minerTagBase = 1;
const tagged = plan.placements
  .filter((p) => p.kind === 'machine')
  .map((p, i) => ({ ...p, tag: miners.length + minerTagBase + i }));

const attachments = plan.placements.filter((p) => p.kind === 'splitter' || p.kind === 'merger');

/** 표: 번호 → 무엇. 채굴기가 먼저 온다. */
interface ScheduleRow {
  tag: number;
  machine: string;
  makes: string;
  clock: number;
  perMachine: number | null;
  kind: string;
  detail: string;
}
const minerRows: ScheduleRow[] = miners.map((m, i) => ({
  tag: minerTagBase + i,
  machine: m.extractorKo,
  makes: m.itemKo,
  clock: m.clockPercent,
  perMachine: m.ratePerMinute,
  kind: 'extractor' as const,
  detail: `${m.cell} ${m.purityKo} 노드`,
}));
const schedule = minerRows.concat(tagged.map((t) => {
  const g = t.group != null ? plan.groups[t.group] : null;
  const [machine, item] = t.label.split('\n');
  return {
    tag: t.tag,
    machine: machine ?? '',
    makes: g ? g.itemKo : (item ?? ''),
    clock: t.clockPercent ?? 100,
    perMachine: g ? g.outPerMachinePerMinute : null,
    kind: t.kind,
    detail: '',
  };
}));

---

<figure class="ms">
  <figcaption class="ms-head">
    <p class="ms-num">모듈 {String(index).padStart(2, '0')}</p>
    <h3>
      {plan.targetKo} <span class="ms-rate">{fmt(plan.targetPerMinute)}/분</span>
    </h3>
    {subtitle && <p class="ms-sub">{subtitle}</p>}
  </figcaption>

  <div class="ms-body">
    <div class="ms-drawing">
      <svg
        class="ms-svg"
        width={W}
        height={H}
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={`${plan.targetKo} 모듈 배치도. 채굴기 ${miners.length}대에서 시작해 토대 ${plan.foundation.wTiles}×${plan.foundation.hTiles}칸 안에 기계 ${tagged.length}대가 들어간다.`}
      >
        <defs>
          <pattern id={`ms-grid-${index}`} width={PX} height={PX} patternUnits="userSpaceOnUse">
            <path d={`M ${PX} 0 L 0 0 0 ${PX}`} fill="none" class="ms-gridline" />
          </pattern>
          <marker
            id={`ms-arrow-${index}`}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto-start-reverse"
          >
            <path d="M 0 0 L 10 5 L 0 10 z" class="ms-arrowhead" />
          </marker>
        </defs>

        {/*
          채굴기 스트립 — 토대 **밖**이다. 채굴기는 노드 위에 있고, 그 노드는 부지에서
          수십~수백 m 떨어져 있을 수 있다. 토대 안에 그리면 거짓말이 된다.
        */}
        <g transform={`translate(0 ${PAD_T})`} class="ms-minerstrip">
          {miners.map((m, i) => {
            const y = i * 78;
            return (
              <g class="ms-block is-extractor">
                <rect x="6" y={y} width={PAD_L - 40} height="58" rx="2" />
                <circle cx="22" cy={y + 16} r="10" class="ms-tag-bg" />
                <text x="22" y={y + 20} text-anchor="middle" class="ms-tag">
                  {minerTagBase + i}
                </text>
                {/* 무엇을 캐는지가 먼저다. 좌표와 순도만 적어 두었더니 어느 광석인지 알 수 없었다. */}
                <text x="38" y={y + 20} class="ms-minerlabel">{m.itemKo}</text>
                <text x="12" y={y + 36} class="ms-minerrate">{fmt(m.ratePerMinute)}/분</text>
                <text x="12" y={y + 50} class="ms-minerrate is-muted">
                  {m.purityKo} · {m.cell}
                  {m.clockPercent < 100 ? ` · ${fmt(m.clockPercent)}%` : ''}
                </text>
                {/* 노드에서 토대로 들어오는 벨트 */}
                <line
                  x1={PAD_L - 34}
                  y1={y + 29}
                  x2={PAD_L - 4}
                  y2={y + 29}
                  class="ms-belt"
                  marker-end={`url(#ms-arrow-${index})`}
                />
              </g>
            );
          })}
          <text x="6" y={miners.length * 78 + 12} class="ms-striplabel">
            노드 위 · 토대 밖
          </text>
        </g>

        <g transform={`translate(${PAD_L} ${PAD_T})`}>
          {/*
            토대. 바탕 rect 와 격자 rect 를 분리한다 — 한 rect 에 class(fill)와
            fill="url(#pattern)" 을 같이 주면 CSS 가 이겨서 격자가 사라진다.
          */}
          <rect x="0" y="0" width={FLOOR_W} height={FLOOR_H} class="ms-floor" />
          <rect x="0" y="0" width={FLOOR_W} height={FLOOR_H} fill={`url(#ms-grid-${index})`} stroke="none" />
          {/* 4칸마다 굵은 선 — 청사진 설계소 Mk.1의 내부 치수가 토대 4칸(32 m)이다 */}
          {Array.from({ length: Math.floor(plan.foundation.wTiles / 4) + 1 }, (_, i) => (
            <line x1={i * 4 * PX} y1={0} x2={i * 4 * PX} y2={FLOOR_H} class="ms-gridline is-major" />
          ))}
          {Array.from({ length: Math.floor(plan.foundation.hTiles / 4) + 1 }, (_, j) => (
            <line x1={0} y1={j * 4 * PX} x2={FLOOR_W} y2={j * 4 * PX} class="ms-gridline is-major" />
          ))}
          <rect x="0" y="0" width={FLOOR_W} height={FLOOR_H} class="ms-boundary" />

          {/*
            벨트 — 통로 하나에 선 하나. 라벨은 통로 안, 오른쪽 끝에 붙인다.
            예전에는 행마다 입력·출력 벨트를 따로 그려 같은 통로에 선과 라벨이 두 겹으로 겹쳤다.
          */}
          {/*
            기계 — **종류마다 다른 실루엣**을 그린다.
            사각형 + 번호로만 그렸더니 "2D로 흩뿌려놓은 도면"이 됐다. 사각형 열두 개가 놓인
            그림에서는 어느 것이 제련기고 어느 것이 조립기인지 알 수 없다. 실제 공정 도면은
            설비 종류마다 실루엣이 다르다 (docs/research/drawing-tools-visual.md).

            심볼은 0..1 정규화 좌표라 transform 으로 실제 치수에 얹는다. 비균등 스케일이므로
            선 굵기가 찌그러지지 않게 vector-effect="non-scaling-stroke" 를 붙인다.

            클럭 퍼센트는 도형에 적지 않는다 — 8 m짜리 기계가 나란히 서면
            "88.89%88.89%88.89%"로 겹쳤다. 수치는 옆 표에 있다.
          */}
          {tagged.map((t) => {
            const sym = symbolFor(t.machineId ?? '');
            const icon = iconOf(t.machineId ?? '');
            const bx = t.x * PX;
            const by = t.y * PX;
            const bw = t.wTiles * PX;
            const bh = t.hTiles * PX;
            // 아이콘은 도형 안에 여백을 두고 넣는다 — 꽉 채우면 번호와 겹친다
            // 건물 아이콘은 블록을 채운다 — 무슨 기계인지가 첫 정보다
            const iconSize = Math.max(22, Math.min(bw, bh) * 0.78);
            // 산출 배지는 모서리에 작게
            const badge = Math.max(14, Math.min(bw, bh) * 0.26);
            /*
              포트 표식은 **계획이 계산한 좌표**를 쓴다. 도면이 따로 계산하면 벨트가 닿는 자리와
              삼각형이 그려진 자리가 어긋난다. 위치는 추정값이다 (게임 데이터에 포트 좌표가 없다).
            */
            const ports = (t.ports ?? []).map((pt) => ({
              x: pt.x * PX,
              y: pt.y * PX,
              role: pt.role,
            }));
            return (
              <g class="ms-machine">
                {/*
                  아이콘이 있으면 아이콘을 쓴다. 저장소에 이미 있는 위키 자산이고,
                  직접 그린 실루엣보다 훨씬 잘 읽힌다. 없는 건물만 실루엣으로 떨어진다.
                */}
                <rect x={bx + 1} y={by + 1} width={bw - 2} height={bh - 2} rx="2"
                  fill="var(--surface)" stroke="var(--ink)" stroke-width="1.6" />
                {icon && (
                  <image
                    href={`${iconBase}/${t.machineId}.png`}
                    x={bx + (bw - iconSize) / 2}
                    y={by + (bh - iconSize) / 2}
                    width={iconSize}
                    height={iconSize}
                    preserveAspectRatio="xMidYMid meet"
                  />
                )}
                {!icon && drawSymbol(sym, bx, by, bw, bh, t.rotated ?? false).map((pa) => (
                  <path
                    d={pa.d}
                    class={`ms-sym is-${pa.kind}`}
                    fill={pa.kind === 'outline' ? 'var(--surface)' : 'none'}
                    stroke="var(--ink)"
                    stroke-width={pa.kind === 'outline' ? 1.6 : pa.kind === 'detail' ? 1.1 : 1}
                    stroke-dasharray={pa.kind === 'hint' ? '3 2' : undefined}
                    stroke-linejoin="round"
                  />
                ))}
                {/* 포트 — 방향이 보이는 작은 삼각형. 위치는 추정값이라 점선으로 둔다 */}
                {ports.map((pt) => (
                  <path
                    d={`M ${pt.x - 4} ${pt.y - 4} L ${pt.x + 4} ${pt.y - 4} L ${pt.x} ${pt.y + 4} Z`}
                    class={`ms-port is-${pt.role}`}
                    fill={pt.role === 'out' ? 'var(--accent)' : 'var(--bg)'}
                    stroke="var(--accent)"
                    stroke-width="1.2"
                  />
                ))}
                {/*
                  **이 기계가 무엇을 분당 몇 개 만드는가**를 아이템 아이콘 + 수량 배지로 보여준다.
                  글자로 적으면 도면이 글자로 덮인다. 좋은 커뮤니티 도면들이 쓰는 방식이다.
                */}
                {t.itemId && (() => {
                  const label = `×${fmt(t.perMachinePerMinute ?? 0)}`;
                  const tw = 7 * label.length + 8;
                  const gx = bx + bw - 3 - badge - tw;
                  const gy = by + bh - 3 - badge;
                  return (
                    <g class="ms-outbadge">
                      <rect x={gx} y={gy} width={badge + tw} height={badge} rx="3" class="ms-badge-bg" />
                      <image href={`${itemIconBase}/${t.itemId}.png`} x={gx + 1} y={gy + 1} width={badge - 2} height={badge - 2} />
                      <text x={gx + badge + 4} y={gy + badge / 2 + 4} class="ms-badge-text">{label}</text>
                    </g>
                  );
                })()}
                {/* 번호는 왼쪽 위 모서리로 — 가운데 두면 아이콘과 겹친다 */}
                <circle cx={bx + 13} cy={by + 13} r="10" class="ms-tag-bg" />
                <text x={bx + 13} y={by + 17} text-anchor="middle" class="ms-tag">
                  {t.tag}
                </text>
              </g>
            );
          })}
          {/*
            벨트를 **기계보다 나중에** 그린다. 먼저 그렸더니 기계 블록이 벨트를 덮어
            "건물 입구로 컨베이어가 하나도 안 들어간다"는 그림이 됐다.
          */}
          {/*
            벨트 — pack.ts의 A* 라우터가 낸 **실제 경로**를 그린다. 기계를 관통하지 않는다.
            앞서는 통로마다 가로선 하나를 그어 눈속임했는데, 어느 기계의 어느 면에서 나와
            어디로 들어가는지가 보이지 않았다.
          */}
          {/*
            벨트 — pack.ts 의 A* 라우터가 낸 **실제 경로**를 그린다. 기계를 관통하지 않는다.
            분기 벨트는 가늘게 그리고 라벨을 붙이지 않는다.
          */}
          {plan.belts.filter((b) => b.path.length >= 2).map((b, bi) => (
            <>
              {/*
                벨트 — 참고 도면의 시각 언어를 따른다: 굵은 진회색 몸통에 밝은 테두리,
                둥근 모서리, 그리고 흐름 방향을 **초록 삼각 표식**으로 찍는다.
                가는 선 하나로 그렸을 때는 벨트인지 지시선인지 구분되지 않았다.
              */}
              <path
                d={roundedPath(b.path, 12)}
                fill="none"
                stroke="var(--bp-belt-edge)"
                stroke-width={b.branch ? 13 : 17}
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d={roundedPath(b.path, 12)}
                fill="none"
                stroke="var(--bp-belt)"
                stroke-width={b.branch ? 10 : 14}
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              {/* 흐름 방향 — 벨트 위에 찍는 표식 */}
              <path
                d={roundedPath(b.path, 12)}
                fill="none"
                stroke="var(--bp-flow)"
                stroke-width={b.branch ? 3 : 4}
                stroke-linecap="butt"
                stroke-dasharray="5 13"
                marker-end={`url(#ms-arrow-${index})`}
              />
            </>
          ))}

          {/*
            간선 라벨. y 가 겹치면 아래로 밀어 쌓는다 — 라벨이 겹쳐 읽히지 않는 사고를 막는다.
          */}
          {(() => {
            let lastY = -999;
            return trunkBelts.map(({ b, i }) => {
              const raw = b.path[b.path.length - 1]!.y * PX;
              const y = Math.max(raw, lastY + 20);
              lastY = y;
              const text = beltLabels.get(i)!;
              const lw = labelWidth(text);
              return (
                <g class="ms-beltlabelgroup">
                  <line x1={FLOOR_W} y1={raw} x2={FLOOR_W + 12} y2={y} class="ms-leader" />
                  <rect x={FLOOR_W + 12} y={y - 9} width={lw} height="18" rx="2" class="ms-beltlabel-bg" />
                  <text x={FLOOR_W + 18} y={y + 4} class="ms-beltlabel">{text}</text>
                </g>
              );
            });
          })()}

          {/*
            부속을 **기계보다 나중에** 그린다. 먼저 그렸더니 기계 실루엣이 위에 덮여
            '병합' 글자가 잘렸다. 실제로도 부속은 기계 옆·위에 얹히는 물건이다.
          */}
          {/* 부속 — 분배기·병합기. 글자로 적는다. 좌우 대칭 기호로는 구분이 안 된다. */}
          {/*
            분배기·병합기는 **팔각형 허브**로 그린다. 게임 안에서도 팔각형이고, 사각형 기계와
            형태가 달라 한눈에 구분된다. 예전에는 글자로 적었는데 도형이 작아 잘렸다.
            분배(1→3)는 채운 삼각형, 병합(3→1)은 빈 삼각형으로 방향을 표시한다.
          */}
          {attachments.map((a) => {
            const cx = a.x * PX + (a.wTiles * PX) / 2;
            const cy = a.y * PX + (a.hTiles * PX) / 2;
            // 부속은 기계보다 작게 — 크게 그리면 기계를 삼킨다
            const r = (Math.min(a.wTiles, a.hTiles) * PX) / 2.6;
            return (
              <g class={`ms-attach is-${a.kind}`}>
                {/* 바깥 팔각형 — 분배기는 파랑, 병합기는 주황 (참고 도면의 약속) */}
                <path
                  d={octagon(cx, cy, r)}
                  fill={a.kind === 'splitter' ? 'var(--bp-splitter)' : 'var(--bp-merger)'}
                  stroke={a.kind === 'splitter' ? 'var(--bp-splitter-line)' : 'var(--bp-merger-line)'}
                  stroke-width="2"
                />
                {/* 안쪽 판 — 형태만으로도 구분되게 (색만으로 구분하지 않는다) */}
                <path
                  d={octagon(cx, cy, r * 0.55)}
                  fill="none"
                  stroke={a.kind === 'splitter' ? 'var(--bp-splitter-line)' : 'var(--bp-merger-line)'}
                  stroke-width="1.5"
                  stroke-dasharray={a.kind === 'merger' ? '3 2' : undefined}
                />
              </g>
            );
          })}

        </g>

        {/* 축척 — 글자를 막대 아래에 두어 도면 폭을 넘지 않게 한다 */}
        <g transform={`translate(${PAD_L} ${H - 24})`} class="ms-scale">
          <line x1="0" y1="0" x2={PX * 4} y2="0" />
          <line x1="0" y1="-4" x2="0" y2="4" />
          <line x1={PX * 4} y1="-4" x2={PX * 4} y2="4" />
          <text x="0" y="16">토대 4칸 = 32 m (청사진 Mk.1 폭)</text>
        </g>
      </svg>

      <p class="ms-foot ms-assume">
        기계 실루엣은 종류를 알아보기 위한 <strong>단순화한 도식</strong>입니다. 점선 삼각형은 벨트
        접속부이고, <strong>그 위치는 추정값</strong>입니다 — 게임 데이터에 접속부 좌표가 없고
        위키·커뮤니티에도 측정치가 없습니다. 입력이 뒷면·출력이 앞면이라는 것만 출처가 있습니다
        (제조기는 반대).
      </p>
      <p class="ms-foot">
        토대 <span class="n">{plan.foundation.wTiles}×{plan.foundation.hTiles}</span>칸
        (<span class="n">{plan.foundation.wTiles * 8}×{plan.foundation.hTiles * 8}</span> m) ·
        전력 <span class="n">{fmt(plan.power.totalMW)}</span> MW
        {plan.power.savedMW > 0 && (
          <span class="muted"> (100%로 두면 {fmt(plan.power.at100MW)} MW)</span>
        )}
      </p>
    </div>

    <div class="ms-panel">
      {where && (
        <section class="ms-where">
          <h4>어디에</h4>
          <p>
            <span class="n">{where.cell}</span> — {where.note}
          </p>
        </section>
      )}

      <section>
        <h4>번호별 설비</h4>
        <table class="ms-schedule">
          <tbody>
            {schedule.map((s) => (
              <tr>
                <td class="ms-t"><span class="ms-tagcell">{s.tag}</span></td>
                <td>
                  {s.machine}
                  {s.detail && <span class="muted"> · {s.detail}</span>}
                </td>
                <td class="n">{s.makes}</td>
                <td class="n">
                  {s.perMachine != null ? `${fmt(s.perMachine)}/분` : ''}
                  {s.clock < 100 && <span class="muted"> {fmt(s.clock)}%</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section>
        <h4>건물 목록</h4>
        <ul class="ms-bom">
          {plan.bom.map((b) => (
            <li>
              <span class="ms-bom-ko">{b.ko}</span>
              {b.count > 0 && <span class="n">×{b.count}</span>}
              {b.note && <span class="ms-bom-note">{b.note}</span>}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h4>공정 비율</h4>
        <table class="ms-ratio">
          <thead>
            <tr>
              <th>만드는 것</th>
              <th class="n">정확값</th>
              <th class="n">짓는 수</th>
              <th class="n">클럭</th>
              <th class="n">대당 산출</th>
              <th class="n">합계</th>
            </tr>
          </thead>
          <tbody>
            {plan.groups.map((g) => (
              <tr>
                <td>{g.itemKo}</td>
                <td class="n">{fmt(g.exact)}대</td>
                <td class="n">{g.built}대</td>
                <td class="n">{fmt(g.clockPercent)}%</td>
                <td class="n">{fmt(g.outPerMachinePerMinute)}/분</td>
                <td class="n">{fmt(g.outPerMinute)}/분</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="ms-note">
          정확값이 소수인 곳은 <strong>올려 짓고 다운클럭</strong>합니다. 반 대를 지을 수는 없고,
          올려 지은 뒤 100%로 두면 앞 공정이 못 따라와 굶습니다.
        </p>
        <p class="ms-note">
          클럭은 <strong>%로 맞추지 않아도 됩니다</strong> — 기계 UI에서 목표 산출을 개/분으로
          바로 넣을 수 있습니다. 위의 <strong>대당 산출</strong> 값을 그대로 적으면 반올림 오차 없이
          정확히 맞습니다. 88.89% 같은 값을 손으로 맞추는 것보다 이쪽이 쉽습니다.
        </p>
      </section>

      <section>
        <h4>채굴</h4>
        <ul class="ms-mining">
          {plan.mining.map((m) => (
            <li>
              <span class="ms-bom-ko">{m.itemKo}</span>
              <span class="n">{fmt(m.demandPerMinute)}/분</span>
              <span class="muted">
                {m.assignments
                  .map((a) => `${a.cell} ${a.purityKo}${a.clockPercent < 100 ? ` ${fmt(a.clockPercent)}%` : ''}`)
                  .join(' · ')}
              </span>
              {m.shortfallPerMinute > 0 && (
                <span class="ms-short">{fmt(m.shortfallPerMinute)}/분 부족</span>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section class="ms-build">
        <h4>손으로 짓는 순서</h4>
        <p class="ms-note">
          청사진 설계소는 티어 <span class="n">4</span>에 열립니다. 그 전에는 아래대로 하나씩 세웁니다.
          위치는 <strong>토대 왼쪽 위 모서리</strong>가 기준입니다. 도면이 흐릿해도 이 표만 정확하면
          지어집니다.
        </p>
        <ol class="ms-steps">
          {plan.buildSteps.map((st) => (
            <li>
              <div class="ms-step-head">
                <span class="ms-step-what">{st.what}</span>
                {st.count > 1 && <span class="n">×{st.count}</span>}
              </div>
              <div class="ms-step-where">{st.where}</div>
              {st.facing && <div class="ms-step-facing">{st.facing}</div>}
              {st.setting && st.setting !== '100%' && (
                <div class="ms-step-setting">{st.setting}</div>
              )}
              {st.why && <p class="ms-step-why">{st.why}</p>}
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h4>벨트 연결 목록</h4>
        <p class="ms-note">
          번호는 도면의 번호와 같습니다. 접속부의 정확한 높이·좌우 위치는 게임 데이터에 없어서
          <strong>어느 기계에서 어느 기계로</strong>만 적습니다 — 실제로 벨트를 놓을 때는 게임이
          접속부에 붙여 주므로 이 정보로 충분합니다.
        </p>
        <table class="ms-links">
          <thead>
            <tr><th>품목</th><th class="n">유량</th><th>어디서</th><th>어디로</th></tr>
          </thead>
          <tbody>
            {plan.belts.map((b) => (
              <tr class={b.branch ? 'is-branch' : undefined}>
                <td>{b.itemKo}{b.branch && <span class="muted"> (분기)</span>}</td>
                <td class="n">
                  {fmt(b.perMinute)}/분
                  {b.lines > 1 && <span class="muted"> ×{b.lines}줄</span>}
                </td>
                <td>{b.fromLabel}</td>
                <td>{b.toLabel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section>
        <h4>특징</h4>
        <ul class="ms-features">
          {plan.features.map((f) => <li>{f}</li>)}
        </ul>
      </section>

      {plan.notes.length > 0 && (
        <section>
          <h4>주의</h4>
          <ul class="ms-features is-warn">
            {plan.notes.map((n) => <li>{n}</li>)}
          </ul>
        </section>
      )}
    </div>
  </div>
</figure>
