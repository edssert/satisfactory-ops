---
/**
 * ItemChip — 게임의 아이템 칸 그대로. 가운데에 그림, 오른쪽 아래에 개수.
 *
 * 인게임 비용·보상 표시가 이 모양이라 눈이 익어 있다. 글로 "철판 300" 이라고 쓰는 것보다
 * 훨씬 빨리 읽히고, 목록이 길어져도 개수가 늘 같은 자리에 있어 훑기 좋다.
 */
interface Props {
  id: string;
  ko: string;
  amount?: number | null;
  kind?: 'items' | 'buildings-png';
  size?: number;
  /** 아이콘 파일이 없을 때 이름 첫 글자로 대신할지 */
  fallback?: boolean;
}
const { id, ko, amount = null, kind = 'items', size = 52, fallback = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{/*
  * 그림과 숫자만으로는 이름이 안 읽힌다 — 아이콘이 안 뜨거나 화면 낭독기로 볼 때 빈칸이 된다.
  * 칸 전체를 하나의 그림으로 선언하고 이름과 개수를 라벨로 붙인다. 인게임 모양은 그대로 둔다.
  */}
<span
  class="chip"
  style={`--s:${size}px`}
  role="img"
  title={amount == null ? ko : `${ko} ${amount}개`}
  aria-label={amount == null ? ko : `${ko} ${amount}개`}
>
  <img src={`${base}/assets/${kind}/${id}.png`} alt="" loading="lazy" />
  {fallback && <span class="chip-fb" aria-hidden="true">{ko.slice(0, 1)}</span>}
  {amount != null && <b class="chip-n" aria-hidden="true">{amount}</b>}
</span>

<style>
  .chip {
    position: relative;
    display: inline-flex;
    width: var(--s);
    height: var(--s);
    align-items: center;
    justify-content: center;
    border: var(--hair) solid var(--line-strong);
    border-radius: 3px;
    background: var(--surface);
    vertical-align: middle;
  }
  .chip img {
    width: 78%;
    height: 78%;
    object-fit: contain;
  }
  /* 아이콘이 없으면 빈 칸이 아니라 글자가 남는다 */
  .chip-fb {
    position: absolute;
    z-index: 0;
    color: var(--ink-3);
    font-family: var(--font-display);
    font-size: calc(var(--s) * 0.42);
    font-weight: 700;
  }
  .chip img { position: relative; z-index: 1; }
  .chip-n {
    position: absolute;
    z-index: 2;
    right: -1px;
    bottom: -1px;
    min-width: 42%;
    padding: 0 3px;
    border-radius: 2px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: calc(var(--s) * 0.27);
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }
</style>
