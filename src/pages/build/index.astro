---
/**
 * 건설 프로그램 — **어떤 공장을 · 어디에 · 어떤 순서로 지을지.**
 *
 * 계산기가 아니다. 목표 생산량을 입력하지 않는다.
 * 규모는 항상 **노드 하나에 올린 채굴기 하나**가 정한다. 그래서 나오는 숫자가 초반에
 * 실제로 지을 수 있는 숫자다. ("보강된 철판 60/분"이 기본값인 화면은 초반 안내서가 아니다.)
 *
 * 이 화면의 모든 수치는 게임 데이터에서 계산된다:
 *   해금 티어·기계 치수·전력·레시피 비율 → Docs.json
 *   노드 위치·순도·거리 → resource-nodes.json (좌표), 순도 배수는 위키 근거
 */
import Base from '../../layouts/Base.astro';
import ModuleSheet from '../../components/ModuleSheet.astro';
import SitePlan from '../../components/SitePlan.astro';
import '../../styles/module-sheet.css';
import resourceNodes from '../../data/app/resource-nodes.json';
import { building, calculatorRecipes, item, milestonesByTier, nameOf } from '../../lib/gamedata';
import { makeRecipeBook } from '../../lib/recipe-select';
import { planModule, rateFromSupply, type MachineSpec } from '../../lib/module-plan';
import { findSites, siteVerdict } from '../../lib/siting';
import { distanceM, type Extractor, type ResourceNode } from '../../lib/mining';
import itemsJson from '../../data/app/items.json';
import recipesJson from '../../data/app/recipes.json';
import buildingsJson from '../../data/app/buildings.json';
import type { Building, Item, Recipe } from '../../lib/types';

const items = itemsJson as Item[];
const recipes = recipesJson as Recipe[];
const buildings = buildingsJson as Building[];
const nodes = (resourceNodes as { nodes: ResourceNode[] }).nodes.filter(
  (n) => (n as unknown as { isItem: boolean }).isItem
);

const book = makeRecipeBook(items, recipes, buildings);
const isRaw = (id: string) => !book.recipeFor(id);
const machines = new Map<string, MachineSpec>(
  buildings.map((b) => [
    b.id,
    {
      id: b.id,
      ko: b.ko,
      footprint: b.footprint ?? null,
      powerMW: b.powerMW ?? null,
      powerExponent: b.powerExponent ?? null,
    },
  ])
);

// ---------------------------------------------------------------- 기준 시점
//
// "보강된 철판을 자동화하는 시점"이 언제인지 데이터로 정한다.
const assembler = building('Build_AssemblerMk1_C');
const minerMk1B = building('Build_MinerMk1_C');
const minerMk2B = building('Build_MinerMk2_C');
const beltMk1B = building('Build_ConveyorBeltMk1_C');
const beltMk2B = building('Build_ConveyorBeltMk2_C');
const liftMk1B = building('Build_ConveyorLiftMk1_C');
const designerB = building('Build_BlueprintDesigner_C');

const TIER = assembler.unlockTier ?? 2;

const extractor: Extractor = {
  id: minerMk1B.id,
  ko: minerMk1B.ko,
  perMinuteAtNormalPurity: minerMk1B.extraction?.perMinuteAtNormalPurity ?? 60,
  unlockTier: minerMk1B.unlockTier ?? 0,
  powerMW: minerMk1B.powerMW ?? null,
};
const belt = { ko: beltMk1B.ko, perMinute: beltMk1B.beltItemsPerMinute ?? 60 };
const futureBelt = {
  ko: beltMk2B.ko,
  perMinute: beltMk2B.beltItemsPerMinute ?? 120,
  tier: beltMk2B.unlockTier ?? 2,
};

/** 보강된 철판을 처음 요구하는 마일스톤 — "왜 지금인가"의 근거 */
const RIP = 'Desc_IronPlateReinforced_C';
const ripDemand = milestonesByTier()
  .flatMap((t) => t.list.map((m) => ({ tier: t.tier, m })))
  .filter((x) => x.m.cost.some((c) => c.item === RIP))
  .sort((a, b) => a.tier - b.tier)[0];

/** 티어 1~2 마일스톤이 요구하는 부품 총량 — 단계 순서의 근거 */
const needTotals = new Map<string, number>();
for (const t of milestonesByTier().filter((t) => t.tier <= TIER)) {
  for (const m of t.list) {
    for (const c of m.cost) needTotals.set(c.item, (needTotals.get(c.item) ?? 0) + c.amount);
  }
}
const needOf = (id: string) => needTotals.get(id) ?? 0;

// ---------------------------------------------------------------- 부지
const wants = [
  { res: 'Desc_OreIron_C', ko: item('Desc_OreIron_C').ko, minPerMinute: 120 },
  { res: 'Desc_OreCopper_C', ko: item('Desc_OreCopper_C').ko, minPerMinute: 120 },
  { res: 'Desc_Stone_C', ko: item('Desc_Stone_C').ko, minPerMinute: 120 },
];
const sites = findSites(nodes, wants, extractor, 3);
const site = sites[0]!;

/** 부지 반경 안의 노드만 이 프로그램에 쓴다 — 지도 반대편 노드를 쓰는 계획은 계획이 아니다 */
const RADIUS_M = 400;
const localNodes = nodes.filter((n) => distanceM(site, n) <= RADIUS_M);

// ---------------------------------------------------------------- 모듈
const mk = (targetId: string, rawId: string, supply: number) => {
  const rate = rateFromSupply(targetId, rawId, supply, book, isRaw);
  return planModule({
    targetItemId: targetId,
    targetPerMinute: rate,
    tier: TIER,
    book,
    machines,
    belt,
    futureBelt,
    nodes: localNodes,
    extractor,
    isRaw,
    liftKo: liftMk1B.ko,
  });
};

/** 노드 하나(순수 = 노말의 2배)에서 나오는 산출 */
const pureSupply = (minerMk1B.extraction?.perMinuteAtNormalPurity ?? 60) * 2;

const concrete = mk('Desc_Cement_C', 'Desc_Stone_C', pureSupply);
const iron = mk(RIP, 'Desc_OreIron_C', pureSupply);
const wire = mk('Desc_Wire_C', 'Desc_OreCopper_C', pureSupply);

/** 철 모듈에서 조립기가 몇 번 도형인가 — 본문이 번호로 지목할 수 있게 */
const ironTags = iron.placements
  .filter((p) => p.kind === 'machine' || p.kind === 'extractor')
  .map((p, i) => ({ tag: i + 1, group: p.group }));
const assemblerGroup = iron.groups.findIndex((g) => g.machineId === assembler.id);
const assemblerTags = ironTags.filter((t) => t.group === assemblerGroup).map((t) => t.tag);
const preAssemblerTags = ironTags.filter((t) => t.group !== assemblerGroup).map((t) => t.tag);
const tagRange = (a: number[]) =>
  a.length === 0 ? '' : a.length === 1 ? `⑨${a[0]}` : `${a[0]}~${a[a.length - 1]}`;

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));

const constraints = [
  {
    what: '채굴기',
    now: `${minerMk1B.ko} — 노말 ${extractor.perMinuteAtNormalPurity}/분, 순수 ${pureSupply}/분`,
    later: `${minerMk2B.ko}는 티어 ${minerMk2B.unlockTier} — 그때 같은 노드에서 배가 나옵니다`,
  },
  {
    what: '벨트',
    now: `${beltMk1B.ko} ${belt.perMinute}/분`,
    later: `${beltMk2B.ko} ${futureBelt.perMinute}/분이 티어 ${futureBelt.tier} — 조립기와 같은 티어입니다`,
  },
  {
    what: '리프트',
    now: `${liftMk1B.ko} (티어 ${liftMk1B.unlockTier})`,
    later: '높이가 바뀌는 지점에만 씁니다 — 채굴기 출력구, 층 전환',
  },
  {
    what: '조립기',
    now: `티어 ${assembler.unlockTier} 해금 — 이 시점의 기준입니다`,
    later: '조립기가 없으면 보강된 철판을 자동화할 수 없습니다',
  },
  {
    what: '청사진',
    now: `없음 — ${designerB.ko}는 티어 ${designerB.unlockTier}`,
    later: '그래서 폭을 32 m(토대 4칸)로 맞춥니다. 티어 4에 그대로 청사진으로 뜹니다',
  },
];
---

<Base
  title="건설 프로그램 — 무엇을 어디에 어떤 순서로"
  description="보강된 철판 자동화 시점을 기준으로, 어떤 공장을 어느 노드 군집에 어떤 순서로 지어야 하는지. 규모는 채굴기 한 대가 정합니다."
>
  <div class="wrap page">
    <header class="page-head">
      <p class="section-label"><span class="num">F14</span> 건설 프로그램</p>
      <h1>무엇을 · 어디에 · 어떤 순서로</h1>
      <p class="prose">
        생산량을 입력받지 않습니다. 규모는 <strong>노드 하나에 올린 채굴기 하나</strong>가 정합니다.
        그래야 초반에 실제로 지을 수 있는 숫자가 나옵니다 — 티어 {TIER}에서 보강된 철판
        60/분은 조립기 12대와 채굴기 12대짜리 계획이고, 그건 안내서가 아니라 산수입니다.
      </p>
    </header>

    <section class="note" style="margin-bottom: var(--s10)">
      <span class="note-title">기준 시점 — 왜 지금 보강된 철판인가</span>
      <p>
        {assembler.ko}가 티어 <span class="n">{assembler.unlockTier}</span>에 열리고,
        보강된 철판을 처음 요구하는 마일스톤이
        {ripDemand ? (
          <>
            티어 <span class="n">{ripDemand.tier}</span> · <strong>{ripDemand.m.ko}</strong>
            (<span class="n">{ripDemand.m.cost.find((c) => c.item === RIP)?.amount}</span>개)
          </>
        ) : (
          <>티어 {TIER}</>
        )}입니다. 그 앞 티어의 마일스톤은 철판·철봉·전선·콘크리트만 요구합니다 — 그래서 단계
        순서가 이 데이터에서 그대로 나옵니다.
      </p>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">00</span> 이 시점에 쓸 수 있는 것</p>
      <h2>제약을 먼저 못 박습니다</h2>
      <p class="prose">
        해금 안 된 설비를 전제한 계획은 못 짓는 계획입니다. 아래는 전부 게임 데이터의 해금
        티어에서 가져온 값입니다.
      </p>
      <div class="scroll-x">
        <table class="table">
          <thead>
            <tr><th>설비</th><th>지금</th><th>곧</th></tr>
          </thead>
          <tbody>
            {constraints.map((c) => (
              <tr>
                <td><strong>{c.what}</strong></td>
                <td>{c.now}</td>
                <td class="muted">{c.later}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">01</span> 어디에</p>
      <h2>순수 철·구리·석회석이 한자리에 모인 곳</h2>
      <p class="prose">
        아래는 노드 좌표에서 계산한 값입니다. 판단 기준은 <strong>가장 먼 자원까지의 거리</strong>
        하나입니다 — 벨트를 깔아야 하는 노동은 가장 먼 한 줄이 결정하기 때문입니다. 평균이 짧아도
        한 자원이 멀면 그 부지는 나쁜 부지입니다.
      </p>
      <SitePlan
        mapSrc={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/map/biome-map.webp`}
        sites={sites}
        selected={0}
        radiusM={250}
        resKo={Object.fromEntries(wants.map((w) => [w.res, w.ko]))}
      />

      <div class="scroll-x">
        <table class="table">
          <thead>
            <tr>
              <th>부지</th>
              <th class="n">최대 운반</th>
              {wants.map((w) => <th>{w.ko}</th>)}
              <th>판정</th>
            </tr>
          </thead>
          <tbody>
            {sites.map((s, i) => (
              <tr class={i === 0 ? 'total-row' : undefined}>
                <td>
                  <span class="n">{s.cell}</span>
                  {i === 0 && <span class="chip">추천</span>}
                </td>
                <td class="n">{s.maxHaulM} m</td>
                {s.resources.map((r) => (
                  <td class="n">
                    {r.nodes.map((n) => (
                      <span class="chip">{n.purity === 'pure' ? '순수' : n.purity === 'normal' ? '노말' : '불순'} {fmt(n.perMinute)}/분 · {n.distanceM}m</span>
                    ))}
                  </td>
                ))}
                <td class="muted">{siteVerdict(s)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">
        거리는 직선거리입니다. 실제 벨트는 지형을 따라 더 길어지므로 이 값은 <strong>하한</strong>입니다.
        지형 비용을 반영한 경로 계산은 아직 근거를 확보하지 못해 넣지 않았습니다.
      </p>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">02</span> 순서</p>
      <h2>세 개의 모듈, 이 순서로</h2>
      <p class="prose">
        아래 순서는 마일스톤이 요구하는 부품에서 나왔습니다. 티어 {TIER}까지 필요한 총량이
        콘크리트 <span class="n">{needOf('Desc_Cement_C')}</span>개,
        철판 <span class="n">{needOf('Desc_IronPlate_C')}</span>개,
        철봉 <span class="n">{needOf('Desc_IronRod_C')}</span>개,
        나사 <span class="n">{needOf('Desc_IronScrew_C')}</span>개,
        전선 <span class="n">{needOf('Desc_Wire_C')}</span>개,
        케이블 <span class="n">{needOf('Desc_Cable_C')}</span>개입니다.
        콘크리트가 가장 먼저 벽에 부딪히는 부품이고(티어 1 '기초 건축물'), 그래서 콘크리트 모듈이
        1번입니다.
      </p>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">단계 01</span> 콘크리트</p>
      <h2>제일 먼저 — 짓는 데 쓰는 물건부터</h2>
      <p class="prose">
        콘크리트는 마일스톤 납품과 토대 건설에 동시에 들어갑니다. 손으로 캐서는 절대 안 따라오는
        첫 부품이고, 공정이 한 단계라 가장 빨리 세울 수 있습니다.
        <strong>완료 조건</strong>: 콘크리트 <span class="n">{fmt(concrete.targetPerMinute)}</span>/분이
        흐르고 보관함에 쌓이기 시작하면 다음 단계로.
      </p>
      <ModuleSheet
        plan={concrete}
        index={1}
        subtitle={`석회석 ${fmt(concrete.mining[0]?.demandPerMinute ?? 0)}/분 → 콘크리트 ${fmt(concrete.targetPerMinute)}/분 · 순수 노드 1개 기준`}
        where={{ cell: site.cell, note: `석회석 노드까지 ${site.resources.find((r) => r.res === 'Desc_Stone_C')?.maxDistanceM ?? 0} m` }}
      />
    </section>

    <section class="section">
      <p class="section-label"><span class="num">단계 02</span> 철 라인</p>
      <h2>티어 1에 짓고, 티어 2에 조립기만 얹는다</h2>
      <p class="prose">
        이 모듈이 이 프로그램의 핵심입니다. <strong>티어 1에서는 번호 {tagRange(preAssemblerTags)}까지만
        짓습니다</strong> — 조립기가 아직 없으므로 철판·철봉·나사가 그대로 나와 티어 1 마일스톤
        세 개를 채웁니다. 티어 {assembler.unlockTier}에 조립기가 열리면
        번호 {assemblerTags.join('·')}을 <strong>같은 자리에 얹기만</strong> 하면 같은 모듈이 보강된
        철판을 냅니다. 앞 공정을 뜯을 필요가 없습니다 — 초반 배치를 후반까지 보고 잡는다는 것이
        구체적으로 이 뜻입니다.
      </p>
      <p class="prose">
        <strong>완료 조건</strong>: 보강된 철판
        <span class="n">{fmt(iron.targetPerMinute)}</span>/분.
        {ripDemand && (
          <>
            티어 {ripDemand.tier} <strong>{ripDemand.m.ko}</strong>가 요구하는
            <span class="n">{ripDemand.m.cost.find((c) => c.item === RIP)?.amount}</span>개를
            <span class="n">
              {Math.ceil((ripDemand.m.cost.find((c) => c.item === RIP)?.amount ?? 0) / iron.targetPerMinute)}
            </span>분에 채웁니다.
          </>
        )}
      </p>
      <ModuleSheet
        plan={iron}
        index={2}
        subtitle={`철 광석 ${fmt(iron.mining[0]?.demandPerMinute ?? 0)}/분 → 보강된 철판 ${fmt(iron.targetPerMinute)}/분 · 순수 노드 1개 기준`}
        where={{ cell: site.cell, note: `철 광석 노드 위 — 이 부지의 중심입니다` }}
      />
    </section>

    <section class="section">
      <p class="section-label"><span class="num">단계 03</span> 구리 라인</p>
      <h2>전선 — 티어 1이 가장 많이 요구하는 부품</h2>
      <p class="prose">
        티어 {TIER}까지 전선 <span class="n">{needOf('Desc_Wire_C')}</span>개가 필요합니다. 철보다도
        많습니다. 손으로 캐서 만들 양이 아닙니다.
        <strong>완료 조건</strong>: 전선 <span class="n">{fmt(wire.targetPerMinute)}</span>/분.
        케이블이 필요해지면 이 라인 뒤에 제작기를 붙입니다 — 전선
        <span class="n">{futureBelt.perMinute}</span>/분을 케이블
        <span class="n">{futureBelt.perMinute / 2}</span>/분으로 바꿉니다.
      </p>
      <ModuleSheet
        plan={wire}
        index={3}
        subtitle={`구리 광석 ${fmt(wire.mining[0]?.demandPerMinute ?? 0)}/분 → 전선 ${fmt(wire.targetPerMinute)}/분 · 순수 노드 1개 기준`}
        where={{ cell: site.cell, note: `구리 광석 노드까지 ${site.resources.find((r) => r.res === 'Desc_OreCopper_C')?.maxDistanceM ?? 0} m` }}
      />
    </section>

    <section class="note">
      <span class="note-title">아직 이 화면에 없는 것</span>
      <p>
        전력 발전 설계, 드론·트럭·열차 물류, 대체 제작법 우선순위, 티어 3 이후 단계는 아직
        들어오지 않았습니다. 근거를 확보하지 못한 수치(트럭·열차 처리량, 지형을 반영한 벨트 경로)를
        추정으로 채우지 않기 위해 비워 둡니다.
      </p>
    </section>
  </div>
</Base>
