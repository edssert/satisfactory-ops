---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const candidate = `${base}/assets/review/biomass-burner-isometric-foundation-transparent.png`;
---

<Base
  title="바이오매스 발전기 아이소메트릭 비교"
  description="Satisfactory 1.0 실제 플레이 화면과 현재 게임 자산 기반 아이소메트릭 후보를 모바일에서 비교합니다."
  section="codex"
>
  <main class="iso-review" id="main">
    <header class="iso-review__header">
      <p>VISUAL REVIEW · CURRENT GAME BUILD</p>
      <h1>바이오매스 발전기 아이소메트릭</h1>
      <span>왼쪽 실제 플레이 영상을 21초부터 재생하거나 멈춘 뒤, 오른쪽 후보의 색·재질·부품을 비교하세요.</span>
    </header>

    <section class="iso-review__grid" aria-label="인게임과 아이소메트릭 후보 비교">
      <figure>
        <div class="iso-review__video">
          <a href="https://www.youtube.com/watch?v=koR8EY7guHg&t=21s" target="_blank" rel="noreferrer">
            <img src="https://i.ytimg.com/vi/koR8EY7guHg/maxresdefault.jpg" alt="Satisfactory 1.0 바이오매스 발전기 실제 게임 모델" loading="lazy" />
            <span>▶ 21초부터 실제 플레이 열기</span>
          </a>
        </div>
        <figcaption>
          <strong>실제 1.0 플레이</strong>
          <span>SpectrumDad 영상 · 21초부터 설비 배치와 인게임 조명 확인</span>
          <a href="https://www.youtube.com/watch?v=koR8EY7guHg&t=21s" target="_blank" rel="noreferrer">YouTube에서 열기</a>
        </figcaption>
      </figure>

      <figure>
        <div class="iso-review__candidate">
          <img src={candidate} alt="실제 FICSIT 8×8×1 m 토대 위 바이오매스 발전기 아이소메트릭 후보" />
        </div>
        <figcaption>
          <strong>현재 후보</strong>
          <span>고도·방위각 45° · 78 mm 원근 · 투명 배경 · 블룸 없음 · 실제 토대와 PBR 채널</span>
          <a href={candidate} target="_blank">원본 1024px 열기</a>
        </figcaption>
      </figure>
    </section>

    <section class="iso-review__checks" aria-label="비교 항목">
      <h2>확인할 차이</h2>
      <ul>
        <li><b>부품</b><span>연료 투입부·상부 그릴·발전 코어·배관·사다리·표시등</span></li>
        <li><b>재질</b><span>주황 도색, 회색 구조재, 검정 고무, 무광 금속 배관</span></li>
        <li><b>조명</b><span>표시등 렌즈 외 과발광 없음, 흰 금속 하이라이트 억제</span></li>
        <li><b>배치</b><span>게임 원본 8×8×1 m FICSIT 토대 위 접지</span></li>
      </ul>
      <p>모델·수치 기준: 현재 설치본 CL-502094. 외부 영상은 시각 비교에만 사용하며 앱 자산으로 복사하지 않습니다.</p>
    </section>
  </main>
</Base>

<style>
  .iso-review { width: min(1500px, calc(100% - 32px)); margin: 0 auto; padding: clamp(32px, 6vw, 84px) 0; }
  .iso-review__header { display: grid; gap: 12px; max-width: 860px; margin-bottom: 32px; }
  .iso-review__header p { margin: 0; color: var(--primary); font: 700 .68rem var(--font-mono); letter-spacing: .12em; }
  .iso-review__header h1 { margin: 0; font-size: clamp(2rem, 5vw, 4.6rem); line-height: .98; }
  .iso-review__header span { color: var(--ink-2); line-height: 1.7; }
  .iso-review__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  figure { min-width: 0; margin: 0; border: 1px solid var(--line-strong); background: var(--surface); }
  .iso-review__video { position: relative; aspect-ratio: 16 / 9; background: var(--bg); }
  .iso-review__video a { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; color: var(--ink-1); }
  .iso-review__video img { width: 100%; height: 100%; object-fit: cover; }
  .iso-review__video a span { position: absolute; inset: auto 16px 16px; width: max-content; max-width: calc(100% - 32px); padding: 9px 12px; background: color-mix(in oklab, var(--bg) 88%, transparent); font: 700 .64rem var(--font-mono); }
  .iso-review__candidate { display: grid; aspect-ratio: 16 / 9; place-items: center; overflow: hidden; background-color: var(--bg); background-image: linear-gradient(45deg, var(--surface) 25%, transparent 25%), linear-gradient(-45deg, var(--surface) 25%, transparent 25%), linear-gradient(45deg, transparent 75%, var(--surface) 75%), linear-gradient(-45deg, transparent 75%, var(--surface) 75%); background-position: 0 0, 0 12px, 12px -12px, -12px 0; background-size: 24px 24px; }
  .iso-review__candidate img { width: 100%; height: 100%; object-fit: contain; }
  figcaption { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; padding: 16px; border-top: 1px solid var(--line); }
  figcaption strong { font-size: .9rem; }
  figcaption span { grid-row: 2; color: var(--ink-3); font-size: .7rem; line-height: 1.55; }
  figcaption a { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--primary); font: 700 .64rem var(--font-mono); }
  .iso-review__checks { margin-top: 18px; border: 1px solid var(--line-strong); padding: clamp(18px, 3vw, 30px); }
  .iso-review__checks h2 { margin: 0 0 16px; font-size: 1.2rem; }
  .iso-review__checks ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; background: var(--line); list-style: none; }
  .iso-review__checks li { display: grid; gap: 8px; padding: 14px; background: var(--bg); }
  .iso-review__checks b { color: var(--primary); font: 700 .62rem var(--font-mono); }
  .iso-review__checks li span, .iso-review__checks p { color: var(--ink-3); font-size: .68rem; line-height: 1.6; }
  .iso-review__checks p { margin: 16px 0 0; }
  @media (max-width: 800px) {
    .iso-review { width: min(100% - 20px, 680px); padding-block: 28px; }
    .iso-review__grid { grid-template-columns: 1fr; }
    .iso-review__checks ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 430px) {
    .iso-review__checks ul { grid-template-columns: 1fr; }
    figcaption { grid-template-columns: 1fr; }
    figcaption a { grid-column: 1; grid-row: auto; justify-self: start; }
  }
</style>
