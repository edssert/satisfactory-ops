---
/**
 * F1 마일스톤 진행 체크리스트.
 * 목록은 빌드타임에 데이터에서 렌더된다. 손으로 적은 마일스톤 이름·비용이 한 글자도 없다.
 */
import Base from '../../layouts/Base.astro';
import MilestoneChecklist, { type TierView } from '../../components/MilestoneChecklist.tsx';
import { item, milestonesByTier } from '../../lib/gamedata';
import advice from '../../data/curated/milestone-advice.json';

const adviceMap = advice.advice as Record<
  string,
  { action: string; trap: string; why: string; dispute?: string; confidence: string; sources: string[] }
>;
const tierNotes = advice.tierNotes as Record<string, { title: string; body: string }>;

const tiers: TierView[] = milestonesByTier().map(({ tier, list }) => ({
  tier,
  note: tierNotes[String(tier)],
  milestones: list.map((m) => ({
    id: m.id,
    ko: m.ko,
    en: m.en,
    cost: m.cost.map((c) => {
      const it = item(c.item);
      return { ko: it.ko, en: it.en, amount: c.amount };
    }),
    unlockCount: m.unlocksRecipes.length,
    advice: adviceMap[m.id],
  })),
}));

const totalMilestones = tiers.reduce((n, t) => n + t.milestones.length, 0);
---

<Base
  title="마일스톤 체크리스트 — satisfactory-ops"
  description="티어별 마일스톤과 해금 비용을 체크하며 현재 티어와 다음에 할 일을 판정합니다. 진행 상황은 이 브라우저에만 저장됩니다."
>
  <div class="wrap page">
    <header class="page-head">
      <p class="section-label"><span class="num">F1</span> 마일스톤 진행</p>
      <h1>어디까지 왔고, 다음에 무엇을 해야 하는가</h1>
      <p class="prose">
        마일스톤 <span class="n">{totalMilestones}</span>개를 티어별로 놓습니다. 체크하면 현재 티어를
        판정하고 다음에 할 일 세 가지를 제시합니다. 비용과 이름은 게임 배포 데이터에서 왔고, 조언에는
        전부 근거 출처가 붙어 있습니다.
      </p>
      <p class="caption">
        진행 상황은 <strong>이 브라우저에만</strong> 저장됩니다. 서버로 보내지 않습니다. 브라우저
        데이터를 지우면 사라지니, 오래 쓸 계획이면 가끔 내보내기를 해두세요.
      </p>
    </header>

    <MilestoneChecklist client:load tiers={tiers} />
  </div>
</Base>

<style>
  .page {
    padding-top: var(--s12);
  }
  .page-head {
    margin-bottom: var(--s12);
  }
  .page-head h1 {
    margin-bottom: var(--s4);
  }
</style>
