---
/**
 * F2 시작 가이드 — 착륙에서 티어 1 자동화까지.
 *
 * 이전 단일 HTML 버전(start.html)의 이식본. 차이는 하나다:
 * 요구 수량·기계 대수·노드 필요량을 **손으로 적지 않고 게임 데이터에서 계산한다.**
 * (그 손 타이핑이 커밋 bd981f4·2b5cdad의 원인이었다 — ADR-0009 참조)
 */
import Base from '../../layouts/Base.astro';
import StartPath from '../../components/StartPath.tsx';
import SiteMap from '../../components/SiteMap.tsx';
import {
  building,
  defaultRecipeOf,
  findBuilding,
  isRawResource,
  item,
  milestonesByTier,
  nameOf,
} from '../../lib/gamedata';
import { solve, type RecipeBook, type SolverRecipe } from '../../lib/solver';
import { ceil, ceilNum, format, toNumber } from '../../lib/rational';
import hub from '../../data/app/hub.json';
import sitesData from '../../data/curated/sites.json';
import startInventory from '../../data/curated/start-inventory.json';
// 이름이 게임 데이터 기준으로 정규화된 산출물을 쓴다 (원본은 외부 출처라 이름이 다르다)
import resourceNodes from '../../data/app/resource-nodes.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ---------------------------------------------------------------- 허브 · 티어 0
const hubBuilding = building('Build_TradingPost_C');
const hubCost = hubBuilding.buildCost.map((c) => ({ ko: item(c.item).ko, amount: c.amount }));

const hubUpgrades = (hub as { id: string; ko: string; en: string; cost: { item: string; amount: number }[]; unlocksRecipes: string[] }[]).map(
  (h) => ({
    ...h,
    costView: h.cost.map((c) => ({ ko: item(c.item).ko, en: item(c.item).en, amount: c.amount })),
  })
);

const hubTotal: Record<string, number> = {};
for (const h of hubUpgrades) for (const c of h.costView) hubTotal[c.ko] = (hubTotal[c.ko] ?? 0) + c.amount;

// ---------------------------------------------------------------- 티어 1 요구량
const tier1 = milestonesByTier().find((t) => t.tier === 1)!;
const t1Need: Record<string, number> = {};
for (const m of tier1.list) for (const c of m.cost) t1Need[c.item] = (t1Need[c.item] ?? 0) + c.amount;

// 계획의 기준을 "임의의 마감 시간"이 아니라 **노드 용량**으로 잡는다.
// 티어 1 요구 부품을 요구 비율 그대로 생산하되, 철광석 소비가 채굴기 Mk.1 한 대(노말 노드) 산출과
// 정확히 같아지도록 스케일을 맞춘다. 그러면 "노드 하나를 꽉 채우면 몇 분에 끝나는가"가 나온다.
const BASE_MINUTES = 60;

const book: RecipeBook = {
  recipeFor: (id) => {
    if (isRawResource(id)) return undefined;
    const r = defaultRecipeOf(id);
    if (!r) return undefined;
    return {
      id: r.id,
      ko: r.ko,
      en: r.en,
      durationSec: r.durationSec,
      ingredients: r.ingredients,
      products: r.products,
      producedIn: r.producedIn,
    } satisfies SolverRecipe;
  },
  machine: (id) => {
    const b = findBuilding(id);
    return b ? { id, ko: b.ko, en: b.en, powerMW: b.powerMW } : undefined;
  },
  nameOf,
};

// 1단계: 기준 비율(요구량/60분)로 한 번 풀어 철광석 소비를 구한다.
const baseLines = Object.entries(t1Need).map(([itemId, total]) => {
  const rate = total / BASE_MINUTES;
  const result = solve(itemId, rate, book);
  if (!result.ok) throw new Error(`티어 1 계획 계산 실패 (${itemId}): ${result.message}`);
  return { itemId, total, rate, result };
});

const ironOreAtBase = baseLines.reduce(
  (sum, l) => sum + (l.result.raw.find((r) => r.itemId === 'Desc_OreIron_C') ? toNumber(l.result.raw.find((r) => r.itemId === 'Desc_OreIron_C')!.rate) : 0),
  0
);

// 2단계: 철광석 소비가 채굴기 Mk.1(노말 노드) 산출과 같아지도록 전체를 확대한다.
const minerNormal = building('Build_MinerMk1_C').extraction?.perMinuteAtNormalPurity ?? 60;
const scale = ironOreAtBase > 0 ? minerNormal / ironOreAtBase : 1;
const minutesToFinish = BASE_MINUTES / scale;

const lines = baseLines.map((l) => {
  const rate = l.rate * scale;
  const result = solve(l.itemId, rate, book);
  if (!result.ok) throw new Error(`티어 1 계획 계산 실패 (${l.itemId}): ${result.message}`);
  return { itemId: l.itemId, total: l.total, rate, result };
});

// 기계·원자재·전력 합계
const machineTotals = new Map<string, number>();
const rawTotals = new Map<string, number>();
let totalPowerMW = 0;
for (const l of lines) {
  for (const m of l.result.machines) {
    machineTotals.set(m.buildingId, (machineTotals.get(m.buildingId) ?? 0) + toNumber(m.count));
  }
  for (const r of l.result.raw) {
    rawTotals.set(r.itemId, (rawTotals.get(r.itemId) ?? 0) + toNumber(r.rate));
  }
}
const machineRows = [...machineTotals.entries()]
  .map(([id, count]) => {
    const b = building(id);
    const built = ceilNum(count);
    totalPowerMW += (b.powerMW ?? 0) * built;
    return { ko: b.ko, en: b.en, exact: count, built, powerMW: b.powerMW ?? 0 };
  })
  .sort((a, b) => b.built - a.built);

const rawRows = [...rawTotals.entries()]
  .map(([id, rate]) => ({ id, ...nameOf(id), rate }))
  .sort((a, b) => b.rate - a.rate);

// 벨트 상한 검사 (ADR-0016)
const beltMk1 = building('Build_ConveyorBeltMk1_C').beltItemsPerMinute ?? 60;
const minerMk1Base = building('Build_MinerMk1_C').extraction?.perMinuteAtNormalPurity ?? 60;
const minerMk1 = { impure: minerMk1Base / 2, normal: minerMk1Base, pure: minerMk1Base * 2 };

// ---------------------------------------------------------------- 입지 지도 데이터
const nodeList = (resourceNodes as { nodes: { res: string; ko: string; isItem: boolean; purity: string; type: string; fx: number; fy: number; cell: string }[] }).nodes
  .filter((n) => n.isItem)
  .map((n) => ({
    res: n.res,
    ko: n.ko,
    purity: (n.purity ?? 'normal') as 'impure' | 'normal' | 'pure',
    type: n.type,
    fx: Math.round(n.fx * 1e5) / 1e5,
    fy: Math.round(n.fy * 1e5) / 1e5,
    cell: n.cell,
  }));

/*
 * 노드와의 연결은 **클래스 id**로 한다. 예전에는 여기 한글 이름 표를 손으로 적어
 * 노드의 '철광석'과 맞췄는데, 파이프라인이 이름을 게임 이름('철 광석')으로 정규화한
 * 순간 조인이 조용히 0건이 되어 화면에 "근처에 노드 없음"이 떴다. 표를 없앤다.
 */
const nodeResIds = new Set(nodeList.map((n) => n.res));
const demand = rawRows
  .filter((r) => nodeResIds.has(r.id))
  .map((r) => ({ res: r.id, ko: r.ko, need: ceilNum(r.rate), why: '' }));

// why 문구는 계산된 소비처에서 만든다 (손으로 적지 않는다)
const consumerOf: Record<string, string[]> = {};
for (const l of lines) {
  const walk = (n: (typeof l.result.root)) => {
    for (const c of n.children) {
      if (!c.recipeId && n.recipeKo) (consumerOf[c.ko] ??= []).push(n.ko);
      walk(c);
    }
  };
  walk(l.result.root);
}
for (const d of demand) {
  const uses = [...new Set(consumerOf[d.ko] ?? [])];
  d.why = uses.length
    ? `${uses.join(' · ')} 라인이 먹습니다. 노말 순도 노드 ${ceilNum(d.need / minerMk1.normal)}개 또는 순수 ${ceilNum(d.need / minerMk1.pure)}개 분량입니다.`
    : `채굴기 Mk.1 기준 노말 노드 ${ceilNum(d.need / minerMk1.normal)}개 분량입니다.`;
}

// ---------------------------------------------------------------- 스킵 시작 격차
const baseBuilding = tier1.list.find((m) => m.id === 'Schematic_1-1_C')!;
const skipHave: Record<string, number> = {};
for (const x of startInventory.tutorialSkip.items) skipHave[x.item] = x.amount;
const gap = baseBuilding.cost.map((c) => ({
  ko: item(c.item).ko,
  en: item(c.item).en,
  need: c.amount,
  have: skipHave[c.item] ?? 0,
}));

const startPoints = sitesData.startPoints.map((p) => ({ id: p.id, name: p.name, en: p.en }));
---

<Base
  title="시작 가이드 — satisfactory-ops"
  description="착륙에서 티어 1 자동화까지. 입지 선정, 허브 업그레이드, 첫 자동화 라인을 게임 데이터에서 계산한 수치로 안내합니다."
>
  <div class="wrap page">
    <header class="page-head">
      <p class="section-label"><span class="num">F2</span> 시작 가이드</p>
      <h1>착륙에서 첫 자동화까지</h1>
      <p class="prose">
        여기서 하는 결정 두 가지가 나중에 가장 크게 돌아옵니다 — <strong>어디에 자리를 잡는가</strong>와{' '}
        <strong>무엇을 먼저 자동화하는가</strong>. 아래 수치는 전부 게임 데이터에서 계산했습니다.
      </p>
    </header>

    <section class="note" style="margin-bottom: var(--s12)">
      <span class="note-title">먼저 알아둘 것 — 허브 위치로 고민하지 마세요</span>
      <p>
        허브(The HUB)는 언제든 철거하고 다시 지을 수 있습니다. 철거하면 건설에 쓴{' '}
        {hubCost.map((c) => (
          <span>
            {c.ko} <span class="n">{c.amount}</span>개
          </span>
        ))}
        를 돌려받고, <strong>업그레이드와 마일스톤 진행도는 전부 유지됩니다.</strong>
      </p>
      <p>
        그래서 진짜 결정은 "허브를 어디 놓나"가 아니라 <strong>"본 공장을 어디에 세우나"</strong>입니다.
        허브는 마일스톤 납품 단말일 뿐이고, 공장이 그 옆에 있을 필요도 없습니다.
      </p>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">01</span> 게임 설정과 첫 10분</p>
      <h2>어떻게 시작했는지에 따라 첫 순서가 달라집니다</h2>
      <StartPath
        client:load
        gap={gap}
        hubCost={hubCost}
        portableMiners={startInventory.tutorialSkip.portableMiners}
        inventoryNote={`시작 인벤토리 수량은 게임 배포 데이터에 없어 인게임에서 확인한 값입니다. ${startInventory.openQuestion}`}
        startPoints={startPoints}
      />
    </section>

    <section class="section">
      <p class="section-label"><span class="num">02</span> 입지 선정</p>
      <h2>본 공장을 어디에 세울 것인가</h2>
      <p class="prose">
        좌표계는 남서쪽 모서리가 <span class="n">X0Y0</span>, 한 칸이 <span class="n">1.024</span> km로
        게임 내 지도와 같습니다. 핀을 누르면 그 자리 기준으로 티어 1에 필요한 노드를 실제 좌표에서
        골라 거리와 함께 보여줍니다.
      </p>
      <SiteMap
        client:visible
        mapSrc={`${base}/assets/map/biome-map.webp`}
        sites={sitesData.sites}
        nodes={nodeList}
        demand={demand}
        minerMk1={minerMk1}
        sourceNote={sitesData.$sourceNote}
      />
      <p class="footnote">
        점 크기가 순도입니다 — 큰 흰 테두리가 순수(Pure), 중간이 일반(Normal), 작고 흐린 것이
        불순(Impure)입니다. 노드 데이터 출처: {(resourceNodes as { $source: string }).$source}. 노드
        단위의 정밀한 확인은 커뮤니티 인터랙티브 맵(SCIM)이 훨씬 낫습니다 — 이 화면은 그 앞단의 판단을
        돕는 용도입니다.
      </p>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">03</span> 허브 업그레이드</p>
      <h2>티어 0 전체 비용</h2>
      <p class="prose">
        허브 업그레이드 <span class="n">{hubUpgrades.length}</span>단계를 모두 마치려면 아래 부품이
        필요합니다. 이 구간은 대부분 손으로 만들게 되므로, 무엇이 얼마나 필요한지 먼저 보고 채굴 계획을
        세우는 편이 빠릅니다.
      </p>
      <div class="scroll-x">
        <table>
          <thead>
            <tr><th>단계</th><th>비용</th><th class="n">해금 레시피</th></tr>
          </thead>
          <tbody>
            {
              hubUpgrades.map((h) => (
                <tr>
                  <td>{h.ko}</td>
                  <td>
                    {h.costView.map((c) => (
                      <span class="chip">
                        {c.ko} <span class="n">{c.amount}</span>
                      </span>
                    ))}
                  </td>
                  <td class="n">{h.unlocksRecipes.length}</td>
                </tr>
              ))
            }
            <tr class="total-row">
              <td><strong>합계</strong></td>
              <td>
                {
                  Object.entries(hubTotal).map(([ko, amount]) => (
                    <span class="chip">
                      {ko} <span class="n">{amount}</span>
                    </span>
                  ))
                }
              </td>
              <td class="n">—</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">04</span> 티어 1 자동화</p>
      <h2>마일스톤 3개를 통과하는 라인</h2>
      <p class="prose">
        티어 1의 마일스톤 <span class="n">{tier1.list.length}</span>개({tier1.list.map((m, i) => (
          <span>{i > 0 && ' · '}{m.ko}</span>
        ))})가 요구하는 부품을 <strong>요구 비율 그대로</strong> 생산하되, 철광석 소비가 채굴기
        Mk.1 한 대(노말 노드 <span class="n">{minerNormal}</span>개/분)와 정확히 맞아떨어지도록 규모를
        잡았습니다. 이 구성이면 티어 1 부품 세트가{' '}
        <strong><span class="n">{Math.round(minutesToFinish)}</span>분</strong>에 채워집니다 — 순수
        노드면 <span class="n">{Math.round(minutesToFinish / 2)}</span>분입니다.
      </p>

      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th>부품</th>
              <th class="n">총 요구</th>
              <th class="n">필요 생산</th>
              <th class="n">제작 기계</th>
              <th>벨트</th>
            </tr>
          </thead>
          <tbody>
            {
              lines.map((l) => {
                const root = l.result.root;
                const machines = root.machines ? format(root.machines, 2) : '—';
                const built = root.machines ? ceil(root.machines) : 0;
                const overBelt = l.rate > beltMk1;
                return (
                  <tr>
                    <td>
                      {root.ko} <span class="en">{root.en}</span>
                    </td>
                    <td class="n">{l.total}</td>
                    <td class="n">{Math.round(l.rate * 100) / 100}/분</td>
                    <td class="n">
                      {root.machineKo} {machines}대 → {built}대
                    </td>
                    <td class={overBelt ? 'over' : ''}>
                      {overBelt ? `Mk.1 상한 초과 (${beltMk1}/분)` : `Mk.1 한 줄로 충분`}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <div class="grid-2">
        <div>
          <h3>기계 합계</h3>
          <div class="kv">
            {
              machineRows.map((m) => (
                <div>
                  <span class="k">{m.ko}</span>
                  <span class="v">
                    <span class="n">{m.built}</span>대{' '}
                    <span class="muted">(정확히 {Math.round(m.exact * 100) / 100})</span>
                  </span>
                </div>
              ))
            }
            <div>
              <span class="k">전력</span>
              <span class="v">
                <span class="n">{totalPowerMW}</span> MW — 바이오매스 연소기{' '}
                <span class="n">{ceilNum(totalPowerMW / 30)}</span>대분
              </span>
            </div>
          </div>
        </div>
        <div>
          <h3>원자재 소요</h3>
          <div class="kv">
            {
              rawRows.map((r) => (
                <div>
                  <span class="k">{r.ko}</span>
                  <span class="v">
                    <span class="n">{Math.round(r.rate * 100) / 100}</span>/분
                    <span class="muted">
                      {' '}
                      · 채굴기 Mk.1 노말 <span class="n">{ceilNum(r.rate / minerMk1.normal)}</span>대
                    </span>
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <p class="note">
        <span class="note-title">왜 매니폴드인가</span>
        기계가 <span class="n">{machineRows.reduce((n, m) => n + m.built, 0)}</span>대나 되므로 분배
        방식이 문제가 됩니다. 벨트를 기계 열 옆으로 흘리고 스플리터로 하나씩 따내는{' '}
        <a href={`${base}/glossary/#manifold`}>매니폴드</a>를 쓰세요. 처음엔 앞쪽 기계부터 채워져서
        뒤쪽이 노는 것처럼 보이지만, 포화되면 사라집니다. 그걸 못 참고 로드 밸런서로 갈아타는 것이 가장
        흔한 실수입니다.
      </p>

      <p class="footnote">
        이 표의 모든 수치는 마일스톤 비용과 레시피에서 계산됩니다. 게임이 패치되어 비용이나 레시피가
        바뀌면 이 페이지도 다시 빌드하는 것만으로 따라갑니다 — 사람이 고칠 곳이 없습니다.{' '}
        <a href={`${base}/milestones/`}>마일스톤 체크리스트로 이동 →</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: var(--s12);
  }
  .page-head h1 {
    margin-bottom: var(--s4);
  }
  h2 {
    margin-bottom: var(--s4);
  }
  h3 {
    font-size: var(--t-body-l);
    margin-bottom: var(--s2);
  }
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s8);
    margin-top: var(--s8);
  }
  @media (max-width: 760px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }
  }
  table .chip {
    margin: 1px;
  }
  .total-row td {
    border-top: 1px solid var(--line-strong);
  }
  td.over {
    color: var(--accent-ink);
    font-weight: 600;
  }
</style>
