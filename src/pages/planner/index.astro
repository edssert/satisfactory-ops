---
/** 설계 스튜디오 — 설치본 데이터와 자산 매니페스트를 사용하는 수동 공장 편집기. */
import Base from '../../layouts/Base.astro';
import ValidatedFactoryPlanner, { type DrawingMachine } from '../../components/ValidatedFactoryPlanner';
import { buildings, items, recipes } from '../../lib/gamedata';
import { requireMachineSpec } from '../../domain/factory/specs';
import portsData from '../../data/curated/machine-ports.json';
import topviewData from '../../data/curated/topview-assets.json';
import '../../styles/validated-planner.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const buildingById = new Map(buildings.map((building) => [building.id, building]));
const itemById = new Map(items.map((entry) => [entry.id, entry]));
const usableTopviews = topviewData.assets.filter((asset) => asset.reviewStatus !== 'rejected');
const topviewByClass = new Map(usableTopviews
  .filter((asset) => asset.role === 'building' && 'buildingClass' in asset)
  .map((asset) => [asset.buildingClass, asset]));
const topviewById = new Map(usableTopviews.map((asset) => [asset.assetId, asset]));
const assetUrl = (asset: (typeof topviewData.assets)[number]) =>
  `${base}/${asset.path}${'sha256' in asset && asset.sha256 ? `?v=${asset.sha256.slice(0, 12)}` : ''}`;
const topviewUrl = (assetId: string) => {
  const asset = topviewById.get(assetId);
  if (!asset) throw new Error(`탑뷰 자산 매니페스트 누락: ${assetId}`);
  return assetUrl(asset);
};
const foundationTopview = topviewByClass.get('Build_Foundation_8x1_01_C');

const machines: DrawingMachine[] = portsData.$completeBuildings.flatMap((buildingClass) => {
  const building = buildingById.get(buildingClass);
  const spec = requireMachineSpec(buildingClass);
  const materialPorts = spec.ports.filter((port) => port.medium !== 'power');
  if (!building || !spec.hardBoxes.length || !materialPorts.length) return [];
  const topview = topviewByClass.get(buildingClass);
  if (!topview) return [];
  const statusImages = 'statusImages' in topview ? topview.statusImages : undefined;
  return [{
    ...spec,
    ports: materialPorts,
    imageUrl: assetUrl(topview),
    imageKind: 'topview' as const,
    occupancyFrame: 'occupancyFrame' in topview ? topview.occupancyFrame : undefined,
    statusImageUrls: statusImages ? {
      active: `${base}/${statusImages.active.path}?v=${statusImages.active.sha256.slice(0, 12)}`,
      activeWithCrystal: `${base}/${statusImages.activeWithCrystal.path}?v=${statusImages.activeWithCrystal.sha256.slice(0, 12)}`,
      standby: `${base}/${statusImages.standby.path}?v=${statusImages.standby.sha256.slice(0, 12)}`,
      error: `${base}/${statusImages.error.path}?v=${statusImages.error.sha256.slice(0, 12)}`,
    } : undefined,
    recipes: recipes.filter((recipe) => !recipe.isBuildingRecipe && recipe.producedIn.includes(buildingClass)).map((recipe) => ({
      id: recipe.id,
      name: recipe.ko,
      isAlternate: recipe.isAlternate,
      ingredients: recipe.ingredients.map((part) => ({ item: part.item, name: itemById.get(part.item)?.ko ?? part.item, perMinute: part.perMinute })),
      products: recipe.products.map((part) => ({ item: part.item, name: itemById.get(part.item)?.ko ?? part.item, perMinute: part.perMinute })),
    })),
    somersloopSlots: building.somersloopSlots ?? 0,
    basePowerMW: building.powerMW ?? 0,
    powerExponent: building.powerExponent ?? 1,
    productionBoostPowerExponent: building.productionBoostPowerExponent ?? 2,
  }];
});
---

<Base
  title="공장 설계 스튜디오"
  description="실제 축척의 설비와 토대를 직접 배치하고 벨트·파이프·리프트를 연결하는 공장 설계 작업 공간입니다."
  section="planner"
  workspace
>
  <div class="plan-page">
    <noscript><p class="workspace-fallback">왼쪽에서 검증 설비를 놓으세요. 설계 스튜디오는 브라우저 JavaScript가 필요합니다.</p></noscript>
    <ValidatedFactoryPlanner
      client:load
      machines={machines}
      beltImageUrl={topviewUrl('ConveyorBeltStraightMk1')}
      beltTurnImageUrl={topviewUrl('ConveyorBeltTurn90Mk1')}
      beltDirectionImageUrl={topviewUrl('ConveyorDirectionForward')}
      pipeImageUrl={topviewUrl('PipelineStraightMk1')}
      pipeTurnImageUrl={topviewUrl('PipelineTurn90Mk1')}
      liftImageUrl={topviewUrl('ConveyorLiftHeadA')}
      foundationImageUrl={foundationTopview
        ? assetUrl(foundationTopview)
        : `${base}/assets/buildings-png/Build_Foundation_8x1_01_C.png`}
    />
  </div>
</Base>
