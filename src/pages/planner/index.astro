---
/**
 * 설계 — 실제 축척으로 공장을 짜는 도면판.
 *
 * `/builder` 와 다르다. 거기는 목표를 넣으면 공정을 펼쳐 주는 자동 계산이고,
 * 여기는 사람이 배치를 그린다. 좌표 단위가 미터라서 "여기에 들어가나"까지 답한다.
 *
 * 페이지가 데이터 서브셋을 만들어 아일랜드에 props 로 넘긴다(ADR-0009).
 * 대체 제작법도 전부 넣는다 — 화면에서 딴 것만 걸러 보여 준다.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/planner.css';
import FactoryPlanner from '../../components/FactoryPlanner';
import { buildings, index, items, recipes } from '../../lib/gamedata';
import resourceNodesJson from '../../data/app/resource-nodes.json';
import { isUnpackaging } from '../../lib/recipe-select';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resourceNodes = resourceNodesJson as unknown as { nodes: { res: string; type: string }[] };
const itemById = new Map(items.map((i) => [i.id, i]));
const buildingById = new Map(buildings.map((b) => [b.id, b]));

/** 레시피를 돌리는 기계 — index.byBuilding 에 들어 있는 것이 정본이다 */
const recipeMachineIds = Object.keys(index.byBuilding).filter((id) => buildingById.has(id));
const extractorIds = buildings.filter((b) => b.extraction != null).map((b) => b.id);
const generatorIds = buildings.filter((b) => b.fuels.length > 0).map((b) => b.id);

/**
 * 물류 설비. 레시피가 없어서 byBuilding 에 안 잡히지만 도면에는 반드시 있어야 한다 —
 * 갈라지고 합쳐지는 자리를 못 그리면 배치를 짤 수가 없다.
 */
const LOGISTIC: { id: string; lg: 'split' | 'merge' }[] = [
  { id: 'Build_ConveyorAttachmentSplitter_C', lg: 'split' },
  { id: 'Build_ConveyorAttachmentSplitterSmart_C', lg: 'split' },
  { id: 'Build_ConveyorAttachmentSplitterProgrammable_C', lg: 'split' },
  { id: 'Build_ConveyorAttachmentMerger_C', lg: 'merge' },
  { id: 'Build_ConveyorAttachmentMergerPriority_C', lg: 'merge' },
  { id: 'Build_StorageContainerMk1_C', lg: 'merge' },
  { id: 'Build_StorageContainerMk2_C', lg: 'merge' },
  { id: 'Build_PipeStorageTank_C', lg: 'merge' },
];
const logisticIds = LOGISTIC.filter((x) => buildingById.has(x.id)).map((x) => x.id);
const lgOf = new Map(LOGISTIC.map((x) => [x.id, x.lg]));

const machineIds = [
  ...new Set([...recipeMachineIds, ...extractorIds, ...generatorIds, ...logisticIds]),
];

const usedItems = new Set<string>();

const payloadRecipes = machineIds.flatMap((mid) =>
  (index.byBuilding[mid] ?? [])
    .map((rid) => recipes.find((r) => r.id === rid)!)
    .filter((r) => r && !r.isBuildingRecipe && !isUnpackaging(r))
    .map((r) => {
      for (const g of r.ingredients) usedItems.add(g.item);
      for (const p of r.products) usedItems.add(p.item);
      return {
        i: r.id,
        k: r.ko,
        m: mid,
        ...(r.isAlternate ? { a: 1 as const } : {}),
        g: r.ingredients.map((g) => [g.item, g.perMinute] as [string, number]),
        o: r.products.map((p) => [p.item, p.perMinute] as [string, number]),
      };
    })
);

/*
 * 어떤 추출기가 무엇을 뽑는가는 게임 배포 데이터에 없다. 형태(고체·액체·기체)만 있어서
 * 그대로 조인하면 물 추출기가 원유를 뽑는 목록이 나온다. 노드 종류를 같이 본다:
 *
 *   채굴기        고체 + 채굴 노드가 있는 자원
 *   원유 추출기    액체 + 채굴 노드가 있는 자원 (원유)
 *   자원정 추출기  자원정(frackingCore)이 있는 자원 (원유·물·질소)
 *   물 추출기      물. 노드가 아니라 수면 아무 데나 놓는 것이라 데이터로는 안 나온다
 */
const nodeTypesOf = new Map<string, Set<string>>();
for (const n of resourceNodes.nodes) {
  if (!nodeTypesOf.has(n.res)) nodeTypesOf.set(n.res, new Set());
  nodeTypesOf.get(n.res)!.add(n.type);
}
const resourceItems = items.filter((i) => i.kind === 'resource');

function extractableBy(b: (typeof buildings)[number]): string[] {
  if (!b.extraction) return [];
  if (b.id === 'Build_WaterPump_C') return ['Desc_Water_C'];
  const forms = new Set(b.extraction.allowedForms);
  const want = b.id.includes('Fracking') ? 'frackingCore' : 'node';
  return resourceItems
    .filter((r) => forms.has(r.form) && nodeTypesOf.get(r.id)?.has(want))
    .map((r) => r.id);
}

const payloadMachines = machineIds.map((id) => {
  const b = buildingById.get(id)!;
  const canExtract = extractableBy(b);
  /* 뽑을 것이 하나도 없는 추출기를 목록에 올리면 화면에서 고를 수가 없다 */
  if (b.extraction && canExtract.length === 0) {
    throw new Error(`${b.ko}(${b.id})가 캘 수 있는 자원이 없습니다 — 형태 표기가 어긋났습니다.`);
  }
  for (const r of canExtract) usedItems.add(r);
  for (const f of b.fuels) {
    usedItems.add(f.fuel);
    if (f.supplemental) usedItems.add(f.supplemental);
    if (f.byproduct) usedItems.add(f.byproduct);
  }
  return {
    i: id,
    k: b.ko,
    t: b.unlockTier,
    /* 가변 전력 건물(입자 가속기 등)은 상한을 쓴다. 낮춰 잡으면 발전 계획이 어긋난다 */
    p: b.powerMW ?? b.powerMaxMW ?? null,
    ...(b.powerIsVariable ? { v: 1 as const } : {}),
    /* 바닥 크기. 도면의 축척이 이 값에서 나온다 */
    ...(b.footprint ? { fw: b.footprint.widthM, fl: b.footprint.lengthM } : {}),
    ...(lgOf.has(id) ? { lg: lgOf.get(id)! } : {}),
    ...(b.extraction ? { e: b.extraction.perMinuteAtNormalPurity ?? 0, res: canExtract } : {}),
    ...(b.fuels.length
      ? {
          gen: b.powerGenMW ?? 0,
          sr: b.supplementalToPowerRatio ?? null,
          f: b.fuels.map((f) => ({
            f: f.fuel,
            s: f.supplemental,
            b: f.byproduct,
            ba: f.byproductAmount,
          })),
        }
      : {}),
    n: (index.byBuilding[id] ?? []).length,
  };
});

/** 벨트와 리프트 등급. 분배기 상한과 층 사이 이동에 쓴다 */
const payloadBelts = buildings
  .filter((b) => /^Build_Conveyor(Belt|Lift)Mk\d_C$/.test(b.id) && b.beltItemsPerMinute)
  .map((b) => ({
    i: b.id,
    k: b.ko,
    r: b.beltItemsPerMinute!,
    t: b.unlockTier,
    ...(b.id.includes('Lift') ? { lift: 1 as const } : {}),
  }))
  .sort((a, b) => a.r - b.r);

const payloadItems = [...usedItems]
  .map((id) => itemById.get(id))
  .filter((x): x is NonNullable<typeof x> => !!x)
  .map((it) => ({
    i: it.id,
    k: it.ko,
    ...(it.isFluid ? { fl: 1 as const } : {}),
    /* 연료 열량. 발전기가 분당 몇 개를 태우는지는 여기서 나온다 */
    ...(it.energyMJ ? { mj: it.energyMJ } : {}),
  }));

const bytes = JSON.stringify({
  payloadRecipes,
  payloadMachines,
  payloadItems,
  payloadBelts,
}).length;
---

<Base
  title="설계 — 실제 크기로 짜 본다"
  description="건물을 게임의 실제 치수로 놓고, 돌리고, 층을 나눠 이으면 처리량과 전력이 계산됩니다. 짓기 전에 먼저 짜 보세요."
  section="planner"
>
  <div class="plan-w plan-head">
    <p class="marker"><span class="num">설계</span></p>
    <h1>짓기 전에 <span>실제 크기로</span></h1>
    <p class="lede prose">
      건물 크기는 게임의 실제 치수이고 바닥 격자는 토대 한 칸(8 m)입니다. 놓고, 돌리고,
      층을 나눠 이으면 처리량·전력·모자란 재료가 그 자리에서 계산됩니다.
    </p>
  </div>

  <div class="plan-w plan-stage">
    <FactoryPlanner
      client:load
      machines={payloadMachines}
      recipesList={payloadRecipes}
      itemsList={payloadItems}
      belts={payloadBelts}
      iconBase={`${base}/assets`}
    />
  </div>

  <div class="plan-w">
    <p class="caption foot">
      1.2 게임 데이터 기준입니다. 건물 크기는 충돌 박스, 전력은 생산 건물이 클럭의 1.321928 제곱,
      발전기는 클럭에 비례합니다. 데이터 {Math.round(bytes / 1024)}KB 를 화면과 함께 보내므로
      조작에 네트워크 요청이 없고, 짠 것은 이 브라우저에만 남습니다.
    </p>
  </div>

  <style>
    /*
     * 제목과 도면판이 같은 세로선에서 시작해야 한다.
     * 제목만 `.wrap`(1180px 상한)을 쓰고 도면판은 화면 폭을 쓰는 바람에, 1440px 에서
     * h1 은 x=162 인데 왼쪽 「건물 찾기」 서랍은 x=25 에서 시작했다. 컨테이너를 하나로 묶는다.
     *
     * `100vw` 를 쓰지 않는다 — 세로 스크롤막대 폭이 포함돼 그만큼 가로로 밀린다.
     */
    .plan-w {
      width: min(2200px, 100%);
      margin-inline: auto;
      padding-inline: var(--s5);
    }
    @media (min-width: 720px) {
      .plan-w { padding-inline: var(--s8); }
    }

    .plan-head { padding-block: var(--s14) var(--s6); }
    .plan-head h1 { margin-bottom: var(--s4); }
    .plan-head h1 span { color: var(--brand); }
    .lede { font-size: var(--t-body-l); color: var(--ink-2); }
    .foot { margin-top: var(--s6); }
  </style>
</Base>
