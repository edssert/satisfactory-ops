---
/**
 * 설계 — 검증된 실제 게임 기하로만 그리는 공장 도면판.
 *
 * 페이지가 게임 데이터·세이브 코퍼스·Anders 탑뷰의 교집합만 아일랜드에 전달한다.
 * 포트가 일부만 확인된 설비는 목록에조차 넣지 않아 그럴듯한 거짓 도면을 만들 수 없다.
 */
import Base from '../../layouts/Base.astro';
import ValidatedFactoryPlanner, { type DrawingMachine } from '../../components/ValidatedFactoryPlanner';
import { buildings, items, recipes } from '../../lib/gamedata';
import { requireMachineSpec } from '../../domain/factory/specs';
import portsData from '../../data/curated/machine-ports.json';
import topviewData from '../../data/curated/topview-assets.json';
import '../../styles/validated-planner.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const buildingById = new Map(buildings.map((building) => [building.id, building]));
const itemById = new Map(items.map((entry) => [entry.id, entry]));
const topviewByClass = new Map(topviewData.assets.map((asset) => [asset.buildingClass, asset]));
const sourceEntries = Object.values(portsData.$sources);
const foundationTopview = topviewByClass.get('Build_Foundation_8x1_01_C');
const proof = {
  fileCount: sourceEntries.length,
  publicFileCount: sourceEntries.filter((source) => 'url' in source).length,
  observationCount: portsData.ports.reduce((sum, port) => sum + port.sampleCount, 0),
  toleranceM: portsData.$toleranceM,
};

const machines: DrawingMachine[] = portsData.$completeBuildings.flatMap((buildingClass) => {
  const building = buildingById.get(buildingClass);
  const spec = requireMachineSpec(buildingClass);
  const materialPorts = spec.ports.filter((port) => port.medium !== 'power');
  if (!building || !spec.hardBoxes.length || !materialPorts.length) return [];
  const topview = topviewByClass.get(buildingClass);
  return [{
    ...spec,
    ports: materialPorts,
    imageUrl: topview
      ? `${base}/assets/topview/${buildingClass}.webp`
      : `${base}/assets/buildings-png/${buildingClass}.png`,
    imageKind: topview ? 'topview' as const : 'icon' as const,
    occupancyFrame: topview && 'occupancyFrame' in topview ? topview.occupancyFrame : undefined,
    recipes: recipes.filter((recipe) => !recipe.isBuildingRecipe && recipe.producedIn.includes(buildingClass)).map((recipe) => ({
      id: recipe.id,
      name: recipe.ko,
      isAlternate: recipe.isAlternate,
      ingredients: recipe.ingredients.map((part) => ({ item: part.item, name: itemById.get(part.item)?.ko ?? part.item, perMinute: part.perMinute })),
      products: recipe.products.map((part) => ({ item: part.item, name: itemById.get(part.item)?.ko ?? part.item, perMinute: part.perMinute })),
    })),
    somersloopSlots: building.somersloopSlots ?? 0,
    basePowerMW: building.powerMW ?? 0,
    powerExponent: building.powerExponent ?? 1,
    productionBoostPowerExponent: building.productionBoostPowerExponent ?? 2,
  }];
});
---

<Base
  title="공장 설계 — 검증된 실제 축척 도면판"
  description="게임 충돌 상자와 공개 세이브·블루프린트에서 검증한 포트를 사용해 실제 축척으로 공장을 배치하고 검사합니다."
  section="planner"
>
  <main class="plan-page">
    <header class="plan-intro">
      <p class="marker"><span class="num">설계 / 검증형 도면판</span></p>
      <h1>보이는 만큼<br /><span>실제로 맞아야</span><br />도면입니다.</h1>
      <p>
        설비 외곽은 게임 설치본의 하드 클리어런스, 물류 포트는 여러 버전의 공개 세이브와
        제작자별 블루프린트에서 역산한 실측 좌표입니다. 이미지 크기로 판정하지 않으며,
        토대 지지·충돌·접속점·운송 용량 검사를 통과하지 못한 설계는 발행할 수 없습니다.
      </p>
    </header>

    <ValidatedFactoryPlanner
      client:load
      machines={machines}
      beltImageUrl={`${base}/assets/buildings/conveyor-belt-mk.1.webp`}
      liftImageUrl={`${base}/assets/buildings-png/Build_ConveyorLiftMk1_C.png`}
      foundationImageUrl={foundationTopview
        ? `${base}/assets/topview/Build_Foundation_8x1_01_C.webp`
        : `${base}/assets/buildings-png/Build_Foundation_8x1_01_C.png`}
      proof={proof}
    />

    <section class="plan-method" aria-label="도면 데이터 원칙">
      <article>
        <b>01 / GEOMETRY</b>
        <h2>게임 설치본이 외곽을 결정</h2>
        <p>화면용 이미지의 여백이나 비율이 아니라 게임 데이터의 하드 충돌 상자를 미터 좌표로 씁니다.</p>
      </article>
      <article>
        <b>02 / CONNECTIONS</b>
        <h2>실제 연결 흔적에서 포트를 복원</h2>
        <p>공개 세이브와 서로 다른 제작자의 블루프린트에서 벨트·파이프 끝점을 설비 로컬 좌표로 되돌립니다.</p>
      </article>
      <article>
        <b>03 / PUBLISH GATE</b>
        <h2>검증 실패를 그림으로 감추지 않음</h2>
        <p>근거가 부족한 설비는 카탈로그에서 제외하고, 충돌이나 미접속 상태는 시공 게이트에 그대로 남깁니다.</p>
      </article>
    </section>
  </main>
</Base>
