---
/**
 * 도감 · 티어 — 허브 업그레이드(티어 0)와 마일스톤을 게임 화면 그대로.
 *
 * 위에 티어 탭, 그 아래 그 티어의 항목 타일, 맨 아래 고른 항목의 보상·비용.
 * 게임에서 이렇게 고르므로 그대로 옮긴다. 한 페이지에 전부 늘어놓으면
 * 지금 몇 티어를 보고 있는지가 사라진다.
 */
import Base from '../../../layouts/Base.astro';
import TechNav from '../../../components/TechNav.astro';
import ItemChip from '../../../components/ItemChip.astro';
import '../../../styles/fx.css';
import '../../../styles/tech.css';
import { hasBadge, iconPath, rewardsOf, tiers } from '../../../lib/tech';

export function getStaticPaths() {
  return tiers().map((t) => ({ params: { tier: String(t.tier) }, props: { tier: t } }));
}

const { tier } = Astro.props;
const all = tiers();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/** 지금 펼쳐 볼 항목. 주소의 해시로 고르는 게 아니라 목록 전체를 미리 그려 두고 스크립트가 하나만 보인다 */
const list = tier.list;

/*
 * 보상 목록은 lib/tech.ts 의 rewardsOf 가 만든다.
 *
 * 예전에는 이 파일이 「그림 있는 것만」 골라 담았다. 그래서 허브 업그레이드 1 의 보상 셋
 * (장비 작업장 · 휴대용 채굴기 · 손 장비 슬롯 +1) 중 둘이 화면에서 사라졌다 —
 * 손 제작 레시피는 아예 담지 않았고, 슬롯 보상은 그림이 없다는 이유로 빠졌다.
 * 게임은 셋 다 보여 준다. 그림이 없으면 이름만이라도 나와야 한다.
 */
---

<Base
  title={`${tier.ko} — 도감`}
  description={`${tier.ko}의 ${list.length}개 항목과 각각의 보상·비용을 게임 화면 그대로 봅니다.`}
  section="dex"
>
  <div class="wrap dex">
    <TechNav here="tiers" />

    <header class="dex-head">
      <p class="marker"><span class="num">도감</span> 허브 · 마일스톤</p>
      <h1><span class="fx-gradient-text">{tier.ko}</span></h1>
    </header>

    <nav class="tabs" aria-label="티어">
      {all.map((t) => (
        <a
          href={`${base}/dex/tiers/${t.tier}/`}
          aria-current={t.tier === tier.tier ? 'page' : undefined}
        >
          티어
          <b>{t.tier}</b>
          <span class="tab-n">{t.list.length}</span>
        </a>
      ))}
    </nav>

    <div class="tiles" data-tiles>
      {list.map((e, i) => {
        /* 게임이 이 스키매틱에 붙여 둔 전용 아이콘. 해금 목록의 첫 건물 그림이 아니다 */
        const ic = iconPath(e.iconRef);
        return (
          <a
            class="tile"
            href={`#${e.id}`}
            data-tile={e.id}
            aria-current={i === 0 ? 'page' : undefined}
          >
            {ic ? (
              <img src={`${base}/assets/${ic}`} alt="" width="52" height="52" loading="lazy" />
            ) : (
              <span class="tile-fb" aria-hidden="true">{e.ko.slice(0, 1)}</span>
            )}
            {e.ko}
          </a>
        );
      })}
    </div>

    {list.map((e, i) => (
      <section class="detail" id={e.id} data-detail={e.id} hidden={i !== 0}>
        <div>
          <h2>{e.ko}</h2>
          {/*
            * 보상은 하나도 버리지 않는다. 그림이 없는 것도 이름으로 나온다 —
            * 게임 화면이 그렇다. 각 그림 오른쪽 위의 배지가 종류를 말해 준다.
            */}
          {rewardsOf(e.unlocks).length > 0 && (
            <>
              <p class="panel-k">보상</p>
              <ul class="rewards">
                {rewardsOf(e.unlocks).map((r) => (
                  <li class="reward">
                    <span class="rw-icon">
                      {r.icon ? (
                        <ItemChip
                          id={r.icon.slice(r.icon.indexOf('/') + 1, -4)}
                          ko={r.ko}
                          kind={r.icon.slice(0, r.icon.indexOf('/')) as 'items' | 'buildings-png'}
                          size={56}
                        />
                      ) : (
                        <span class="rw-blank" aria-hidden="true">{r.ko.slice(0, 1)}</span>
                      )}
                      {hasBadge(r.kind) && (
                        <img
                          class="rw-badge"
                          src={`${base}/assets/badges/${r.kind}.png`}
                          alt=""
                          width="16"
                          height="16"
                          loading="lazy"
                        />
                      )}
                    </span>
                    <span>{r.ko}</span>
                    <span class="tag">{r.kindKo}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>

        <div>
          <p class="panel-k">비용</p>
          {e.cost.length > 0 ? (
            <div class="costs">
              {e.cost.map((c) => (
                <ItemChip id={c.item} ko={c.ko} amount={c.amount} size={56} />
              ))}
            </div>
          ) : (
            <p class="detail-note">비용 없음</p>
          )}
        </div>
      </section>
    ))}

  </div>

  <style>
    /* 게임처럼 보상 그림 오른쪽 위에 종류 배지를 얹는다 */
    .rw-icon {
      position: relative;
      display: inline-flex;
    }
    .rw-badge {
      position: absolute;
      z-index: 3;
      top: -6px;
      right: -6px;
      width: 16px;
      height: 16px;
      padding: 2px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 3px;
      background: var(--bg);
      object-fit: contain;
    }
    /* 그림을 못 구한 보상. 빈칸 대신 이름 첫 글자가 남는다 */
    .rw-blank {
      display: inline-flex;
      width: 56px;
      height: 56px;
      align-items: center;
      justify-content: center;
      border: var(--hair) dashed var(--line-strong);
      border-radius: 3px;
      background: var(--surface);
      color: var(--ink-3);
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
    }
  </style>

  <script is:inline>
    (function () {
      /* 타일을 누르면 그 항목만 펼친다. 게임에서 마일스톤을 고르는 것과 같다 */
      var tiles = document.querySelectorAll('[data-tile]');
      var panels = document.querySelectorAll('[data-detail]');
      function show(id) {
        for (var i = 0; i < panels.length; i++) {
          panels[i].hidden = panels[i].dataset.detail !== id;
        }
        for (var j = 0; j < tiles.length; j++) {
          if (tiles[j].dataset.tile === id) tiles[j].setAttribute('aria-current', 'page');
          else tiles[j].removeAttribute('aria-current');
        }
      }
      for (var k = 0; k < tiles.length; k++) {
        tiles[k].addEventListener('click', function (e) {
          e.preventDefault();
          show(e.currentTarget.dataset.tile);
          history.replaceState(null, '', '#' + e.currentTarget.dataset.tile);
        });
      }
      if (location.hash.length > 1) {
        var want = decodeURIComponent(location.hash.slice(1));
        for (var m = 0; m < tiles.length; m++) if (tiles[m].dataset.tile === want) show(want);
      }
    })();
  </script>
</Base>
