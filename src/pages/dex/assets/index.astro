---
/** 게임 데이터와 현재 설치본에서 직접 제작한 런타임 탑뷰를 티어별로 대조하는 검수 화면. */
import Base from '../../../layouts/Base.astro';
import TechNav from '../../../components/TechNav.astro';
import { buildings } from '../../../lib/gamedata';
import { comparePlannerAssetTargets, requiresRasterTopview } from '../../../lib/planner-asset-scope';
import { RUNTIME_TOPVIEW_SOURCE, topviewAssets } from '../../../lib/topview-assets';
import plannerScope from '../../../data/app/planner-asset-scope.json';
import portData from '../../../data/curated/machine-ports.json';
import '../../../styles/tech.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const buildingByClass = new Map(buildings.map((building) => [building.id, building]));
const assetsByClass = Map.groupBy(
  topviewAssets.filter((asset) => asset.role !== 'golden-reference' && 'buildingClass' in asset && asset.buildingClass),
  (asset) => asset.buildingClass,
);
const portClasses = new Set(portData.$completeBuildings);
const CATEGORY: Record<string, string> = {
  facility: '설비', extractor: '추출', generator: '발전', storage: '저장',
  'logistics-device': '물류 장치', 'logistics-support': '물류 지지대',
  belt: '컨베이어', lift: '리프트', pipeline: '파이프', hypertube: '하이퍼튜브',
  transport: '운송', rail: '철도', foundation: '토대', 'foundation-slope': '토대 경사', 'power-network': '전력망',
};
const tierLabel = (tier: number | null) => tier == null ? '미분류' : `티어 ${tier}`;
const auditTargets = plannerScope.targets.filter(requiresRasterTopview)
  .sort(comparePlannerAssetTargets);
const rows = auditTargets.map((target) => {
  const building = buildingByClass.get(target.buildingClass);
  if (!building) throw new Error(`설계 자산 범위가 없는 건물을 참조합니다: ${target.buildingClass}`);
  const assets = assetsByClass.get(target.buildingClass) ?? [];
  const topview = assets.find((asset) => asset.sourceId === RUNTIME_TOPVIEW_SOURCE && asset.reviewStatus === 'approved');
  const candidate = assets.find((asset) => asset.sourceId === RUNTIME_TOPVIEW_SOURCE && asset.reviewStatus === 'candidate');
  const reference = assets.find((asset) => asset.sourceId !== RUNTIME_TOPVIEW_SOURCE);
  const assetStateKey = topview ? 'approved' : candidate ? 'candidate' : reference ? 'reference' : 'missing';
  return {
    target,
    building,
    topview,
    image: topview?.path ?? null,
    assetStateKey,
    assetState: topview ? '승인' : candidate ? '후보' : reference ? '연구 대조만' : '누락',
    portState: portClasses.has(building.id) ? '재검증 표본 있음' : '미검증',
  };
});
const tiers = [...new Set(rows.map((row) => row.target.unlockTier))].map((tier) => ({
  tier,
  rows: rows.filter((row) => row.target.unlockTier === tier),
}));
const approved = rows.filter((row) => row.assetStateKey === 'approved').length;
const candidates = rows.filter((row) => row.assetStateKey === 'candidate').length;
const references = rows.filter((row) => row.assetStateKey === 'reference').length;
const missing = rows.filter((row) => row.assetStateKey === 'missing').length;
const composedRepresentations = plannerScope.targets.length - rows.length;
const implicitConnections = plannerScope.implicitPowerNetwork.length;
---

<Base
  title="설계 재료 — 티어별 탑뷰·점유·포트 검수"
  description="게임 데이터의 설비를 티어별로 정렬하고 현재 게임 설치본 기반 탑뷰, 점유 박스와 포트 검증 상태를 대조합니다."
  section="dex"
>
  <div class="wrap asset-audit">
    <TechNav here="assets" />
    <header class="asset-audit-head">
      <p class="marker"><span class="num">설계 재료</span></p>
      <h1>티어별 설계 탑뷰 검수</h1>
      <p class="lede">게임 설치본의 해금 순서에 따라 실제 개별 탑뷰가 필요한 고정 설비·부착물만 정렬했습니다.
        토대 변형과 벨트·리프트·파이프·철도는 별도 이미지를 만들지 않고 설계판의 합성 계약으로 처리합니다.</p>
      <dl class="asset-audit-counts">
        <div><dt>대상</dt><dd>{rows.length}</dd></div>
        <div><dt>탑뷰 승인</dt><dd>{approved}</dd></div>
        <div><dt>후보</dt><dd>{candidates}</dd></div>
        <div><dt>연구 대조만</dt><dd>{references}</dd></div>
        <div><dt>누락</dt><dd>{missing}</dd></div>
        <div><dt>합성 계약</dt><dd>{composedRepresentations}</dd></div>
        <div><dt>자동 연결</dt><dd>{implicitConnections}</dd></div>
      </dl>
    </header>

    {tiers.map(({ tier, rows: tierRows }) => (
      <section class="asset-tier" aria-labelledby={`asset-tier-${tier ?? 'none'}`}>
        <header>
          <p>{tierLabel(tier)}</p>
          <span>{tierRows.length}개</span>
        </header>
        <div class="asset-grid">
          {tierRows.map(({ target, building, topview, image, assetState, assetStateKey, portState }) => (
            <article class:list={['asset-card', `is-${assetStateKey}`]} data-building-class={target.buildingClass}>
              <div class="asset-preview">
                {image
                  ? <img src={`${base}/${image}`} alt="" width="200" height="200" loading="lazy" />
                  : <span class="asset-missing-preview" aria-hidden="true">탑뷰 제작 중</span>}
                <span>{assetState}</span>
              </div>
              <div class="asset-copy">
                <p>{CATEGORY[target.plannerKind] ?? target.plannerKind}</p>
                <h2>{building.ko}</h2>
                <dl>
                  <div><dt>게임 하드 박스</dt><dd>{building.footprint ? `${building.footprint.widthM} × ${building.footprint.lengthM} × ${building.footprint.heightM} m` : '없음'}</dd></div>
                  <div><dt>포트</dt><dd>{portState}</dd></div>
                  <div><dt>표현 계약</dt><dd>{topview?.visualProfile ?? target.representation}</dd></div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .asset-audit { padding-block: var(--s12) var(--s20); }
  .asset-audit-head { display: grid; gap: var(--s3); margin-bottom: var(--s10); }
  .asset-audit-head h1 { margin: 0; }
  .asset-audit-head .lede { max-width: 76ch; margin: 0; color: var(--ink-2); }
  .asset-audit-counts { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: var(--s2); margin: var(--s4) 0 0; }
  .asset-audit-counts div { padding: var(--s3); border: var(--hair) solid var(--line); background: var(--surface); }
  .asset-audit-counts dt { color: var(--ink-3); font: var(--t-caption) var(--font-mono); }
  .asset-audit-counts dd { margin: var(--s1) 0 0; font: 700 var(--t-h3) var(--font-mono); }
  .source-audit { margin-block: var(--s12) var(--s16); padding-block: var(--s8); border-block: var(--hair) solid var(--line-strong); }
  .source-audit > header { display: grid; gap: var(--s2); max-width: 82ch; }
  .source-audit > header h2 { margin: 0; }
  .source-audit > header > p:last-child { margin: 0; color: var(--ink-2); }
  .source-counts { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: var(--s2); margin: var(--s5) 0 0; }
  .source-counts div { padding: var(--s3); border: var(--hair) solid var(--line); background: var(--surface); }
  .source-counts dt { color: var(--ink-3); font: var(--t-caption) var(--font-mono); }
  .source-counts dd { margin: var(--s1) 0 0; font: 700 var(--t-h3) var(--font-mono); }
  .source-method { display: grid; grid-template-columns: minmax(150px, .3fr) 1fr; gap: var(--s3); margin-top: var(--s3); padding: var(--s4); border-left: 3px solid var(--primary); background: var(--surface); }
  .source-method strong { font-family: var(--font-mono); }
  .source-method span { color: var(--ink-2); }
  .source-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--s2); margin-top: var(--s5); }
  .source-grid article { display: grid; align-content: start; min-width: 0; padding: var(--s3); border: var(--hair) solid var(--line); background: var(--surface); }
  .source-grid article > p { display: flex; justify-content: space-between; margin: 0; color: var(--ink-3); font: var(--t-caption) var(--font-mono); }
  .source-grid article > p span { color: var(--primary); }
  .source-grid h3 { margin: var(--s2) 0 0; font-size: var(--t-body); line-height: 1.45; }
  .source-grid dl { display: grid; gap: 4px; margin: var(--s3) 0; }
  .source-grid dl div { display: flex; justify-content: space-between; gap: var(--s2); color: var(--ink-3); font-size: var(--t-caption); }
  .source-grid dd { margin: 0; }
  .source-grid a { align-self: end; color: var(--ink-1); font-size: var(--t-caption); font-weight: 700; }
  .asset-tier { margin-top: var(--s12); }
  .asset-tier > header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--s4); border-bottom: var(--hair) solid var(--line-strong); padding-bottom: var(--s2); }
  .asset-tier > header p { margin: 0; font: 700 var(--t-h3) var(--font-mono); }
  .asset-tier > header span { color: var(--ink-3); font: var(--t-caption) var(--font-mono); }
  .asset-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--s3); }
  .asset-card { display: grid; grid-template-columns: 104px minmax(0, 1fr); min-width: 0; border: var(--hair) solid var(--line); background: var(--surface); }
  .asset-missing-preview { display: grid; width: 100%; min-height: 104px; place-items: center; padding: var(--s2); color: var(--ink-3); font: var(--t-caption) var(--font-mono); text-align: center; }
  .asset-card.is-approved { border-color: color-mix(in oklab, var(--status-ok) 35%, var(--line)); }
  .asset-card.is-missing { border-color: color-mix(in oklab, var(--status-danger) 45%, var(--line)); }
  .asset-card.is-candidate,
  .asset-card.is-reference { border-color: color-mix(in oklab, var(--status-warning) 45%, var(--line)); }
  .asset-card.is-implicit { border-color: color-mix(in oklab, var(--primary) 45%, var(--line)); }
  .asset-preview { position: relative; display: grid; min-height: 148px; place-items: center; overflow: hidden; border-right: var(--hair) solid var(--line); background: var(--bg); }
  .asset-preview img { width: 92px; height: 116px; object-fit: contain; }
  .asset-preview span { position: absolute; inset: 7px auto auto 7px; padding: 3px 6px; background: var(--bg); color: var(--ink-2); font: 700 .58rem var(--font-mono); }
  .asset-copy { min-width: 0; padding: var(--s3); }
  .asset-copy > p { margin: 0 0 var(--s1); color: var(--primary); font: .58rem var(--font-mono); }
  .asset-copy h2 { margin: 0; font-size: var(--t-body); }
  .asset-copy code { display: block; margin-top: 3px; color: var(--ink-3); font-size: .55rem; overflow-wrap: anywhere; }
  .asset-copy dl { display: grid; gap: 5px; margin: var(--s3) 0 0; }
  .asset-copy dl div { display: grid; grid-template-columns: 78px minmax(0, 1fr); gap: 6px; font-size: .6rem; }
  .asset-copy dt { color: var(--ink-3); }
  .asset-copy dd { min-width: 0; margin: 0; overflow-wrap: anywhere; color: var(--ink-2); }
  @media (max-width: 520px) { .asset-card { grid-template-columns: 88px minmax(0, 1fr); } .asset-preview img { width: 78px; } .source-method { grid-template-columns: 1fr; } }
</style>
