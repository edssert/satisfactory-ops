---
/**
 * 대체 제작법 — 무엇을 대체하고, 무엇이 달라지는가.
 *
 * 앞선 판본은 대체 제작법의 재료만 표로 늘어놓았다. 그러면 "대체"의 의미가 안 보인다.
 * 기본 제작법과 나란히 놓고, **산출 1개당 재료량**으로 정규화해 비교한다 —
 * 산출 속도가 다른 두 레시피를 재료 절대량으로 비교하면 틀린 결론이 나온다.
 *
 * 순위와 점수는 우리가 매긴 것이 아니다. 커뮤니티 분석글(1.0 기준)에서 옮겼고 출처를 밝힌다.
 */
import Base from '../../../layouts/Base.astro';
import '../../../styles/fx.css';
import priority from '../../../data/curated/alternate-priority.json';
import saveUnlocks from '../../../data/app/save-unlocks.json';

interface Ing {
  ko: string;
  perMinute: number;
}
interface Out extends Ing {
  isMain: boolean;
}
interface Alt {
  id: string;
  ko: string;
  en: string;
  makes: { ko: string; perMinute: number };
  tier: string;
  score: number;
  usableFromTier: number;
  needsOtherAlternate: boolean;
  grades: { lp: string; steam: string | null; own: string | null; gap: number | null };
  own: {
    score: number;
    efficiency: number;
    convenience: number;
    resourcePct: number;
    machinePct: number;
    powerPct: number;
  } | null;
  agreement: 'strong' | 'weak' | 'split' | 'partial';
  character: 'efficiency' | 'convenience' | 'balanced' | null;
  hassleNotes: string[] | null;
  disagreeWhy: string[] | null;
  consensus: 'both-high' | 'mixed' | 'conflict' | 'both-low' | 'unknown';
  sortKey: number;
  compare: {
    standard: { ko: string; machineKo: string; outPerMin: number; ingredients: Ing[]; outputs: Out[] };
    alternate: { machineKo: string; outPerMin: number; ingredients: Ing[]; outputs: Out[] };
    outputRatio: number;
    removed: string[];
    added: string[];
    byproducts: Out[];
  } | null;
}

const doc = priority as unknown as {
  $sources: {
    title: string;
    author: string;
    url: string;
    date: string;
    gameVersion: string;
    method: string;
    limits?: string;
  }[];
  $dispute: {
    summary: string;
    agree: number;
    near: number;
    far: number;
    note: string;
    threeWay: { strong: number; conflict: number; note: string };
  };
  $axes: { efficiency: string; convenience: string; note: string };
  $note: string;
  $tierNote: string;
  $unranked: { id: string; ko: string; en: string }[];
  recipes: Alt[];
};

const TIER_KO: Record<string, string> = {
  S: '무조건',
  A: '적극 권장',
  B: '권장',
  C: '때에 따라',
  D: '거의 안 씀',
  F: '안 씀',
};

/*
 * 등급은 **이 사이트의 계산 하나**로 매긴다. 세 개를 나란히 보여주면 고르는 사람이
 * 판단을 떠안는다. 남의 순위는 각주로 내리고, 크게 엇갈릴 때만 표시한다.
 */
const GRADE_ORDER = ['S', 'A', 'B', 'C', 'D', 'F'];
const gradeRank = (g: string | null) => (g ? GRADE_ORDER.indexOf(g) : 99);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const counts = {
  total: doc.recipes.length,
  s: doc.recipes.filter((r) => r.grades.own === 'S').length,
  a: doc.recipes.filter((r) => r.grades.own === 'A').length,
  conflict: doc.recipes.filter((r) => r.agreement === 'split').length,
};

const tiers = [...new Set(doc.recipes.map((r) => r.usableFromTier))].sort((a, b) => a - b);
const groups = tiers.map((t) => ({
  tier: t,
  /* 자체 계산 점수 순. 등급이 없는 것(비교 대상 없음)은 맨 뒤로 */
  list: doc.recipes
    .filter((r) => r.usableFromTier === t)
    .sort(
      (a, b) =>
        gradeRank(a.grades.own) - gradeRank(b.grades.own) ||
        (b.own?.score ?? -999) - (a.own?.score ?? -999)
    ),
}));

const num = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 1000) / 1000));
const pct = (n: number) => `${n > 0 ? '+' : ''}${n}%`;
const topPicks = doc.recipes.filter((r) => r.tier === 'S' || r.tier === 'A').length;
---

<Base
  title="대체 제작법, 무엇이 어떻게 달라지나"
  description="대체 제작법 104건을 기본 제작법과 나란히 비교합니다. 산출 1개당 재료량으로 정규화했습니다."
  section="dex"
>
  <div class="wrap page">
    <header class="page-head">
      <p class="marker"><span class="num">대체 제작법</span></p>
      <h1><span class="fx-gradient-text">무엇이 어떻게 달라지나</span></h1>
      <p class="lede prose">
        하드 드라이브는 후보 <strong>2개 중 1개</strong>를 고르고 리롤이 한 번 있습니다.
        아래는 <strong>실제로 쓸 수 있게 되는 티어</strong>로 묶었습니다. 재료가 아직 안 열렸으면
        뽑아 둬도 못 씁니다.
      </p>
    </header>

    <div class="facts">
      <div class="fact"><span class="fact-k">비교한 제작법</span><span class="fact-v n">{doc.recipes.length}</span></div>
      <div class="fact is-ok"><span class="fact-k">S 등급</span><span class="fact-v n">{counts.s}</span></div>
      <div class="fact is-ok"><span class="fact-k">A 등급</span><span class="fact-v n">{counts.a}</span></div>
      <div class="fact is-warn"><span class="fact-k">외부와 크게 다름</span><span class="fact-v n">{counts.conflict}</span></div>
    </div>

    <section class="note-box">
      <p>
        등급은 <strong>1.2 게임 데이터로 직접 계산</strong>했습니다. 우주 엘리베이터를 끝까지
        납품하는 데 드는 총량을 기본 제작법으로 한 번 풀고, 대체 제작법을 하나씩 끼워 다시 푼 뒤
        차이를 봅니다. 원자재는 <strong>실제 맵의 노드 수</strong>로 희소도를 매겨 곱합니다. 우라늄 6개와 철 70여 개를 같은 무게로 셈하지 않습니다.
      </p>
      <p>
        점수는 <strong>두 축</strong>입니다. <strong>효율</strong>은 {doc.$axes.efficiency}{' '}
        <strong>편의</strong>는 {doc.$axes.convenience}
      </p>
      <p class="caption">{doc.$axes.note}</p>
      <p class="caption">
        커뮤니티 순위 두 건과 대조했고 <strong>{counts.conflict}건</strong>이 크게 갈립니다.
        그 항목은 카드에서 왜 갈리는지 펼쳐 볼 수 있습니다. {doc.$note}
      </p>
    </section>

    <div class="ownbar" data-ownbar hidden>
      <p class="ownbar-n">
        딴 대체 제작법 <b class="n" data-own-count>0</b>/<span class="n">{counts.total}</span>
      </p>
      <label class="ownbar-filter">
        <input type="checkbox" data-own-filter />
        딴 것만 보기
      </label>
      <button type="button" class="ownbar-clear" data-own-clear>모두 해제</button>
      <label class="ownbar-load" data-own-load>
        <input type="file" accept=".sav" data-own-file />
        <span data-own-label>세이브에서 가져오기</span>
      </label>
      <p class="ownbar-note">
        여기서 체크한 것이 <a href={`${base}/planner/`}>설계</a> 화면의 레시피 목록에 그대로 쓰입니다.
        이 브라우저에만 저장됩니다.
      </p>
      <p class="ownbar-note" data-own-msg hidden></p>
    </div>

    {groups.map((g) => (
      <section class="section">
        <p class="marker">
          <span class="num">{g.tier === 0 ? '허브' : `티어 ${g.tier}`}</span> 부터 쓸 수 있음
          <span class="marker-count n">{g.list.length}건</span>
        </p>

        <div class="cards">
          {g.list.map((r) => (
            <article class={`card is-${r.consensus}`} data-alt={r.id}>
              <header class="card-head">
                <h3>
                  <label class="own">
                    {/*
                      * 딴 것을 체크해 둔다. 하드 드라이브가 대체 제작법 수보다 적어서
                      * 사람마다 가진 것이 다르고, 설계 화면은 여기서 체크한 것만 보여 준다.
                      */}
                    <input type="checkbox" data-own={r.id} />
                    <span class="sr-only">{r.ko} 딴 것으로 표시</span>
                  </label>
                  {r.ko} <span class="en">{r.en}</span>
                </h3>
                <div class="card-grade">
                  {r.agreement === 'split' && <span class="verdict is-warn">평가 갈림</span>}
                  <span class={`grade is-${(r.grades.own ?? 'f').toLowerCase()}`}>
                    {r.grades.own ?? ''}
                  </span>
                  {r.own && <span class="score n">{num(r.own.score)}</span>}
                </div>
              </header>

              {r.compare ? (
                <>
                  <div class="cmp">
                    {[
                      { label: '기본', d: r.compare.standard, alt: false },
                      { label: '대체', d: r.compare.alternate, alt: true },
                    ].map((row) => (
                      <div class={`cmp-row${row.alt ? ' is-alt' : ''}`}>
                        <span class="cmp-label">{row.label}</span>
                        <span class="cmp-in">
                          {row.d.ingredients.map((g2, i) => (
                            <>
                              {i > 0 && <span class="sep">·</span>}
                              {g2.ko} <span class="n">{num(g2.perMinute)}/분</span>
                            </>
                          ))}
                        </span>
                        <span class="cmp-arrow" aria-hidden="true">→</span>
                        <span class="cmp-out">
                          {row.d.outputs.map((o, i) => (
                            <>
                              {i > 0 && <span class="sep">·</span>}
                              <span class={o.isMain ? 'is-main' : 'is-by'}>
                                {o.ko} <span class="n">{num(o.perMinute)}/분</span>
                              </span>
                            </>
                          ))}
                          {row.alt && r.compare!.outputRatio !== 1 && (
                            <span class={`ratio${r.compare!.outputRatio > 1 ? ' is-up' : ' is-down'}`}>
                              ×{num(r.compare!.outputRatio)}
                            </span>
                          )}
                        </span>
                        <span class="cmp-machine">{row.d.machineKo}</span>
                      </div>
                    ))}
                  </div>

                  {(r.compare.removed.length > 0 || r.compare.added.length > 0) && (
                    <p class="changes">
                      {r.compare.removed.map((k, i) => (
                        <>
                          {i > 0 && <span class="sep">·</span>}
                          <span class="chg is-out">{k} 빠짐</span>
                        </>
                      ))}
                      {r.compare.added.map((k, i) => (
                        <>
                          {(i > 0 || r.compare!.removed.length > 0) && <span class="sep">·</span>}
                          <span class="chg is-in">{k} 들어감</span>
                        </>
                      ))}
                    </p>
                  )}

                  {r.own && (
                    <div class="axes">
                      <div class="axis">
                        <span class="axis-k">효율</span>
                        <span class={`axis-bar ${r.own.efficiency >= 0 ? 'is-plus' : 'is-minus'}`}>
                          <i style={`--w:${Math.min(100, Math.abs(r.own.efficiency) * 2.2)}%`}></i>
                        </span>
                        <span class={`axis-v n ${r.own.efficiency >= 0 ? 'is-save' : 'is-cost'}`}>
                          {r.own.efficiency >= 0 ? '+' : ''}{num(r.own.efficiency)}
                        </span>
                        <span class="axis-note">
                          자원 {r.own.resourcePct >= 0 ? '−' : '+'}{Math.abs(r.own.resourcePct)}% ·
                          기계 {r.own.machinePct >= 0 ? '−' : '+'}{Math.abs(r.own.machinePct)}% ·
                          전력 {r.own.powerPct >= 0 ? '−' : '+'}{Math.abs(r.own.powerPct)}%
                        </span>
                      </div>
                      <div class="axis">
                        <span class="axis-k">편의</span>
                        <span class={`axis-bar ${r.own.convenience >= 0 ? 'is-plus' : 'is-minus'}`}>
                          <i style={`--w:${Math.min(100, Math.abs(r.own.convenience) * 6)}%`}></i>
                        </span>
                        <span class={`axis-v n ${r.own.convenience >= 0 ? 'is-save' : 'is-cost'}`}>
                          {r.own.convenience >= 0 ? '+' : ''}{num(r.own.convenience)}
                        </span>
                        <span class="axis-note">
                          {r.hassleNotes && r.hassleNotes.length > 0
                            ? r.hassleNotes.join(' · ')
                            : '기본 제작법과 품이 비슷하다'}
                        </span>
                      </div>
                    </div>
                  )}

                  {r.disagreeWhy && (
                    <details class="why">
                      <summary>커뮤니티 평가와 다릅니다. 왜</summary>
                      <ul>
                        {r.disagreeWhy.map((w) => (
                          <li>{w}</li>
                        ))}
                      </ul>
                      <p class="caption">
                        LP 모형 <span class="n">{r.grades.lp}</span> · 스팀 가이드{' '}
                        <span class="n">{r.grades.steam ?? ''}</span> · 이 사이트{' '}
                        <span class="n">{r.grades.own ?? ''}</span>
                      </p>
                    </details>
                  )}
                  {r.needsOtherAlternate && (
                    <p class="caution">다른 대체 제작법이 함께 있어야 제값을 합니다.</p>
                  )}
                  {!r.disagreeWhy && (
                    <p class="caution">
                      커뮤니티 평가도 비슷합니다. LP <span class="n">{r.grades.lp}</span> · 스팀{' '}
                      <span class="n">{r.grades.steam ?? ''}</span>
                    </p>
                  )}
                </>
              ) : (
                <p class="caution">기본 제작법이 없어 비교할 대상이 없습니다.</p>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}

    {doc.$unranked.length > 0 && (
      <section class="section">
        <p class="marker"><span class="num">순위 미확보</span></p>
        <p class="caption">출처의 표에 없어 순위를 붙이지 못한 것들입니다.</p>
        <ul class="unranked">
          {doc.$unranked.map((r) => (
            <li class="chip">{r.ko} <span class="en">{r.en}</span></li>
          ))}
        </ul>
      </section>
    )}

    <section class="section">
      <p class="marker"><span class="num">출처</span></p>
      <div class="src">
        {doc.$sources.map((src, i) => (
          <div class="src-item">
            <p>
              <span class="n src-n">{['LP 모형', '스팀 가이드', '자체 계산'][i]}</span>{' '}
              <a href={src.url}>{src.title}</a>, {src.author}, {src.date} · 게임{' '}
              <span class="n">{src.gameVersion}</span>
            </p>
            <p class="caption">{src.method}</p>
            {src.limits && <p class="caption limits">한계: {src.limits}</p>}
          </div>
        ))}
        <p class="caption">{doc.$dispute.summary}</p>
        <p class="caption">{doc.$note}</p>
        <p class="caption">{doc.$tierNote}</p>
        <p class="caption">
          레시피는 <strong>기계 한 대를 100%로 돌렸을 때의 분당 값</strong>입니다. 게임 화면과
          같은 수치라 그대로 대조할 수 있습니다.
        </p>
      </div>
    </section>
  </div>

  <script is:inline set:html={`window.__sfopsUnlocks=${JSON.stringify(saveUnlocks.map)}`}></script>

  <script is:inline>
    (function () {
      var KEY = 'sfops.owned';
      var VERSION = 1;
      function load() {
        try {
          var s = JSON.parse(localStorage.getItem(KEY) || 'null');
          if (!s || s.version !== VERSION || !Array.isArray(s.ids)) return [];
          return s.ids;
        } catch (e) {
          return [];
        }
      }
      function save(ids) {
        try {
          localStorage.setItem(KEY, JSON.stringify({ version: VERSION, ids: ids }));
        } catch (e) {}
      }

      var owned = load();
      var bar = document.querySelector('[data-ownbar]');
      var count = document.querySelector('[data-own-count]');
      var filter = document.querySelector('[data-own-filter]');
      var boxes = Array.prototype.slice.call(document.querySelectorAll('[data-own]'));
      if (!bar) return;
      bar.hidden = false;

      function paint() {
        var set = {};
        for (var i = 0; i < owned.length; i++) set[owned[i]] = 1;
        for (var j = 0; j < boxes.length; j++) {
          var b = boxes[j];
          var on = !!set[b.dataset.own];
          b.checked = on;
          var card = b.closest('.card');
          card.classList.toggle('is-owned', on);
          card.hidden = filter && filter.checked && !on;
        }
        count.textContent = String(owned.length);
      }

      for (var k = 0; k < boxes.length; k++) {
        boxes[k].addEventListener('change', function (e) {
          var id = e.currentTarget.dataset.own;
          var at = owned.indexOf(id);
          if (at >= 0) owned.splice(at, 1);
          else owned.push(id);
          save(owned);
          paint();
        });
      }
      if (filter) filter.addEventListener('change', paint);
      var clear = document.querySelector('[data-own-clear]');
      if (clear)
        clear.addEventListener('click', function () {
          owned = [];
          save(owned);
          if (filter) filter.checked = false;
          paint();
        });
      /* 다른 탭(설계 화면)에서 바꾼 것을 따라간다 */
      window.addEventListener('storage', function (e) {
        if (e.key === KEY) {
          owned = load();
          paint();
        }
      });
      paint();
    })();
  </script>

  <script>
    /*
     * 세이브에서 "딴 대체 제작법"을 가져온다. 110가지를 손으로 체크하는 건 실제로 안 한다.
     * 파서가 2.6MB 라 파일을 고른 뒤에야 내려받는다. 파일은 브라우저 밖으로 나가지 않는다.
     */
    const box = document.querySelector('[data-own-file]') as HTMLInputElement | null;
    const label = document.querySelector('[data-own-label]') as HTMLElement | null;
    const msg = document.querySelector('[data-own-msg]') as HTMLElement | null;
    const wrap = document.querySelector('[data-own-load]') as HTMLElement | null;
    const say = (text: string) => {
      if (!msg) return;
      msg.hidden = false;
      msg.textContent = text;
    };
    box?.addEventListener('change', async () => {
      const file = box.files?.[0];
      if (!file || !label || !wrap) return;
      wrap.classList.add('is-busy');
      label.textContent = '읽는 중…';
      try {
        const { readSave } = await import('../../../lib/save-import');
        const unlocks = (window as unknown as { __sfopsUnlocks?: Record<string, string[]> })
          .__sfopsUnlocks;
        const r = await readSave(file, unlocks ?? {});
        const KEY = 'sfops.owned';
        const cur = JSON.parse(localStorage.getItem(KEY) || 'null') as { ids?: string[] } | null;
        const ids = [...new Set([...(cur?.ids ?? []), ...r.alternates])];
        localStorage.setItem(KEY, JSON.stringify({ version: 1, ids }));
        say(
          r.alternates.length === 0
            ? `${r.session} · ${r.hours}시간 — 아직 딴 대체 제작법이 없습니다`
            : `${r.session} · ${r.hours}시간 — ${r.alternates.length}가지를 가져왔습니다`
        );
        /* 위 스크립트가 storage 를 듣고 있다. 같은 탭에는 안 오므로 직접 보낸다 */
        window.dispatchEvent(new StorageEvent('storage', { key: KEY }));
      } catch (err) {
        say('읽지 못했습니다 — ' + (err instanceof Error ? err.message : String(err)));
      } finally {
        wrap.classList.remove('is-busy');
        label.textContent = '세이브에서 가져오기';
        box.value = '';
      }
    });
  </script>

  <style>
    .page { padding-block: var(--s16) 0; }
    .page-head { margin-bottom: var(--s8); }
    .page-head h1 { margin-bottom: var(--s4); }
    .lede { font-size: var(--t-body-l); color: var(--ink-2); }
    .lede strong { color: var(--ink); font-weight: 600; }

    .facts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      gap: var(--s3);
    }
    .fact {
      padding: var(--s4) var(--s5);
      border-radius: calc(var(--radius) * 2);
      background: var(--glass);
      box-shadow: var(--lit);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .fact-k { display: block; margin-bottom: var(--s1); font-size: var(--t-label); color: var(--ink-3); }
    .fact-v { font-size: var(--t-body-l); font-weight: 500; }

    .section { padding-block: var(--s16) 0; }
    .marker-count { margin-left: auto; color: var(--ink-3); }

    .ownbar {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s3) var(--s5);
      align-items: center;
      margin-bottom: var(--s8);
      padding: var(--s4) var(--s5);
      border-radius: var(--radius);
      background: var(--raised);
      box-shadow: var(--lit);
    }
    .ownbar-n { margin: 0; font-size: var(--t-body-s); }
    .ownbar-n b { color: var(--accent); }
    .ownbar-filter {
      display: flex;
      gap: var(--s2);
      align-items: center;
      font-size: var(--t-body-s);
      cursor: pointer;
    }
    .ownbar-filter input { accent-color: var(--primary); }
    .ownbar-clear {
      padding: 4px 10px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 4px;
      background: none;
      color: var(--ink-3);
      font: inherit;
      font-size: var(--t-caption);
      cursor: pointer;
    }
    .ownbar-clear:hover { color: var(--ink); }
    .ownbar-note {
      flex-basis: 100%;
      margin: 0;
      color: var(--ink-3);
      font-size: var(--t-caption);
      line-height: 1.7;
      word-break: keep-all;
    }

    .own { display: inline-flex; align-items: center; margin-right: var(--s2); vertical-align: middle; }
    .own input { accent-color: var(--primary); cursor: pointer; }
    /* 딴 것으로 표시한 카드. 체크 표시가 이미 붙어 있으므로 색은 보조 신호다 */
    .ownbar-load {
      padding: 4px 11px;
      border: var(--hair) solid var(--primary);
      border-radius: 4px;
      font-size: var(--t-caption);
      cursor: pointer;
    }
    .ownbar-load:hover { background: color-mix(in oklab, var(--primary) 14%, transparent); }
    .ownbar-load.is-busy { border-color: var(--line-strong); color: var(--ink-3); cursor: progress; }
    .ownbar-load input { display: none; }

    .card.is-owned { box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--primary) 40%, transparent); }

    .cards { display: grid; gap: var(--s5); }
    @media (min-width: 1000px) { .cards { grid-template-columns: 1fr 1fr; } }

    .card {
      padding: var(--s5);
      border-radius: var(--radius);
      background: var(--glass);
      box-shadow: var(--lit);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    /* 두 곳이 함께 높게 본 것만 테두리로 띄운다. 색이 아니라 라벨이 정본이다 */
    /* 상위 등급은 테두리를 밝혀 어둠 속에서 먼저 눈에 들어오게 한다 */
    .card:has(.grade.is-s), .card:has(.grade.is-a) { box-shadow: var(--lit-strong); }
    .card-grade .grade { min-width: 28px; font-size: var(--t-body); }

    .card-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--s2) var(--s4);
      margin-bottom: var(--s4);
    }
    .card-head h3 { font-size: var(--t-body-l); }
    .card-grade { margin-left: auto; display: flex; align-items: baseline; gap: var(--s2); }
    .grade {
      display: inline-block;
      min-width: 24px;
      padding: 0.05em 0.3em;
      border: var(--hair) solid var(--line-strong);
      border-radius: var(--radius);
      font-family: var(--font-mono);
      font-weight: 600;
      text-align: center;
      font-size: var(--t-caption);
    }
    .grade.is-s, .grade.is-a { border-color: var(--accent); color: var(--accent); }
    .grade.is-d, .grade.is-f { color: var(--ink-3); }
    .grades { display: inline-flex; align-items: flex-end; gap: var(--s2); }
    .grade-cell { display: grid; justify-items: center; gap: 2px; }
    .grade-src { font-family: var(--font-mono); font-size: 10px; color: var(--ink-3); }
    .verdict {
      padding: 0.1em 0.45em;
      border: var(--hair) solid var(--line);
      border-radius: var(--radius);
      font-size: var(--t-label);
      color: var(--ink-2);
      white-space: nowrap;
    }
    .verdict.is-ok { border-color: var(--ok); color: var(--ok); }
    .verdict.is-warn { border-color: var(--accent); color: var(--accent); }
    .verdict.is-low { color: var(--ink-3); }

    .note-box {
      margin-top: var(--s6);
      padding: var(--s5);
      border-left: 2px solid var(--primary);
      border-radius: var(--radius);
      background: var(--glass-raised);
      box-shadow: var(--lit);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .note-box p { max-width: var(--measure-wide); }
    .fact.is-ok .fact-v { color: var(--ok); }
    .fact.is-warn .fact-v { color: var(--accent); }
    .src-item { margin-bottom: var(--s5); }
    .src-n { color: var(--accent); font-size: var(--t-caption); }

    /*
     * 게임이 레시피를 보여주는 그대로, 분당 재료 → 분당 산출. 산출 1개당으로 정규화하면
     * 정확하긴 해도 게임 화면과 대조가 안 된다.
     */
    .cmp { display: grid; gap: var(--s2); font-size: var(--t-small); }
    .cmp-row {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr) 24px minmax(0, 0.8fr) auto;
      align-items: baseline;
      gap: var(--s2) var(--s3);
      padding-block: var(--s2);
      border-top: var(--hair) solid var(--line);
    }
    .cmp-label {
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }
    .cmp-row.is-alt .cmp-label { color: var(--accent); }
    .cmp-row.is-alt { font-weight: 500; }
    .cmp-row:not(.is-alt) { color: var(--ink-2); }
    .cmp-arrow { color: var(--ink-3); text-align: center; }
    .cmp-machine { font-size: var(--t-caption); color: var(--ink-3); white-space: nowrap; }
    .cmp-out .is-by { color: var(--accent); }
    .sep { color: var(--ink-3); margin-inline: 0.35em; }
    .ratio { margin-left: var(--s2); font-size: var(--t-caption); }
    .ratio.is-up { color: var(--ok); }
    .ratio.is-down { color: var(--ink-3); }

    @media (max-width: 700px) {
      .cmp-row { grid-template-columns: 40px minmax(0, 1fr); }
      .cmp-arrow { display: none; }
      .cmp-out, .cmp-machine { grid-column: 2; }
    }

    .changes {
      margin: var(--s4) 0 0;
      font-size: var(--t-caption);
      line-height: 1.9;
      color: var(--ink-2);
    }
    .chg { white-space: nowrap; }
    .chg.is-out { color: var(--ok); font-weight: 600; }
    .chg.is-in { color: var(--ink-2); }

    .own {
      margin: var(--s3) 0 0;
      padding-top: var(--s3);
      border-top: var(--hair) solid var(--line);
      font-size: var(--t-caption);
      color: var(--ink-2);
    }
    .own-k {
      display: inline-block;
      margin-right: var(--s3);
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.06em;
      color: var(--accent);
    }
    /* 줄면 좋은 것이므로 절감을 초록으로. 색만으로 구분하지 않도록 부호를 함께 쓴다 */
    .is-save { color: var(--ok); }
    .is-cost { color: var(--ink-3); }
    .limits { color: var(--ink-3); }

    /* 두 축을 막대로 나란히. 어느 쪽이 이 제작법의 성격인지 눈으로 잡히게 한다 */
    .axes {
      margin-top: var(--s4);
      padding-top: var(--s4);
      border-top: var(--hair) solid var(--line);
      display: grid;
      gap: var(--s3);
    }
    .axis {
      display: grid;
      grid-template-columns: 40px minmax(0, 96px) 56px minmax(0, 1fr);
      align-items: center;
      gap: var(--s2) var(--s3);
      font-size: var(--t-caption);
    }
    .axis-k {
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }
    .axis-bar {
      position: relative;
      height: 5px;
      border-radius: 3px;
      background: var(--line);
      overflow: hidden;
    }
    .axis-bar i {
      position: absolute;
      inset: 0 auto 0 0;
      width: var(--w);
      border-radius: 3px;
    }
    .axis-bar.is-plus i { background: var(--ok); }
    .axis-bar.is-minus i { background: var(--ink-3); }
    .axis-v { text-align: right; }
    .axis-note { color: var(--ink-3); min-width: 0; }
    @media (max-width: 700px) {
      .axis { grid-template-columns: 40px minmax(0, 1fr) 56px; }
      .axis-note { grid-column: 1 / -1; }
    }

    .why { margin-top: var(--s3); font-size: var(--t-caption); }
    .why summary {
      cursor: pointer;
      color: var(--accent);
      list-style: none;
    }
    .why summary::-webkit-details-marker { display: none; }
    .why summary::before { content: '+ '; font-family: var(--font-mono); }
    .why[open] summary::before { content: '- '; }
    .why ul { margin: var(--s2) 0; padding-left: 1.1em; color: var(--ink-2); }
    .why li { margin-bottom: var(--s1); }
    .caution { margin: var(--s3) 0 0; font-size: var(--t-caption); color: var(--ink-3); }

    .unranked { display: flex; flex-wrap: wrap; gap: var(--s2); margin: var(--s4) 0 0; padding: 0; list-style: none; }
    .src p { max-width: var(--measure-wide); }
    .nowrap { white-space: nowrap; }
  </style>
</Base>
