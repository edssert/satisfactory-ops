---
/**
 * 도감 · 표 — 레퍼런스와 용어집. JS 0KB 정적 페이지.
 *
 * 표는 게임 배포 데이터에서 빌드타임에 렌더한다. 사람이 옮겨 적은 값이 없다.
 *
 * 표기 규칙 두 가지가 앞선 판본에서 문제가 됐다:
 *   - 컨베이어 벨트와 리프트는 등급별 처리량이 **같다**. 행을 두 벌 쓰지 않고 한 행에 합친다.
 *   - 고체 채굴기와 유체 추출기를 처리량 순으로 한 표에 섞으면 Mk.1/2/3 이 떨어져 읽을 수 없다.
 *     표를 나눈다.
 */
import Base from '../../../layouts/Base.astro';
import TechNav from '../../../components/TechNav.astro';
import '../../../styles/fx.css';
import '../../../styles/tech.css';
import { buildings, item, logistics } from '../../../lib/gamedata';
import glossaryJson from '../../../data/glossary.json';

const { belts, pipes: allPipes } = logistics();

/*
 * '깨끗한 파이프라인'은 유량 표시기만 뺀 외형 변종이라 처리량이 같다.
 * 표에 두 벌씩 나오면 등급 비교가 안 되므로 제외한다.
 */
const pipes = allPipes.filter((p) => !p.id.includes('NoIndicator'));

/** 벨트와 리프트를 등급으로 짝지어 한 행으로 만든다 */
const beltRows = belts
  .filter((b) => b.id.includes('ConveyorBelt'))
  .map((b) => {
    const mk = b.id.match(/Mk(\d)/)?.[1] ?? '?';
    const lift = belts.find((l) => l.id.includes('ConveyorLift') && l.id.includes(`Mk${mk}`));
    return {
      mk,
      ko: b.ko,
      en: b.en,
      rate: b.beltItemsPerMinute ?? 0,
      liftKo: lift?.ko ?? null,
      liftSame: (lift?.beltItemsPerMinute ?? 0) === (b.beltItemsPerMinute ?? 0),
      tier: b.unlockTier,
    };
  })
  .sort((a, b) => a.rate - b.rate);

/*
 * 형태 이름은 `RF_SOLID` 가 아니라 아이템의 form 과 같은 `solid` 다 (build-data.mjs).
 * 여기만 `RF_SOLID` 로 두었더니 채굴기 표가 **한 행도 없이** 배포됐다.
 * 대소문자·접두사 어느 쪽이 와도 걸리게 두고, 행이 0 이면 빌드가 서도록 검사를 넣었다
 * (scripts/check-coverage.mjs).
 */
const isSolid = (f: string) => /solid/i.test(f);
const solidMiners = buildings
  .filter((b) => b.extraction?.allowedForms?.some(isSolid))
  .sort((a, b) => (a.extraction!.perMinuteAtNormalPurity ?? 0) - (b.extraction!.perMinuteAtNormalPurity ?? 0));

const fluidExtractors = buildings
  .filter((b) => b.extraction && !b.extraction.allowedForms?.some(isSolid))
  .sort((a, b) => (a.extraction!.perMinuteAtNormalPurity ?? 0) - (b.extraction!.perMinuteAtNormalPurity ?? 0));

const generators = buildings
  .filter((b) => b.category === 'generator')
  .sort((a, b) => (a.unlockTier ?? -1) - (b.unlockTier ?? -1) || (a.powerGenMW ?? 0) - (b.powerGenMW ?? 0));

/*
 * 전력을 먹는 건물 **전부**. 앞선 판본은 category === 'manufacturer' 로 걸러
 * 채굴기·A.W.E.S.O.M.E. 싱크·펌프가 통째로 빠졌다.
 *
 * 구버전 세이브 호환용으로만 남아 있는 점프 패드 두 개는 뺀다 — 지금은 지을 수 없다.
 */
const LEGACY = new Set(['Build_JumpPad_C', 'Build_JumpPadTilted_C']);
const consumers = buildings
  .filter((b) => !LEGACY.has(b.id) && ((b.powerMW ?? 0) > 0 || b.powerIsVariable))
  .sort(
    (a, b) =>
      (a.unlockTier ?? -1) - (b.unlockTier ?? -1) ||
      (a.powerMW ?? a.powerMaxMW ?? 0) - (b.powerMW ?? b.powerMaxMW ?? 0)
  );

/** 티어별로 묶는다. 36행을 한 덩어리로 두면 어디서 티어가 바뀌는지 안 보인다 */
const consumersByTier = [...new Map<number, typeof consumers>(
  consumers.map((b) => [b.unlockTier ?? -1, []])
)].map(([tier]) => ({
  tier,
  list: consumers.filter((b) => (b.unlockTier ?? -1) === tier),
}));

/** 분류 라벨. 데이터의 category 값을 화면 말로 옮긴다 */
const CATEGORY_KO: Record<string, string> = {
  extractor: '채굴',
  manufacturer: '생산',
  logistics: '물류',
  transport: '운송',
  hub: '허브',
  decoration: '조명',
  structure: '구조물',
  other: '기타',
};

const beltCaps = beltRows.map((b) => b.rate);

const tierOf = (t: number | null) => (t == null ? '허브' : `T${t}`);
const num = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));
/** 빈 칸은 공백이 아니라 대시로 채운다. 공백은 "아직 못 채웠다"와 구별이 안 된다 */
const DASH = '—';
const or = (v: number | null | undefined) => (v == null ? DASH : String(v));

/** 채굴기 산출 — 순도 배율은 게임 데이터에 없다. 위키 검증치다 */
const PURITY = [
  { key: 'impure', ko: '불순', mul: 0.5 },
  { key: 'normal', ko: '보통', mul: 1 },
  { key: 'pure', ko: '순수', mul: 2 },
];

const terms = (
  Array.isArray(glossaryJson) ? glossaryJson : (glossaryJson as { terms: unknown[] }).terms
) as {
  id: string;
  term: string;
  en: string;
  unlock?: string;
  /** game = 게임이 정한 이름 · industry = 실제 산업·공학 용어 · community = 플레이어들이 만든 말 */
  origin?: 'game' | 'industry' | 'community';
  originNote?: string;
  /** 게임 공식 로케일 표기가 통용어와 다를 때만 (ADR-0017) */
  gameKo?: string;
  short: string;
  why: string;
  how: string;
  gotcha: string;
}[];

const ORIGIN_KO: Record<string, string> = {
  game: '게임 용어',
  industry: '실제 산업 용어',
  community: '커뮤니티 용어',
};
/* 같은 분류끼리 붙여 둔다. 배지가 열을 이루면 훑을 때 눈이 덜 튄다 */
const ORIGIN_ORDER = ['industry', 'game', 'community'];
const sortedTerms = [...terms].sort(
  (a, b) =>
    ORIGIN_ORDER.indexOf(a.origin ?? 'game') - ORIGIN_ORDER.indexOf(b.origin ?? 'game') ||
    a.term.localeCompare(b.term, 'ko')
);
---

<Base
  title="표 — 레퍼런스와 용어집"
  description="벨트·파이프 처리량, 채굴기 산출량, 발전기 출력, 생산 건물 전력. 게임 배포 데이터에서 직접 생성한 표."
  section="dex"
>
  <div class="wrap page">
    <TechNav here="reference" />

    <header class="page-head">
      <p class="marker"><span class="num">도감</span> 표</p>
      <h1><span class="fx-gradient-text">레퍼런스 표</span></h1>
      <p class="lede prose">게임 배포 데이터에서 그대로 생성합니다.</p>
    </header>

    <section class="section">
      <p class="marker"><span class="num">01</span> 물류</p>
      <h2>벨트 · 리프트 처리량</h2>
      <div class="scroll-x" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>등급</th>
              <th class="n">처리량 (개/분)</th>
              <th class="n">Mk.1 대비</th>
              <th class="n">해금</th>
            </tr>
          </thead>
          <tbody>
            {beltRows.map((b) => (
              <tr>
                <td>
                  <span class="n">Mk.{b.mk}</span>
                  <span class="rownote">벨트 · 리프트 공통</span>
                </td>
                <td class="n">{b.rate}</td>
                <td class="n">×{Math.round((b.rate / beltCaps[0]) * 10) / 10}</td>
                <td class="n">{tierOf(b.tier)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <p class="marker"><span class="num">02</span> 채굴기</p>
      <h2>순도별 산출량</h2>
      <div class="scroll-x" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>채굴기</th>
              {PURITY.map((p) => <th class="n">{p.ko}</th>)}
              <th class="n">전력 (MW)</th>
              <th class="n">해금</th>
            </tr>
          </thead>
          <tbody>
            {solidMiners.map((m) => {
              const b = m.extraction!.perMinuteAtNormalPurity ?? 0;
              return (
                <tr>
                  <td>{m.ko} <span class="en">{m.en}</span></td>
                  {PURITY.map((p) => <td class="n">{num(b * p.mul)}</td>)}
                  <td class="n">{or(m.powerMW)}</td>
                  <td class="n">{tierOf(m.unlockTier)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <p class="marker"><span class="num">03</span> 유체</p>
      <h2>추출기와 파이프</h2>
      <div class="two">
        <div class="scroll-x" tabindex="0">
          <table>
            <thead>
              <tr><th>추출기</th><th class="n">m³/분</th><th class="n">전력</th><th class="n">해금</th></tr>
            </thead>
            <tbody>
              {fluidExtractors.map((m) => (
                <tr>
                  <td>{m.ko}</td>
                  <td class="n">{or(m.extraction!.perMinuteAtNormalPurity)}</td>
                  <td class="n">{or(m.powerMW)}</td>
                  <td class="n">{tierOf(m.unlockTier)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="scroll-x" tabindex="0">
          <table>
            <thead>
              <tr><th>파이프</th><th class="n">m³/분</th><th class="n">해금</th></tr>
            </thead>
            <tbody>
              {pipes.map((p) => (
                <tr>
                  <td>{p.ko}</td>
                  <td class="n">{p.pipeFlowM3PerMinute}</td>
                  <td class="n">{tierOf(p.unlockTier)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <p class="marker"><span class="num">04</span> 발전</p>
      <h2>발전기 출력</h2>
      <div class="scroll-x" tabindex="0">
        <table>
          <thead>
            <tr><th>발전기</th><th class="n">출력 (MW)</th><th class="n">해금</th><th>보조 자원</th></tr>
          </thead>
          <tbody>
            {generators.map((g) => (
              <tr>
                <td>
                  {g.ko} <span class="en">{g.en}</span>
                  {g.powerGenMW == null && <span class="rownote">간헐천 순도에 따라 달라 배포 데이터에 값이 없습니다</span>}
                </td>
                <td class="n">{or(g.powerGenMW)}</td>
                <td class="n">{tierOf(g.unlockTier)}</td>
                <td class="small muted">
                  {g.supplementalToPowerRatio ? `비율 ${g.supplementalToPowerRatio}` : DASH}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <p class="marker"><span class="num">05</span> 전력 소비</p>
      <h2>전력을 쓰는 건물 <span class="n">{consumers.length}</span>개</h2>
      <div class="scroll-x" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>건물</th>
              <th>분류</th>
              <th class="n">전력 (MW)</th>
              <th>건설 비용</th>
            </tr>
          </thead>
          <tbody>
            {consumersByTier.map((g) => (
              <>
                <tr class="tier-row">
                  <th colspan="5" scope="colgroup">
                    {g.tier < 0 ? '허브' : `티어 ${g.tier}`}
                  </th>
                </tr>
                {g.list.map((b) => (
              <tr>
                <td>{b.ko} <span class="en">{b.en}</span></td>
                <td class="small muted nowrap">{CATEGORY_KO[b.category ?? 'other'] ?? b.category}</td>
                <td class="n">
                  {b.powerIsVariable
                    ? `${num(b.powerMinMW ?? 0)}~${num(b.powerMaxMW ?? 0)}`
                    : or(b.powerMW)}
                </td>
                <td>
                  {b.buildCost.length > 0
                    ? b.buildCost.map((c) => (
                        <span class="chip">{item(c.item).ko} <span class="n">{c.amount}</span></span>
                      ))
                    : DASH}
                </td>
              </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <p class="caption">
        해금 티어순입니다. 클럭 100% 기준이고, 오버클럭 시 전력은 지수(약 1.32)로 오릅니다.
        범위로 적힌 건물은 가동 상태에 따라 소비가 변합니다.
      </p>
    </section>

    <section class="section">
      <p class="marker"><span class="num">06</span> 용어집</p>
      <h2>처음 만나는 용어</h2>
      <div class="terms">
        {sortedTerms.map((t) => (
          <details class="term">
            <summary>
              <span class="term-ko">{t.term}</span>
              <span class="en">{t.en}</span>
              {t.origin && (
                <span class={`term-origin is-${t.origin}`}>{ORIGIN_KO[t.origin]}</span>
              )}
              {t.origin === 'game' && t.unlock && <span class="term-unlock">{t.unlock}</span>}
            </summary>
            <div class="term-body">
              <p class="term-lead">{t.short}</p>
              <dl class="term-rows">
                {t.gameKo && (
                  <>
                    <dt>게임 표기</dt>
                    <dd><strong>{t.gameKo}</strong>, 위 이름은 커뮤니티 통용어입니다.</dd>
                  </>
                )}
                {t.originNote && (
                  <>
                    <dt>바깥 뜻</dt>
                    <dd>{t.originNote}</dd>
                  </>
                )}
                {t.origin !== 'game' && t.unlock && (
                  <>
                    <dt>필요한 것</dt>
                    <dd>{t.unlock}</dd>
                  </>
                )}
                <dt>왜</dt>
                <dd>{t.why}</dd>
                <dt>어떻게</dt>
                <dd>{t.how}</dd>
                <dt class="is-gotcha">함정</dt>
                <dd>{t.gotcha}</dd>
              </dl>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>

  <style>
    .page { padding-block: var(--s16) 0; }
    .page-head { margin-bottom: var(--s8); }
    .page-head h1 { margin-bottom: var(--s4); }
    .lede { font-size: var(--t-body-l); color: var(--ink-2); }

    .section { padding-block: var(--s16) 0; }
    .section h2 { margin-bottom: var(--s5); }
    .section .caption { margin-top: var(--s3); max-width: var(--measure); }

    .two { display: grid; gap: var(--s6); }
    @media (min-width: 780px) { .two { grid-template-columns: 1fr 1fr; gap: var(--s8); } }

    .rownote { display: block; font-size: var(--t-caption); color: var(--ink-3); }
    .nowrap { white-space: nowrap; }
    /* 티어가 바뀌는 지점을 눈에 보이게 한다 */
    .tier-row th {
      padding-top: var(--s5);
      border-bottom: var(--hair) solid var(--line-strong);
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.1em;
      color: var(--accent);
      background: var(--bg);
    }
    tbody tr.tier-row:hover th { background: var(--bg); }
    td .chip { margin: 1px 2px 1px 0; }

    .terms { border-top: var(--hair) solid var(--line); }
    .term { border-bottom: var(--hair) solid var(--line); }
    /*
     * 열을 고정한다. flex 로 두면 용어 길이에 따라 배지가 제각각 다른 곳에 붙어
     * 훑어 읽을 수가 없다.
     */
    .term summary {
      display: grid;
      grid-template-columns: 24px minmax(0, 176px) minmax(0, 176px) 120px minmax(0, 1fr);
      align-items: baseline;
      gap: var(--s3);
      padding-block: var(--s4);
      cursor: pointer;
      list-style: none;
    }
    @media (max-width: 860px) {
      .term summary {
        grid-template-columns: 24px minmax(0, 1fr) 120px;
      }
      .term summary .en { grid-column: 2; }
      .term-unlock { grid-column: 2 / -1; }
    }
    .term summary::-webkit-details-marker { display: none; }
    .term summary::before {
      content: '+';
      font-family: var(--font-mono);
      color: var(--accent);
    }
    .term[open] summary::before { content: '−'; }
    .term-ko { font-weight: 600; }
    .term-origin {
      justify-self: start;
      text-align: center;
      padding: 0.1em 0.45em;
      border: var(--hair) solid var(--line);
      border-radius: var(--radius);
      font-size: var(--t-label);
      color: var(--ink-2);
      white-space: nowrap;
    }
    /* 실제 산업에서 그대로 쓰는 말만 강조색을 준다. 게임 밖에서도 통하는 지식이라서다 */
    .term-origin.is-industry { border-color: var(--accent); color: var(--accent); }
    .term-unlock {
      text-align: right;
      font-family: var(--font-mono);
      font-size: var(--t-caption);
      color: var(--ink-3);
    }
    .term-body { padding: 0 0 var(--s6) 40px; }
    .term-lead {
      margin-bottom: var(--s4);
      max-width: 54em;
      font-size: var(--t-body);
      font-weight: 600;
    }
    /* 라벨과 본문을 두 열로 세운다. 인라인 라벨은 본문을 라벨 밑으로 말아 넣는다 */
    .term-rows {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: var(--s3) var(--s5);
      margin: 0;
      max-width: 62em;
    }
    .term-rows dt {
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.06em;
      color: var(--ink-2);
      padding-top: 0.2em;
    }
    .term-rows dt.is-gotcha { color: var(--accent); }
    .term-rows dd { margin: 0; font-size: var(--t-small); color: var(--ink); }
    @media (max-width: 640px) {
      .term-body { padding-left: 0; }
      .term-rows { grid-template-columns: minmax(0, 1fr); gap: var(--s1) 0; }
      .term-rows dd { margin-bottom: var(--s3); }
    }
  </style>
</Base>
