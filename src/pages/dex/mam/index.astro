---
/**
 * MAM 첫 화면은 첫 연구 트리로 보낸다. 게임도 트리를 하나 고른 상태로 열린다.
 *
 * 목록의 맨 위는 「하드 드라이브」인데 그건 연구 트리가 아니라 대체 제작법 뽑기라
 * 자기 화면이 없다. 연구가 실제로 들어 있는 첫 트리로 보내야 한다.
 */
import { tech } from '../../../lib/tech';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const first = tech.mamTrees.find((t) => t.count > 0);
if (!first) throw new Error('연구가 들어 있는 MAM 트리가 없습니다');
const to = `${base}/dex/mam/${first.key}/`;
---
<meta http-equiv="refresh" content={`0; url=${to}`} />
<link rel="canonical" href={to} />
<p><a href={to}>MAM 도감으로 이동</a></p>
