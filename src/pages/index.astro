---
/**
 * 랜딩. 히어로 유형 = **체험형(Live Demo)**.
 *
 * 근거: 이 프로젝트는 후기·사용자수·로고월이 하나도 없는 개인 제작물이다.
 * 그런 경우 작동하는 위젯이 증언보다 강한 신뢰 신호다
 * (docs/research/design-landing-craft.md §3, landing-page-craft 스킬 1단계).
 *
 * 위젯 강제 요건:
 *   1. 네트워크 요청 0 — 필요한 데이터를 HTML 에 인라인한다.
 *   2. 결과에 이 앱 고유의 판단 한 줄이 붙는다(계산 결과만 뱉으면 계산기다).
 *   3. label 명시 + 결과 영역 aria-live.
 *   4. LCP 대상이 텍스트다.
 *
 * 화면의 모든 수치는 빌드 타임에 게임 데이터에서 계산한다. 마크업에 타이핑하지 않는다.
 */
import Base from '../layouts/Base.astro';
import FlowChart from '../components/FlowChart.astro';
import { building, item, meta, milestonesByTier, recipe } from '../lib/gamedata';
import spine from '../data/curated/spine.json';
import { ironLine } from '../lib/flows';
import versionHistory from '../data/curated/version-history.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/** 게임 버전은 배포 데이터에 없다. 빌드 ID 에 묶인 큐레이션 사실이라 연혁 파일이 정본이다 */
const gameVersion = versionHistory.$dataBaseline.version;

const minerMk1 = building('Build_MinerMk1_C');
const beltMk1 = building('Build_ConveyorBeltMk1_C');
const smelter = building('Build_SmelterMk1_C');
const assembler = building('Build_AssemblerMk1_C');
const coalGen = building('Build_GeneratorCoal_C');

const beltMk1Rate = beltMk1.beltItemsPerMinute ?? 60;
const coalMW = coalGen.powerGenMW ?? 75;
const coalPerGen = (coalMW / (item('Desc_Coal_C').energyMJ ?? 300)) * 60;

/** 제련기 한 대가 먹는 철광석 — 레시피에서 읽는다 */
const ironIngot = recipe('Recipe_IngotIron_C');
const smeltIn = ironIngot.ingredients[0]?.perMinute ?? 30;

/** 벨트 한 줄에 붙는 제련기 대수 — 초반 라인 크기가 여기서 정해진다 */
const smeltersPerBelt = Math.floor(beltMk1Rate / smeltIn);
const gensPerBelt = Math.floor(beltMk1Rate / coalPerGen);

/**
 * 위젯 선택지. 순서와 문구는 spine.json 이 정하고, 수치는 여기서 계산해 끼운다.
 * 인라인 스크립트로 넘기므로 순수 데이터만 담는다.
 */
const LINES: Record<string, { now: string; scale: string; keep: string }> = {
  hub: {
    now: '철 노드 옆에 허브를 놓고, 허브 6까지 민다',
    scale: '허브 6에서 바이오매스 연소기와 바이오매스 레시피가 같이 열린다 — 급유 자동화가 되는 시점이 정확히 여기다',
    keep: '이파리보다 나무를 먼저 챙긴다. 나무 하나가 바이오매스 5개, 이파리는 0.5개다',
  },
  't1-iron': {
    now: `채굴기 1대 → ${smelter.ko} ${smeltersPerBelt}대 → 제작기 4대`,
    scale: `${smelter.ko} 한 대가 철광석 ${smeltIn}개/분을 소모한다. 벨트 Mk.1 한 줄(${beltMk1Rate}개/분)이 정확히 ${smeltersPerBelt}대분이다`,
    keep: '제련기 줄 옆을 비워 둔다. 티어 2에서 조립기가 여기 붙는다',
  },
  't2-assembler': {
    now: `${assembler.ko} 2대 — 회전자용 1대, 지능형 도금판용 1대`,
    scale: '대수를 늘리는 대신 클럭을 내린다. 회전자 5개/분은 한 대의 절반이면 나온다',
    keep: '옆을 4×4 파운데이션 이상 비워 둔다. 페이즈 2가 같은 부품을 20배 요구한다',
  },
  't3-coal': {
    now: `${coalGen.ko} ${gensPerBelt}대`,
    scale: `한 대가 석탄 ${coalPerGen}개/분을 소모한다. 벨트 Mk.1 한 줄이 정확히 ${gensPerBelt}대분이다`,
    keep: '바이오매스 연소기를 철거하지 않는다. 석탄이 끊기면 그걸로 복구한다',
  },
};

const options = spine.steps.map((s) => ({
  id: s.id,
  label: s.label,
  title: s.title,
  gate: s.gateNote,
  ...(LINES[s.id] ?? { now: '', scale: '', keep: '' }),
}));

/** 랜딩에 싣는 실물 — 가이드와 같은 정의를 쓴다 */
const showcase = ironLine();

const tiers = milestonesByTier();
const laterMilestones = tiers
  .filter((t) => t.tier >= 4)
  .reduce((n, t) => n + t.list.length, 0);

const buildFacts = [
  { k: '게임 버전', v: gameVersion },
  { k: 'Steam 빌드', v: meta.game?.steamBuildId ?? '—' },
  { k: '데이터 추출', v: String(meta.generatedAt ?? '').slice(0, 10) },
  { k: '레시피', v: `${meta.counts?.recipes ?? 0}건` },
  { k: '건물', v: `${meta.counts?.buildings ?? 0}건` },
  { k: '마일스톤', v: `${meta.counts?.milestones ?? 0}건` },
];
---

<Base
  title="Satisfactory — 지금 무엇을 얼마나 지어야 하는가"
  description="해금 순서대로 안내하는 한국어 Satisfactory 플레이북. 계산기가 아니라, 지금 할 일과 남겨둘 자리를 알려줍니다."
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="n">Satisfactory {gameVersion}</span> · 한국어 플레이북
        </p>
        <h1>지금 무엇을<br />얼마나 지어야 하는가</h1>
        <p class="lede prose">
          기계 대수를 답하는 계산기는 이미 많습니다. 이 사이트는 <strong>해금 순서</strong>대로
          지금 지을 것과 <strong>비워 둘 자리</strong>를 알려줍니다.
        </p>
      </div>

      <div class="demo">
        <div class="demo-head">
          <label class="demo-label" for="step">지금 어디까지 왔나요</label>
          <select id="step" class="demo-select">
            {options.map((o, i) => (
              <option value={o.id} selected={i === 1}>{o.label} — {o.title}</option>
            ))}
          </select>
        </div>

        <dl class="demo-out" aria-live="polite" data-demo-out>
          <div class="row">
            <dt>지금 지을 것</dt>
            <dd data-f="now"></dd>
          </div>
          <div class="row">
            <dt>왜 그 규모인가</dt>
            <dd data-f="scale"></dd>
          </div>
          <div class="row is-keep">
            <dt>남겨둘 것</dt>
            <dd data-f="keep"></dd>
          </div>
        </dl>

        <p class="demo-gate"><span data-f="gate"></span></p>
      </div>

      <div class="hero-cta">
        <a class="btn is-primary" href={`${base}/guide/`}>가이드 열기</a>
        <a class="btn" href={`${base}/tools/`}>레퍼런스 표</a>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <p class="marker"><span class="num">01</span> 왜 다른가</p>
    <h2 class="prose">같은 질문에 다른 답을 냅니다</h2>
    <p class="prose muted">
      "지능형 도금판을 자동화하려고 한다"는 상황에 두 도구가 내놓는 답입니다.
    </p>

    <div class="versus">
      <article class="vs-col">
        <p class="vs-tag">계산기</p>
        <p class="vs-answer">
          지능형 도금판 <span class="n">5</span>개/분 → {assembler.ko}{' '}
          <span class="n">1.25</span>대
        </p>
        <p class="vs-note">목표 수량을 넣으면 필요한 기계 수를 돌려줍니다. 정확합니다.</p>
      </article>

      <article class="vs-col is-ours">
        <p class="vs-tag">satisfactory-ops</p>
        <p class="vs-answer">
          지금은 {assembler.ko} <span class="n">2</span>대만 짓고,
          옆을 <span class="n">4×4</span> 파운데이션 비워 두세요.
        </p>
        <p class="vs-note">
          페이즈 2가 같은 부품을 <span class="n">20</span>배 요구합니다. 지금 자리를 안 남기면
          그때 전부 뜯습니다.
        </p>
      </article>
    </div>
  </section>

  <section class="wrap section">
    <p class="marker"><span class="num">02</span> 진행 축</p>
    <h2 class="prose">해금 순서를 벗어나지 않습니다</h2>
    <p class="prose muted">
      아직 못 짓는 것을 먼저 설명하지 않습니다. 각 단계는 그 시점에 실제로 열려 있는 것만 다룹니다.
    </p>

    <ol class="spine">
      <span class="spine-rail" aria-hidden="true"></span>
      {spine.steps.map((s) => (
        <li class="spine-step">
          <span class="spine-tier n">{s.label}</span>
          <div>
            <h3>{s.title}</h3>
            <p class="caption">{s.gateNote}</p>
          </div>
        </li>
      ))}
      <li class="spine-step is-future">
        <span class="spine-tier n">티어 4–9</span>
        <div>
          <h3><span class="n">{laterMilestones}</span>개 마일스톤</h3>
          <p class="caption">해금 목록과 요구 부품만 표로 제공합니다. 진행 조언은 아직 없습니다.</p>
        </div>
      </li>
    </ol>

    <div class="showcase">
      <p class="showcase-tag">가이드가 실제로 주는 것 — 티어 1 철 라인</p>
      <FlowChart rows={showcase.rows} caption={showcase.caption} />
    </div>
  </section>

  <section class="wrap section">
    <p class="marker"><span class="num">03</span> 수치의 출처</p>
    <h2 class="prose">이 사이트의 숫자는 게임 파일에서 나옵니다</h2>

    <div class="facts">
      {buildFacts.map((f) => (
        <div class="fact">
          <span class="fact-k">{f.k}</span>
          <span class="fact-v n">{f.v}</span>
        </div>
      ))}
    </div>
    <p class="caption facts-note">
      화면에 손으로 옮겨 적은 수치가 없습니다. 게임이 갱신되면 데이터를 다시 뽑고, 검증에 실패하면
      빌드가 멈춥니다.
    </p>
  </section>

  <section class="final">
    <div class="wrap final-inner">
      <h2>지금 어디까지 왔든, 다음 한 단계</h2>
      <a class="btn is-primary" href={`${base}/guide/`}>가이드 열기</a>
    </div>
  </section>

  <script is:inline define:vars={{ options }}>
    (function () {
      var out = document.querySelector('[data-demo-out]');
      var gate = document.querySelector('[data-f="gate"]');
      var sel = document.getElementById('step');
      if (!out || !sel) return;
      var byId = {};
      options.forEach(function (o) {
        byId[o.id] = o;
      });
      function render(id) {
        var o = byId[id];
        if (!o) return;
        ['now', 'scale', 'keep'].forEach(function (k) {
          var el = out.querySelector('[data-f="' + k + '"]');
          if (el) el.textContent = o[k];
        });
        if (gate) gate.textContent = o.gate || '';
      }
      sel.addEventListener('change', function () {
        render(sel.value);
      });
      render(sel.value);
    })();
  </script>

  <style>
    .hero {
      border-bottom: var(--hair) solid var(--line);
      padding-block: var(--s16);
    }
    .hero-inner {
      display: grid;
      gap: var(--s10);
    }
    @media (min-width: 940px) {
      .hero {
        padding-block: var(--s24) var(--s20);
      }
      .hero-inner {
        grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
        grid-template-areas: 'copy demo' 'cta demo';
        align-items: start;
        column-gap: var(--s16);
        row-gap: var(--s8);
      }
      .hero-copy {
        grid-area: copy;
      }
      .demo {
        grid-area: demo;
      }
      .hero-cta {
        grid-area: cta;
      }
    }

    .eyebrow {
      margin-bottom: var(--s4);
      font-family: var(--font-mono);
      font-size: var(--t-caption);
      letter-spacing: 0.08em;
      color: var(--ink-2);
    }
    .hero h1 {
      font-size: var(--t-display);
      line-height: 1.14;
      margin-bottom: var(--s6);
    }
    .lede {
      font-size: var(--t-body-l);
      color: var(--ink-2);
      margin-bottom: 0;
    }
    .lede strong {
      color: var(--ink);
      font-weight: 600;
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s3);
    }

    .demo {
      border: var(--hair) solid var(--line-strong);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .demo-head {
      padding: var(--s4) var(--s5);
      border-bottom: var(--hair) solid var(--line);
    }
    .demo-label {
      display: block;
      margin-bottom: var(--s2);
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .demo-select {
      width: 100%;
      padding: var(--s2) var(--s3);
      border: var(--hair) solid var(--line-strong);
      border-radius: var(--radius);
      background: var(--bg);
      color: var(--ink);
      font: inherit;
      font-size: var(--t-small);
      font-weight: 600;
    }
    .demo-out {
      margin: 0;
      padding: var(--s2) var(--s5) var(--s4);
    }
    .demo-out .row {
      padding-block: var(--s3);
      border-bottom: var(--hair) solid var(--line);
    }
    .demo-out .row:last-child {
      border-bottom: 0;
    }
    .demo-out dt {
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.08em;
      color: var(--ink-3);
      margin-bottom: var(--s1);
    }
    .demo-out dd {
      margin: 0;
      font-size: var(--t-small);
      line-height: 1.6;
    }
    .demo-out .is-keep dt {
      color: var(--accent);
    }
    .demo-out .is-keep dd {
      font-weight: 600;
    }
    .demo-gate {
      margin: 0;
      padding: var(--s3) var(--s5);
      border-top: var(--hair) solid var(--line);
      background: var(--raised);
      font-size: var(--t-caption);
      color: var(--ink-2);
      border-radius: 0 0 var(--radius) var(--radius);
    }

    .section {
      padding-block: var(--s20) 0;
    }
    .section h2 {
      margin-bottom: var(--s3);
    }
    .section > .muted {
      margin-bottom: var(--s8);
    }

    .versus {
      display: grid;
      gap: var(--hair);
      background: var(--line);
      border: var(--hair) solid var(--line);
    }
    @media (min-width: 780px) {
      .versus {
        grid-template-columns: 1fr 1fr;
      }
    }
    .vs-col {
      background: var(--bg);
      padding: var(--s6);
    }
    .vs-col.is-ours {
      background: var(--surface);
    }
    .vs-tag {
      margin-bottom: var(--s4);
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .is-ours .vs-tag {
      color: var(--accent);
    }
    .vs-answer {
      font-size: var(--t-body-l);
      font-weight: 600;
      line-height: 1.5;
      margin-bottom: var(--s3);
    }
    .vs-note {
      margin: 0;
      font-size: var(--t-small);
      color: var(--ink-2);
    }

    /*
     * 진행 축 레일. 스크롤에 따라 채워진다 — 이 사이트에서 유일한 '볼거리' 모션이고,
     * 장식이 아니라 진행 자체를 나타낸다. 미지원 브라우저(Firefox 156 미만 등)에서는
     * 레일이 그냥 회색 선으로 남는다. 내용은 그대로다.
     */
    .spine {
      position: relative;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .spine-rail {
      position: absolute;
      left: 2.55rem;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--line);
      pointer-events: none;
    }
    .spine-rail::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--accent);
      transform-origin: top;
      transform: scaleY(0.06);
    }
    @supports (animation-timeline: view()) {
      .spine-rail::after {
        animation: rail-grow linear both;
        animation-timeline: view();
        animation-range: cover 12% cover 78%;
      }
      @keyframes rail-grow {
        from { transform: scaleY(0.06); }
        to { transform: scaleY(1); }
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .spine-rail::after { animation: none; transform: scaleY(1); }
    }
    .spine-step {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: var(--s5);
      padding-block: var(--s5);
      border-top: var(--hair) solid var(--line);
    }
    .spine-step:last-child {
      border-bottom: var(--hair) solid var(--line);
    }
    .spine-step > div { min-width: 0; }
    .spine-tier {
      position: relative;
      font-size: var(--t-caption);
      color: var(--accent);
      padding-top: 0.35em;
      letter-spacing: 0;
    }
    .spine-tier::after {
      content: '';
      position: absolute;
      right: -1.02rem;
      top: 0.85em;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      outline: 3px solid var(--bg);
    }
    .spine-step.is-future .spine-tier::after { background: var(--line-strong); }
    .spine-step h3 {
      margin-bottom: var(--s1);
      font-size: var(--t-body-l);
    }

    .showcase { margin-top: var(--s10); }
    .showcase-tag {
      margin-bottom: var(--s3);
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .spine-step.is-future .spine-tier {
      color: var(--ink-3);
    }
    .spine-step.is-future h3 {
      color: var(--ink-2);
      font-weight: 600;
    }

    .facts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      gap: var(--hair);
      background: var(--line);
      border: var(--hair) solid var(--line);
    }
    .fact {
      background: var(--bg);
      padding: var(--s4) var(--s5);
    }
    .fact-k {
      display: block;
      font-size: var(--t-label);
      letter-spacing: 0.06em;
      color: var(--ink-3);
      margin-bottom: var(--s1);
    }
    .fact-v {
      font-size: var(--t-body-l);
      font-weight: 500;
    }
    .facts-note {
      margin-top: var(--s4);
      max-width: var(--measure);
    }

    .final {
      margin-top: var(--s24);
      border-top: var(--hair) solid var(--line);
      padding-block: var(--s16);
    }
    .final-inner {
      display: flex;
      flex-wrap: wrap;
