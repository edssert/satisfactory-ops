---
/**
 * 제품 랜딩.
 *
 * 도면처럼 보이는 장식은 만들지 않는다. 이 화면은 제품의 약속, 검증 과정, 데이터 범위만
 * 설명하고 실제 배치는 검증 엔진을 통과한 뒤 스튜디오에서만 렌더한다.
 */
import Base from '../layouts/Base.astro';
import '../styles/landing.css';
import { buildings, items, meta } from '../lib/gamedata';
import { drawingSupported } from '../domain/factory/specs';
import topviewAssets from '../data/curated/topview-assets.json';
import versionHistory from '../data/curated/version-history.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const gameVersion = versionHistory.$dataBaseline.version;
const itemCount = meta.counts?.items ?? items.length;
const recipeCount = meta.counts?.recipes ?? 0;
const buildingCount = meta.counts?.buildings ?? buildings.length;

const machinePortraits = topviewAssets.assets.flatMap((asset) => {
  const building = buildings.find((entry) => entry.id === asset.buildingClass);
  if (!building) return [];
  return [{
    ...building,
    drawingStatus: drawingSupported(building.id) ? '도면 검증 완료' : '포트 검증 중',
  }];
});

const itemStrip = items
  .filter((entry) => entry.kind === 'part' || entry.kind === 'resource')
  .slice(0, 36);

const workflow = [
  {
    number: '01',
    kicker: 'DEFINE',
    title: '목표를 생산 조건으로 바꿉니다',
    body: '품목과 목표량만 받지 않습니다. 사용할 제작법, 가동률, 운송 수단, 해금 상태를 한 작업 조건으로 묶습니다.',
    signal: '생산 조건 확정',
  },
  {
    number: '02',
    kicker: 'COMPOSE',
    title: '실제 공간에 설비를 놓습니다',
    body: '설비 외곽, 방향, 입·출력 포트, 파운데이션 격자를 같은 좌표계에서 다룹니다. 수량표와 배치도를 분리하지 않습니다.',
    signal: '공간 모델 생성',
  },
  {
    number: '03',
    kicker: 'ROUTE',
    title: '물류를 실제 포트까지 연결합니다',
    body: '각 구간의 품목과 처리량을 추적하고, 끊긴 연결·용량 초과·역방향 접속·배선 누락을 찾아냅니다.',
    signal: '물류 완결',
  },
  {
    number: '04',
    kicker: 'PROVE',
    title: '지을 수 있을 때만 도면을 냅니다',
    body: '충돌, 파운데이션 지지, 포트 정합, 유량 보존, 운송 용량을 통과하지 못한 안은 완성 도면으로 취급하지 않습니다.',
    signal: '발행 가능',
  },
];

const workspaces = [
  {
    index: 'A',
    title: '가이드',
    body: '현재 해금 상태에서 먼저 해야 할 일과, 다음 확장을 위해 남겨야 할 공간을 함께 봅니다.',
    href: `${base}/guide/`,
    action: '진행 경로 보기',
  },
  {
    index: 'B',
    title: '설계 스튜디오',
    body: '실제 크기의 설비와 파운데이션을 배치하고 컨베이어·파이프 연결을 검증하는 작업 공간입니다.',
    href: `${base}/planner/`,
    action: '스튜디오 열기',
  },
  {
    index: 'C',
    title: '데이터 덱스',
    body: '게임 원본에서 추출한 품목·제작법·설비·해금 관계를 한 곳에서 추적합니다.',
    href: `${base}/dex/`,
    action: '데이터 탐색하기',
  },
];
---

<Base
  title="Satisfactory 공장을 설계 가능한 시스템으로"
  description="생산 목표를 실제 공간, 물류, 검증 조건까지 연결하는 Satisfactory 공장 설계 플레이북입니다."
>
  <div class="landing-progress" aria-hidden="true"><span></span></div>

  <main class="landing-main">
    <section class="landing-hero" data-hero>
      <div class="hero-media" aria-hidden="true">
        <div class="hero-image" style={`--hero-image:url('${base}/assets/art/factory.webp')`}></div>
        <div class="hero-wash"></div>
        <div class="hero-lines"></div>
      </div>

      <div class="landing-shell hero-layout">
        <div class="hero-message">
          <p class="landing-kicker"><span></span> FACTORY OPERATIONS / {gameVersion}</p>
          <h1 data-split-title>
            <span>계산이 끝난 곳에서</span>
            <em>설계가 시작됩니다</em>
          </h1>
          <p class="hero-lede">
            생산량 표를 실제 공장으로 옮기는 순간 생기는 문제까지 다룹니다.
            공간, 토대, 포트, 물류 중 하나라도 성립하지 않으면 완성된 도면으로 내보내지 않습니다.
          </p>
          <div class="hero-actions">
            <a class="landing-button is-primary" href={`${base}/planner/`}>
              설계 스튜디오 열기 <span aria-hidden="true">↗</span>
            </a>
            <a class="landing-button is-quiet" href={`${base}/guide/start/`}>
              첫 공장부터 시작하기
            </a>
          </div>
        </div>

        <aside class="hero-proof" aria-label="제품 검증 원칙">
          <div class="proof-head">
            <p>OUTPUT CONTRACT</p>
            <span>VALIDATED ONLY</span>
          </div>
          <p class="proof-statement">보기에 그럴듯한 배치와<br />실제로 지을 수 있는 설계를<br />같은 것으로 취급하지 않습니다.</p>
          <dl class="proof-list">
            <div><dt>공간</dt><dd>실제 크기 · 회전 · 충돌</dd></div>
            <div><dt>연결</dt><dd>입출력 포트 · 방향 · 매체</dd></div>
            <div><dt>물류</dt><dd>컨베이어 · 파이프 · 용량</dd></div>
          </dl>
          <div class="proof-seal"><span aria-hidden="true"></span> 검증 실패 시 발행 차단</div>
        </aside>
      </div>

      <div class="hero-index landing-shell" aria-label="데이터 범위">
        <div><span>ITEMS</span><strong>{itemCount.toLocaleString('ko-KR')}</strong></div>
        <div><span>RECIPES</span><strong>{recipeCount.toLocaleString('ko-KR')}</strong></div>
        <div><span>BUILDINGS</span><strong>{buildingCount.toLocaleString('ko-KR')}</strong></div>
        <p>게임 설치본 → 정규화 → 관계 검증 → 정적 발행</p>
      </div>
    </section>

    <div class="asset-ribbon" aria-hidden="true">
      <div class="asset-ribbon-track">
        {[...itemStrip, ...itemStrip].map((entry) => (
          <img src={`${base}/assets/items/${entry.id}.png`} alt="" width="42" height="42" loading="lazy" />
        ))}
      </div>
    </div>

    <section class="principle landing-shell" data-reveal>
      <div class="section-label"><span>01</span><p>PRODUCT PRINCIPLE</p></div>
      <div class="principle-copy">
        <p class="landing-kicker">FROM RATE TO REALITY</p>
        <h2>기계 수를 맞추는 것으로<br />공장 설계가 끝나지 않습니다.</h2>
      </div>
      <div class="principle-body">
        <p>
          같은 생산량이라도 포트 방향, 벨트 등급, 증설 여유, 통행 공간에 따라 전혀 다른 공장이 됩니다.
          이 제품은 계산 결과를 별도의 예쁜 그림으로 옮기지 않습니다.
        </p>
        <p>
          하나의 공장 모델에서 계산·배치·연결·검증·도면을 함께 만들기 때문에,
          화면에 보이는 설계와 실제로 검증한 설계가 어긋나지 않습니다.
        </p>
      </div>
    </section>

    <section class="workflow" data-workflow>
      <div class="landing-shell workflow-shell">
        <header class="workflow-intro">
          <div class="section-label"><span>02</span><p>ENGINEERING LOOP</p></div>
          <p class="landing-kicker">ONE MODEL / FOUR PASSES</p>
          <h2>도면 한 장이 나오기 전,<br />네 번 확인합니다.</h2>
          <p>오른쪽 단계는 장식용 공정도가 아니라 실제 설계 엔진이 책임질 검증 순서입니다.</p>
        </header>

        <div class="workflow-steps">
          {workflow.map((step, index) => (
            <article class="workflow-step" data-step={index}>
              <div class="step-top"><span>{step.number}</span><p>{step.kicker}</p></div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <footer><span aria-hidden="true"></span>{step.signal}</footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="machine-stage" data-machines>
      <div class="landing-shell machine-heading">
        <div class="section-label"><span>03</span><p>GAME-SOURCE DATA</p></div>
        <div>
          <p class="landing-kicker">THE REAL OBJECTS</p>
          <h2>설계의 재료는<br />게임 데이터에서 시작합니다.</h2>
        </div>
        <p>
          이름·크기·충돌은 게임 설치본에서, 탑뷰는 공개된 AndersPottemager 자산에서 가져옵니다.
          이미지는 표현일 뿐이며 실제 점유공간과 포트 좌표를 바꾸지 못합니다.
        </p>
      </div>
      <div class="machine-window">
        <div class="machine-rail">
          {machinePortraits.map((entry, index) => (
            <article class="machine-portrait">
              <span class="machine-no">{String(index + 1).padStart(2, '0')}</span>
              <img
                src={`${base}/assets/topview/${entry.id}.webp`}
                alt={entry.ko}
                width="320"
                height="320"
                loading="lazy"
              />
              <div>
                <h3>{entry.ko}</h3>
                <p>
                  {entry.footprint ? `${entry.footprint.widthM} × ${entry.footprint.lengthM} m` : '외곽 데이터 확인 중'}
                  {' · '}{entry.drawingStatus}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="workspaces landing-shell" data-reveal>
      <div class="workspaces-head">
        <div class="section-label"><span>04</span><p>WORKSPACES</p></div>
        <p class="landing-kicker">LEARN / DESIGN / VERIFY</p>
        <h2>읽고 끝나는 가이드가 아니라<br />결정을 이어가는 작업 공간입니다.</h2>
      </div>
      <div class="workspace-list">
        {workspaces.map((space) => (
          <a href={space.href} class="workspace-card">
            <span class="workspace-index">{space.index}</span>
            <div><h3>{space.title}</h3><p>{space.body}</p></div>
            <strong>{space.action} <span aria-hidden="true">↗</span></strong>
          </a>
        ))}
      </div>
    </section>

    <section class="landing-close" data-close>
      <div class="close-media" style={`--close-image:url('${base}/assets/art/factory.webp')`} aria-hidden="true"></div>
      <div class="landing-shell close-inner">
        <p class="landing-kicker">BUILD WITH EVIDENCE</p>
        <h2>다음 공장은<br />뜯어고칠 필요 없이.</h2>
        <p>진행 단계에서 시작해, 검증 가능한 공장 모델로 끝내세요.</p>
        <div class="hero-actions">
          <a class="landing-button is-primary" href={`${base}/guide/`}>가이드에서 시작하기 <span aria-hidden="true">↗</span></a>
          <a class="landing-button is-quiet" href={`${base}/dex/`}>게임 데이터 살펴보기</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { SplitText } from 'gsap/SplitText';

    gsap.registerPlugin(ScrollTrigger, SplitText);

    const media = gsap.matchMedia();
    media.add(
      {
        desktop: '(min-width: 960px)',
        reduce: '(prefers-reduced-motion: reduce)',
      },
      (context: gsap.Context) => {
        const { desktop = false, reduce = false } = (context.conditions ?? {}) as Record<string, boolean>;
        if (reduce) return;

        gsap.to('.landing-progress span', {
          scaleX: 1,
          ease: 'none',
          scrollTrigger: { start: 0, end: 'max', scrub: 0.2 },
        });

        const title = new SplitText('[data-split-title]', { type: 'lines', linesClass: 'hero-line' });
        gsap.from(title.lines, {
          yPercent: 112,
          opacity: 0,
          rotate: 1.5,
          stagger: 0.11,
          duration: 1.05,
          ease: 'power4.out',
          delay: 0.12,
        });
        gsap.from('.hero-lede, .hero-actions, .hero-proof, .hero-index', {
          y: 28,
          opacity: 0,
          stagger: 0.1,
          duration: 0.85,
          ease: 'power3.out',
          delay: 0.35,
        });
        gsap.to('.hero-image', {
          yPercent: 14,
          scale: 1.12,
          ease: 'none',
          scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true },
        });

        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((section) => {
          gsap.from(section.children, {
            y: 56,
            opacity: 0,
            stagger: 0.12,
            duration: 0.9,
            ease: 'power3.out',
            scrollTrigger: { trigger: section, start: 'top 78%', once: true },
          });
        });

        gsap.utils.toArray<HTMLElement>('.workflow-step').forEach((step, index) => {
          gsap.from(step, {
            scale: index % 2 === 0 ? 0.975 : 0.965,
            opacity: 0,
            transformOrigin: '50% 100%',
            duration: 0.85,
            ease: 'power3.out',
            scrollTrigger: { trigger: step, start: 'top 84%', once: true },
          });
        });

        if (desktop) {
          const rail = document.querySelector<HTMLElement>('.machine-rail');
          const windowElement = document.querySelector<HTMLElement>('.machine-window');
          if (rail && windowElement) {
            gsap.to(rail, {
              x: () => Math.min(0, window.innerWidth - rail.scrollWidth - 48),
              ease: 'none',
              scrollTrigger: {
                trigger: '[data-machines]',
                start: 'top top',
                end: () => `+=${Math.max(window.innerWidth, rail.scrollWidth - window.innerWidth)}`,
                pin: true,
                scrub: 0.55,
                invalidateOnRefresh: true,
              },
            });
          }
        }

        gsap.to('.close-media', {
          scale: 1.08,
          ease: 'none',
          scrollTrigger: { trigger: '[data-close]', start: 'top bottom', end: 'bottom top', scrub: true },
        });

        return () => title.revert();
      },
    );
  </script>
</Base>
