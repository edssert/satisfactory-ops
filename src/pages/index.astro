---
/**
 * 랜딩.
 *
 * 시각 방향: 게임 실물(공식 키 아트) 위에 유리 계층. 효과는 Magic UI 가 정착시킨 것들을
 * CSS 로 옮겨 썼다(`src/styles/fx.css`) — Border Beam · Retro Grid · Dot Pattern ·
 * Shimmer · Gradient Text · Number Ticker.
 *
 * 히어로는 **체험형**이다. 후기도 사용자수도 없는 개인 제작물에서는 작동하는 위젯이
 * 가장 강한 신뢰 신호다. 데이터를 HTML 에 인라인해 네트워크 요청이 0 이다.
 *
 * 화면의 모든 수치는 빌드 타임에 게임 데이터에서 계산한다.
 */
import Base from '../layouts/Base.astro';
import FlowChart from '../components/FlowChart.astro';
import '../styles/fx.css';
import '../styles/landing.css';
import { building, buildings, item, items, meta, milestonesByTier, recipe } from '../lib/gamedata';
import { ironLine } from '../lib/flows';
import spine from '../data/curated/spine.json';
import versionHistory from '../data/curated/version-history.json';
import priority from '../data/curated/alternate-priority.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const gameVersion = versionHistory.$dataBaseline.version;

const beltMk1 = building('Build_ConveyorBeltMk1_C');
const smelter = building('Build_SmelterMk1_C');
const assembler = building('Build_AssemblerMk1_C');
const coalGen = building('Build_GeneratorCoal_C');

const beltMk1Rate = beltMk1.beltItemsPerMinute ?? 60;
const coalPerGen = ((coalGen.powerGenMW ?? 75) / (item('Desc_Coal_C').energyMJ ?? 300)) * 60;
const smeltIn = recipe('Recipe_IngotIron_C').ingredients[0]?.perMinute ?? 30;
const smeltersPerBelt = Math.floor(beltMk1Rate / smeltIn);
const gensPerBelt = Math.floor(beltMk1Rate / coalPerGen);

const LINES: Record<string, { now: string; scale: string; keep: string }> = {
  hub: {
    now: '철 노드 옆에 허브를 놓고, 허브 6까지 민다',
    scale:
      '허브 6에서 바이오매스 연소기와 바이오매스 레시피가 같이 열린다 — 급유 자동화가 되는 시점이 정확히 여기다',
    keep: '이파리보다 나무를 먼저 챙긴다. 나무 하나가 바이오매스 5개, 이파리는 0.5개다',
  },
  't1-iron': {
    now: `채굴기 1대 → ${smelter.ko} ${smeltersPerBelt}대 → 제작기 4대`,
    scale: `${smelter.ko} 한 대가 철광석 ${smeltIn}개/분을 소모한다. 벨트 Mk.1 한 줄(${beltMk1Rate}개/분)이 정확히 ${smeltersPerBelt}대분이다`,
    keep: '제련기 줄 옆을 비워 둔다. 티어 2에서 조립기가 여기 붙는다',
  },
  't2-assembler': {
    now: `${assembler.ko} 2대 — 회전자용 1대, 지능형 도금판용 1대`,
    scale: '대수를 늘리는 대신 클럭을 내린다. 회전자 5개/분은 한 대의 절반이면 나온다',
    keep: '옆을 4×4 파운데이션 이상 비워 둔다. 페이즈 2가 같은 부품을 20배 요구한다',
  },
  't3-coal': {
    now: `${coalGen.ko} ${gensPerBelt}대`,
    scale: `한 대가 석탄 ${coalPerGen}개/분을 소모한다. 벨트 Mk.1 한 줄이 정확히 ${gensPerBelt}대분이다`,
    keep: '바이오매스 연소기를 철거하지 않는다. 석탄이 끊기면 그걸로 복구한다',
  },
};

const options = spine.steps.map((s) => ({
  id: s.id,
  label: s.label,
  title: s.title,
  gate: s.gateNote,
  ...(LINES[s.id] ?? { now: '', scale: '', keep: '' }),
}));

const showcase = ironLine();

const tiers = milestonesByTier();
const laterMilestones = tiers.filter((t) => t.tier >= 4).reduce((n, t) => n + t.list.length, 0);

/** 아이콘 띠 — 이 앱이 아는 것의 규모를 말이 아니라 실물로 보여준다 */
const stripIcons = items
  .filter((i) => i.kind === 'part' || i.kind === 'resource')
  .slice(0, 44)
  .map((i) => i.id);

const altCount = (priority as unknown as { recipes: unknown[] }).recipes.length;

/**
 * 기계 전시 — 세로로 스크롤하면 가로로 흘러간다.
 * 게임이 준 렌더를 그대로 쓴다. 해금 티어순으로 늘어놓아 진행 순서가 그대로 보인다.
 */
const gallery = buildings
  .filter((b) => ['manufacturer', 'generator', 'extractor'].includes(b.category ?? ''))
  .sort((a, b) => (a.unlockTier ?? -1) - (b.unlockTier ?? -1) || (a.powerMW ?? 0) - (b.powerMW ?? 0));

const facts = [
  { k: '레시피', v: meta.counts?.recipes ?? 0 },
  { k: '건물', v: meta.counts?.buildings ?? 0 },
  { k: '대체 제작법 등급', v: altCount },
  { k: '자원 노드', v: meta.counts?.resourceNodes ?? 0 },
];
---

<Base
  title="Satisfactory — 지금 무엇을 얼마나 지어야 하는가"
  description="해금 순서대로 안내하는 한국어 Satisfactory 플레이북. 계산기가 아니라, 지금 할 일과 남겨둘 자리를 알려줍니다."
>
  <section class="hero" style={`--hero-art:url('${base}/assets/art/keyart.webp')`}>
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="fx-retrogrid" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="dot" aria-hidden="true"></span>
          <span class="n">Satisfactory {gameVersion}</span>
        </p>
        <h1>
          지금 무엇을<br />
          <span class="fx-gradient-text">얼마나 지어야 하는가</span>
        </h1>
        <p class="lede">
          기계 대수를 답하는 계산기는 이미 많습니다.<br />
          이 사이트는 <strong>해금 순서</strong>대로 지금 지을 것과
          <strong>비워 둘 자리</strong>를 알려줍니다.
        </p>
      </div>

      <div class="demo fx-beam">
        <div class="demo-head">
          <label class="demo-label" for="step">지금 어디까지 왔나요</label>
          <select id="step" class="demo-select">
            {options.map((o, i) => (
              <option value={o.id} selected={i === 1}>{o.label} — {o.title}</option>
            ))}
          </select>
        </div>
        <dl class="demo-out" aria-live="polite" data-demo-out>
          <div class="row"><dt>지금 지을 것</dt><dd data-f="now"></dd></div>
          <div class="row"><dt>왜 그 규모인가</dt><dd data-f="scale"></dd></div>
          <div class="row is-keep"><dt>남겨둘 것</dt><dd data-f="keep"></dd></div>
        </dl>
        <p class="demo-gate"><span data-f="gate"></span></p>
      </div>

      <div class="hero-cta">
        <a class="btn is-primary fx-shimmer" href={`${base}/guide/`}>가이드 열기</a>
        <a class="btn" href={`${base}/builder/`}>직접 만들어 보기</a>
      </div>
    </div>
  </section>

  <div class="strip" aria-hidden="true">
    <div class="strip-track">
      {[...stripIcons, ...stripIcons].map((id) => (
        <img src={`${base}/assets/items/${id}.png`} alt="" width="34" height="34" loading="lazy" />
      ))}
    </div>
  </div>

  <section class="wrap section reveal">
    <p class="marker"><span class="num">01</span> 왜 다른가</p>
    <h2 class="prose">같은 질문에 다른 답을 냅니다</h2>
    <p class="prose muted">
      "지능형 도금판을 자동화하려고 한다"는 상황에 두 도구가 내놓는 답입니다.
    </p>

    <div class="versus">
      <article class="vs-col">
        <p class="vs-tag">계산기</p>
        <p class="vs-answer">
          지능형 도금판 <span class="n">5</span>개/분 → {assembler.ko}{' '}
          <span class="n">1.25</span>대
        </p>
        <p class="vs-note">목표 수량을 넣으면 필요한 기계 수를 돌려줍니다. 정확합니다.</p>
      </article>

      <article class="vs-col is-ours fx-beam">
        <p class="vs-tag">satisfactory-ops</p>
        <p class="vs-answer">
          지금은 {assembler.ko} <span class="n">2</span>대만 짓고, 옆을{' '}
          <span class="n">4×4</span> 파운데이션 비워 두세요.
        </p>
        <p class="vs-note">
          페이즈 2가 같은 부품을 <span class="n">20</span>배 요구합니다. 지금 자리를 안 남기면
          그때 전부 뜯습니다.
        </p>
      </article>
    </div>
  </section>

  <section class="wrap section reveal">
    <p class="marker"><span class="num">02</span> 진행 축</p>
    <h2 class="prose">해금 순서를 벗어나지 않습니다</h2>
    <p class="prose muted">
      아직 못 짓는 것을 먼저 설명하지 않습니다. 각 단계는 그 시점에 실제로 열려 있는 것만 다룹니다.
    </p>

    <ol class="spine">
      <span class="spine-rail" aria-hidden="true"></span>
      {spine.steps.map((s) => (
        <li class="spine-step">
          <span class="spine-tier n">{s.label}</span>
          <div>
            <h3>{s.title}</h3>
            <p class="caption">{s.gateNote}</p>
          </div>
        </li>
      ))}
      <li class="spine-step is-future">
        <span class="spine-tier n">티어 4–9</span>
        <div>
          <h3><span class="n">{laterMilestones}</span>개 마일스톤</h3>
          <p class="caption">해금 목록과 요구 부품만 표로 제공합니다. 진행 조언은 아직 없습니다.</p>
        </div>
      </li>
    </ol>

    <div class="showcase">
      <p class="showcase-tag">가이드가 실제로 주는 것 — 티어 1 철 라인</p>
      <FlowChart rows={showcase.rows} caption={showcase.caption} />
    </div>
  </section>

  <section class="gallery">
    <div class="wrap gallery-head">
      <p class="marker"><span class="num">02-b</span> 설비</p>
      <h2>해금 순서대로 늘어놓은 <span class="n">{gallery.length}</span>대</h2>
      <p class="caption">스크롤하면 옆으로 흘러갑니다. 게임이 주는 렌더 그대로입니다.</p>
    </div>
    <div class="gallery-viewport">
      <div class="gallery-track">
        {gallery.map((b) => (
          <article class="machine">
            <img
              src={`${base}/assets/buildings-png/${b.id}.png`}
              alt={b.ko}
              width="104"
              height="104"
              loading="lazy"
            />
            <p class="machine-name">{b.ko}</p>
            <p class="machine-meta">
              <span class="machine-tier">{b.unlockTier == null ? '허브' : `티어 ${b.unlockTier}`}</span>
              {b.powerMW != null && ` · ${b.powerMW} MW`}
              {b.powerGenMW != null && ` · +${b.powerGenMW} MW`}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section reveal">
    <p class="marker"><span class="num">03</span> 수치의 출처</p>
    <h2 class="prose">이 사이트의 숫자는 게임 파일에서 나옵니다</h2>

    <div class="facts">
      {facts.map((f) => (
        <div class="fact">
          <span class="fact-k">{f.k}</span>
          <span class="fact-v n">
            <span class="fx-ticker" style={`--to:${f.v}`}></span>
            <span class="fx-ticker-fallback">{f.v}</span>
          </span>
        </div>
      ))}
    </div>
    <p class="caption facts-note prose">
      화면에 손으로 옮겨 적은 수치가 없습니다. 게임이 갱신되면 데이터를 다시 뽑고, 검증에
      실패하면 빌드가 멈춥니다. 대체 제작법 등급은 남의 순위를 옮긴 것이 아니라{' '}
      <span class="n">{gameVersion}</span> 데이터로 직접 계산했습니다.
    </p>
  </section>

  <section class="final" style={`--final-art:url('${base}/assets/art/factory.webp')`}>
    <div class="final-art" aria-hidden="true"></div>
    <div class="final-scrim" aria-hidden="true"></div>
    <div class="fx-dots" aria-hidden="true"></div>
    <div class="wrap final-inner">
      <h2>지금 어디까지 왔든, 다음 한 단계</h2>
      <a class="btn is-primary fx-shimmer" href={`${base}/guide/`}>가이드 열기</a>
    </div>
  </section>

  <script is:inline define:vars={{ options }}>
    (function () {
      var out = document.querySelector('[data-demo-out]');
      var gate = document.querySelector('[data-f="gate"]');
      var sel = document.getElementById('step');
      if (!out || !sel) return;
      var byId = {};
      options.forEach(function (o) {
        byId[o.id] = o;
      });
      function render(id) {
        var o = byId[id];
        if (!o) return;
        ['now', 'scale', 'keep'].forEach(function (k) {
          var el = out.querySelector('[data-f="' + k + '"]');
          if (el) el.textContent = o[k];
        });
        if (gate) gate.textContent = o.gate || '';
      }
      sel.addEventListener('change', function () {
        render(sel.value);
      });
      render(sel.value);
    })();
  </script>
</Base>
