---
/**
 * F13 공장 설계 도면 (P1 — 단층).
 *
 * 계산기가 기계 대수까지 알려준다면, 여기는 **그 기계를 어디에 어떻게 놓을지**를 도면으로 낸다.
 * 치수는 게임 충돌 박스, 분배 방식은 벨트 용량 판정, 경계는 블루프린트 디자이너 규격에서 온다.
 */
import Base from '../../layouts/Base.astro';
import LayoutPlan from '../../components/LayoutPlan.tsx';
import {
  calculatorRecipes,
  findBuilding,
  findItem,
  logistics,
  nameOf,
  producerIndexOf,
} from '../../lib/gamedata';
import { DESIGNERS, TILE_M } from '../../lib/layout';
import type { SolverRecipe } from '../../lib/solver';

const usable = calculatorRecipes();
const producers = producerIndexOf(usable);

const payload: SolverRecipe[] = usable.map((r) => ({
  id: r.id,
  ko: r.ko,
  en: r.en,
  durationSec: r.durationSec,
  ingredients: r.ingredients,
  products: r.products,
  producedIn: r.producedIn,
}));

const names: Record<string, { ko: string; en: string }> = {};
const fluids: Record<string, boolean> = {};
for (const r of usable) {
  for (const g of [...r.ingredients, ...r.products]) {
    names[g.item] = nameOf(g.item);
    fluids[g.item] = !!findItem(g.item)?.isFluid;
  }
}

const machineIds = new Set(usable.flatMap((r) => r.producedIn));
const machines = [...machineIds].map((id) => {
  const b = findBuilding(id);
  return {
    id,
    ko: b?.ko ?? id,
    en: b?.en ?? id,
    powerMW: b?.powerMW ?? null,
    footprint: b?.footprint ?? null,
  };
});

const belts = logistics().belts.map((b) => ({
  ko: b.ko,
  perMinute: b.beltItemsPerMinute!,
  tier: b.unlockTier,
}));

const targets = Object.keys(producers)
  .map((id) => ({ id, ...nameOf(id) }))
  .sort((a, b) => a.ko.localeCompare(b.ko, 'ko'));

// 도면이 없는 건물은 배치할 수 없다 — 데이터 상태를 화면에 정직하게 표기한다
const missingFootprint = machines.filter((m) => !m.footprint).length;
---

<Base
  title="공장 설계 도면 — satisfactory-ops"
  description="생산 목표를 넣으면 8m 파운데이션 격자 위의 실제 배치 도면을 만듭니다. 건물 치수는 게임 데이터의 충돌 박스에서, 분배 방식은 벨트 용량 판정에서 나옵니다."
>
  <div class="wrap page">
    <header class="page-head">
      <p class="section-label"><span class="num">F13</span> 공장 설계 도면</p>
      <h1>어디에 어떻게 놓을지까지</h1>
      <p class="prose">
        계산기는 "제작기 <span class="n">4.5</span>대"까지 알려줍니다. 이 화면은 그 기계를
        <strong>8m 파운데이션 격자 위 어디에 놓고, 벨트를 어떻게 흘리고, 블루프린트 한 장에 들어가는지</strong>까지
        냅니다. 모든 치수는 게임 데이터의 충돌 박스에서 계산합니다 — 사람이 잰 값이 아닙니다.
      </p>
      <p class="caption">
        지금은 <strong>단층</strong>까지입니다. 층 분리·유체 양정·리프트는 다음 단계이고, 그때까지는 해당 조건을
        경고로만 알려줍니다. 계획은 <code>docs/FRD.md</code> F13에 단계별로 적혀 있습니다.
      </p>
    </header>

    <LayoutPlan
      client:load
      targets={targets}
      recipes={payload}
      machines={machines}
      names={names}
      producers={producers}
      fluids={fluids}
      belts={belts}
      defaultTarget="Desc_IronPlateReinforced_C"
    />

    <section class="section">
      <p class="section-label"><span class="num">기준</span> 이 도면이 지키는 규격</p>
      <div class="kv">
        <div>
          <span class="k">격자</span>
          <span class="v">
            파운데이션 <span class="n">{TILE_M}</span> × <span class="n">{TILE_M}</span> m. 월드 스냅은 수평 8m
            / 수직 1m입니다.
          </span>
        </div>
        <div>
          <span class="k">건물 치수</span>
          <span class="v">
            게임 데이터 <code>mClearanceData</code>의 충돌 박스 <strong>전부의 합집합</strong>. 박스가 여러 개인
            건물이 많아 하나만 읽으면 틀립니다.
          </span>
        </div>
        <div>
          <span class="k">블루프린트</span>
          <span class="v">
            {DESIGNERS.map((d, i) => (
              <span>
                {i > 0 && ' · '}Mk.{d.mk} <span class="n">{d.innerM}</span>m (티어 {d.tier})
              </span>
            ))}
          </span>
        </div>
        <div>
          <span class="k">분배 방식</span>
          <span class="v">
            총 소요가 벨트 한 줄 용량을 넘으면 <strong>매니폴드를 제안하지 않습니다</strong>. 끝단 기계가 영구히
            굶기 때문입니다. 그 경우 인젝티드 매니폴드나 벨트 등급 상향을 제시합니다.
          </span>
        </div>
        {
          missingFootprint > 0 && (
            <div>
              <span class="k">치수 없음</span>
              <span class="v">
                생산 건물 <span class="n">{missingFootprint}</span>개는 치수 데이터가 없어 배치할 수 없습니다.
              </span>
            </div>
          )
        }
      </div>
      <p class="footnote">
        근거: <code>docs/research/layout.md</code>(격자·패턴) ·
        <code>layout-design-tools.md</code>(도구 조사·치수 추출) ·
        <code>layout-expert-techniques.md</code>(분배 판정·1.2 변경). 명세는 <code>docs/FRD.md</code> F13.
      </p>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: var(--s12);
  }
  .page-head h1 {
    margin-bottom: var(--s4);
  }
</style>
