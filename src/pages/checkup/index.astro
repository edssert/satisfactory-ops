---
/**
 * 공장 진단 — 세이브를 읽어 「지금 뭐가 문제인가」를 답한다.
 *
 * 이 앱은 "지금 뭘 해야 하는지"를 알려 주기로 했다. 가이드는 마일스톤 단위로 그걸 답하는데,
 * 정작 이미 지어 둔 공장에 대해서는 답하지 못했다.
 *
 * 그런데 세이브에 답이 들어 있다 — 게임이 설비마다 직전 5분의 가동률을 적어 둔다.
 * 가동률이 낮은 설비가 병목이고, 그게 지금 손대야 할 자리다. 벨트 연결까지 따라가면
 * 그 설비가 굶는지 막혔는지도 갈린다. 둘은 대처가 정반대다.
 *
 * 세이브 파일을 서버로 보내지 않는다(CLAUDE.md). 전부 브라우저 안에서 끝난다.
 * 파서는 2.6MB 라 파일을 고른 뒤에야 내려받는다.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/fx.css';
import catalog from '../../data/app/checkup-catalog.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="공장 진단 — 지금 뭐가 막혀 있나"
  description="인게임 세이브를 읽어 병목·정전 위험·끊긴 라인을 짚어 줍니다. 파일은 브라우저 밖으로 나가지 않습니다."
  section="checkup"
>
  <div class="wrap page">
    <header class="page-head">
      <p class="marker"><span class="num">진단</span></p>
      <h1>지금 <span class="fx-gradient-text">뭐가 막혀 있나</span></h1>
      <p class="lede prose">
        인게임 세이브를 열면 설비마다 직전 5분 동안 실제로 몇 퍼센트나 돌았는지 읽어,
        어디가 병목인지 짚습니다.
      </p>

      <label class="pick" data-pick>
        <input type="file" accept=".sav" data-file />
        <span data-label>세이브 열기</span>
      </label>
      <p class="where">
        <code>%LOCALAPPDATA%\FactoryGame\Saved\SaveGames</code>
      </p>
      <p class="msg" data-msg hidden></p>
    </header>

    <section class="sum" data-sum hidden>
      <dl>
        <div><dt>세이브</dt><dd data-s-name>—</dd></div>
        <div><dt>플레이</dt><dd class="n"><span data-s-hours>—</span>시간</dd></div>
        <div><dt>설비</dt><dd class="n"><span data-s-mach>—</span>대</dd></div>
        <div><dt>발전</dt><dd class="n"><span data-s-gen>—</span> MW</dd></div>
        <div><dt>평균 가동률</dt><dd class="n"><span data-s-up>—</span>%</dd></div>
      </dl>
    </section>

    <section class="finds" data-finds hidden></section>

    <template data-tpl>
      <article class="find">
        <p class="find-head">
          <span class="sev"></span>
          <b class="find-t"></b>
        </p>
        <p class="find-d"></p>
        <p class="find-f"><span class="find-flag">이렇게</span><span class="find-ftext"></span></p>
        <table class="find-rows" hidden>
          <tbody></tbody>
        </table>
      </article>
    </template>

    <p class="empty" data-empty>
      아직 세이브를 열지 않았습니다.
      <a href={`${base}/guide/`}>가이드</a>도 같은 세이브로 지금 구간을 짚어 줍니다.
    </p>
  </div>

  <script is:inline set:html={`window.__sfopsCheckup=${JSON.stringify(catalog)}`}></script>

  <script>
    import type { CheckupCatalog, FactoryModel } from '../../lib/save-factory';
    import type { Finding } from '../../lib/diagnose';

    const SEV: Record<string, string> = { stop: '멈춤', warn: '주의', info: '알림' };

    const pick = document.querySelector<HTMLInputElement>('[data-file]');
    const wrap = document.querySelector<HTMLElement>('[data-pick]');
    const label = document.querySelector<HTMLElement>('[data-label]');
    const msg = document.querySelector<HTMLElement>('[data-msg]');
    const sum = document.querySelector<HTMLElement>('[data-sum]');
    const finds = document.querySelector<HTMLElement>('[data-finds]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const tpl = document.querySelector<HTMLTemplateElement>('[data-tpl]');

    const say = (text: string) => {
      if (!msg) return;
      msg.hidden = false;
      msg.textContent = text;
    };
    const put = (sel: string, text: string) => {
      const el = document.querySelector<HTMLElement>(sel);
      if (el) el.textContent = text;
    };

    function render(model: FactoryModel, list: Finding[]) {
      if (!finds || !tpl || !sum || !empty) return;

      const measured = model.machines.filter((m) => m.uptime != null);
      const avg = measured.length
        ? Math.round(
            (measured.reduce((a, m) => a + (m.uptime ?? 0), 0) / measured.length) * 100
          )
        : 0;

      put('[data-s-name]', model.session);
      put('[data-s-hours]', String(model.hours));
      put('[data-s-mach]', String(model.machines.length));
      put('[data-s-gen]', String(model.power.genMW));
      put('[data-s-up]', String(avg));
      sum.hidden = false;
      empty.hidden = true;

      finds.replaceChildren();
      /* 같은 계열의 공통 설명은 한 번만 그린다. 항목마다 반복하면 잡음이 된다 */
      const shown = new Set<string>();
      for (const f of list) {
        if (f.basis && f.group && !shown.has(f.group)) {
          shown.add(f.group);
          const p = document.createElement('p');
          p.className = 'basis';
          p.textContent = f.basis;
          finds.append(p);
        }
        const node = tpl.content.cloneNode(true) as DocumentFragment;
        const art = node.querySelector('.find') as HTMLElement;
        art.classList.add(`is-${f.severity}`);
        (node.querySelector('.sev') as HTMLElement).textContent = SEV[f.severity] ?? f.severity;
        (node.querySelector('.find-t') as HTMLElement).textContent = f.title;
        (node.querySelector('.find-d') as HTMLElement).textContent = f.detail;
        (node.querySelector('.find-ftext') as HTMLElement).textContent = f.fix;

        const table = node.querySelector('.find-rows') as HTMLTableElement;
        if (f.rows?.length) {
          const body = table.querySelector('tbody')!;
          for (const r of f.rows) {
            const tr = document.createElement('tr');
            const th = document.createElement('th');
            th.scope = 'row';
            th.textContent = r.ko;
            const td = document.createElement('td');
            td.textContent = r.note;
            tr.append(th, td);
            body.append(tr);
          }
          table.hidden = false;
        }
        finds.append(node);
      }
      finds.hidden = false;
    }

    function runCheckup(buffer: ArrayBuffer, catalog: CheckupCatalog, fileName: string): Promise<{ model: FactoryModel; findings: Finding[] }> {
      return new Promise((resolve, reject) => {
        const worker = new Worker(new URL('../../workers/checkup.worker.ts', import.meta.url), { type: 'module' });
        const id = Date.now();
        worker.onmessage = (event: MessageEvent<{
          id: number;
          ok: boolean;
          model?: FactoryModel;
          findings?: Finding[];
          error?: string;
        }>) => {
          if (event.data.id !== id) return;
          worker.terminate();
          if (event.data.ok && event.data.model && event.data.findings) {
            resolve({ model: event.data.model, findings: event.data.findings });
          } else reject(new Error(event.data.error ?? '세이브 Worker 응답 오류'));
        };
        worker.onerror = (event) => {
          worker.terminate();
          reject(new Error(event.message || '세이브 Worker 실행 오류'));
        };
        worker.postMessage({ id, buffer, catalog, fileName }, [buffer]);
      });
    }

    pick?.addEventListener('change', async () => {
      const file = pick.files?.[0];
      if (!file || !wrap || !label) return;
      wrap.classList.add('is-busy');
      label.textContent = '읽는 중…';
      say('세이브를 읽고 있습니다. 이 브라우저 안에서만 처리합니다.');
      try {
        const cat = (window as unknown as { __sfopsCheckup: CheckupCatalog }).__sfopsCheckup;
        const { model, findings } = await runCheckup(await file.arrayBuffer(), cat, file.name);
        render(model, findings);
        say(`${model.session} · 설비 ${model.machines.length}대를 읽었습니다.`);
      } catch (err) {
        say('읽지 못했습니다 — ' + (err instanceof Error ? err.message : String(err)));
      } finally {
        wrap.classList.remove('is-busy');
        label.textContent = '세이브 열기';
        pick.value = '';
      }
    });
  </script>

  <style>
    .page { padding-block: var(--s16) var(--s20); }
    .page-head { margin-bottom: var(--s10); }
    .page-head h1 { margin-bottom: var(--s5); line-height: 1.15; }
    .lede {
      max-width: var(--measure);
      margin-bottom: var(--s6);
      color: var(--ink-2);
      font-size: var(--t-body-l);
      word-break: keep-all;
    }

    .pick {
      display: inline-block;
      padding: 9px 18px;
      border: var(--hair) solid var(--primary);
      border-radius: 4px;
      color: var(--ink);
      font-size: var(--t-body);
      cursor: pointer;
    }
    .pick:hover { background: color-mix(in oklab, var(--primary) 14%, transparent); }
    .pick.is-busy { border-color: var(--line-strong); color: var(--ink-3); cursor: progress; }
    .pick input { display: none; }

    .where { margin: 8px 0 0; color: var(--ink-2); font-size: var(--t-caption); }
    .where code { font-family: var(--font-mono); overflow-wrap: anywhere; }
    .msg { margin: 10px 0 0; color: var(--ink-2); font-size: var(--t-body-s); }

    /* 한 줄 요약 — 세이브를 제대로 읽었는지 눈으로 확인하는 자리 */
    .sum { margin-bottom: var(--s8); }
    .sum dl {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s6) var(--s10);
      margin: 0;
      padding: var(--s4) 0;
      border-block: var(--hair) solid var(--line);
    }
    .sum div { min-width: 0; }
    .sum dt { margin: 0 0 4px; color: var(--ink-2); font-size: var(--t-caption); }
    .sum dd { margin: 0; color: var(--ink); font-size: var(--t-body-l); }
    .sum .n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

    .finds { display: grid; gap: var(--s4); }

    .find {
      padding: var(--s4) var(--s5);
      border-left: 2px solid var(--line-strong);
      background: var(--surface);
    }
    .find.is-stop { border-left-color: var(--danger); }
    .find.is-warn { border-left-color: var(--accent); }

    .find p { margin: 0 0 8px; word-break: keep-all; }
    .find p:last-child { margin-bottom: 0; }

    .find-head {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      align-items: baseline;
    }
    .sev {
      padding: 2px 8px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 3px;
      color: var(--ink-2);
      font-size: var(--t-caption);
      white-space: nowrap;
    }
    .is-stop .sev { border-color: var(--danger); color: var(--danger); }
    .is-warn .sev { border-color: var(--accent); color: var(--accent-ink); }
    .find-t { flex: 1; min-width: 0; color: var(--ink); font-size: var(--t-body-l); }

    .find-d { color: var(--ink-2); font-size: var(--t-body-s); line-height: 1.75; }

    .find-f { display: flex; gap: 9px; align-items: baseline; }
    .find-flag {
      color: var(--ink-3);
      font-size: var(--t-caption);
      white-space: nowrap;
    }
    .find-ftext { flex: 1; min-width: 0; color: var(--ink); font-size: var(--t-body-s); line-height: 1.75; }

    .find-rows {
      width: 100%;
      margin-top: var(--s3);
      border-collapse: collapse;
      font-size: var(--t-body-s);
    }
    .find-rows th,
    .find-rows td {
      padding: 6px 0;
      border-top: var(--hair) solid var(--line);
      text-align: left;
      font-weight: 400;
    }
    .find-rows th { color: var(--ink); width: 40%; }
    .find-rows td {
      color: var(--ink-2);
      font-family: var(--font-mono);
      font-size: var(--t-caption);
    }

    /* 계열 공통 설명 — 아래 항목들이 무엇을 근거로 하는지 한 번만 말한다 */
    .basis {
      margin: var(--s4) 0 calc(var(--s2) * -1);
      padding-left: var(--s3);
      border-left: 2px solid var(--line);
      color: var(--ink-3);
      font-size: var(--t-caption);
      line-height: 1.7;
      word-break: keep-all;
    }
    .finds > .basis:first-child { margin-top: 0; }

    .empty { color: var(--ink-2); font-size: var(--t-body-s); }
    [hidden] { display: none !important; }

    @media (max-width: 640px) {
      .find-rows th { width: auto; }
    }
  </style>
</Base>
