---
/**
 * 시작 지점 고르기.
 *
 * 게임은 네 곳 중 하나를 고르게 하고 별점만 보여 준다. 그 별점이 무슨 뜻인지는 안 알려준다 —
 * 「자원량 ★★★」이 철이 많다는 뜻인지 원유가 많다는 뜻인지 알 수가 없다.
 * 그래서 별점은 게임 것을 그대로 두고, 무엇이 얼마나 있는지는 노드 좌표에서 직접 센다.
 *
 * 판단(무엇을 골라야 하나)만 이 화면에 적고, 수치는 전부 lib/start-areas.ts 가 계산한다.
 */
import Base from '../../../layouts/Base.astro';
import ItemChip from '../../../components/ItemChip.astro';
import '../../../styles/fx.css';
import {
  AREA_NOTE,
  AREA_SOURCE,
  TRACKED,
  allStats,
  type Count,
} from '../../../lib/start-areas';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stats = allStats();

const EARLY = new Set(TRACKED.filter((t) => t.early).map((t) => t.res));
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 10) / 10));
const find = (list: Count[], res: string) => list.find((c) => c.res === res);
const total = (a: (typeof stats)[number], res: string) =>
  (find(a.near, res)?.n ?? 0) + (find(a.wide, res)?.n ?? 0);
/*
 * 별점은 기호만으로 정보를 주면 안 된다(색각 이상·화면 낭독). 숫자를 같이 적는다.
 */
const star = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const rating = (n: number) => `${star(n)} ${n}/5`;

/** 이 화면이 실제로 하는 말 — 게임이 안 해 주는 판단 */
const VERDICT: Record<string, { one: string; why: string }> = {
  grass: {
    one: '첫 회차의 넓은 작업장',
    why:
      '게임 안내가 첫 회차에 적합하다고 분류한 지역입니다. 넓고 평탄한 지형은 설비 간격과 물류 방향을 시험하기 쉽지만, ' +
      '노드 사이 거리는 실제 표의 집 앞·맞닿은 칸을 보고 판단해야 합니다. 평탄하다는 이유만으로 모든 자원이 한 부지에 모이는 것은 아닙니다.',
  },
  dune: {
    one: '넓은 부지, 제한된 초기 연료',
    why:
      '큰 설비군을 평면으로 펼치기 좋은 대신 바이오매스와 수면 접근이 일부 구역에 모여 있습니다. ' +
      '첫 전력 셀을 놓기 전에 연료 수집 경로와 이후 급수 경로를 함께 확인할 수 있는 플레이어에게 맞습니다.',
  },
  rocky: {
    one: '균형과 해안 접근',
    why:
      '게임 안내가 자원·공간·거리의 균형과 바다 접근을 장점으로 드는 지역입니다. ' +
      '해안은 유체 공정 후보지를 넓혀 주지만, 실제 생산량은 표의 노드 수와 순도를 기준으로 잡아야 합니다.',
  },
  forest: {
    one: '높은 자원 밀도, 어려운 시공면',
    why:
      '자원량과 다양성은 높지만 높이 차와 좁은 공터 때문에 평면 공장을 그대로 복제하기 어렵습니다. ' +
      '토대 기준면·수직 물류·보행 동선을 처음부터 설계할 의향이 있을 때 장점이 살아납니다.',
  },
};
---

<Base
  title="시작 지점 고르기 — 철·구리·석회석·S.A.M. 기준"
  description="게임이 고르게 하는 네 시작 지역을 주변 노드 수로 비교합니다. 별점이 아니라 실제로 무엇이 몇 개 있는지 봅니다."
  section="guide"
>
  <div class="wrap page">
    <header class="page-head">
      <p class="marker"><span class="num">가이드</span> 시작 지점</p>
      <h1><span class="fx-gradient-text">어디서 시작할 것인가</span></h1>
      <p class="lede prose">
        게임은 별점만 보여 줍니다. 「자원량 ★★★」이 철이 많다는 뜻인지 원유가 많다는 뜻인지는
        안 알려 줍니다. 별점은 게임 것을 그대로 두고, 무엇이 몇 개 있는지는 노드 좌표에서 직접 셌습니다.
      </p>
    </header>

    <div class="scroll-x">
      <table class="cmp">
        <thead>
          <tr>
            <th>시작 지역</th>
            {TRACKED.filter((t) => EARLY.has(t.res)).map((t) => (
              <th class="n">{t.ko}</th>
            ))}
            <th class="n">S.A.M.</th>
            <th class="n">물 자원정</th>
            <th>게임 별점</th>
          </tr>
        </thead>
        <tbody>
          {stats.map((a, i) => (
            <tr class={i === 0 ? 'is-top' : ''}>
              <th scope="row">
                <a href={`#${a.key}`}>{a.ko}</a>
                <small>{a.where}</small>
              </th>
              {TRACKED.filter((t) => EARLY.has(t.res)).map((t) => (
                <td class="n">
                  <b>{find(a.near, t.res)?.n ?? 0}</b>
                  <small>+{find(a.wide, t.res)?.n ?? 0}</small>
                </td>
              ))}
              <td class="n">
                <b>{find(a.near, 'Desc_SAM_C')?.n ?? 0}</b>
                <small>+{find(a.wide, 'Desc_SAM_C')?.n ?? 0}</small>
              </td>
              <td class="n">
                <b>{find(a.near, 'Desc_Water_C')?.n ?? 0}</b>
                <small>+{find(a.wide, 'Desc_Water_C')?.n ?? 0}</small>
              </td>
              <td class="stars">
                평탄 {rating(a.stars.flat)}
                <br />
                자원량 {rating(a.stars.amount)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="caption">
      굵은 숫자는 시작 지역 격자 한 칸(약 1.09 km) 안, 작은 숫자는 맞닿은 여덟 칸(약 3.3 km)까지입니다.
      노드 수이지 채굴량이 아닙니다 — 순도는 아래 각 지역에서 봅니다.
    </p>
    <p class="warn">
      물 자원정은 티어 8 자원정 추출기로만 씁니다. <b>초반에 쓰는 물은 노드가 아닙니다</b> —
      바다나 호수 수면에 물 추출기를 놓습니다. 바위 사막이 물 자원정 0개인데도 물이 가장 쉬운 이유가
      그것입니다. 표의 이 칸으로 초반 물 사정을 판단하지 마세요.
    </p>

    {stats.map((a, i) => (
      <section class="area" id={a.key}>
        <header class="area-head">
          <p class="marker">
            <span class="num">{String(i + 1).padStart(2, '0')}</span> {a.forWhom}
          </p>
          <h2>
            {a.ko} <span class="en">{a.en}</span>
          </h2>
          <p class="verdict">{VERDICT[a.key]?.one}</p>
        </header>

        <p class="why prose">{VERDICT[a.key]?.why}</p>
        <p class="blurb">게임 안내문 — {a.blurb}</p>

        <div class="stars-row">
          <span>평탄도 {rating(a.stars.flat)}</span>
          <span>바이오매스 {rating(a.stars.biomass)}</span>
          <span>자원량 {rating(a.stars.amount)}</span>
          <span>자원 다양성 {rating(a.stars.variety)}</span>
        </div>

        <div class="cols">
          <div>
            <p class="col-k">집 앞 · 격자 {a.cells.join(' · ')}</p>
            {a.near.length ? (
              <ul class="nodes">
                {a.near.map((c) => (
                  <li>
                    <ItemChip id={c.res} ko={c.ko} amount={c.n} size={44} />
                    <span class="node-ko">{c.ko}</span>
                    <span class="node-p">
                      {[
                        c.pure ? `순수 ${c.pure}` : '',
                        c.normal ? `보통 ${c.normal}` : '',
                        c.impure ? `불순 ${c.impure}` : '',
                      ]
                        .filter(Boolean)
                        .join(' · ')}
                    </span>
                    <span class="node-r">채굴기 Mk.1 전부 {fmt(c.perMinute)}/분</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">없음</p>
            )}
          </div>
          <div>
            <p class="col-k">걸어서 · 맞닿은 칸</p>
            {a.wide.length ? (
              <ul class="nodes is-thin">
                {a.wide.map((c) => (
                  <li>
                    <ItemChip id={c.res} ko={c.ko} amount={c.n} size={34} />
                    <span class="node-ko">{c.ko}</span>
                    <span class="node-r">{fmt(c.perMinute)}/분</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">없음</p>
            )}
          </div>
        </div>
      </section>
    ))}

    <section class="sam">
      <h2>S.A.M. 이 시작 지점을 결정하나</h2>
      <p class="prose">
        S.A.M. 연구는 MAM을 연 뒤 수집 경험으로 시작할 수 있고, 차원 저장과 생산 증폭 같은 외계 기술로 이어집니다.
        다만 연구 트리는 허브 티어와 독립적이며 뒤쪽 노드는 아직 열지 않은 부품을 요구할 수 있습니다.
        따라서 “후반까지 쓸 수 없다”거나 반대로 “S.A.M. 노드가 가까워야만 한다”는 식으로 시작 지역을 단정하지 않습니다.
      </p>
      <p class="prose">
        현재 추출 데이터에서 <b>{stats.find((s) => s.key === 'grass')?.ko}</b> 주변은 {total(stats.find((s) => s.key === 'grass')!, 'Desc_SAM_C')}개,
        <b>{stats.find((s) => s.key === 'rocky')?.ko}</b> 주변은 {total(stats.find((s) => s.key === 'rocky')!, 'Desc_SAM_C')}개입니다.
        이 값은 시작 지역과 맞닿은 격자의 노드 수일 뿐 이동 거리·동굴 입구·고도·위험도를 대신하지 않습니다.
      </p>
      <p class="caption">연구 시점 교차 확인: 게임 추출 데이터 · 공식 위키 MAM 및 S.A.M. 문서.</p>
    </section>

    <p class="caption foot prose">
      노드 수·순도·격자는 게임 데이터(<code>resource-nodes.json</code>)에서 계산했습니다.
      시작 지역의 안내문과 별점은 게임 선택 화면의 것이고, 격자 위치는 커뮤니티 자료를 따랐습니다
      (<a href={AREA_SOURCE.split(' · ')[0]?.replace('https://', 'https://')}>출처</a>).
      {AREA_NOTE}
    </p>

    <p class="back">
      <a href={`${base}/guide/`}>← 가이드로</a>
    </p>
  </div>

  <style>
    .page { padding-block: var(--s14) var(--s16); }
    .page-head { margin-bottom: var(--s8); }
    .page-head h1 { margin-bottom: var(--s4); }
    .lede { font-size: var(--t-body-l); color: var(--ink-2); }

    /* 좁은 화면에서 표는 자기 상자 안에서만 굴린다. 오른쪽 끝을 흐리게 해 굴릴 수 있음을 알린다 */
    @media (max-width: 520px) {
      .page :global(.scroll-x) {
        -webkit-mask-image: linear-gradient(to right, var(--mask-solid) calc(100% - 16px), transparent);
        mask-image: linear-gradient(to right, var(--mask-solid) calc(100% - 16px), transparent);
      }
    }

    .cmp { width: 100%; border-collapse: collapse; font-size: var(--t-small); }
    .cmp th, .cmp td {
      padding: var(--s3);
      border-bottom: var(--hair) solid var(--line);
      text-align: left;
      vertical-align: top;
      word-break: keep-all;
    }
    .cmp thead th { color: var(--ink-3); font-family: var(--font-mono); font-size: 11px; font-weight: 500; }
    /*
     * 수치 열은 값이 오른쪽 맞춤이라 머리글도 오른쪽에 붙어야 한다.
     * 위의 `.cmp th { text-align: left }` 가 base.css 의 `th.n` 을 덮어 머리글만
     * 자기 열 왼쪽 끝에 떠 있었다 — 시작 지역 열과 첫 숫자 사이가 통째로 비었다.
     */
    .cmp thead th.n, .cmp td.n { text-align: right; }
    /* 별점 열은 줄이 길어 붙어 버린다. 한 줄씩 떨어뜨린다 */
    .cmp .stars { white-space: nowrap; }
    .cmp tbody th { font-weight: 600; white-space: nowrap; }
    .cmp tbody th small { display: block; color: var(--ink-3); font-size: 11px; font-weight: 400; }
    .cmp td.n { font-family: var(--font-mono); text-align: right; }
    .cmp td.n b { color: var(--accent); font-size: var(--t-body); }
    .cmp td.n small { color: var(--ink-3); font-size: 11px; }
    .cmp .stars { color: var(--ink-2); font-size: 11px; letter-spacing: 0.05em; }
    .cmp tr.is-top { background: color-mix(in oklab, var(--accent) 7%, transparent); }

    .warn {
      margin: var(--s3) 0 0;
      padding: var(--s3) var(--s4);
      border-left: 3px solid var(--accent);
      border-radius: 0 var(--radius) var(--radius) 0;
      background: color-mix(in oklab, var(--accent) 7%, transparent);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
      max-width: var(--measure-wide);
    }
    .warn b { color: var(--ink); }

    .area {
      margin-top: var(--s10);
      padding: var(--s6);
      border-radius: var(--radius);
      background: var(--raised);
      box-shadow: var(--lit);
    }
    .area-head { margin-bottom: var(--s4); }
    .area-head h2 { margin: 0 0 var(--s2); }
    .area-head .en { color: var(--ink-3); font-family: var(--font-mono); font-size: var(--t-body-s); }
    .verdict {
      margin: 0;
      color: var(--accent);
      font-size: var(--t-body-l);
      font-weight: 600;
      word-break: keep-all;
    }
    .why { margin: 0 0 var(--s3); max-width: var(--measure); line-height: 1.85; word-break: keep-all; }
    .blurb {
      margin: 0 0 var(--s4);
      max-width: var(--measure);
      color: var(--ink-3);
      font-size: var(--t-small);
      line-height: 1.8;
      word-break: keep-all;
    }
    .stars-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s2) var(--s5);
      margin-bottom: var(--s5);
      color: var(--ink-2);
      font-size: var(--t-caption);
    }

    .cols { display: grid; gap: var(--s5); }
    @media (min-width: 900px) { .cols { grid-template-columns: 1.3fr 1fr; } }
    .col-k {
      margin: 0 0 var(--s3);
      padding-bottom: 6px;
      border-bottom: var(--hair) solid var(--line);
      color: var(--ink-3);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
    }
    .nodes { display: grid; gap: var(--s3); margin: 0; padding: 0; list-style: none; }
    .nodes li {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2px var(--s3);
      align-items: center;
    }
    .nodes li :global(.chip) { grid-row: span 3; }
    .node-ko { font-size: var(--t-body-s); font-weight: 600; }
    .node-p { color: var(--ink-3); font-family: var(--font-mono); font-size: 11px; }
    .node-r { min-width: 8ch; color: var(--accent); font-family: var(--font-mono); font-size: 11px; }
    .nodes.is-thin li { grid-template-columns: auto minmax(0, 1fr) auto; }
    .nodes.is-thin li :global(.chip) { grid-row: auto; }
    .nodes.is-thin .node-r { text-align: right; }

    .sam { margin-top: var(--s10); }
    .sam h2 { margin-bottom: var(--s3); }
    .sam p { margin: 0 0 var(--s3); max-width: var(--measure); line-height: 1.85; word-break: keep-all; }
    .sam b { color: var(--accent); }

    .foot { margin-top: var(--s10); }
    .back { margin-top: var(--s6); }
  </style>
</Base>
