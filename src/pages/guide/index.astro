---
/**
 * 가이드 — 이 사이트의 본체.
 *
 * 순서는 **게임의 해금 순서**를 따른다. 아직 못 짓는 것을 먼저 설명하지 않는다.
 * (석탄 발전을 맨 앞에 두었다가 티어 3 해금이라는 지적을 받았다. 그 실수를 구조로 막는다 —
 *  단계의 순서는 spine.json 이 정하고, 각 단계의 해금 내용은 게임 데이터에서 조회한다.)
 *
 * 각 단계는 관찰 가능한 완료 상태 → 시공 순서 → 현장 검증 → 확장 예약으로 구성한다.
 * 생산 기준과 기계 대수는 게임 레시피로 계산하며 설명문에 수치를 복제하지 않는다.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/fx.css';
import { building, buildings, defaultRecipeOf, item, milestones, recipe } from '../../lib/gamedata';
import spine from '../../data/curated/spine.json';
import finite from '../../data/curated/finite-resources.json';
import exploration from '../../data/curated/exploration.json';
import craft from '../../data/curated/build-craft.json';
import purity from '../../data/curated/node-purity.json';
import saveUnlocks from '../../data/app/save-unlocks.json';
import hub from '../../data/app/hub.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
 * 순도 표. 게임 데이터에서 계산한다 — 채굴기 기본 속도 × 순도 배수 × 클럭.
 * 배수(불순 0.5 · 보통 1 · 순수 2)는 게임이 노드에 붙이는 값이라 코드에 둔다.
 */
const PURITY_MULT = [
  { ko: '불순', mult: 0.5 },
  { ko: '보통', mult: 1 },
  { ko: '순수', mult: 2 },
];
const MAX_CLOCK = 2.5;
const POWER_EXP = 1.321928;

const miners = ['Build_MinerMk1_C', 'Build_MinerMk2_C', 'Build_MinerMk3_C'].map((id) => {
  const b = building(id);
  const rate = b.extraction?.perMinuteAtNormalPurity ?? 0;
  return {
    ko: b.ko,
    base: rate,
    powerMW: b.powerMW ?? 0,
    byPurity: PURITY_MULT.map((q) => ({ ko: q.ko, perMin: rate * q.mult })),
    /* 순수 노드를 최대로 돌리면 얼마나 나오나 — 벨트가 감당하는지 보려는 값이다 */
    maxPure: rate * 2 * MAX_CLOCK,
    maxPowerMW: Math.round((b.powerMW ?? 0) * Math.pow(MAX_CLOCK, POWER_EXP)),
  };
});

/* 리프트는 벨트와 처리량이 같다. 표에는 벨트만 쓴다 */
const belts = buildings
  .filter((b) => b.beltItemsPerMinute != null && b.id.includes('ConveyorBelt'))
  .sort((a, b) => (a.beltItemsPerMinute ?? 0) - (b.beltItemsPerMinute ?? 0))
  .map((b) => ({ ko: b.ko, perMin: b.beltItemsPerMinute ?? 0 }));

/** 어떤 채굴기·순도가 어느 벨트에서 막히나 */
const beltFor = (perMin: number) => belts.find((b) => b.perMin >= perMin) ?? belts[belts.length - 1];

const purityDoc = purity as {
  $key: string;
  $when: string;
  points: { title: string; body: string; confidence: string; source: string }[];
};

const finiteDoc = finite as {
  items: {
    /** 게임 아이템 목록에 없는 것(하드 드라이브)은 id 가 없다 */
    id?: string;
    ko: string;
    what: string;
    becomes: string;
    usedFor: string[];
    warning: string;
    advice: string;
    amplified?: { ko: string; base: number; withSloop: number }[];
    slots?: string;
    synthetic?: {
      recipe: string;
      unlockedByKo: string;
      why: string;
      catch: string;
    };
  }[];
  /** 동물군은 반대다 — 되살아난다. 나란히 놓아야 오해가 안 생긴다 */
  $contrast: string;
};

const craftDoc = craft as {
  $key: string;
  rules: { ko: string; what: string; why: string; how: string; cost: string }[];
  $dispute: { ko: string; sides: { claim: string; why: string }[]; verdict: string };
};

const exploreDoc = exploration as {
  $key: string;
  steps: { order: number; ko: string; when: string; cost: string; what: string; why: string }[];
  gear: { ko: string; when: string; cost: string; effect: string; priority: string; why: string }[];
  tips: { ko: string; keys: string; what: string; why: string; source: string }[];
};

/** 소수점이 붙을 때만 보여준다. 5.00 대신 5 */
const num = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));
const confidenceLabel = (value: string) =>
  ({ verified: '게임 데이터 확인', consensus: '복수 근거 합의', disputed: '의견 대립', unsourced: '근거 미확인' })[value] ?? value;
const sourceLabel = (value: string) => {
  if (value.startsWith('src/data/app/')) return '게임 설치본 추출 데이터';
  if (value.startsWith('docs/research/')) return '조사·교차검증 기록';
  if (value.startsWith('https://')) return '외부 원문';
  return value;
};

/** 레시피 → 산출 건물. "이 마일스톤에서 무엇이 열리는가"를 게임 데이터로 답하기 위한 색인 */
const buildingByRecipe = new Map<string, (typeof buildings)[number]>();
for (const b of buildings) {
  const rid = `Recipe_${b.id.replace(/^Build_/, '')}`;
  buildingByRecipe.set(rid, b);
}

const milestoneByKo = new Map(milestones.map((m) => [m.ko, m]));

/** 그 단계에서 실제로 열리는 건물 — 이름을 타이핑하지 않고 데이터에서 뽑는다 */
function unlockedBuildings(names: string[]) {
  const out: { ko: string; en: string }[] = [];
  const seen = new Set<string>();
  for (const n of names) {
    const m = milestoneByKo.get(n);
    if (!m) continue;
    for (const rid of m.unlocksRecipes ?? []) {
      const b = buildingByRecipe.get(rid);
      if (!b || seen.has(b.id)) continue;
      // 토대·벽 같은 건축 부재는 목록을 덮어버리므로 제외한다
      if (/Foundation|Wall|Ramp|Pillar|Beam|Catwalk|Stair|Fence|Roof|Sign/i.test(b.id)) continue;
      seen.add(b.id);
      out.push({ ko: b.ko, en: b.en });
    }
  }
  return out;
}

/** 목표 생산량 → 필요한 기계와 대수 */
function machinesFor(itemId: string, perMinute: number) {
  const r = defaultRecipeOf(itemId);
  if (!r) return null;
  const outPer = r.products.find((p) => p.item === itemId)?.perMinute ?? 0;
  if (!outPer) return null;
  const b = r.producedIn?.[0] ? building(r.producedIn[0]) : null;
  const exact = perMinute / outPer;
  return {
    machineKo: b?.ko ?? '—',
    machineId: b?.id,
    exact,
    count: Math.ceil(exact - 1e-9),
    clock: Math.round((exact / Math.ceil(exact - 1e-9)) * 1000) / 10,
    inputs: r.ingredients.map((g) => ({
      ko: item(g.item).ko,
      perMinute: (g.perMinute * perMinute) / outPer,
    })),
  };
}

/*
 * 구간 ↔ 마일스톤. 세이브에는 산 스키매틱이 클래스명으로 들어 있어서, 이것만 있으면
 * "지금 어느 구간인가"를 화면에서 바로 답할 수 있다.
 *
 * 주의: 구간이 끝났는지는 **그 티어의 모든 마일스톤**으로 따진다. 가이드가 가르치는
 * 마일스톤 목록(spine 의 milestones)으로 따지면 안 된다 — 그건 설명할 것만 고른 부분집합이라
 * 티어 3을 2개짜리로 보고 「차량 운송」을 안 샀는데도 끝났다고 답한 적이 있다.
 * 하필 그게 인벤토리 3칸을 주는 마일스톤이었다.
 */
const milestoneIdByKo = new Map([
  ...milestones.map((m) => [m.ko, m.id] as const),
  ...(hub as { id: string; ko: string }[]).map((h) => [h.ko, h.id] as const),
]);
const unmapped = spine.steps.flatMap((x) => x.milestones.filter((n) => !milestoneIdByKo.has(n)));
if (unmapped.length) throw new Error('가이드가 없는 마일스톤을 가리킵니다: ' + unmapped.join(', '));

type NeedRow = {
  id: string;
  ko: string;
  cost: { ko: string; amount: number }[];
  slots: number;
  /** 가이드가 이 구간에서 설명하는 것인가 */
  taught: boolean;
};

/** 그 티어에 실제로 있는 마일스톤 전부. 티어 0은 허브 업그레이드다 */
function tierNeeds(tier: number, taughtKo: string[]): NeedRow[] {
  const taught = new Set(taughtKo);
  const rows =
    tier === 0
      ? (hub as { id: string; ko: string; cost: { item: string; amount: number }[] }[]).map((h) => ({
          id: h.id,
          ko: h.ko,
          cost: h.cost,
          slots: 0,
        }))
      : milestones
          .filter((m) => m.tier === tier)
          .map((m) => ({
            id: m.id,
            ko: m.ko,
            cost: m.cost,
            slots: (m as { inventorySlots?: number }).inventorySlots ?? 0,
          }));
  return rows.map((r) => ({
    id: r.id,
    ko: r.ko,
    slots: r.slots,
    taught: taught.has(r.ko),
    cost: r.cost.map((c) => ({ ko: item(c.item).ko, amount: c.amount })),
  }));
}

const steps = spine.steps.map((s) => ({
  ...s,
  unlocks: unlockedBuildings(s.milestones),
  /* 이 구간에서 사야 할 것 전부. 가르치는 것만이 아니라 그 티어에 있는 것 전부다 */
  need: tierNeeds(s.tier, s.milestones),
  needIds: tierNeeds(s.tier, s.milestones).map((n) => n.id),
  rows: s.targets.map((t) => ({
    ko: item(t.item).ko,
    en: item(t.item).en,
    perMinute: t.perMinute,
    note: (t as { note?: string }).note ?? null,
    plan: machinesFor(t.item, t.perMinute),
  })),
}));

---

<Base
  title="공장 시공 가이드 — 완료 상태부터 역산"
  description="Satisfactory 공장을 해금 순서에 맞춰 시공하고, 실제 운전 상태로 완료를 판정하는 검증형 가이드입니다."
  section="guide"
>
  <div class="wrap page">
    <header class="page-head">
      <p class="marker"><span class="num">가이드</span></p>
      <h1>지금 지을 것과<br /><span class="fx-gradient-text">끝났다고 말할 기준</span></h1>
      <p class="lede prose">
        해금 목록을 읽고 끝내지 않습니다. <strong>완료 상태를 먼저 정하고</strong>, 시공 뒤 실제 유량·적체·재가동을 확인합니다.
      </p>
    
      <div class="prog" data-prog hidden>
        <p class="prog-line">
          <b data-prog-where></b>
          <span data-prog-who></span>
        </p>
        <button type="button" data-prog-clear>지우기</button>
      </div>

      <label class="prog-load" data-prog-load>
        <input type="file" accept=".sav" data-prog-file />
        <span data-prog-label>세이브를 열어 내 진행에 맞추기</span>
      </label>
      <p class="prog-note" data-prog-msg>
        인게임 세이브를 고르면 어디까지 왔는지 읽어 각 구간에 끝남·지금·앞으로를 표시합니다.
        파일은 이 브라우저 밖으로 나가지 않습니다.
      </p>

      <p class="startlink" data-startlink>
        아직 시작도 안 했다면 — <a href={`${base}/guide/start/`}>어디서 시작할 것인가</a>부터 보세요.
        네 시작 지역의 철·구리·석회석·S.A.M. 노드 수를 세어 비교합니다.
      </p>
</header>

    <div class="layout">
      <nav class="toc" aria-label="단계 목차">
        <ol>
          {steps.map((s, i) => (
            <li data-step={s.id} data-need={s.needIds.join(' ')}>
              <a href={`#${s.id}`}>
                <span class="toc-n n">{String(i).padStart(2, '0')}</span>
                <span class="toc-t">{s.title}</span>
                <span class="toc-tier n">{s.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="body">
        {steps.map((s, i) => (
          <section class="step" id={s.id} data-step={s.id} data-need={s.needIds.join(' ')}>
            <p class="marker">
              <span class="num">{String(i).padStart(2, '0')}</span> {s.label}
              <span class="stage" data-stage hidden></span>
            </p>
            <h2>{s.title}</h2>
            <p class="brief">{s.brief}</p>

            <div class="completion">
              <p class="completion-k">완료 상태</p>
              <ul class="checks">
                {s.doneWhen.map((check) => <li>{check}</li>)}
              </ul>
              {s.unlocks.length > 0 && (
                <div class="unlocked-row">
                  <span>이 단계 해금</span>
                <ul class="unlocks">
                  {s.unlocks.slice(0, 10).map((b) => (
                    <li class="chip">{b.ko}</li>
                  ))}
                </ul>
                </div>
              )}
            </div>

            <div class="remain" data-remain hidden>
              <h3 class="sub">이 구간에서 아직 안 산 것</h3>
              <ul>
                {s.need.map((n) => (
                  <li data-ms={n.id}>
                    <span class="remain-ko">
                      {n.ko}
                      {n.slots > 0 && <em class="remain-slot">인벤토리 +{n.slots}칸</em>}
                    </span>
                    <span class="remain-cost n">
                      {n.cost.map((c) => (
                        <span>
                          {c.ko} {c.amount}
                        </span>
                      ))}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <h3 class="sub">시공 순서 · 현장 검증</h3>
            <ol class="sequence">
              {s.sequence.map((a) => (
                <li>
                  <div class="sequence-copy">
                    <p class="build"><span>시공</span>{a.build}</p>
                    <p class="verify"><span>검증</span>{a.verify}</p>
                  </div>
                </li>
              ))}
            </ol>

            {s.rows.length > 0 && (
              <>
                <h3 class="sub">운전 기준</h3>
                <div class="scroll-x" tabindex="0">
                  <table>
                    <thead>
                      <tr>
                        <th>부품</th>
                        <th class="n">분당</th>
                        <th>기계</th>
                        <th class="n">대수</th>
                        <th class="n">클럭</th>
                        <th>재료</th>
                      </tr>
                    </thead>
                    <tbody>
                      {s.rows.map((r) => (
                        <tr>
                          <td>
                            {r.ko} <span class="en">{r.en}</span>
                            {r.note && <span class="rownote">{r.note}</span>}
                          </td>
                          <td class="n">{num(r.perMinute)}</td>
                          <td>{r.plan?.machineKo ?? '채굴기'}</td>
                          <td class="n">{r.plan ? r.plan.count : ''}</td>
                          <td class="n">{r.plan && r.plan.clock < 100 ? `${num(r.plan.clock)}%` : ''}</td>
                          <td class="small muted">
                            {r.plan?.inputs.map((g) => (
                              <span class="chip">{g.ko} <span class="n">{num(g.perMinute)}</span></span>
                            ))}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            )}

            {s.rows.length > 0 && (
              <p class="planner-bridge">
                이 구간의 기계 배치와 실제 포트 연결은 추상 공정도로 대신하지 않습니다.
                <a href={`${base}/planner/`}>검증형 도면판에서 실제 축척으로 배치하기 →</a>
              </p>
            )}

            {s.reserve && (
              <div class="keep">
                <p class="keep-tag">확장 예약</p>
                <p class="keep-body">{s.reserve}</p>
              </div>
            )}

            <footer class="evidence">
              <span class={`confidence is-${s.confidence}`}>{confidenceLabel(s.confidence)}</span>
              <span aria-hidden="true">·</span>
              {s.sources
                .filter((source, sourceIndex, all) =>
                  all.findIndex((candidate) => sourceLabel(candidate) === sourceLabel(source)) === sourceIndex)
                .map((source, sourceIndex) => (
                <>
                  {sourceIndex > 0 && <span aria-hidden="true">·</span>}
                  {source.startsWith('https://') ? (
                    <a href={source} rel="noreferrer">{sourceLabel(source)}</a>
                  ) : (
                    <span title={source}>{sourceLabel(source)}</span>
                  )}
                </>
                ))}
            </footer>
          </section>
        ))}

        <section class="step" id="finite">
          <p class="marker"><span class="num">주의</span> 유한 자원</p>
          <h2>다시 자라지 않는 것들</h2>
          <p class="prose muted">
            채굴 노드는 무한하지만 아래 {finiteDoc.items.length}종은 아닙니다. 맵에 놓인 개수가 정해져 있고 게임이
            경고해 주지 않아서, 초반에 아무 데나 써 버리는 일이 흔합니다.
          </p>

          <div class="finite">
            {finiteDoc.items.map((f) => (
              <article class="fin">
                <header class="fin-head">
                  {f.id && (
                    <img
                      class="fin-icon"
                      src={`${base}/assets/items/${f.id}.png`}
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy"
                    />
                  )}
                  <h3>{f.ko}</h3>
                </header>
                <p class="fin-what">{f.what}</p>
                <dl class="fin-rows">
                  <dt>무엇이 되나</dt>
                  <dd>{f.becomes}</dd>
                  <dt>어디에 쓰나</dt>
                  <dd>{f.usedFor.join(' · ')}</dd>
                  <dt class="is-warn">함정</dt>
                  <dd>{f.warning}</dd>
                  <dt class="is-do">권장</dt>
                  <dd class="is-do">{f.advice}</dd>
                  {f.slots && (
                    <>
                      <dt>슬롯 수</dt>
                      <dd>{f.slots}</dd>
                    </>
                  )}
                </dl>
                {f.synthetic && (() => {
                  /* 수치를 타이핑하지 않는다 — 레시피에서 가져온다 */
                  const r = recipe(f.synthetic.recipe);
                  const b = building(r.producedIn[0]!);
                  const shows = (xs: { item: string; perMinute: number }[]) =>
                    xs.map((x) => `${item(x.item).ko} ${x.perMinute}/분`).join(' + ');
                  return (
                    <div class="synth">
                      <p class="synth-head">
                        <span class="synth-tag">나중에</span>
                        {r.ko} · {b.ko}
                        <span class="synth-when">{f.synthetic.unlockedByKo}</span>
                      </p>
                      <p class="synth-eq n">
                        {shows(r.ingredients)} → {shows(r.products)}
                      </p>
                      <p>{f.synthetic.why}</p>
                      <p class="synth-catch">{f.synthetic.catch}</p>
                    </div>
                  );
                })()}

                {f.amplified && (
                  <table class="amp">
                    <thead>
                      <tr>
                        <th>슬러그</th>
                        <th class="n">그냥 변환</th>
                        <th class="n">소머슬룹 1개</th>
                      </tr>
                    </thead>
                    <tbody>
                      {f.amplified.map((a) => (
                        <tr>
                          <td>{a.ko}</td>
                          <td class="n">{a.base}</td>
                          <td class="n is-amp">{a.withSloop}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </article>
            ))}
          </div>

          <p class="contrast prose">
            <span class="contrast-tag">반대로</span>
            {finiteDoc.$contrast}
          </p>
        </section>

        <section class="step" id="purity">
          <p class="marker"><span class="num">판단</span> 노드 순도</p>
          <h2>순수 노드를 찾아 멀리 가지 않는다</h2>
          <p class="prose muted">{purityDoc.$key}</p>

