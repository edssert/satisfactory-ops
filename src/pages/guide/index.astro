    .rownote { display: block; font-size: var(--t-caption); color: var(--ink-3); }
    td .chip { margin: 1px 2px 1px 0; }

    /*
     * 공정 흐름도는 좁은 화면에서 줄이면 글자가 안 읽힌다. 줄이지 말고 **자기 상자 안에서만**
     * 옆으로 굴린다. 페이지 본문은 절대 가로로 밀리지 않는다.
     * 오른쪽 끝을 흐리게 해서 "더 있다"는 것을 알린다 — 안 그러면 잘린 그림처럼 보인다.
     */
    .planner-bridge {
      display: grid;
      gap: var(--s2);
      margin: var(--s6) 0 0;
      padding: var(--s4);
      border-left: 3px solid var(--primary);
      background: color-mix(in oklab, var(--primary) 7%, transparent);
      color: var(--ink-2);
      font-size: var(--t-small);
      line-height: 1.7;
    }
    .planner-bridge a { color: var(--ink); font-weight: 700; }
    .flowwrap { margin-top: var(--s10); }
    /* 굴리는 것은 그림뿐이다. 설명글은 제자리에서 접혀야 읽힌다 */
    .flowwrap > :global(.fc) {
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }
    /*
     * 그림의 진짜 폭은 FlowChart 가 인라인 `max-width` 로 준다. `width: 100%` 만 주면
     * 좁은 화면에서 그 폭까지 **줄어들어** 글자가 6px 이 됐다. 바닥을 640px 로 깔아
     * 그 아래로는 안 줄이고 대신 옆으로 굴린다. 넓은 화면에서는 전과 똑같이 맞춰 들어간다.
     */
    .flowwrap :global(.fc-svg) { width: max(100%, 640px); }
    @media (max-width: 660px) {
      /* 오른쪽 끝을 흐리게 해 "옆으로 더 있다"를 알린다. 안 그러면 잘린 그림으로 보인다 */
      .flowwrap > :global(.fc) {
        -webkit-mask-image: linear-gradient(to right, var(--mask-solid) calc(100% - 20px), transparent);
        mask-image: linear-gradient(to right, var(--mask-solid) calc(100% - 20px), transparent);
      }
      /* 흐려지는 자리에 글자가 걸리지 않게 설명글 오른쪽을 비운다 */
      .flowwrap :global(.fc-cap) { padding-right: 30px; }
    }

    /* 표도 같다 — 좁을 때만 상자 안에서 굴리고, 굴릴 수 있다는 것을 오른쪽 끝으로 알린다 */
    @media (max-width: 520px) {
      .unlocked-row { grid-template-columns: 1fr; }
      .sequence-copy p { grid-template-columns: 1fr; gap: var(--s1); }
      .step :global(.scroll-x) {
        -webkit-mask-image: linear-gradient(to right, var(--mask-solid) calc(100% - 16px), transparent);
        mask-image: linear-gradient(to right, var(--mask-solid) calc(100% - 16px), transparent);
      }
    }

    .keep {
      margin-top: var(--s10);
      padding: var(--s5);
      border-radius: var(--radius);
      background: var(--glass);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, white 10%, transparent),
        0 0 0 1px color-mix(in oklab, var(--accent) 34%, transparent);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .keep-tag {
      margin-bottom: var(--s2);
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .keep-body { margin: 0; font-weight: 600; max-width: var(--measure); }

    .step.is-open h2 { color: var(--ink-2); }

    /* 내 진행 상황 */
    /*
     * `display` 를 준 요소에는 `hidden` 이 안 먹는다. 세이브를 안 올렸는데도
     * 테두리만 있고 「지우기」 단추 하나 든 빈 상자가 떠 있었다. 여기서 확실히 끊는다.
     */
    .prog[hidden] { display: none; }
    .prog {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s3);
      align-items: center;
      margin-bottom: var(--s3);
      padding: var(--s3);
      border-left: 2px solid var(--primary);
      background: var(--surface);
    }
    .prog-line { margin: 0; flex: 1; min-width: 0; }
    .prog-line b { display: block; color: var(--ink); font-size: var(--t-body); }
    .prog-line span { color: var(--ink-3); font-size: var(--t-caption); }
    .prog button {
      padding: 4px 10px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 4px;
      background: none;
      color: var(--ink-3);
      font: inherit;
      font-size: var(--t-caption);
      cursor: pointer;
    }
    .prog button:hover { color: var(--ink); }

    .prog-load {
      display: inline-block;
      padding: 6px 13px;
      border: var(--hair) solid var(--primary);
      border-radius: 4px;
      color: var(--ink);
      font-size: var(--t-body-s);
      cursor: pointer;
    }
    .prog-load:hover { background: color-mix(in oklab, var(--primary) 14%, transparent); }
    .prog-load.is-busy { border-color: var(--line-strong); color: var(--ink-3); cursor: progress; }
    .prog-load input { display: none; }
    .prog-note {
      margin: 6px 0 var(--s4);
      color: var(--ink-3);
      font-size: var(--t-caption);
      line-height: 1.7;
      word-break: keep-all;
    }

    /* 이 구간에서 아직 안 산 것 */
    .remain {
      margin-bottom: var(--s5);
      padding: var(--s3) var(--s4);
      border-left: 2px solid var(--primary);
      background: var(--surface);
    }
    .remain .sub { margin-top: 0; }
    .remain ul { margin: 0; padding: 0; list-style: none; }
    .remain li {
      display: flex;
      flex-wrap: wrap;
      gap: 4px var(--s3);
      align-items: baseline;
      padding: 7px 0;
      border-bottom: var(--hair) solid var(--line);
    }
    .remain li:last-child { border-bottom: 0; }
    /* display 를 준 요소는 hidden 이 안 먹는다. 산 마일스톤이 그대로 보였다 */
    .remain li[hidden] { display: none; }
    .remain-ko { flex: 1 1 12em; color: var(--ink); font-weight: 500; }
    /* 인벤토리 칸은 놓치면 계속 아쉬운데 목록에서 눈에 안 띈다 */
    .remain-slot {
      margin-left: 7px;
      padding: 1px 6px;
      border-radius: 3px;
      background: var(--accent-soft);
      color: var(--accent-ink);
      font-size: var(--t-caption);
      font-style: normal;
      font-weight: 400;
    }
    .remain-cost {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 10px;
      color: var(--ink-3);
      font-size: var(--t-caption);
      font-variant-numeric: tabular-nums;
    }

    /* 구간마다 끝남·지금·앞으로 */
    .stage {
      margin-left: 8px;
      padding: 1px 7px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 3px;
      color: var(--ink-3);
      font-size: var(--t-caption);
    }
    .step.is-now .stage { border-color: var(--primary); color: var(--primary); }
    .step.is-done { opacity: 0.55; }
    .step.is-done:hover { opacity: 1; }

    .toc li.is-now a { color: var(--primary); }
    .toc li.is-now .toc-t { font-weight: 600; }

    /* 게임이 알려 주지 않는 조작 */
    .tip {
      margin-top: var(--s4);
      padding: var(--s3);
      border-left: 2px solid var(--primary);
      background: var(--surface);
    }
    .tip p {
      margin: 0 0 6px;
      color: var(--ink-2);
      font-size: var(--t-body-s);
      line-height: 1.7;
      word-break: keep-all;
    }
    .tip p:last-child { margin-bottom: 0; }
    .tip-head {
      display: flex;
      gap: 9px;
      align-items: baseline;
      color: var(--ink) !important;
      font-weight: 600;
    }
    .tip kbd {
      padding: 2px 8px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 3px;
      background: var(--raised);
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: var(--t-caption);
      white-space: nowrap;
    }
    .tip-why { color: var(--ink-3) !important; }

    /* 합성 동력 조각 — 슬러그 칸 안의 「나중에 열리는 길」 */
    .synth {
      margin-top: var(--s3);
      padding: var(--s3);
      border: var(--hair) solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .synth p {
      margin: 0 0 6px;
      color: var(--ink-2);
      font-size: var(--t-body-s);
      line-height: 1.7;
      word-break: keep-all;
    }
    .synth p:last-child { margin-bottom: 0; }
    .synth-head {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      align-items: baseline;
      color: var(--ink) !important;
      font-weight: 600;
    }
    .synth-tag {
      padding: 1px 7px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 3px;
      color: var(--ink-3);
      font-size: var(--t-caption);
      font-weight: 400;
    }
    .synth-when { color: var(--ink-3); font-size: var(--t-caption); font-weight: 400; }
    /* 식은 좁은 칸에서 잘리느니 줄바꿈되는 편이 낫다 */
    .synth-eq {
      font-family: var(--font-mono);
      font-size: var(--t-caption) !important;
      line-height: 1.9 !important;
    }
    .synth-catch { color: var(--accent-ink) !important; }

    /* 순도 표 — 수치는 오른쪽 맞춤, 자릿수가 눈으로 비교돼야 한다 */
    .pur {
      width: 100%;
      margin-top: var(--s4);
      border-collapse: collapse;
      font-size: var(--t-body-s);
    }
    .pur th,
    .pur td {
      padding: 9px 10px;
      border-bottom: var(--hair) solid var(--line);
      text-align: left;
    }
    .pur thead th {
      color: var(--ink-3);
      font-size: var(--t-caption);
      font-weight: 500;
    }
    .pur .n {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      text-align: right;
    }
    .pur tbody th { color: var(--ink); font-weight: 500; white-space: nowrap; }
    .pur .is-amp { color: var(--primary); }
    .pur-sub { display: block; color: var(--ink-3); font-size: var(--t-caption); }

    .pur-pts {
      display: grid;
      gap: var(--s3);
      margin-top: var(--s5);
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
    .pur-pt {
      padding: var(--s3);
      border-left: 2px solid var(--line-strong);
    }
    .pur-pt h3 {
      margin: 0 0 6px;
      font-size: var(--t-body);
      font-weight: 600;
      word-break: keep-all;
    }
    .pur-pt p {
      margin: 0;
      color: var(--ink-2);
      font-size: var(--t-body-s);
      line-height: 1.7;
      word-break: keep-all;
    }

    /* 출처는 각주로 내린다 — 화면은 결론만 */
    .src { margin-top: var(--s4); }
    .src summary {
      color: var(--ink-3);
      font-size: var(--t-caption);
      cursor: pointer;
    }
    .src ol {
      margin: var(--s2) 0 0;
      padding-left: 1.4em;
      color: var(--ink-3);
      font-size: var(--t-caption);
      line-height: 1.7;
    }

    .contrast {
      margin: var(--s5) 0 0;
      padding: var(--s4) var(--s5);
      border-left: 3px solid var(--primary);
      border-radius: 0 var(--radius) var(--radius) 0;
      background: color-mix(in oklab, var(--primary) 7%, transparent);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
    }
    .contrast-tag {
      display: inline-block;
      margin-right: var(--s2);
      color: var(--primary);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }

    .ex-steps {
      display: grid;
      gap: var(--s3);
      margin: var(--s6) 0 var(--s8);
      padding: 0;
      list-style: none;
    }
    .ex {
      padding: var(--s4) var(--s5);
      border-radius: var(--radius);
      background: var(--raised);
      box-shadow: var(--lit);
    }
    .ex-head { display: flex; align-items: baseline; gap: var(--s3); margin: 0 0 var(--s2); }
    .ex-n { color: var(--accent); font-family: var(--font-mono); font-weight: 600; }
    .ex-ko { font-size: var(--t-body-l); font-weight: 600; }
    .ex-when { margin-left: auto; color: var(--ink-3); font-family: var(--font-mono); font-size: var(--t-caption); }
    .ex-what { margin: 0 0 var(--s2); max-width: var(--measure); word-break: keep-all; }
    .ex-why {
      margin: 0 0 var(--s3);
      max-width: var(--measure);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
    }
    .ex-cost { margin: 0; color: var(--ink-3); font-family: var(--font-mono); font-size: var(--t-caption); }

    .ex-h3 { margin: 0 0 var(--s4); font-size: var(--t-body-l); }
    .ex-gear { width: 100%; border-collapse: collapse; font-size: var(--t-small); }
    .ex-gear th, .ex-gear td {
      padding: var(--s3) var(--s4);
      border-bottom: var(--hair) solid var(--line);
      text-align: left;
      vertical-align: top;
      word-break: keep-all;
    }
    .ex-gear thead th { color: var(--ink-3); font-family: var(--font-mono); font-size: 11px; font-weight: 500; }
    .ex-gear tbody th { font-weight: 600; white-space: nowrap; }
    .ex-gear small {
      display: block;
      margin-top: 3px;
      color: var(--ink-3);
      font-size: var(--t-caption);
      font-weight: 400;
      white-space: normal;
    }
    .ex-pri { font-family: var(--font-mono); white-space: nowrap; }
    .ex-pri.is-hi { color: var(--accent); }
    .ex-pri.is-mid { color: var(--ink-2); }
    .ex-pri.is-low { color: var(--ink-3); }

    .craft { display: grid; gap: var(--s3); margin: var(--s6) 0 var(--s8); }
    @media (min-width: 900px) { .craft { grid-template-columns: 1fr 1fr; } }
    .cr {
      padding: var(--s4) var(--s5);
      border-radius: var(--radius);
      background: var(--raised);
      box-shadow: var(--lit);
    }
    .cr-head { display: flex; align-items: baseline; gap: var(--s3); margin: 0 0 var(--s2); }
    .cr-n { color: var(--primary); font-family: var(--font-mono); font-size: var(--t-caption); }
    .cr-ko { font-size: var(--t-body-l); font-weight: 600; word-break: keep-all; }
    .cr-what { margin: 0 0 var(--s2); max-width: var(--measure); word-break: keep-all; }
    .cr-why {
      margin: 0 0 var(--s3);
      max-width: var(--measure);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
    }
    .cr-rows {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 4px var(--s3);
      margin: 0;
      font-size: var(--t-caption);
    }
    .cr-rows dt { color: var(--ink-3); font-family: var(--font-mono); }
    .cr-rows dd { margin: 0; color: var(--ink-2); word-break: keep-all; }

    .cr-dispute {
      padding: var(--s5);
      border-radius: var(--radius);
      background: color-mix(in oklab, var(--primary) 6%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--primary) 18%, transparent);
    }
    .cr-dispute h3 { margin: 0 0 var(--s4); font-size: var(--t-body-l); }
    .cr-sides { display: grid; gap: var(--s4); margin-bottom: var(--s4); }
    @media (min-width: 720px) { .cr-sides { grid-template-columns: 1fr 1fr; } }
    .cr-claim { margin: 0 0 4px; font-weight: 600; word-break: keep-all; }
    .cr-cwhy {
      margin: 0;
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
    }
    .cr-verdict {
      margin: 0;
      padding-top: var(--s4);
      border-top: var(--hair) solid color-mix(in oklab, var(--primary) 22%, transparent);
      font-size: var(--t-small);
      line-height: 1.8;
      word-break: keep-all;
    }

    .startlink {
      margin: var(--s5) 0 0;
      padding: var(--s3) var(--s4);
      border-left: 3px solid var(--primary);
      border-radius: 0 var(--radius) var(--radius) 0;
      background: color-mix(in oklab, var(--primary) 7%, transparent);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      max-width: var(--measure);
      word-break: keep-all;
    }

    .finite { display: grid; gap: var(--s4); }
    @media (min-width: 900px) { .finite { grid-template-columns: 1fr 1fr; } }
    .fin {
      /*
       * 안에 줄바꿈 없는 긴 줄(레시피 식)이 있으면 칸이 그만큼 벌어져 옆 칸을 눌러 버린다.
       * 그리드 칸의 최소 너비를 풀어 준다 — 긴 줄은 자기 상자 안에서만 가로로 넘긴다.
       */
      min-width: 0;
      padding: var(--s5);
      border-radius: calc(var(--radius) * 2);
      background: var(--glass);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, white 10%, transparent),
        0 0 0 1px color-mix(in oklab, var(--danger) 24%, transparent);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .fin-head { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s3); }
    .fin-head h3 { font-size: var(--t-body-l); }
    .fin-icon { flex: none; }
    .fin-what { margin: 0 0 var(--s4); font-size: var(--t-small); color: var(--ink-2); }
    .fin-rows {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: var(--s2) var(--s4);
      margin: 0;
      font-size: var(--t-small);
    }
    .fin-rows dt {
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.06em;
      color: var(--ink-3);
      padding-top: 2px;
    }
    .fin-rows dt.is-warn { color: var(--danger); }
    .fin-rows dt.is-do { color: var(--ok); }
    .fin-rows dd { margin: 0; color: var(--ink-2); }
    .fin-rows dd.is-do { color: var(--ink); font-weight: 500; }
    .amp { margin-top: var(--s4); font-size: var(--t-caption); }
    .amp thead th { position: static; background: transparent; padding-block: 0 4px; }
    .amp td, .amp th { padding-inline: 0 var(--s3); }
    .amp .is-amp { color: var(--ok); font-weight: 600; }
    @media (max-width: 620px) {
      .fin-rows { grid-template-columns: minmax(0, 1fr); gap: 2px; }
      .fin-rows dd { margin-bottom: var(--s3); }
    }
    .wide { max-width: var(--measure-wide); }
  </style>
</Base>
