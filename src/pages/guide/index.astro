---
/**
 * 가이드 — 이 사이트의 본체.
 *
 * 순서는 **게임의 해금 순서**를 따른다. 아직 못 짓는 것을 먼저 설명하지 않는다.
 * (석탄 발전을 맨 앞에 두었다가 티어 3 해금이라는 지적을 받았다. 그 실수를 구조로 막는다 —
 *  단계의 순서는 spine.json 이 정하고, 각 단계의 해금 내용은 게임 데이터에서 조회한다.)
 *
 * 규모는 마일스톤 요구량 역산이 아니라 **커뮤니티 표준 생산량**이다(spine.json 의 targets).
 * 기계 대수는 그 목표를 게임 레시피로 나눠 계산한다.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/fx.css';
import FlowChart from '../../components/FlowChart.astro';
import { building, buildings, defaultRecipeOf, item, milestones, recipe } from '../../lib/gamedata';
import spine from '../../data/curated/spine.json';
import finite from '../../data/curated/finite-resources.json';
import exploration from '../../data/curated/exploration.json';
import craft from '../../data/curated/build-craft.json';
import purity from '../../data/curated/node-purity.json';
import { biomassLine, ironLine, smartPlatingLine, type FlowDef } from '../../lib/flows';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
 * 순도 표. 게임 데이터에서 계산한다 — 채굴기 기본 속도 × 순도 배수 × 클럭.
 * 배수(불순 0.5 · 보통 1 · 순수 2)는 게임이 노드에 붙이는 값이라 코드에 둔다.
 */
const PURITY_MULT = [
  { ko: '불순', mult: 0.5 },
  { ko: '보통', mult: 1 },
  { ko: '순수', mult: 2 },
];
const MAX_CLOCK = 2.5;
const POWER_EXP = 1.321928;

const miners = ['Build_MinerMk1_C', 'Build_MinerMk2_C', 'Build_MinerMk3_C'].map((id) => {
  const b = building(id);
  const rate = b.extraction?.perMinuteAtNormalPurity ?? 0;
  return {
    ko: b.ko,
    base: rate,
    powerMW: b.powerMW ?? 0,
    byPurity: PURITY_MULT.map((q) => ({ ko: q.ko, perMin: rate * q.mult })),
    /* 순수 노드를 최대로 돌리면 얼마나 나오나 — 벨트가 감당하는지 보려는 값이다 */
    maxPure: rate * 2 * MAX_CLOCK,
    maxPowerMW: Math.round((b.powerMW ?? 0) * Math.pow(MAX_CLOCK, POWER_EXP)),
  };
});

/* 리프트는 벨트와 처리량이 같다. 표에는 벨트만 쓴다 */
const belts = buildings
  .filter((b) => b.beltItemsPerMinute != null && b.id.includes('ConveyorBelt'))
  .sort((a, b) => (a.beltItemsPerMinute ?? 0) - (b.beltItemsPerMinute ?? 0))
  .map((b) => ({ ko: b.ko, perMin: b.beltItemsPerMinute ?? 0 }));

/** 어떤 채굴기·순도가 어느 벨트에서 막히나 */
const beltFor = (perMin: number) => belts.find((b) => b.perMin >= perMin) ?? belts[belts.length - 1];

const purityDoc = purity as {
  $key: string;
  $when: string;
  points: { title: string; body: string; confidence: string; source: string }[];
};

const finiteDoc = finite as {
  items: {
    /** 게임 아이템 목록에 없는 것(하드 드라이브)은 id 가 없다 */
    id?: string;
    ko: string;
    what: string;
    becomes: string;
    usedFor: string[];
    warning: string;
    advice: string;
    amplified?: { ko: string; base: number; withSloop: number }[];
    slots?: string;
    synthetic?: {
      recipe: string;
      unlockedByKo: string;
      why: string;
      catch: string;
    };
  }[];
  /** 동물군은 반대다 — 되살아난다. 나란히 놓아야 오해가 안 생긴다 */
  $contrast: string;
};

const craftDoc = craft as {
  $key: string;
  rules: { ko: string; what: string; why: string; how: string; cost: string }[];
  $dispute: { ko: string; sides: { claim: string; why: string }[]; verdict: string };
};

const exploreDoc = exploration as {
  $key: string;
  steps: { order: number; ko: string; when: string; cost: string; what: string; why: string }[];
  gear: { ko: string; when: string; cost: string; effect: string; priority: string; why: string }[];
  tips: { ko: string; keys: string; what: string; why: string; source: string }[];
};

/** 소수점이 붙을 때만 보여준다. 5.00 대신 5 */
const num = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));

/** 레시피 → 산출 건물. "이 마일스톤에서 무엇이 열리는가"를 게임 데이터로 답하기 위한 색인 */
const buildingByRecipe = new Map<string, (typeof buildings)[number]>();
for (const b of buildings) {
  const rid = `Recipe_${b.id.replace(/^Build_/, '')}`;
  buildingByRecipe.set(rid, b);
}

const milestoneByKo = new Map(milestones.map((m) => [m.ko, m]));

/** 그 단계에서 실제로 열리는 건물 — 이름을 타이핑하지 않고 데이터에서 뽑는다 */
function unlockedBuildings(names: string[]) {
  const out: { ko: string; en: string }[] = [];
  const seen = new Set<string>();
  for (const n of names) {
    const m = milestoneByKo.get(n);
    if (!m) continue;
    for (const rid of m.unlocksRecipes ?? []) {
      const b = buildingByRecipe.get(rid);
      if (!b || seen.has(b.id)) continue;
      // 토대·벽 같은 건축 부재는 목록을 덮어버리므로 제외한다
      if (/Foundation|Wall|Ramp|Pillar|Beam|Catwalk|Stair|Fence|Roof|Sign/i.test(b.id)) continue;
      seen.add(b.id);
      out.push({ ko: b.ko, en: b.en });
    }
  }
  return out;
}

/** 목표 생산량 → 필요한 기계와 대수 */
function machinesFor(itemId: string, perMinute: number) {
  const r = defaultRecipeOf(itemId);
  if (!r) return null;
  const outPer = r.products.find((p) => p.item === itemId)?.perMinute ?? 0;
  if (!outPer) return null;
  const b = r.producedIn?.[0] ? building(r.producedIn[0]) : null;
  const exact = perMinute / outPer;
  return {
    machineKo: b?.ko ?? '—',
    machineId: b?.id,
    exact,
    count: Math.ceil(exact - 1e-9),
    clock: Math.round((exact / Math.ceil(exact - 1e-9)) * 1000) / 10,
    inputs: r.ingredients.map((g) => ({
      ko: item(g.item).ko,
      perMinute: (g.perMinute * perMinute) / outPer,
    })),
  };
}

const steps = spine.steps.map((s) => ({
  ...s,
  unlocks: unlockedBuildings(s.milestones),
  rows: s.targets.map((t) => ({
    ko: item(t.item).ko,
    en: item(t.item).en,
    perMinute: t.perMinute,
    note: (t as { note?: string }).note ?? null,
    plan: machinesFor(t.item, t.perMinute),
  })),
}));

const FLOWS: Record<string, FlowDef> = {
  hub: biomassLine(),
  't1-iron': ironLine(),
  /* 고체 바이오 연료는 티어 2 「장애물 제거」 해금이라 여기서 처음 그린다 */
  't2-assembler': smartPlatingLine(),
  't2-biofuel': biomassLine(true),
};
---

<Base
  title="가이드, 해금 순서대로 무엇을 얼마나"
  description="Satisfactory 진행 가이드. 허브부터 석탄 발전까지, 그 시점에 실제로 열려 있는 것만 다룹니다."
  section="guide"
>
  <div class="wrap page">
    <header class="page-head">
      <p class="marker"><span class="num">가이드</span></p>
      <h1>해금 순서대로<br /><span class="fx-gradient-text">무엇을 얼마나</span></h1>
      <p class="lede prose">
        각 단계는 그 시점에 <strong>실제로 열려 있는 것만</strong> 다룹니다.
      </p>
    
      <p class="startlink">
        아직 시작도 안 했다면 — <a href={`${base}/guide/start/`}>어디서 시작할 것인가</a>부터 보세요.
        네 시작 지역의 철·구리·석회석·S.A.M. 노드 수를 세어 비교합니다.
      </p>
</header>

    <div class="layout">
      <nav class="toc" aria-label="단계 목차">
        <ol>
          {steps.map((s, i) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="toc-n n">{String(i).padStart(2, '0')}</span>
                <span class="toc-t">{s.title}</span>
                <span class="toc-tier n">{s.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="body">
        {steps.map((s, i) => (
          <section class="step" id={s.id}>
            <p class="marker">
              <span class="num">{String(i).padStart(2, '0')}</span> {s.label}
            </p>
            <h2>{s.title}</h2>
            <p class="goal">{s.goal}</p>

            {s.unlocks.length > 0 && (
              <div class="gate">
                <p class="gate-note">{s.gateNote}</p>
                <ul class="unlocks">
                  {s.unlocks.slice(0, 10).map((b) => (
                    <li class="chip">{b.ko}</li>
                  ))}
                </ul>
              </div>
            )}

            <h3 class="sub">지금 지을 것</h3>
            <ol class="actions">
              {s.actions.map((a) => (
                <li>
                  <p class="do">{a.do}</p>
                  <p class="why">{a.why}</p>
                </li>
              ))}
            </ol>

            {s.rows.length > 0 && (
              <>
                <h3 class="sub">목표 생산량</h3>
                <div class="scroll-x">
                  <table>
                    <thead>
                      <tr>
                        <th>부품</th>
                        <th class="n">분당</th>
                        <th>기계</th>
                        <th class="n">대수</th>
                        <th class="n">클럭</th>
                        <th>재료</th>
                      </tr>
                    </thead>
                    <tbody>
                      {s.rows.map((r) => (
                        <tr>
                          <td>
                            {r.ko} <span class="en">{r.en}</span>
                            {r.note && <span class="rownote">{r.note}</span>}
                          </td>
                          <td class="n">{num(r.perMinute)}</td>
                          <td>{r.plan?.machineKo ?? '채굴기'}</td>
                          <td class="n">{r.plan ? r.plan.count : ''}</td>
                          <td class="n">{r.plan && r.plan.clock < 100 ? `${num(r.plan.clock)}%` : ''}</td>
                          <td class="small muted">
                            {r.plan?.inputs.map((g) => (
                              <span class="chip">{g.ko} <span class="n">{num(g.perMinute)}</span></span>
                            ))}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            )}

            {FLOWS[s.id] && (
              <div class="flowwrap">
                <FlowChart
                  rows={FLOWS[s.id]!.rows}
                  links={FLOWS[s.id]!.links}
                  caption={FLOWS[s.id]!.caption}
                  index={i + 1}
                />
              </div>
            )}
            {s.id === 't2-assembler' && (
              <div class="flowwrap">
                <FlowChart
                rows={FLOWS['t2-biofuel']!.rows}
                links={FLOWS['t2-biofuel']!.links}
                caption={FLOWS['t2-biofuel']!.caption}
                index={90}
              />
              </div>
            )}

            {s.leaveRoom && (
              <div class="keep">
                <p class="keep-tag">남겨둘 것</p>
                <p class="keep-body">{s.leaveRoom}</p>
              </div>
            )}
          </section>
        ))}

        <section class="step" id="finite">
          <p class="marker"><span class="num">주의</span> 유한 자원</p>
          <h2>다시 자라지 않는 것들</h2>
          <p class="prose muted">
            채굴 노드는 무한하지만 아래 넷은 아닙니다. 맵에 놓인 개수가 정해져 있고 게임이
            경고해 주지 않아서, 초반에 아무 데나 써 버리는 일이 흔합니다.
          </p>

          <div class="finite">
            {finiteDoc.items.map((f) => (
              <article class="fin">
                <header class="fin-head">
                  {f.id && (
                    <img
                      class="fin-icon"
                      src={`${base}/assets/items/${f.id}.png`}
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy"
                    />
                  )}
                  <h3>{f.ko}</h3>
                </header>
                <p class="fin-what">{f.what}</p>
                <dl class="fin-rows">
                  <dt>무엇이 되나</dt>
                  <dd>{f.becomes}</dd>
                  <dt>어디에 쓰나</dt>
                  <dd>{f.usedFor.join(' · ')}</dd>
                  <dt class="is-warn">함정</dt>
                  <dd>{f.warning}</dd>
                  <dt class="is-do">권장</dt>
                  <dd class="is-do">{f.advice}</dd>
                  {f.slots && (
                    <>
                      <dt>슬롯 수</dt>
                      <dd>{f.slots}</dd>
                    </>
                  )}
                </dl>
                {f.synthetic && (() => {
                  /* 수치를 타이핑하지 않는다 — 레시피에서 가져온다 */
                  const r = recipe(f.synthetic.recipe);
                  const b = building(r.producedIn[0]!);
                  const shows = (xs: { item: string; perMinute: number }[]) =>
                    xs.map((x) => `${item(x.item).ko} ${x.perMinute}/분`).join(' + ');
                  return (
                    <div class="synth">
                      <p class="synth-head">
                        <span class="synth-tag">나중에</span>
                        {r.ko} · {b.ko}
                        <span class="synth-when">{f.synthetic.unlockedByKo}</span>
                      </p>
                      <p class="synth-eq n">
                        {shows(r.ingredients)} → {shows(r.products)}
                      </p>
                      <p>{f.synthetic.why}</p>
                      <p class="synth-catch">{f.synthetic.catch}</p>
                    </div>
                  );
                })()}

                {f.amplified && (
                  <table class="amp">
                    <thead>
                      <tr>
                        <th>슬러그</th>
                        <th class="n">그냥 변환</th>
                        <th class="n">소머슬룹 1개</th>
                      </tr>
                    </thead>
                    <tbody>
                      {f.amplified.map((a) => (
                        <tr>
                          <td>{a.ko}</td>
                          <td class="n">{a.base}</td>
                          <td class="n is-amp">{a.withSloop}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </article>
            ))}
          </div>

          <p class="contrast prose">
            <span class="contrast-tag">반대로</span>
            {finiteDoc.$contrast}
          </p>
        </section>

        <section class="step" id="purity">
          <p class="marker"><span class="num">판단</span> 노드 순도</p>
          <h2>순수 노드를 찾아 멀리 가지 않는다</h2>
          <p class="prose muted">{purityDoc.$key}</p>

          <table class="pur">
            <thead>
              <tr>
                <th>채굴기</th>
                {PURITY_MULT.map((q) => (
                  <th class="n">{q.ko}</th>
                ))}
                <th class="n">순수·250%</th>
                <th>그때 필요한 벨트</th>
              </tr>
            </thead>
            <tbody>
              {miners.map((m) => (
                <tr>
                  <th scope="row">{m.ko}</th>
                  {m.byPurity.map((q) => (
                    <td class="n">{q.perMin}</td>
                  ))}
                  <td class="n is-amp">{m.maxPure}</td>
                  <td>
                    {beltFor(m.maxPure).ko}
                    <span class="pur-sub n"> {m.maxPowerMW} MW</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="caption">단위는 분당 개수입니다. 250%는 동력 조각 3개를 꽂은 최대치입니다.</p>

          <div class="pur-pts">
            {purityDoc.points.map((x) => (
              <article class="pur-pt">
                <h3>{x.title}</h3>
                <p>{x.body}</p>
              </article>
            ))}
          </div>

          <p class="contrast prose">
            <span class="contrast-tag">단</span>
            {purityDoc.$when}
          </p>

          <details class="src">
            <summary>출처</summary>
            <ol>
              {purityDoc.points.map((x) => (
                <li>{x.source}</li>
              ))}
            </ol>
          </details>
        </section>

        <section class="step" id="explore">
          <p class="marker"><span class="num">편의</span> 탐험</p>
          <h2>탐험이 곧 편의성이다</h2>
          <p class="prose muted">{exploreDoc.$key}</p>

          <ol class="ex-steps">
            {exploreDoc.steps.map((x) => (
              <li class="ex">
                <p class="ex-head">
                  <span class="ex-n n">{x.order}</span>
                  <span class="ex-ko">{x.ko}</span>
                  <span class="ex-when n">{x.when}</span>
                </p>
                <p class="ex-what">{x.what}</p>
                <p class="ex-why">{x.why}</p>
                <p class="ex-cost n">{x.cost}</p>
              </li>
            ))}
          </ol>

          <h3 class="ex-h3">장비 — 무엇부터 열 것인가</h3>
          <div class="scroll-x">
            <table class="ex-gear">
              <thead>
                <tr>
                  <th>장비</th>
                  <th>어디서</th>
                  <th>무엇이 달라지나</th>
                  <th>우선</th>
                </tr>
              </thead>
              <tbody>
                {exploreDoc.gear.map((g) => (
                  <tr>
                    <th scope="row">
                      {g.ko}
                      <small>{g.cost}</small>
                    </th>
                    <td class="n">{g.when}</td>
                    <td>
                      {g.effect}
                      <small>{g.why}</small>
                    </td>
                    <td class={`ex-pri is-${g.priority === '높음' ? 'hi' : g.priority === '중간' ? 'mid' : 'low'}`}>
                      {g.priority}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {exploreDoc.tips.map((t) => (
            <div class="tip">
              <p class="tip-head">
                <kbd>{t.keys}</kbd>
                {t.ko}
              </p>
              <p>{t.what}</p>
              <p class="tip-why">{t.why}</p>
            </div>
          ))}

          <details class="src">
            <summary>출처</summary>
            <ol>
              {exploreDoc.tips.map((t) => (
                <li>{t.source}</li>
              ))}
            </ol>
          </details>
        </section>

        <section class="step" id="craft">
          <p class="marker"><span class="num">마감</span> 짓는 법</p>
          <h2>떠 있는 것과 지어진 것</h2>
          <p class="prose muted">{craftDoc.$key}</p>

          <div class="craft">
            {craftDoc.rules.map((r, i) => (
              <article class="cr">
                <p class="cr-head">
                  <span class="cr-n n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="cr-ko">{r.ko}</span>
                </p>
                <p class="cr-what">{r.what}</p>
                <p class="cr-why">{r.why}</p>
                <dl class="cr-rows">
                  <dt>치수</dt>
                  <dd>{r.how}</dd>
                  <dt>재료</dt>
                  <dd>{r.cost}</dd>
                </dl>
              </article>
            ))}
          </div>

          <div class="cr-dispute">
            <h3>{craftDoc.$dispute.ko}</h3>
            <div class="cr-sides">
              {craftDoc.$dispute.sides.map((sd) => (
                <div class="cr-side">
                  <p class="cr-claim">{sd.claim}</p>
                  <p class="cr-cwhy">{sd.why}</p>
                </div>
              ))}
            </div>
            <p class="cr-verdict">{craftDoc.$dispute.verdict}</p>
          </div>
        </section>

        <section class="step is-open">
          <p class="marker"><span class="num">{String(steps.length).padStart(2, '0')}</span> 티어 4 이후</p>
          <h2>아직 쓰지 않았습니다</h2>
          <p class="wide muted">
            티어 4부터는 해금 목록과 요구 부품만 <a href={`${base}/codex/reference/`}>표</a>로 제공합니다.
            진행 조언은 조사가 끝나는 대로 같은 형식으로 추가합니다.
          </p>
        </section>
      </div>
    </div>
  </div>

  <style>
    .page { padding-block: var(--s16) 0; }
    .page-head { margin-bottom: var(--s16); }
    .page-head h1 { margin-bottom: var(--s5); line-height: 1.15; }
    .lede { font-size: var(--t-body-l); color: var(--ink-2); }
    .lede strong { color: var(--ink); font-weight: 600; }

    .layout { display: grid; gap: var(--s10); }
    @media (min-width: 1000px) {
      .layout { grid-template-columns: 240px minmax(0, 1fr); gap: var(--s16); align-items: start; }
      .toc { position: sticky; top: 5rem; }
    }
    @media (max-width: 999px) { .toc { display: none; } }

    .toc ol { margin: 0; padding: 0; list-style: none; }
    .toc li + li { border-top: var(--hair) solid var(--line); }
    .toc a {
      display: grid;
      grid-template-columns: 24px minmax(0, 1fr);
      gap: var(--s2);
      padding-block: var(--s3);
      text-decoration: none;
      font-size: var(--t-small);
      line-height: 1.45;
    }
    .toc-n { color: var(--ink-3); font-size: var(--t-caption); }
    .toc-t { font-weight: 600; }
    .toc-tier { grid-column: 2; font-size: var(--t-caption); color: var(--accent); }

    .step { padding-bottom: var(--s20); }
    .step + .step { border-top: var(--hair) solid var(--line); padding-top: var(--s16); }
    .step h2 { margin-bottom: var(--s4); }
    .goal {
      max-width: var(--measure);
      font-size: var(--t-body-l);
      color: var(--ink-2);
      margin-bottom: var(--s8);
    }

    .gate {
      margin-bottom: var(--s10);
      padding: var(--s4) var(--s5);
      border-left: 2px solid var(--primary);
      border-radius: var(--radius);
      background: var(--glass-raised);
      box-shadow: var(--lit);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .gate-note { margin-bottom: var(--s3); font-size: var(--t-small); }
    .unlocks { display: flex; flex-wrap: wrap; gap: var(--s2); margin: 0; padding: 0; list-style: none; }

    .sub {
      margin-bottom: var(--s4);
      font-size: var(--t-body);
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--ink-2);
    }
    .step > .sub:not(:first-of-type) { margin-top: var(--s10); }

    .actions { margin: 0 0 var(--s4); padding: 0; list-style: none; counter-reset: a; }
    .actions li {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr);
      gap: var(--s3);
      padding-block: var(--s4);
      border-top: var(--hair) solid var(--line);
      counter-increment: a;
    }
    .actions li:last-child { border-bottom: var(--hair) solid var(--line); }
    .actions li::before {
      content: counter(a);
      color: var(--primary);
      font-family: var(--font-mono);
      font-size: var(--t-caption);
      color: var(--accent);
      padding-top: 0.35em;
    }
    .do { grid-column: 2; margin: 0 0 var(--s1); font-weight: 600; }
    .why {
      grid-column: 2;
      margin: 0;
      max-width: var(--measure);
      font-size: var(--t-small);
      color: var(--ink-2);
    }

    .rownote { display: block; font-size: var(--t-caption); color: var(--ink-3); }
    td .chip { margin: 1px 2px 1px 0; }

    .flowwrap { margin-top: var(--s10); }

    .keep {
      margin-top: var(--s10);
      padding: var(--s5);
      border-radius: var(--radius);
      background: var(--glass);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, white 10%, transparent),
        0 0 0 1px color-mix(in oklab, var(--accent) 34%, transparent);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .keep-tag {
      margin-bottom: var(--s2);
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .keep-body { margin: 0; font-weight: 600; max-width: var(--measure); }

    .step.is-open h2 { color: var(--ink-2); }

    /* 게임이 알려 주지 않는 조작 */
    .tip {
      margin-top: var(--s4);
      padding: var(--s3);
      border-left: 2px solid var(--primary);
      background: var(--surface);
    }
    .tip p {
      margin: 0 0 6px;
      color: var(--ink-2);
      font-size: var(--t-body-s);
      line-height: 1.7;
      word-break: keep-all;
    }
    .tip p:last-child { margin-bottom: 0; }
    .tip-head {
      display: flex;
      gap: 9px;
      align-items: baseline;
      color: var(--ink) !important;
      font-weight: 600;
    }
    .tip kbd {
      padding: 2px 8px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 3px;
      background: var(--raised);
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: var(--t-caption);
      white-space: nowrap;
    }
    .tip-why { color: var(--ink-3) !important; }

    /* 합성 동력 조각 — 슬러그 칸 안의 「나중에 열리는 길」 */
    .synth {
      margin-top: var(--s3);
      padding: var(--s3);
      border: var(--hair) solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .synth p {
      margin: 0 0 6px;
      color: var(--ink-2);
      font-size: var(--t-body-s);
      line-height: 1.7;
      word-break: keep-all;
    }
    .synth p:last-child { margin-bottom: 0; }
    .synth-head {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      align-items: baseline;
      color: var(--ink) !important;
      font-weight: 600;
    }
    .synth-tag {
      padding: 1px 7px;
      border: var(--hair) solid var(--line-strong);
      border-radius: 3px;
      color: var(--ink-3);
      font-size: var(--t-caption);
      font-weight: 400;
    }
    .synth-when { color: var(--ink-3); font-size: var(--t-caption); font-weight: 400; }
    .synth-eq {
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: var(--t-caption) !important;
      white-space: nowrap;
    }
    .synth-catch { color: var(--warn, #e0a13c) !important; }

    /* 순도 표 — 수치는 오른쪽 맞춤, 자릿수가 눈으로 비교돼야 한다 */
    .pur {
      width: 100%;
      margin-top: var(--s4);
      border-collapse: collapse;
      font-size: var(--t-body-s);
    }
    .pur th,
    .pur td {
      padding: 9px 10px;
      border-bottom: var(--hair) solid var(--line);
      text-align: left;
    }
    .pur thead th {
      color: var(--ink-3);
      font-size: var(--t-caption);
      font-weight: 500;
    }
    .pur .n {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      text-align: right;
    }
    .pur tbody th { color: var(--ink); font-weight: 500; white-space: nowrap; }
    .pur .is-amp { color: var(--primary); }
    .pur-sub { display: block; color: var(--ink-3); font-size: var(--t-caption); }

    .pur-pts {
      display: grid;
      gap: var(--s3);
      margin-top: var(--s5);
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
    .pur-pt {
      padding: var(--s3);
      border-left: 2px solid var(--line-strong);
    }
    .pur-pt h3 {
      margin: 0 0 6px;
      font-size: var(--t-body);
      font-weight: 600;
      word-break: keep-all;
    }
    .pur-pt p {
      margin: 0;
      color: var(--ink-2);
      font-size: var(--t-body-s);
      line-height: 1.7;
      word-break: keep-all;
    }

    /* 출처는 각주로 내린다 — 화면은 결론만 */
    .src { margin-top: var(--s4); }
    .src summary {
      color: var(--ink-3);
      font-size: var(--t-caption);
      cursor: pointer;
    }
    .src ol {
      margin: var(--s2) 0 0;
      padding-left: 1.4em;
      color: var(--ink-3);
      font-size: var(--t-caption);
      line-height: 1.7;
    }

    .contrast {
      margin: var(--s5) 0 0;
      padding: var(--s4) var(--s5);
      border-left: 3px solid var(--primary);
      border-radius: 0 var(--radius) var(--radius) 0;
      background: color-mix(in oklab, var(--primary) 7%, transparent);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
    }
    .contrast-tag {
      display: inline-block;
      margin-right: var(--s2);
      color: var(--primary);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }

    .ex-steps {
      display: grid;
      gap: var(--s3);
      margin: var(--s6) 0 var(--s8);
      padding: 0;
      list-style: none;
    }
    .ex {
      padding: var(--s4) var(--s5);
      border-radius: var(--radius);
      background: var(--raised);
      box-shadow: var(--lit);
    }
    .ex-head { display: flex; align-items: baseline; gap: var(--s3); margin: 0 0 var(--s2); }
    .ex-n { color: var(--accent); font-family: var(--font-mono); font-weight: 600; }
    .ex-ko { font-size: var(--t-body-l); font-weight: 600; }
    .ex-when { margin-left: auto; color: var(--ink-3); font-family: var(--font-mono); font-size: var(--t-caption); }
    .ex-what { margin: 0 0 var(--s2); max-width: var(--measure); word-break: keep-all; }
    .ex-why {
      margin: 0 0 var(--s3);
      max-width: var(--measure);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
    }
    .ex-cost { margin: 0; color: var(--ink-3); font-family: var(--font-mono); font-size: var(--t-caption); }

    .ex-h3 { margin: 0 0 var(--s4); font-size: var(--t-body-l); }
    .ex-gear { width: 100%; border-collapse: collapse; font-size: var(--t-small); }
    .ex-gear th, .ex-gear td {
      padding: var(--s3) var(--s4);
      border-bottom: var(--hair) solid var(--line);
      text-align: left;
      vertical-align: top;
      word-break: keep-all;
    }
    .ex-gear thead th { color: var(--ink-3); font-family: var(--font-mono); font-size: 11px; font-weight: 500; }
    .ex-gear tbody th { font-weight: 600; white-space: nowrap; }
    .ex-gear small {
      display: block;
      margin-top: 3px;
      color: var(--ink-3);
      font-size: var(--t-caption);
      font-weight: 400;
      white-space: normal;
    }
    .ex-pri { font-family: var(--font-mono); white-space: nowrap; }
    .ex-pri.is-hi { color: var(--accent); }
    .ex-pri.is-mid { color: var(--ink-2); }
    .ex-pri.is-low { color: var(--ink-3); }

    .craft { display: grid; gap: var(--s3); margin: var(--s6) 0 var(--s8); }
    @media (min-width: 900px) { .craft { grid-template-columns: 1fr 1fr; } }
    .cr {
      padding: var(--s4) var(--s5);
      border-radius: var(--radius);
      background: var(--raised);
      box-shadow: var(--lit);
    }
    .cr-head { display: flex; align-items: baseline; gap: var(--s3); margin: 0 0 var(--s2); }
    .cr-n { color: var(--primary); font-family: var(--font-mono); font-size: var(--t-caption); }
    .cr-ko { font-size: var(--t-body-l); font-weight: 600; word-break: keep-all; }
    .cr-what { margin: 0 0 var(--s2); max-width: var(--measure); word-break: keep-all; }
    .cr-why {
      margin: 0 0 var(--s3);
      max-width: var(--measure);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
    }
    .cr-rows {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 4px var(--s3);
      margin: 0;
      font-size: var(--t-caption);
    }
    .cr-rows dt { color: var(--ink-3); font-family: var(--font-mono); }
    .cr-rows dd { margin: 0; color: var(--ink-2); word-break: keep-all; }

    .cr-dispute {
      padding: var(--s5);
      border-radius: var(--radius);
      background: color-mix(in oklab, var(--primary) 6%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--primary) 18%, transparent);
    }
    .cr-dispute h3 { margin: 0 0 var(--s4); font-size: var(--t-body-l); }
    .cr-sides { display: grid; gap: var(--s4); margin-bottom: var(--s4); }
    @media (min-width: 720px) { .cr-sides { grid-template-columns: 1fr 1fr; } }
    .cr-claim { margin: 0 0 4px; font-weight: 600; word-break: keep-all; }
    .cr-cwhy {
      margin: 0;
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      word-break: keep-all;
    }
    .cr-verdict {
      margin: 0;
      padding-top: var(--s4);
      border-top: var(--hair) solid color-mix(in oklab, var(--primary) 22%, transparent);
      font-size: var(--t-small);
      line-height: 1.8;
      word-break: keep-all;
    }

    .startlink {
      margin: var(--s5) 0 0;
      padding: var(--s3) var(--s4);
      border-left: 3px solid var(--primary);
      border-radius: 0 var(--radius) var(--radius) 0;
      background: color-mix(in oklab, var(--primary) 7%, transparent);
      font-size: var(--t-small);
      line-height: 1.8;
      color: var(--ink-2);
      max-width: var(--measure);
      word-break: keep-all;
    }

    .finite { display: grid; gap: var(--s4); }
    @media (min-width: 900px) { .finite { grid-template-columns: 1fr 1fr; } }
    .fin {
      padding: var(--s5);
      border-radius: calc(var(--radius) * 2);
      background: var(--glass);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, white 10%, transparent),
        0 0 0 1px color-mix(in oklab, var(--danger) 24%, transparent);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .fin-head { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s3); }
    .fin-head h3 { font-size: var(--t-body-l); }
    .fin-icon { flex: none; }
    .fin-what { margin: 0 0 var(--s4); font-size: var(--t-small); color: var(--ink-2); }
    .fin-rows {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: var(--s2) var(--s4);
      margin: 0;
      font-size: var(--t-small);
    }
    .fin-rows dt {
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.06em;
      color: var(--ink-3);
      padding-top: 2px;
    }
    .fin-rows dt.is-warn { color: var(--danger); }
    .fin-rows dt.is-do { color: var(--ok); }
    .fin-rows dd { margin: 0; color: var(--ink-2); }
    .fin-rows dd.is-do { color: var(--ink); font-weight: 500; }
    .amp { margin-top: var(--s4); font-size: var(--t-caption); }
    .amp thead th { position: static; background: transparent; padding-block: 0 4px; }
    .amp td, .amp th { padding-inline: 0 var(--s3); }
    .amp .is-amp { color: var(--ok); font-weight: 600; }
    @media (max-width: 620px) {
      .fin-rows { grid-template-columns: minmax(0, 1fr); gap: 2px; }
      .fin-rows dd { margin-bottom: var(--s3); }
    }
    .wide { max-width: var(--measure-wide); }
  </style>
</Base>
