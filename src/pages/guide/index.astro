  <script>
    /*
     * 세이브를 읽어 "지금 어느 구간인가"를 표시한다.
     *
     * 구간이 끝났다 = 그 구간의 마일스톤을 전부 샀다. 지금 구간 = 안 끝난 첫 구간.
     * 판정은 클래스명 대조뿐이라 게임 표기가 바뀌어도 흔들리지 않는다.
     */
    import { loadProgress, saveProgress, clearProgress } from '../../lib/progress';

    const box = document.querySelector('[data-prog-file]') as HTMLInputElement | null;
    const label = document.querySelector('[data-prog-label]') as HTMLElement | null;
    const msg = document.querySelector('[data-prog-msg]') as HTMLElement | null;
    const wrap = document.querySelector('[data-prog-load]') as HTMLElement | null;
    const bar = document.querySelector('[data-prog]') as HTMLElement | null;
    const where = document.querySelector('[data-prog-where]') as HTMLElement | null;
    const who = document.querySelector('[data-prog-who]') as HTMLElement | null;
    const clearBtn = document.querySelector('[data-prog-clear]') as HTMLElement | null;
    const hubIds = (window as unknown as { __sfopsHubIds?: string[] }).__sfopsHubIds ?? [];

    const STAGE = { done: '끝남', now: '지금 여기', next: '앞으로' };

    function paint() {
      const p = loadProgress(hubIds);
      const groups = [...document.querySelectorAll<HTMLElement>('[data-step][data-need]')];
      if (!p) {
        groups.forEach((g) => {
          g.classList.remove('is-done', 'is-now', 'is-next');
          const s = g.querySelector<HTMLElement>('[data-stage]');
          if (s) s.hidden = true;
          const box = g.querySelector<HTMLElement>('[data-remain]');
          if (box) box.hidden = true;
        });
          if (bar) bar.hidden = true;
        const link0 = document.querySelector<HTMLElement>('[data-startlink]');
        if (link0) link0.hidden = false;
        return;
      }
      const have = new Set(p.ids);
      /* 구간 순서대로 훑어 안 끝난 첫 구간을 지금으로 삼는다 */
      const seen = new Set<string>();
      let nowId: string | null = null;
      for (const g of groups) {
        const id = g.dataset.step!;
        if (seen.has(id)) continue;
        seen.add(id);
        const need = g.dataset.need!.split(' ').filter(Boolean);
        if (!need.every((n) => have.has(n)) && nowId === null) nowId = id;
      }

      let doneCount = 0;
      const titles = new Map<string, string>();
      for (const g of groups) {
        const id = g.dataset.step!;
        const need = g.dataset.need!.split(' ').filter(Boolean);
        const done = need.every((n) => have.has(n));
        const stage = done ? 'done' : id === nowId ? 'now' : 'next';
        g.classList.toggle('is-done', stage === 'done');
        g.classList.toggle('is-now', stage === 'now');
        g.classList.toggle('is-next', stage === 'next');
        const tag = g.querySelector<HTMLElement>('[data-stage]');
        if (tag) {
          tag.hidden = false;
          tag.textContent = STAGE[stage];
        }
        if (g.tagName === 'SECTION') {
          if (done) doneCount++;
          const h = g.querySelector('h2');
          if (h) titles.set(id, h.textContent ?? '');

          /* 몇 개 중 몇 개인지, 그리고 뭐가 남았는지 */
          const got = need.filter((n) => have.has(n)).length;
          if (tag) tag.textContent = `${STAGE[stage]} · ${got}/${need.length}`;

          const box = g.querySelector<HTMLElement>('[data-remain]');
          if (box) {
            const rows = [...box.querySelectorAll<HTMLElement>('[data-ms]')];
            rows.forEach((r) => {
              r.hidden = have.has(r.dataset.ms!);
            });
            /* 다 산 구간에는 보여 줄 게 없다 */
            box.hidden = stage !== 'now' || rows.every((r) => r.hidden);
          }
        }
      }

      /* 36시간 하고 있는 사람에게 「어디서 시작할까」는 필요 없다 */
      const link = document.querySelector<HTMLElement>('[data-startlink]');
      if (link) link.hidden = doneCount > 0;

      if (bar && where && who) {
        bar.hidden = false;
        where.textContent = nowId
          ? `지금 여기 — ${titles.get(nowId) ?? nowId}`
          : '모든 구간을 끝냈습니다';
        who.textContent = p.session
          ? `${p.session} · ${p.hours}시간 · 구간 ${doneCount}개 완료`
          : `이전 앱에서 복원 · 구간 ${doneCount}개 완료`;
      }
    }

    box?.addEventListener('change', async () => {
      const file = box.files?.[0];
      if (!file || !label || !wrap || !msg) return;
      wrap.classList.add('is-busy');
      label.textContent = '읽는 중…';
      try {
        const { readSave } = await import('../../lib/save-import');
        const unlocks = (window as unknown as { __sfopsUnlocks?: Record<string, string[]> })
          .__sfopsUnlocks;
        const r = await readSave(file, unlocks ?? {});
        saveProgress({ ids: r.schematicIds, session: r.session, hours: r.hours });
        /* 한 번 읽을 때 딸려 오는 것은 같이 저장한다. 두 번 고르게 하지 않는다 */
        if (r.alternates.length) {
          const cur = JSON.parse(localStorage.getItem('sfops.owned') || 'null') as {
            ids?: string[];
          } | null;
          const ids = [...new Set([...(cur?.ids ?? []), ...r.alternates])];
          localStorage.setItem('sfops.owned', JSON.stringify({ version: 1, ids }));
        }
        msg.textContent = `마일스톤 ${r.schematicIds.length}개를 읽었습니다.`;
        paint();
        document.querySelector('.step.is-now')?.scrollIntoView({ block: 'start' });
      } catch (err) {
        msg.textContent = '읽지 못했습니다 — ' + (err instanceof Error ? err.message : String(err));
      } finally {
        wrap.classList.remove('is-busy');
        label.textContent = '세이브를 열어 내 진행에 맞추기';
        box.value = '';
      }
    });

    clearBtn?.addEventListener('click', () => {
      clearProgress();
      paint();
    });

    paint();
  </script>

  <script>
    /*
     * 목차가 「지금 어디를 보고 있나」를 가리킨다.
     *
     * 진행 상황 표시(is-now)와는 다른 것이다 — 그건 게임에서 어디까지 왔나이고,
     * 이건 화면에서 지금 무엇을 읽고 있나다. 둘이 같은 표시를 쓰면 구별이 안 된다.
     *
     * 스크롤 위치로 직접 계산하지 않고 교차 관찰기를 쓴다. 스크롤마다 계산하면
     * 긴 문서에서 끊긴다.
     */
    const secs = [...document.querySelectorAll<HTMLElement>('.body section[id]')];
    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')].map((a) => [
        a.getAttribute('href')!.slice(1),
        a.closest('li') as HTMLElement,
      ])
    );

    if (secs.length && links.size && typeof IntersectionObserver !== 'undefined') {
      /* 화면에 걸쳐 있는 절들 중 가장 위의 것을 「여기」로 본다 */
      const onScreen = new Set<string>();
      const mark = () => {
        let here: string | null = null;
        for (const sec of secs) {
          if (!onScreen.has(sec.id)) continue;
          here = sec.id;
          break;
        }
        for (const [id, li] of links) li.classList.toggle('is-here', id === here);
      };
      const io = new IntersectionObserver(
        (rows) => {
          for (const r of rows) {
            if (r.isIntersecting) onScreen.add(r.target.id);
            else onScreen.delete(r.target.id);
          }
          mark();
        },
        /* 위쪽 머리 띠 높이만큼 빼고 본다 */
        { rootMargin: '-88px 0px -55% 0px' }
      );
      secs.forEach((sec) => io.observe(sec));
    }
  </script>

  <style>
    .page { padding-block: var(--s16) 0; }
    .page-head { margin-bottom: var(--s16); }
    .page-head h1 { margin-bottom: var(--s5); line-height: 1.15; }
    .lede { font-size: var(--t-body-l); color: var(--ink-2); }
    .lede strong { color: var(--ink); font-weight: 600; }

    .layout { display: grid; gap: var(--s10); }
    @media (min-width: 1000px) {
      .layout { grid-template-columns: 240px minmax(0, 1fr); gap: var(--s16); align-items: start; }
      .toc { position: sticky; top: 5rem; }
    }
    @media (max-width: 999px) { .toc { display: none; } }

    .toc ol { margin: 0; padding: 0; list-style: none; }
    .toc li + li { border-top: var(--hair) solid var(--line); }
    .toc a {
      display: grid;
      grid-template-columns: 24px minmax(0, 1fr);
      gap: var(--s2);
      padding-block: var(--s3);
      text-decoration: none;
      font-size: var(--t-small);
      line-height: 1.45;
    }
    /*
     * 지금 보고 있는 곳. 진행 상황(is-now)과 다른 신호라 다른 방식으로 표시한다 —
     * 진행은 글자 색, 위치는 왼쪽 막대다. 둘이 겹쳐도 각각 읽힌다.
     */
    .toc li { position: relative; }
    .toc li::before {
      content: '';
      position: absolute;
      inset-block: 4px;
      left: -12px;
      width: 2px;
      border-radius: 1px;
      background: var(--ink);
      opacity: 0;
      transition: opacity 120ms ease;
    }
    .toc li.is-here::before { opacity: 1; }
    .toc li.is-here .toc-t { color: var(--ink); }
    .toc li:not(.is-here) .toc-t { color: var(--ink-2); }
    .toc li.is-done:not(.is-here) a { opacity: 0.5; }

    .toc-n { color: var(--ink-3); font-size: var(--t-caption); }
    .toc-t { font-weight: 600; }
    .toc-tier { grid-column: 2; font-size: var(--t-caption); color: var(--accent); }

    /*
     * 본문은 그리드 칸이다. 그리드 칸의 자동 최소 너비는 min-content 라서,
     * 안에 든 표 하나가 넓으면 **칸 전체가 그만큼 벌어져** 페이지가 옆으로 밀린다.
     * 390px 에서 본문이 536px 로 굳어 모든 문단의 오른쪽이 잘렸다. 최소 너비를 푼다 —
     * 넘치는 것은 자기 상자(.scroll-x · .flowwrap) 안에서만 가로로 넘긴다.
     */
    .body { min-width: 0; max-width: 100%; }

    /* 해시 오프셋은 base.css의 html scroll-padding-top 하나만 정본으로 쓴다. */
    .step { min-width: 0; max-width: 100%; padding-bottom: var(--s20); }
    .step + .step { border-top: var(--hair) solid var(--line); padding-top: var(--s16); }
    .step h2 { margin-bottom: var(--s4); }
    .brief {
      max-width: var(--measure);
      font-size: var(--t-body-l);
      color: var(--ink-2);
      margin-bottom: var(--s8);
    }

    .completion {
      margin-bottom: var(--s10);
      padding: var(--s5);
      border: var(--hair) solid var(--line);
      border-left: 3px solid var(--primary);
      border-radius: var(--radius);
      background: var(--glass-raised);
      box-shadow: var(--lit);
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .completion-k,
    .sequence-copy p > span,
