    }
    .sequence-copy { grid-column: 2; display: grid; gap: var(--s2); }
    .sequence-copy p { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: var(--s3); margin: 0; }
    .build { font-weight: 650; }
