    .step > .sub:not(:first-of-type) { margin-top: var(--s10); }

    .sequence { margin: 0 0 var(--s4); padding: 0; list-style: none; counter-reset: a; }
    .sequence li {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr);
