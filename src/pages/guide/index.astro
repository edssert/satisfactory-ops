---
/**
 * 가이드 — 이 사이트의 본체.
 *
 * 순서는 **게임의 해금 순서**를 따른다. 아직 못 짓는 것을 먼저 설명하지 않는다.
 * (석탄 발전을 맨 앞에 두었다가 티어 3 해금이라는 지적을 받았다. 그 실수를 구조로 막는다 —
 *  단계의 순서는 spine.json 이 정하고, 각 단계의 해금 내용은 게임 데이터에서 조회한다.)
 *
 * 규모는 마일스톤 요구량 역산이 아니라 **커뮤니티 표준 생산량**이다(spine.json 의 targets).
 * 기계 대수는 그 목표를 게임 레시피로 나눠 계산한다.
 */
import Base from '../../layouts/Base.astro';
import FlowChart from '../../components/FlowChart.astro';
import {
  building,
  buildings,
  defaultRecipeOf,
  item,
  milestones,
  recipe,
} from '../../lib/gamedata';
import spine from '../../data/curated/spine.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/** 소수점이 붙을 때만 보여준다. 5.00 대신 5 */
const num = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));

/** 레시피 → 산출 건물. "이 마일스톤에서 무엇이 열리는가"를 게임 데이터로 답하기 위한 색인 */
const buildingByRecipe = new Map<string, (typeof buildings)[number]>();
for (const b of buildings) {
  const rid = `Recipe_${b.id.replace(/^Build_/, '')}`;
  buildingByRecipe.set(rid, b);
}

const milestoneByKo = new Map(milestones.map((m) => [m.ko, m]));

/** 그 단계에서 실제로 열리는 건물 — 이름을 타이핑하지 않고 데이터에서 뽑는다 */
function unlockedBuildings(names: string[]) {
  const out: { ko: string; en: string }[] = [];
  const seen = new Set<string>();
  for (const n of names) {
    const m = milestoneByKo.get(n);
    if (!m) continue;
    for (const rid of m.unlocksRecipes ?? []) {
      const b = buildingByRecipe.get(rid);
      if (!b || seen.has(b.id)) continue;
      // 토대·벽 같은 건축 부재는 목록을 덮어버리므로 제외한다
      if (/Foundation|Wall|Ramp|Pillar|Beam|Catwalk|Stair|Fence|Roof|Sign/i.test(b.id)) continue;
      seen.add(b.id);
      out.push({ ko: b.ko, en: b.en });
    }
  }
  return out;
}

/** 목표 생산량 → 필요한 기계와 대수 */
function machinesFor(itemId: string, perMinute: number) {
  const r = defaultRecipeOf(itemId);
  if (!r) return null;
  const outPer = r.products.find((p) => p.item === itemId)?.perMinute ?? 0;
  if (!outPer) return null;
  const b = r.producedIn?.[0] ? building(r.producedIn[0]) : null;
  const exact = perMinute / outPer;
  return {
    machineKo: b?.ko ?? '—',
    machineId: b?.id,
    exact,
    count: Math.ceil(exact - 1e-9),
    clock: Math.round((exact / Math.ceil(exact - 1e-9)) * 1000) / 10,
    inputs: r.ingredients.map((g) => ({
      ko: item(g.item).ko,
      perMinute: (g.perMinute * perMinute) / outPer,
    })),
  };
}

const steps = spine.steps.map((s) => ({
  ...s,
  unlocks: unlockedBuildings(s.milestones),
  rows: s.targets.map((t) => ({
    ko: item(t.item).ko,
    en: item(t.item).en,
    perMinute: t.perMinute,
    note: (t as { note?: string }).note ?? null,
    plan: machinesFor(t.item, t.perMinute),
  })),
}));

// ---------------------------------------------------------------- 흐름도: 티어 1 철 라인
const beltMk1Rate = building('Build_ConveyorBeltMk1_C').beltItemsPerMinute ?? 60;
const smelter = building('Build_SmelterMk1_C');
const constructor = building('Build_ConstructorMk1_C');
const assembler = building('Build_AssemblerMk1_C');

const rIngot = recipe('Recipe_IngotIron_C');
const rPlate = recipe('Recipe_IronPlate_C');
const rRod = recipe('Recipe_IronRod_C');
const rScrew = recipe('Recipe_Screw_C');
const inOf = (r: typeof rIngot) => r.ingredients[0]?.perMinute ?? 0;
const outOf = (r: typeof rIngot) => r.products[0]?.perMinute ?? 0;

const smelterCount = Math.floor(beltMk1Rate / inOf(rIngot));
const ingotOut = smelterCount * outOf(rIngot);
const ingotSpare = ingotOut - inOf(rPlate) - inOf(rRod);
const rodSpare = outOf(rRod) - inOf(rScrew);

const ironFlow = {
  nodes: [
    { id: 'smelt', machineKo: smelter.ko, machineId: smelter.id, count: smelterCount, layer: 0 },
    {
      id: 'plate',
      machineKo: `${constructor.ko} · ${item('Desc_IronPlate_C').ko}`,
      machineId: constructor.id,
      count: 1,
      layer: 1,
      out: { itemKo: item('Desc_IronPlate_C').ko, itemId: 'Desc_IronPlate_C', perMinute: outOf(rPlate) },
    },
    {
      id: 'rod',
      machineKo: `${constructor.ko} · ${item('Desc_IronRod_C').ko}`,
      machineId: constructor.id,
      count: 1,
      layer: 1,
      out: { itemKo: item('Desc_IronRod_C').ko, itemId: 'Desc_IronRod_C', perMinute: rodSpare },
    },
    {
      id: 'screw',
      machineKo: `${constructor.ko} · ${item('Desc_IronScrew_C').ko}`,
      machineId: constructor.id,
      count: 1,
      layer: 2,
      out: { itemKo: item('Desc_IronScrew_C').ko, itemId: 'Desc_IronScrew_C', perMinute: outOf(rScrew) },
    },
  ],
  edges: [
    { from: 'smelt', to: 'plate', itemKo: item('Desc_IronIngot_C').ko, itemId: 'Desc_IronIngot_C', perMinute: inOf(rPlate), split: true },
    { from: 'smelt', to: 'rod', itemKo: item('Desc_IronIngot_C').ko, itemId: 'Desc_IronIngot_C', perMinute: inOf(rRod) },
    { from: 'rod', to: 'screw', itemKo: item('Desc_IronRod_C').ko, itemId: 'Desc_IronRod_C', perMinute: inOf(rScrew), split: true },
  ],
};

// ---------------------------------------------------------------- 흐름도: 티어 2 도금판
const rRotor = recipe('Recipe_Rotor_C');
const rRip = recipe('Recipe_IronPlateReinforced_C');
const rSmart = recipe('Recipe_SpaceElevatorPart_1_C');
const TARGET = 5;

const rotorPlan = machinesFor('Desc_Rotor_C', TARGET)!;
const ripPlan = machinesFor('Desc_IronPlateReinforced_C', TARGET)!;
const smartPlan = machinesFor('Desc_SpaceElevatorPart_1_C', TARGET)!;

const smartFlow = {
  nodes: [
    {
      id: 'rip',
      machineKo: `${assembler.ko} · ${item('Desc_IronPlateReinforced_C').ko}`,
      machineId: assembler.id,
      count: ripPlan.count,
      clock: ripPlan.clock,
      layer: 0,
    },
    {
      id: 'rotor',
      machineKo: `${assembler.ko} · ${item('Desc_Rotor_C').ko}`,
      machineId: assembler.id,
      count: rotorPlan.count,
      clock: rotorPlan.clock,
      layer: 0,
    },
    {
      id: 'smart',
      machineKo: `${assembler.ko} · ${item('Desc_SpaceElevatorPart_1_C').ko}`,
      machineId: assembler.id,
      count: smartPlan.count,
      clock: smartPlan.clock,
      layer: 1,
      out: {
        itemKo: item('Desc_SpaceElevatorPart_1_C').ko,
        itemId: 'Desc_SpaceElevatorPart_1_C',
        perMinute: TARGET,
      },
    },
  ],
  edges: [
    { from: 'rip', to: 'smart', itemKo: item('Desc_IronPlateReinforced_C').ko, itemId: 'Desc_IronPlateReinforced_C', perMinute: TARGET },
    { from: 'rotor', to: 'smart', itemKo: item('Desc_Rotor_C').ko, itemId: 'Desc_Rotor_C', perMinute: TARGET },
  ],
};

const FLOWS: Record<string, typeof ironFlow> = {
  't1-iron': ironFlow,
  't2-assembler': smartFlow,
};
const FLOW_CAPS: Record<string, string> = {
  't1-iron': `철괴 ${num(ingotOut)}개/분 중 ${num(ingotSpare)}개/분이 남습니다. 상자로 빼서 손 제작에 쓰거나, 철판 라인을 한 대 늘릴 때 씁니다.`,
  't2-assembler': `${assembler.ko} 두 대면 충분합니다. 대수를 늘리는 대신 클럭을 내립니다 — 전력이 지수로 오르기 때문입니다.`,
};
---

<Base
  title="가이드 — 해금 순서대로 무엇을 얼마나"
  description="Satisfactory 진행 가이드. 허브부터 석탄 발전까지, 그 시점에 실제로 열려 있는 것만 다룹니다."
  section="guide"
>
  <div class="wrap page">
    <header class="page-head">
      <p class="marker"><span class="num">가이드</span></p>
      <h1>해금 순서대로<br />무엇을 얼마나</h1>
      <p class="lede prose">
        각 단계는 그 시점에 <strong>실제로 열려 있는 것만</strong> 다룹니다. 생산량은 마일스톤
        요구량이 아니라 커뮤니티가 실제로 쓰는 규모입니다.
      </p>
    </header>

    <div class="layout">
      <nav class="toc" aria-label="단계 목차">
        <ol>
          {steps.map((s, i) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="toc-n n">{String(i).padStart(2, '0')}</span>
                <span class="toc-t">{s.title}</span>
                <span class="toc-tier n">{s.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="body">
        {steps.map((s, i) => (
          <section class="step" id={s.id}>
            <p class="marker">
              <span class="num">{String(i).padStart(2, '0')}</span> {s.label}
            </p>
            <h2>{s.title}</h2>
            <p class="goal">{s.goal}</p>

            {s.unlocks.length > 0 && (
              <div class="gate">
                <p class="gate-note">{s.gateNote}</p>
                <ul class="unlocks">
                  {s.unlocks.slice(0, 10).map((b) => (
                    <li class="chip">{b.ko}</li>
                  ))}
                </ul>
              </div>
            )}

            <h3 class="sub">지금 지을 것</h3>
            <ol class="actions">
              {s.actions.map((a) => (
                <li>
                  <p class="do">{a.do}</p>
                  <p class="why">{a.why}</p>
                </li>
              ))}
            </ol>

            {s.rows.length > 0 && (
              <>
                <h3 class="sub">목표 생산량</h3>
                <div class="scroll-x">
                  <table>
                    <thead>
                      <tr>
                        <th>부품</th>
                        <th class="n">분당</th>
                        <th>기계</th>
                        <th class="n">대수</th>
                        <th class="n">클럭</th>
                        <th>먹는 것</th>
                      </tr>
                    </thead>
                    <tbody>
                      {s.rows.map((r) => (
                        <tr>
                          <td>
                            {r.ko} <span class="en">{r.en}</span>
                            {r.note && <span class="rownote">{r.note}</span>}
                          </td>
                          <td class="n">{num(r.perMinute)}</td>
                          <td>{r.plan?.machineKo ?? '채굴기'}</td>
                          <td class="n">{r.plan ? r.plan.count : '—'}</td>
                          <td class="n">{r.plan && r.plan.clock < 100 ? `${num(r.plan.clock)}%` : '—'}</td>
                          <td class="small muted">
                            {r.plan?.inputs.map((g) => (
                              <span class="chip">{g.ko} <span class="n">{num(g.perMinute)}</span></span>
                            ))}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            )}

            {FLOWS[s.id] && (
              <div class="flowwrap">
                <FlowChart
                  nodes={FLOWS[s.id].nodes}
                  edges={FLOWS[s.id].edges}
                  input={
                    s.id === 't1-iron'
                      ? {
                          itemKo: item('Desc_OreIron_C').ko,
                          itemId: 'Desc_OreIron_C',
                          perMinute: beltMk1Rate,
                          note: '채굴기 1대 · 벨트 Mk.1 상한',
                        }
                      : undefined
                  }
                  caption={FLOW_CAPS[s.id]}
                />
              </div>
            )}

            {s.leaveRoom && (
              <div class="keep">
                <p class="keep-tag">남겨둘 것</p>
                <p class="keep-body">{s.leaveRoom}</p>
              </div>
            )}
          </section>
        ))}

        <section class="step is-open">
          <p class="marker"><span class="num">{String(steps.length).padStart(2, '0')}</span> 티어 4 이후</p>
          <h2>아직 쓰지 않았습니다</h2>
          <p class="prose muted">
            티어 4부터는 해금 목록과 요구 부품만 <a href={`${base}/tools/`}>표</a>로 제공합니다.
            진행 조언은 조사가 끝나는 대로 같은 형식으로 추가합니다.
          </p>
        </section>
      </div>
    </div>
  </div>

  <style>
    .page { padding-block: var(--s16) 0; }
    .page-head { margin-bottom: var(--s16); }
    .page-head h1 { margin-bottom: var(--s5); line-height: 1.15; }
    .lede { font-size: var(--t-body-l); color: var(--ink-2); }
    .lede strong { color: var(--ink); font-weight: 600; }

    .layout { display: grid; gap: var(--s10); }
    @media (min-width: 1000px) {
      .layout { grid-template-columns: 15rem minmax(0, 1fr); gap: var(--s16); align-items: start; }
      .toc { position: sticky; top: 5rem; }
    }
    @media (max-width: 999px) { .toc { display: none; } }

    .toc ol { margin: 0; padding: 0; list-style: none; }
    .toc li + li { border-top: var(--hair) solid var(--line); }
    .toc a {
      display: grid;
      grid-template-columns: 1.6rem minmax(0, 1fr);
      gap: var(--s2);
      padding-block: var(--s3);
      text-decoration: none;
      font-size: var(--t-small);
      line-height: 1.45;
    }
    .toc-n { color: var(--ink-3); font-size: var(--t-caption); }
    .toc-t { font-weight: 600; }
    .toc-tier { grid-column: 2; font-size: var(--t-caption); color: var(--accent); }

    .step { padding-bottom: var(--s20); }
    .step + .step { border-top: var(--hair) solid var(--line); padding-top: var(--s16); }
    .step h2 { margin-bottom: var(--s4); }
    .goal {
      max-width: var(--measure);
      font-size: var(--t-body-l);
      color: var(--ink-2);
      margin-bottom: var(--s8);
    }

    .gate {
      margin-bottom: var(--s10);
      padding: var(--s4) var(--s5);
      border-left: 2px solid var(--accent);
      background: var(--raised);
    }
    .gate-note { margin-bottom: var(--s3); font-size: var(--t-small); }
    .unlocks { display: flex; flex-wrap: wrap; gap: var(--s2); margin: 0; padding: 0; list-style: none; }

    .sub {
      margin-bottom: var(--s4);
      font-size: var(--t-body);
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--ink-2);
    }
    .step > .sub:not(:first-of-type) { margin-top: var(--s10); }

    .actions { margin: 0 0 var(--s4); padding: 0; list-style: none; counter-reset: a; }
    .actions li {
      display: grid;
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: var(--s3);
      padding-block: var(--s4);
      border-top: var(--hair) solid var(--line);
      counter-increment: a;
    }
    .actions li:last-child { border-bottom: var(--hair) solid var(--line); }
    .actions li::before {
      content: counter(a);
      font-family: var(--font-mono);
      font-size: var(--t-caption);
      color: var(--accent);
      padding-top: 0.35em;
    }
    .do { grid-column: 2; margin: 0 0 var(--s1); font-weight: 600; }
    .why {
      grid-column: 2;
      margin: 0;
      max-width: var(--measure);
      font-size: var(--t-small);
      color: var(--ink-2);
    }

    .rownote { display: block; font-size: var(--t-caption); color: var(--ink-3); }
    td .chip { margin: 1px 2px 1px 0; }

    .flowwrap { margin-top: var(--s10); }

    .keep {
      margin-top: var(--s10);
      padding: var(--s5);
      border: var(--hair) solid var(--accent);
      border-radius: var(--radius);
    }
    .keep-tag {
      margin-bottom: var(--s2);
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .keep-body { margin: 0; font-weight: 600; max-width: var(--measure); }

    .step.is-open h2 { color: var(--ink-2); }
  </style>
</Base>
