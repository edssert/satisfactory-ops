---
/**
 * 초반 가이드북 — 노드 확보부터 우주 엘리베이터 페이즈 1까지.
 *
 * **설계는 하지 않는다.** 배치 도면은 이 앱이 만들지 못한다 (게임 렌더 없이는 쓸 만한 그림이
 * 안 나오고, 벨트 접속부 좌표가 공개 데이터에 없어 경로는 추정밖에 안 된다 —
 * docs/research/drawing-tools-visual.md, machine-ports.md 참조).
 *
 * 대신 **판단에 필요한 수치와 근거**를 준다. 공장을 어떻게 놓을지는 플레이어가 정한다.
 * 계산기와 다른 점은 "얼마가 필요한가"가 아니라 **"무엇을 몇 개 잡고, 왜 그런가"**를
 * 답한다는 것이다.
 *
 * 화면의 모든 수치는 빌드 타임에 게임 데이터에서 계산한다. 마크업에 타이핑하지 않는다.
 */
import Base from '../../layouts/Base.astro';
import FlowChart from '../../components/FlowChart.astro';
import { building, item, milestonesByTier, nameOf } from '../../lib/gamedata';
import { makeRecipeBook } from '../../lib/recipe-select';
import { solve } from '../../lib/solver';
import { toNumber, ceilNum } from '../../lib/rational';
import { PURITY_MULTIPLIER } from '../../lib/mining';
import itemsJson from '../../data/app/items.json';
import recipesJson from '../../data/app/recipes.json';
import buildingsJson from '../../data/app/buildings.json';
import type { Building, Item, Recipe } from '../../lib/types';

const items = itemsJson as Item[];
const recipes = recipesJson as Recipe[];
const buildings = buildingsJson as Building[];
const book = makeRecipeBook(items, recipes, buildings);

const minerMk1 = building('Build_MinerMk1_C');
const minerMk2 = building('Build_MinerMk2_C');
const beltMk1 = building('Build_ConveyorBeltMk1_C');
const beltMk2 = building('Build_ConveyorBeltMk2_C');
const assembler = building('Build_AssemblerMk1_C');

const minerBase = minerMk1.extraction?.perMinuteAtNormalPurity ?? 60;
const beltMk1Rate = beltMk1.beltItemsPerMinute ?? 60;
const beltMk2Rate = beltMk2.beltItemsPerMinute ?? 120;

/** 순도별 채굴기 산출 — 벨트 상한을 씌우기 전 값 */
const yieldByPurity = (['impure', 'normal', 'pure'] as const).map((p) => ({
  key: p,
  ko: p === 'impure' ? '불순' : p === 'normal' ? '노말' : '순수',
  raw: minerBase * PURITY_MULTIPLIER[p],
  onMk1: Math.min(minerBase * PURITY_MULTIPLIER[p], beltMk1Rate),
  onMk2: Math.min(minerBase * PURITY_MULTIPLIER[p], beltMk2Rate),
}));

// ---------------------------------------------------------------- 요구량 → 채굴량
const RAW = ['Desc_OreIron_C', 'Desc_Stone_C', 'Desc_OreCopper_C'];

/** 티어 t 까지 마일스톤이 요구하는 부품 총량 */
function needsUpTo(t: number) {
  const need = new Map<string, number>();
  for (const g of milestonesByTier()) {
    if (g.tier > t) continue;
    for (const m of g.list) for (const c of m.cost) need.set(c.item, (need.get(c.item) ?? 0) + c.amount);
  }
  return need;
}

/** 그 부품들을 만들려면 원자재가 얼마나 드는가 */
function oreFor(need: Map<string, number>) {
  const ore = new Map<string, number>();
  for (const [id, amount] of need) {
    const r = solve(id, 1, book);
    if (!r.ok) continue;
    const walk = (n: (typeof r.root)) => {
      if (!n.recipeId) ore.set(n.itemId, (ore.get(n.itemId) ?? 0) + toNumber(n.rate) * amount);
      n.children.forEach(walk);
    };
    walk(r.root);
  }
  return ore;
}

/** 목표 시간(분) 안에 채우려면 분당 얼마 → 노드 몇 개 */
const TARGET_MIN = 60;
const tiers = [1, 2, 3].map((t) => {
  const need = needsUpTo(t);
  const ore = oreFor(need);
  return {
    tier: t,
    parts: [...need.entries()]
      .map(([id, amount]) => ({ id, ko: nameOf(id).ko, amount }))
      .sort((a, b) => b.amount - a.amount),
    ores: RAW.filter((id) => (ore.get(id) ?? 0) > 0).map((id) => {
      const total = ore.get(id) ?? 0;
      const perMin = total / TARGET_MIN;
      return {
        id,
        ko: nameOf(id).ko,
        total: Math.round(total),
        perMin,
        // 노드 하나에서 실제로 뽑히는 양은 벨트 상한에 걸린다
        nodesMk1: ceilNum(perMin / Math.min(minerBase * 2, beltMk1Rate)),
        nodesMk2: ceilNum(perMin / Math.min(minerBase * 2, beltMk2Rate)),
      };
    }),
  };
});

// ---------------------------------------------------------------- 목표 제품 체인
function chainOf(targetId: string, rate: number) {
  const r = solve(targetId, rate, book);
  if (!r.ok) return null;
  const acc = new Map<string, { ko: string; machineKo: string; rate: number; machines: number }>();
  let ore = 0;
  const walk = (n: (typeof r.root)) => {
    if (n.recipeId && n.machineId) {
      const cur = acc.get(n.itemId) ?? {
        ko: n.ko,
        machineKo: n.machineKo ?? '',
        rate: 0,
        machines: 0,
      };
      cur.rate += toNumber(n.rate);
      cur.machines += n.machines ? toNumber(n.machines) : 0;
      acc.set(n.itemId, cur);
    } else if (n.itemId === 'Desc_OreIron_C') {
      ore += toNumber(n.rate);
    }
    n.children.forEach(walk);
  };
  walk(r.root);
  return { steps: [...acc.values()], ore };
}

const RIP = 'Desc_IronPlateReinforced_C';
const ROTOR = 'Desc_Rotor_C';
const SMART = 'Desc_SpaceElevatorPart_1_C';

const ripChain = chainOf(RIP, 5);
const rotorChain = chainOf(ROTOR, 5);
const smartChain = chainOf(SMART, 5);

/** 페이즈 1 요구량 — 조사로 확인된 값 (docs/research/progression.md) */
const PHASE1_SMART = 50;

// ---------------------------------------------------------------- 석탄 동력 (초반의 결승선)
//
// 조사에서 5개 이상 독립 출처가 "티어 3에서 석탄 동력을 최우선으로 즉시 러시"로 일치했다
// (docs/research/progression-route.md). 그래서 초반 규모의 기준선은 마일스톤 요구량이 아니라
// **석탄 발전을 몇 기 돌릴 것인가**다. 아무도 "마일스톤을 60분에 채우려면"으로 공장을 짓지 않는다.
const coalGen = building('Build_GeneratorCoal_C');
const waterPump = building('Build_WaterPump_C');
const coalItem = item('Desc_Coal_C');
const genMW = coalGen.powerGenMW ?? 75;
/** 석탄 소비 = 발전량 ÷ 연료 에너지 */
const coalPerGen = (genMW / (coalItem.energyMJ ?? 300)) * 60;
/** 물 소비 = 발전량 × 보조자원 비율 (mL/MJ → m³/분) */
const waterPerGen = (genMW * (coalGen.supplementalToPowerRatio ?? 10) * 60) / 1000;
const pumpRate = waterPump.extraction?.perMinuteAtNormalPurity ?? 120;

/** 커뮤니티가 실제로 쓰는 확장 단위 — 벨트 한 줄에 딱 맞는 수에서 시작해 배로 늘린다 */
const coalSteps = [4, 8, 16].map((n) => ({
  gens: n,
  mw: genMW * n,
  coal: coalPerGen * n,
  water: waterPerGen * n,
  pumps: (waterPerGen * n) / pumpRate,
  // 석탄을 나르려면 어느 등급 벨트가 필요한가
  belt:
    coalPerGen * n <= beltMk1Rate
      ? beltMk1.ko
      : coalPerGen * n <= beltMk2Rate
        ? beltMk2.ko
        : `${beltMk2.ko} 이상 (여러 줄)`,
  // 순수 석탄 노드 기준 몇 개 (벨트 상한을 씌운 값)
  nodes: ceilNum((coalPerGen * n) / Math.min(minerBase * 2, coalPerGen * n <= beltMk1Rate ? beltMk1Rate : beltMk2Rate)),
}));

const fmtN = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));

// ---------------------------------------------------------------- 흐름도 데이터
//
// 배치가 아니라 **비율**을 보여주는 그림이다. 수치는 전부 게임 데이터에서 계산한다.
const constructor = building('Build_ConstructorMk1_C');
const smelter = building('Build_SmelterMk1_C');
const cementRec = recipes.find((r) => r.id === 'Recipe_Cement_C')
  ?? recipes.find((r) => !r.isAlternate && r.products[0]?.item === 'Desc_Cement_C')!;
const cementIn = cementRec.ingredients[0]!.perMinute;
const cementOut = cementRec.products[0]!.perMinute;

/** 석회석 노드 1개 → 제작기 2대. 벨트 상한 60/분을 둘로 나눈다. */
const limestoneFlow = {
  input: { itemKo: item('Desc_Stone_C').ko, itemId: 'Desc_Stone_C', perMinute: beltMk1Rate },
  nodes: [0, 1].map((k) => ({
    id: `c${k}`,
    machineKo: constructor.ko,
    machineId: constructor.id,
    count: 1,
    clock: (beltMk1Rate / 2 / cementIn) * 100,
    makes: `${item('Desc_Cement_C').ko} ${fmtN((beltMk1Rate / 2 / cementIn) * cementOut)}/분`,
    layer: 0,
  })),
  edges: [],
  output: {
    itemKo: item('Desc_Cement_C').ko,
    itemId: 'Desc_Cement_C',
    perMinute: (beltMk1Rate / cementIn) * cementOut,
  },
};

/** 철 노드 1개 → 3제품 분할. 제작기 5대가 전부 100%로 돈다. */
const ironFlowChart = (() => {
  const plate = recipes.find((r) => r.id === 'Recipe_IronPlate_C')!;
  const rod = recipes.find((r) => r.id === 'Recipe_IronRod_C')!;
  const screw = recipes.find((r) => r.id === 'Recipe_Screw_C')!;
  const ingotRec = recipes.find((r) => r.id === 'Recipe_IngotIron_C')!;
  const PLATE = 20, ROD_OUT = 10, SCREW = 80;
  const rodForScrew = (SCREW / screw.products[0]!.perMinute) * screw.ingredients[0]!.perMinute;
  const rodTotal = ROD_OUT + rodForScrew;
  const smelters = beltMk1Rate / ingotRec.products[0]!.perMinute;
  return {
    input: { itemKo: item('Desc_OreIron_C').ko, itemId: 'Desc_OreIron_C', perMinute: beltMk1Rate },
    nodes: [
      { id: 's', machineKo: smelter.ko, machineId: smelter.id, count: smelters, clock: 100, layer: 0 },
      {
        id: 'plate',
        machineKo: constructor.ko,
        machineId: constructor.id,
        count: PLATE / plate.products[0]!.perMinute,
        clock: 100,
        layer: 1,
        out: { itemKo: item('Desc_IronPlate_C').ko, itemId: 'Desc_IronPlate_C', perMinute: PLATE },
      },
      {
        id: 'rod',
        machineKo: constructor.ko,
        machineId: constructor.id,
        count: rodTotal / rod.products[0]!.perMinute,
        clock: 100,
        layer: 1,
        // 철봉은 갈라진다 — 일부는 그대로 납품하고 나머지는 나사로 간다
        out: { itemKo: item('Desc_IronRod_C').ko, itemId: 'Desc_IronRod_C', perMinute: ROD_OUT },
      },
      {
        id: 'screw',
        machineKo: constructor.ko,
        machineId: constructor.id,
        count: SCREW / screw.products[0]!.perMinute,
        clock: 100,
        layer: 2,
        out: { itemKo: item('Desc_IronScrew_C').ko, itemId: 'Desc_IronScrew_C', perMinute: SCREW },
      },
    ],
    edges: [
      { from: 's', to: 'plate', itemKo: item('Desc_IronIngot_C').ko, itemId: 'Desc_IronIngot_C', perMinute: (PLATE / plate.products[0]!.perMinute) * plate.ingredients[0]!.perMinute },
      { from: 's', to: 'rod', itemKo: item('Desc_IronIngot_C').ko, itemId: 'Desc_IronIngot_C', perMinute: (rodTotal / rod.products[0]!.perMinute) * rod.ingredients[0]!.perMinute },
      { from: 'rod', to: 'screw', itemKo: item('Desc_IronRod_C').ko, itemId: 'Desc_IronRod_C', perMinute: rodForScrew },
    ],
    rodSpare: ROD_OUT,
  };
})();

const ironFlow = (() => {
  const plate = recipes.find((r) => r.id === 'Recipe_IronPlate_C')!;
  const rod = recipes.find((r) => r.id === 'Recipe_IronRod_C')!;
  const screw = recipes.find((r) => r.id === 'Recipe_Screw_C')!;
  const ingotRec = recipes.find((r) => r.id === 'Recipe_IngotIron_C')!;
  // 주괴 60/분을 남김없이 쓰는 조합: 철판 20 · 철봉 10(납품) · 나사 80
  const PLATE = 20, ROD_OUT = 10, SCREW = 80;
  const rodForScrew = (SCREW / screw.products[0]!.perMinute) * screw.ingredients[0]!.perMinute;
  const rodTotal = ROD_OUT + rodForScrew;
  return {
    plate: PLATE,
    rodOut: ROD_OUT,
    screw: SCREW,
    rodTotal,
    smelters: beltMk1Rate / ingotRec.products[0]!.perMinute,
    mPlate: PLATE / plate.products[0]!.perMinute,
    mRod: rodTotal / rod.products[0]!.perMinute,
    mScrew: SCREW / screw.products[0]!.perMinute,
  };
})();

/*
 * ── 회전자 · 지능형 도금판
 *
 * 이 절을 쓰면서 두 번 틀렸다. 기록해 둔다:
 *   1) "조립기가 100%로 도는 게 깔끔하다"며 도금판 4/분을 잡아 조립기를 2대 세웠다.
 *      기계 가동률을 목표로 착각한 것이다. 목표는 납품이지 가동률이 아니다.
 *   2) "페이즈 1은 일회성이니 작게 지어라"라고 했는데, 페이즈 2가 같은 것을 1,000개 요구한다.
 *      20배다. 그리고 보강된 철판은 벨트 Mk.2·조립기·석탄 발전기가 계속 먹으므로 여유가 아니다.
 */
const rotorRec = recipes.find((r) => r.id === 'Recipe_Rotor_C')!;
const smartRec = recipes.find((r) => r.id === 'Recipe_SpaceElevatorPart_1_C')!;
const screwRec = recipes.find((r) => r.id === 'Recipe_Screw_C')!;
const rodRec = recipes.find((r) => r.id === 'Recipe_IronRod_C')!;
const ripRec2 = recipes.find((r) => r.id === 'Recipe_IronPlateReinforced_C')!;

const per = (rec: Recipe, itemId: string) =>
  (rec.ingredients.find((g) => g.item === itemId)?.perMinute ?? 0) / rec.products[0]!.perMinute;

/** 도금판 N개를 만들 때 드는 나사 — 페이즈 1과 2의 격차를 보여준다 */
const screwsFor = (smartCount: number) => {
  const rotors = smartCount * per(smartRec, 'Desc_Rotor_C');
  const rips = smartCount * per(smartRec, 'Desc_IronPlateReinforced_C');
  return {
    rotors,
    rips,
    screws: rotors * per(rotorRec, 'Desc_IronScrew_C') + rips * per(ripRec2, 'Desc_IronScrew_C'),
  };
};
const PHASE1 = 50;
const PHASE2 = 1000;
const p1 = screwsFor(PHASE1);
const p2 = screwsFor(PHASE2);
const screwPerConstructor = screwRec.products[0]!.perMinute;

/** 보강된 철판을 먹는 초반 건물 — "여유분"이 아니라는 근거 */
const ripEaters = buildings
  .filter((b) => (b.unlockTier ?? 9) <= 3 && b.buildCost?.some((c) => c.item === 'Desc_IronPlateReinforced_C'))
  .map((b) => ({
    ko: b.ko,
    tier: b.unlockTier ?? 0,
    amount: b.buildCost!.find((c) => c.item === 'Desc_IronPlateReinforced_C')!.amount,
  }))
  .sort((a, b) => b.amount - a.amount)
  .slice(0, 6);

/** 회전자 2/분 최소 구성 — 조립기 1대를 50%로 */
const rotorFlow = (() => {
  const RATE = 2;
  const rodDirect = RATE * per(rotorRec, 'Desc_IronRod_C');
  const screwNeed = RATE * per(rotorRec, 'Desc_IronScrew_C');
  const rodForScrew = (screwNeed / screwRec.products[0]!.perMinute) * screwRec.ingredients[0]!.perMinute;
  const rodTotal = rodDirect + rodForScrew;
  const ingotNeed = (rodTotal / rodRec.products[0]!.perMinute) * rodRec.ingredients[0]!.perMinute;
  const smelt = recipes.find((r) => r.id === 'Recipe_IngotIron_C')!;
  return {
    rate: RATE,
    rodDirect,
    rodForScrew,
    rodTotal,
    screwNeed,
    mRod: rodTotal / rodRec.products[0]!.perMinute,
    mScrew: screwNeed / screwRec.products[0]!.perMinute,
    mRotor: RATE / rotorRec.products[0]!.perMinute,
    mSmelt: ingotNeed / smelt.products[0]!.perMinute,
    ore: (ingotNeed / smelt.products[0]!.perMinute) * smelt.ingredients[0]!.perMinute,
    ingot: ingotNeed,
  };
})();

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));
const recipeOf = (id: string) => recipes.find((r) => r.id === id);
const ripRecipe = recipeOf('Recipe_IronPlateReinforced_C')!;
const rotorRecipe = recipeOf('Recipe_Rotor_C')!;
const smartRecipe = recipeOf('Recipe_SpaceElevatorPart_1_C')!;
const ing = (r: Recipe) => r.ingredients.map((g) => `${nameOf(g.item).ko} ${g.perMinute}`).join(' + ');
const out = (r: Recipe) => r.products.map((g) => `${nameOf(g.item).ko} ${g.perMinute}`).join(', ');
---

<Base
  title="초반 가이드북 — 노드 확보부터 페이즈 1까지"
  description="어느 순도 노드를 몇 개 잡아야 하는가, 무엇을 얼마나 만들어야 하는가. 설계는 플레이어가 하고 이 문서는 판단 근거를 준다."
>
  <div class="wrap page">
    <header class="page-head">
      <p class="section-label"><span class="num">F15</span> 초반 가이드북</p>
      <h1>석탄 동력까지, 노드 몇 개면 되는가</h1>
      <p class="prose">
        초반의 결승선은 마일스톤이 아니라 <strong>석탄 동력</strong>입니다. 조사한 가이드 중
        <strong>5개 이상이 독립적으로</strong> "티어 3에서 석탄을 최우선으로 즉시 러시하라"로
        일치했고, 목표 시간을 제시한 가이드는 <strong>티어 1부터 90분</strong>을 기준으로 삼습니다.
      </p>
      <p class="prose">
        그래서 이 문서는 "마일스톤을 채우려면 얼마"가 아니라 <strong>사람들이 실제로 짓는 규모</strong>에서
        시작해 노드 개수를 냅니다. <strong>배치는 정하지 않습니다</strong> — 그건 플레이어가 하는
        일이고, 쓸 만한 배치 도면을 그리는 것은 이 앱이 못 합니다.
      </p>
    </header>

    <section class="note" style="margin-bottom: var(--s10)">
      <span class="note-title">먼저 알아둘 것 — 채굴기 출력구는 하나입니다</span>
      <p>
        이 문서의 절반은 이 사실에서 나옵니다. 채굴기는 벨트를 <strong>한 줄만</strong> 뽑습니다.
        그래서 노드가 아무리 굵어도 <strong>그 벨트가 나를 수 있는 만큼만</strong> 나옵니다.
        {beltMk1.ko}는 <span class="n">{beltMk1Rate}</span>/분이 상한입니다.
      </p>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">01</span> 기준선</p>
      <h2>석탄 발전 몇 기를 돌릴 것인가</h2>
      <p class="prose">
        {coalGen.ko} 한 대는 <span class="n">{fmt(genMW)}</span> MW를 내고
        석탄 <span class="n">{fmt(coalPerGen)}</span>/분, 물 <span class="n">{fmt(waterPerGen)}</span> m³/분을 먹습니다.
        여기서 커뮤니티가 <strong>4대·8대·16대</strong>로 늘리는 이유가 나옵니다 —
        <strong>{beltMk1.ko} 한 줄({beltMk1Rate}/분)이 정확히 {fmt(beltMk1Rate / coalPerGen)}대분</strong>입니다.
      </p>

      <div class="scroll-x">
        <table class="table">
          <thead>
            <tr>
              <th class="n">발전기</th>
              <th class="n">전력</th>
              <th class="n">석탄</th>
              <th class="n">물</th>
              <th class="n">물 추출기</th>
              <th>석탄 벨트</th>
              <th class="n">석탄 노드</th>
            </tr>
          </thead>
          <tbody>
            {coalSteps.map((c) => (
              <tr class={c.gens === 4 ? 'total-row' : undefined}>
                <td class="n">{c.gens}대</td>
                <td class="n">{fmt(c.mw)} MW</td>
                <td class="n">{fmt(c.coal)}/분</td>
                <td class="n">{fmt(c.water)} m³/분</td>
                <td class="n">{fmt(Math.round(c.pumps * 100) / 100)}대</td>
                <td>{c.belt}</td>
                <td class="n">순수 {c.nodes}개</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="note" style="margin-top: var(--s5)">
        <span class="note-title">4대부터 시작하는 이유</span>
        <p>
          석탄 <span class="n">{fmt(coalPerGen * 4)}</span>/분이 {beltMk1.ko} 한 줄에 <strong>딱 맞습니다.</strong>
          벨트를 나누거나 등급을 올릴 필요가 없고, 노드 하나면 됩니다.
        </p>
        <p>
          물은 <span class="n">{fmt(waterPerGen * 4)}</span> m³/분이 필요한데 {waterPump.ko}가
          <span class="n">{pumpRate}</span> m³/분이라 <span class="n">{fmt(Math.round((waterPerGen * 4 / pumpRate) * 100) / 100)}</span>대분입니다.
          커뮤니티는 <strong>2대를 놓고 한 대를 50%로 낮추라</strong>고 권합니다 — 1.5대를 지을 수는 없기 때문입니다.
        </p>
        <p class="muted">
          8대로 늘리려면 {beltMk2.ko}가 먼저 필요합니다. 확장이 벨트 등급에 묶여 있다는 뜻이고,
          이것이 초반 내내 반복되는 구조입니다.
        </p>
      </div>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">02</span> 노드 확보</p>
      <h2>어느 순도를, 몇 개</h2>

      <p class="prose">
        {minerMk1.ko}의 산출은 순도로 정해집니다. 그런데 <strong>벨트가 그것을 자릅니다.</strong>
      </p>

      <div class="scroll-x">
        <table class="table">
          <thead>
            <tr>
              <th>순도</th>
              <th class="n">채굴기가 낼 수 있는 양</th>
              <th class="n">{beltMk1.ko}에 실으면</th>
              <th class="n">{beltMk2.ko}에 실으면</th>
            </tr>
          </thead>
          <tbody>
            {yieldByPurity.map((y) => (
              <tr class={y.key === 'pure' ? 'total-row' : undefined}>
                <td><strong>{y.ko}</strong></td>
                <td class="n">{fmt(y.raw)}/분</td>
                <td class="n">
                  {fmt(y.onMk1)}/분
                  {y.raw > y.onMk1 && <span class="muted"> (벨트가 자름)</span>}
                </td>
                <td class="n">
                  {fmt(y.onMk2)}/분
                  {y.raw > y.onMk2 && <span class="muted"> (벨트가 자름)</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="note" style="margin-top: var(--s6)">
        <span class="note-title">여기서 나오는 판단 — 순수 노드를 먼저 잡으세요</span>
        <p>
          {beltMk1.ko}만 있는 동안에는 <strong>순수 노드와 노말 노드가 똑같이
          <span class="n">{beltMk1Rate}</span>/분</strong>입니다. 지금 당장은 차이가 없습니다.
        </p>
        <p>
          그런데도 순수 노드에 자리를 잡아야 합니다. {beltMk2.ko}(티어
          <span class="n">{beltMk2.unlockTier}</span>)로 갈아끼우면 <strong>같은 자리에서
          <span class="n">{Math.min(minerBase * 2, beltMk2Rate)}</span>/분</strong>이 됩니다.
          노말 노드에 지었다면 벨트를 바꿔도 <span class="n">{minerBase}</span>/분이 끝이라
          <strong>공장을 옮겨야 합니다.</strong>
        </p>
        <p>
          즉 초반에 순수 노드를 잡는 것은 지금의 이득이 아니라 <strong>나중에 안 옮기기 위한
          선택</strong>입니다. 불순 노드는 {beltMk1.ko}에서도 <span class="n">{fmt(minerBase / 2)}</span>/분뿐이라
          초반 주력으로 쓰지 마세요.
        </p>
      </div>

      <h3 style="margin-top: var(--s8)">몇 개가 필요한가</h3>
      <p class="prose">
        아래는 각 티어까지의 <strong>마일스톤 요구량 전부</strong>를 게임 데이터에서 더해
        원자재로 환산한 값입니다. "<span class="n">{TARGET_MIN}</span>분 안에 채운다"를 기준으로
        분당 필요량을 냈습니다 — 더 여유 있게 갈 거면 노드를 덜 잡아도 됩니다.
      </p>

      {tiers.map((t) => (
        <div style="margin-bottom: var(--s6)">
          <h4>티어 {t.tier}까지</h4>
          <div class="scroll-x">
            <table class="table">
              <thead>
                <tr>
                  <th>자원</th>
                  <th class="n">총 필요량</th>
                  <th class="n">{TARGET_MIN}분 기준</th>
                  <th class="n">{beltMk1.ko} 시기</th>
                  <th class="n">{beltMk2.ko} 이후</th>
                </tr>
              </thead>
              <tbody>
                {t.ores.map((o) => (
                  <tr>
                    <td>{o.ko}</td>
                    <td class="n">{o.total}개</td>
                    <td class="n">{fmt(Math.round(o.perMin * 10) / 10)}/분</td>
                    <td class="n">순수 노드 {o.nodesMk1}개</td>
                    <td class="n">순수 노드 {o.nodesMk2}개</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <p class="footnote">
        노드 수는 <strong>순수 노드 기준</strong>입니다. 노말 노드로 채우려면 {beltMk2.ko} 이후에도
        {beltMk1.ko} 시기와 같은 개수가 듭니다 — 벨트를 올려도 노드가 안 굵어지기 때문입니다.
      </p>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">03</span> 노드 하나로 무엇이 나오는가</p>
      <h2>석회석 — 가장 단순한 예</h2>
      <p class="prose">
        노드 1개에 채굴기 1대, {beltMk1.ko} 한 줄이면 <span class="n">{beltMk1Rate}</span>/분입니다.
        {constructor.ko} 한 대가 석회석 <span class="n">{cementIn}</span>/분을 먹으니
        <span class="n">{fmtN(beltMk1Rate / cementIn)}</span>대분입니다 — <strong>2대를 짓고 각각
        <span class="n">{fmtN((beltMk1Rate / 2 / cementIn) * 100)}</span>%로 낮춥니다.</strong>
      </p>
      <FlowChart
        input={limestoneFlow.input}
        nodes={limestoneFlow.nodes}
        edges={limestoneFlow.edges}
        output={limestoneFlow.output}
        index={1}
        caption="석회석 노드 1개 · 채굴기 1대 · 제작기 2대. 배치는 자유이고 비율만 지키면 됩니다."
      />
      <p class="prose">
        1대만 100%로 돌리면 석회석이 <span class="n">{fmtN(beltMk1Rate - cementIn)}</span>/분 남아 벨트에 쌓이고,
        3대를 두면 <span class="n">{fmtN((beltMk1Rate / 3 / cementIn) * 100)}</span>%씩 돌아 기계만 하나 더 듭니다.
        <strong>2대가 답인 이유</strong>입니다.
      </p>

      <h2 style="margin-top: var(--s8)">철 — 3제품을 어떤 비율로</h2>
      <p class="prose">
        초반에 계속 필요한 것은 <strong>철판 · 철봉 · 나사</strong> 셋입니다. 노드 1개
        (<span class="n">{beltMk1Rate}</span>/분)를 남김없이 쓰면서 <strong>제작기가 전부 100%로 도는
        조합</strong>이 하나 있습니다 — 다운클럭이 필요 없습니다.
      </p>
      <div class="scroll-x">
        <table class="table">
          <thead>
            <tr><th>공정</th><th class="n">제작기</th><th class="n">클럭</th><th class="n">산출</th><th>쓰임</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>철판</td>
              <td class="n">{ironFlow.mPlate}대</td>
              <td class="n">100%</td>
              <td class="n">{ironFlow.plate}/분</td>
              <td class="muted">건설 · 마일스톤 · 보강된 철판</td>
            </tr>
            <tr>
              <td>철봉</td>
              <td class="n">{ironFlow.mRod}대</td>
              <td class="n">100%</td>
              <td class="n">{ironFlow.rodTotal}/분</td>
              <td class="muted">{ironFlow.rodOut}/분 납품 + {ironFlow.rodTotal - ironFlow.rodOut}/분은 나사로</td>
            </tr>
            <tr class="total-row">
              <td>나사</td>
              <td class="n">{ironFlow.mScrew}대</td>
              <td class="n">100%</td>
              <td class="n">{ironFlow.screw}/분</td>
              <td class="muted">초반 최대 병목</td>
            </tr>
          </tbody>
        </table>
      </div>
      <FlowChart
        input={ironFlowChart.input}
        nodes={ironFlowChart.nodes}
        edges={ironFlowChart.edges}
        index={2}
        caption="철 노드 1개 · 제련기 2대 · 제작기 5대. 전부 100%로 돌고 주괴가 남지 않습니다."
      />
      <p class="prose">
        철봉 상자에서 <strong>두 갈래</strong>가 나가는 것을 보세요 — 아래로는 나사 공정으로 가고,
        <span class="n">{ironFlowChart.rodSpare}</span>/분은 그대로 납품용으로 뺍니다.
        그 지점에 분배기가 하나 필요합니다.
      </p>
      <p class="prose">
        {smelter.ko} <span class="n">{ironFlow.smelters}</span>대로 주괴
        <span class="n">{beltMk1Rate}</span>/분을 만들고, 제작기
        <span class="n">{ironFlow.mPlate + ironFlow.mRod + ironFlow.mScrew}</span>대가 그것을 남김없이 씁니다.
        <strong>철봉 라인이 두 갈래로 갈라지는 것</strong>만 주의하면 됩니다 — 일부는 그대로 납품하고,
        나머지는 나사로 넘어갑니다.
      </p>
      <div class="note">
        <span class="note-title">비율을 바꾸고 싶다면</span>
        <p>
          주괴 1개는 철판 <span class="n">{fmtN(20 / 30)}</span>개, 철봉
          <span class="n">1</span>개가 됩니다. 나사는 철봉을 거치므로 주괴 1개가 나사
          <span class="n">4</span>개입니다. 이 셋의 합이 <span class="n">{beltMk1Rate}</span>을 넘지 않게만
          맞추면 어떤 비율이든 됩니다.
        </p>
      </div>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">03</span> 무엇을 얼마나</p>
      <h2>티어별 요구 부품</h2>
      <p class="prose">
        아래는 <strong>목표가 아니라 참고</strong>입니다. 마일스톤 요구량은 한 번 내면 끝나는
        일회성 납품이고, 공장 규모는 그것이 아니라 <strong>지속 생산</strong>으로 정합니다 —
        위의 석탄 발전 규모가 그 기준입니다.
      </p>
      <p class="prose">
        그래도 적어 두는 이유는, 커뮤니티 글의 수치가 서로 다를 때 <strong>이쪽이 맞기</strong>
        때문입니다(게임 배포 데이터에서 직접 읽습니다). 실제로 "철봉 10/분 → 나사 4/분"처럼
        오타가 퍼진 사례를 조사에서 확인했습니다 — 맞는 값은 나사 40/분입니다.
      </p>
      <div class="scroll-x">
        <table class="table">
          <thead>
            <tr>
              <th>부품</th>
              {tiers.map((t) => <th class="n">티어 {t.tier}까지</th>)}
            </tr>
          </thead>
          <tbody>
            {[...new Set(tiers.flatMap((t) => t.parts.map((p) => p.id)))].map((id) => (
              <tr>
                <td>{nameOf(id).ko}</td>
                {tiers.map((t) => {
                  const hit = t.parts.find((p) => p.id === id);
                  return <td class="n">{hit ? `${hit.amount}개` : '—'}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">04</span> 보강된 철판</p>
      <h2>첫 조립기</h2>
      <p class="prose">
        {assembler.ko}는 티어 <span class="n">{assembler.unlockTier}</span>에 열립니다. 그 전에는
        보강된 철판을 자동화할 수 없습니다.
      </p>
      <p class="prose">
        <strong>레시피</strong>: {ing(ripRecipe)} → {out(ripRecipe)} (분당 기준)
      </p>

      {ripChain && (
        <div class="scroll-x">
          <table class="table">
            <thead>
              <tr><th>만드는 것</th><th class="n">필요량</th><th>기계</th><th class="n">대수</th></tr>
            </thead>
            <tbody>
              {ripChain.steps.map((s) => (
                <tr>
                  <td>{s.ko}</td>
                  <td class="n">{fmt(Math.round(s.rate * 100) / 100)}/분</td>
                  <td>{s.machineKo}</td>
                  <td class="n">
                    {fmt(Math.round(s.machines * 100) / 100)}
                    {!Number.isInteger(Math.round(s.machines * 100) / 100) && (
                      <span class="muted"> → {ceilNum(s.machines)}대 짓고 다운클럭</span>
                    )}
                  </td>
                </tr>
              ))}
              <tr class="total-row">
                <td colspan="3">철 광석</td>
                <td class="n">{fmt(ripChain.ore)}/분</td>
              </tr>
            </tbody>
          </table>
        </div>
      )}

      <div class="note" style="margin-top: var(--s5)">
        <span class="note-title">왜 5/분인가</span>
        <p>
          {beltMk1.ko} 한 줄이 <span class="n">{beltMk1Rate}</span>/분이고, 보강된 철판 5/분이
          철 광석 <span class="n">{ripChain ? fmt(ripChain.ore) : '60'}</span>/분을 먹습니다.
          <strong>노드 하나에 채굴기 하나, 벨트 한 줄</strong>이 딱 맞는 규모입니다.
          이보다 크게 잡으면 벨트를 두 줄로 나누거나 {beltMk2.ko}가 필요합니다.
        </p>
      </div>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">05</span> 회전자 · 지능형 도금판</p>
      <h2>여기서 나사가 벽이 됩니다</h2>

      <p class="prose">
        <strong>회전자</strong>: {ing(rotorRecipe)} → {out(rotorRecipe)}<br />
        <strong>지능형 도금판</strong>: {ing(smartRecipe)} → {out(smartRecipe)}
      </p>

      <p class="prose">
        회전자 하나에 나사가 <span class="n">{per(rotorRec, 'Desc_IronScrew_C')}</span>개,
        보강된 철판 하나에 <span class="n">{per(ripRec2, 'Desc_IronScrew_C')}</span>개 들어갑니다.
        도금판은 그 <strong>둘 다</strong>를 먹습니다.
      </p>

      <div class="scroll-x">
        <table class="table">
          <thead>
            <tr>
              <th>납품</th>
              <th class="n">도금판</th>
              <th class="n">회전자</th>
              <th class="n">보강된 철판</th>
              <th class="n">나사</th>
              <th class="n">제작기 1대로</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>페이즈 1</td>
              <td class="n">{PHASE1}개</td>
              <td class="n">{fmt(p1.rotors)}개</td>
              <td class="n">{fmt(p1.rips)}개</td>
              <td class="n">{Math.round(p1.screws).toLocaleString()}개</td>
              <td class="n">{Math.round(p1.screws / screwPerConstructor)}분</td>
            </tr>
            <tr class="total-row">
              <td>페이즈 2</td>
              <td class="n">{PHASE2.toLocaleString()}개</td>
              <td class="n">{fmt(p2.rotors).toLocaleString()}개</td>
              <td class="n">{fmt(p2.rips).toLocaleString()}개</td>
              <td class="n">{Math.round(p2.screws).toLocaleString()}개</td>
              <td class="n">{(p2.screws / screwPerConstructor / 60).toFixed(1)}시간</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="note" style="margin-top: var(--s5)">
        <span class="note-title">페이즈 2는 20배입니다 — 일회성이 아닙니다</span>
        <p>
          페이즈 1은 도금판 <span class="n">{PHASE1}</span>개, 페이즈 2는
          <span class="n">{PHASE2.toLocaleString()}</span>개입니다. 나사로 환산하면
          <span class="n">{Math.round(p1.screws).toLocaleString()}</span>개 →
          <span class="n">{Math.round(p2.screws).toLocaleString()}</span>개.
          표준 레시피 제작기 한 대로는 <strong>{(p2.screws / screwPerConstructor / 60).toFixed(1)}시간</strong>입니다.
        </p>
        <p>
          그래서 지금 <strong>작게 짓되 옆자리를 비워 두세요.</strong> 페이즈 2에서 같은 모듈을
          복제해 붙이는 편이, 돌아가는 라인을 뜯어 늘리는 것보다 항상 쉽습니다.
        </p>
        <p>
          그리고 진짜 대비는 규모가 아니라 <strong>대체 레시피</strong>입니다 —
          <strong>용접된 철판</strong>(보강된 철판에서 나사를 아예 없앰)과
          <strong>강철 나사</strong>(나사당 철광석 −79%)가 최우선으로 꼽히는 이유가 이 표입니다.
        </p>
      </div>

      <h3 style="margin-top: var(--s8)">최소 구성 — 조립기 2대</h3>
      <p class="prose">
        페이즈 1을 채우는 데 필요한 것은 도금판 <span class="n">2</span>/분이면 충분합니다
        (<span class="n">{PHASE1 / 2}</span>분). 도금판 조립기 1대가 정확히 2/분을 내고,
        회전자는 조립기 1대를 <span class="n">50</span>%로 돌리면 됩니다.
      </p>

      <FlowChart
        input={{ itemKo: item('Desc_OreIron_C').ko, itemId: 'Desc_OreIron_C', perMinute: rotorFlow.ore }}
        nodes={[
          { id: 'sm', machineKo: smelter.ko, machineId: smelter.id, count: 1, clock: rotorFlow.mSmelt * 100, layer: 0 },
          { id: 'rod', machineKo: constructor.ko, machineId: constructor.id, count: 2, clock: (rotorFlow.mRod / 2) * 100, layer: 1 },
          { id: 'scr', machineKo: constructor.ko, machineId: constructor.id, count: 2, clock: (rotorFlow.mScrew / 2) * 100, layer: 2 },
          { id: 'rot', machineKo: assembler.ko, machineId: assembler.id, count: 1, clock: rotorFlow.mRotor * 100, layer: 3 },
          {
            id: 'sp',
            machineKo: assembler.ko,
            machineId: assembler.id,
            count: 1,
            clock: 100,
            layer: 4,
            out: { itemKo: item('Desc_SpaceElevatorPart_1_C').ko, itemId: 'Desc_SpaceElevatorPart_1_C', perMinute: 2 },
          },
        ]}
        edges={[
          { from: 'sm', to: 'rod', itemKo: item('Desc_IronIngot_C').ko, itemId: 'Desc_IronIngot_C', perMinute: rotorFlow.ingot },
          { from: 'rod', to: 'scr', itemKo: item('Desc_IronRod_C').ko, itemId: 'Desc_IronRod_C', perMinute: rotorFlow.rodForScrew },
          { from: 'rod', to: 'rot', itemKo: item('Desc_IronRod_C').ko, itemId: 'Desc_IronRod_C', perMinute: rotorFlow.rodDirect },
          { from: 'scr', to: 'rot', itemKo: item('Desc_IronScrew_C').ko, itemId: 'Desc_IronScrew_C', perMinute: rotorFlow.screwNeed },
          { from: 'rot', to: 'sp', itemKo: item('Desc_Rotor_C').ko, itemId: 'Desc_Rotor_C', perMinute: 2 },
        ]}
        index={3}
        caption={`철광석 ${fmt(rotorFlow.ore)}/분으로 지능형 도금판 2/분. 보강된 철판 2/분은 기존 라인에서 끌어옵니다.`}
      />

      <p class="prose">
        철봉이 <strong>두 갈래</strong>로 갈라집니다 —
        <span class="n">{fmt(rotorFlow.rodDirect)}</span>/분은 회전자로 직접,
        <span class="n">{fmt(rotorFlow.rodForScrew)}</span>/분은 나사를 거쳐서 갑니다.
        회전자가 먹는 나사가 철봉보다 많기 때문입니다.
      </p>

      <div class="note">
        <span class="note-title">보강된 철판 5/분은 여유가 아닙니다</span>
        <p>
          도금판이 <span class="n">2</span>/분을 먹으면 3/분이 남는 것처럼 보이지만, 앞으로 지을
          것들이 계속 먹습니다:
        </p>
        <div class="kv">
          {ripEaters.map((e) => (
            <div>
              <span class="k">{e.ko} <span class="muted">T{e.tier}</span></span>
              <span class="v n">{e.amount}개</span>
            </div>
          ))}
        </div>
        <p class="footnote">
          특히 <strong>{beltMk2.ko}는 한 개당 보강된 철판 1개</strong>입니다. 벨트를 길게 깔면
          그만큼 나갑니다. 티어 3까지 보강된 철판을 쓰는 건물이
          <span class="n">{buildings.filter((b) => (b.unlockTier ?? 9) <= 3 && b.buildCost?.some((c) => c.item === 'Desc_IronPlateReinforced_C')).length}</span>개입니다.
        </p>
      </div>
    </section>

    <section class="section">
      <p class="section-label"><span class="num">06</span> {beltMk1.ko} → {beltMk2.ko}</p>
      <h2>벨트를 갈 때 무엇이 바뀌는가</h2>
      <p class="prose">
        {beltMk2.ko}는 티어 <span class="n">{beltMk2.unlockTier}</span>에 열립니다. {assembler.ko}와
        <strong>같은 티어</strong>입니다 — 보강된 철판을 자동화하는 시점에는 이미 쓸 수 있습니다.
      </p>
      <ul class="prose">
        <li>
          <strong>채굴기 출력이 두 배가 됩니다</strong> — 순수 노드 기준
          <span class="n">{beltMk1Rate}</span> → <span class="n">{Math.min(minerBase * 2, beltMk2Rate)}</span>/분.
          채굴기는 그대로 두고 <strong>벨트만 갈면 됩니다.</strong>
        </li>
        <li>
          <strong>기존 공장은 그대로 둡니다</strong> — 늘어난 광석으로 라인을 하나 더 세우는 편이,
          돌아가는 라인을 뜯어 키우는 것보다 쉽습니다.
        </li>
        <li>
          <strong>노말 노드였다면 여기서 손해가 드러납니다</strong> — 벨트를 갈아도
          <span class="n">{minerBase}</span>/분 그대로입니다.
        </li>
        <li>
          중간 구간의 벨트도 유량이 <span class="n">{beltMk1Rate}</span>/분을 넘는 곳만 갈면 됩니다.
          전부 갈 필요는 없습니다.
        </li>
      </ul>
      <p class="footnote">
        이 절은 실제로 이 전환을 해 본 사람의 검토가 필요한 부분입니다. 빠진 것이나 틀린 것이
        있으면 알려 주세요.
      </p>
    </section>

    <section class="note">
      <span class="note-title">이 문서가 하지 않는 것</span>
      <p>
        기계를 어디에 놓을지, 벨트를 어떻게 돌릴지는 정하지 않습니다. 쓸 만한 배치 도면을 그리는 것은
        이 앱이 못 합니다 — 게임 렌더 없이는 그림 품질이 안 나오고, 벨트 접속부 좌표가 공개된 데이터
        어디에도 없어 경로는 추정밖에 되지 않습니다. 그 한계는
        <code>docs/research/machine-ports.md</code> 와 <code>drawing-tools-visual.md</code> 에
        적어 두었습니다.
      </p>
    </section>
  </div>
</Base>
