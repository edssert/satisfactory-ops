---
/**
 * 옛 주소. 도감으로 합치면서 옮겼다.
 *
 * 문서 골격을 직접 쓴다 — Base 레이아웃을 태우면 넘겨보내기만 하는 화면에 서체와
 * 스타일시트를 통째로 받게 된다. 대신 `lang` 과 배경색은 반드시 있어야 한다.
 * 없으면 넘어가기 전 한 프레임 동안 「흰 화면」이 번쩍인다.
 *
 * 최소 토큰 스타일만 받아 넘겨보내기 전 한 프레임도 현재 테마와 어긋나지 않게 한다.
 */
import '../../styles/tokens.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/dex/`;
---

<!doctype html>
<html lang="ko" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex" />
    <title>새 주소로 이동</title>
    <link rel="canonical" href={to} />
    <style is:inline>
      :root { color-scheme: dark; background: var(--canvas, Canvas); }
      body {
        margin: 0;
        padding: 2rem;
        background: var(--canvas, Canvas);
        color: var(--text-secondary, CanvasText);
        font: 15px/1.7 system-ui, -apple-system, 'Segoe UI', sans-serif;
      }
      a { color: var(--action-strong, LinkText); }
    </style>
  </head>
  <body>
    <p><a href={to}>새 주소로 이동</a></p>
  </body>
</html>
