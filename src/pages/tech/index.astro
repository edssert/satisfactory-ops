---
/**
 * 테크 사전 — 게임의 모든 해금을 진행도와 상관없이 보여준다.
 *
 * 허브 6 · 마일스톤 42 · MAM 120 · 어썸 싱크 상점 173.
 *
 * 왜 전부 보여주는가: 흩어져 있으면 "이건 언제 열리나"를 물을 때마다 다시 뒤져야 하고,
 * 실제로 그러다 여러 번 틀렸다 — 석탄 발전을 초반에 두고, 고체 바이오 연료를 허브 단계에 넣고,
 * 오버클럭을 티어 4 라고 했다. 한 곳에 모아 두면 그런 실수가 안 난다.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/fx.css';
import '../../styles/tech.css';
import tech from '../../data/app/tech.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Unlocks {
  buildings: { id: string; ko: string }[];
  recipes: { id: string; ko: string; isAlternate: boolean; makes: { ko: string; perMinute: number } | null }[];
  items: { id: string; ko: string }[];
  slots: number;
  other: string[];
}
interface Cost {
  item: string;
  ko: string;
  amount: number;
}
const doc = tech as unknown as {
  $counts: { hub: number; milestones: number; mam: number; shop: number };
  hub: { id: string; ko: string; order: number; cost: Cost[]; unlocks: Unlocks }[];
  milestones: { id: string; ko: string; tier: number; cost: Cost[]; unlocks: Unlocks }[];
  mamTrees: { key: string; ko: string; opens: string; count: number }[];
  mam: {
    id: string;
    ko: string;
    tree: string;
    treeKo: string;
    row: number;
    cost: Cost[];
    unlocks: Unlocks;
    discontinued: boolean;
  }[];
  shop: { id: string; ko: string; coupons: number; unlocks: Unlocks }[];
};

const tiers = [...new Set(doc.milestones.map((m) => m.tier))].sort((a, b) => a - b);

/**
 * MAM 을 트리 → 행으로 묶는다. 게임 화면처럼 위에서 아래로 가지가 뻗는 모양이 된다.
 * 선행 관계가 배포 데이터에 없어 클래스명의 행 번호를 깊이로 쓴다.
 */
const mamByTree = doc.mamTrees.map((t) => {
  const nodes = doc.mam.filter((m) => m.tree === t.key);
  const rows = [...new Set(nodes.map((n) => n.row))].sort((a, b) => a - b);
  return {
    ...t,
    rows: rows.map((r) => ({ row: r, nodes: nodes.filter((n) => n.row === r) })),
  };
});

/** 상점 항목의 대표 그림 — 해금하는 건물이나 아이템의 아이콘을 쓴다 */
function iconOf(u: Unlocks): { src: string; kind: 'building' | 'item' } | null {
  if (u.buildings.length) return { src: u.buildings[0]!.id, kind: 'building' };
  if (u.items.length) return { src: u.items[0]!.id, kind: 'item' };
  return null;
}
const shopCards = doc.shop.map((sh) => ({ ...sh, icon: iconOf(sh.unlocks) }));
const shopTiers = [...new Set(doc.shop.map((x) => x.coupons))].sort((a, b) => a - b);

/** 해금 내용을 한 줄로 */
function summarize(u: Unlocks): string[] {
  const out: string[] = [];
  for (const b of u.buildings) out.push(b.ko);
  for (const r of u.recipes) out.push(r.isAlternate ? `${r.ko} (대체)` : r.ko);
  for (const i of u.items) out.push(i.ko);
  if (u.slots > 0) out.push(`인벤토리 +${u.slots}칸`);
  out.push(...u.other);
  return out;
}
---

<Base
  title="테크 사전, 모든 해금을 한 곳에"
  description="허브·마일스톤·MAM·어썸 싱크 상점의 모든 해금을 진행도와 상관없이 볼 수 있습니다."
  section="tech"
>
  <div class="wrap page">
    <header class="page-head">
      <p class="marker"><span class="num">테크 사전</span></p>
      <h1><span class="fx-gradient-text">모든 해금을 한 곳에</span></h1>
      <p class="lede prose">
        진행도와 상관없이 전부 보입니다. 아직 못 여는 것도 무엇을 얼마나 내야 열리는지
        미리 볼 수 있습니다.
      </p>
    </header>

    <div class="facts">
      <div class="fact"><span class="fact-k">허브 업그레이드</span><span class="fact-v n">{doc.$counts.hub}</span></div>
      <div class="fact"><span class="fact-k">마일스톤</span><span class="fact-v n">{doc.$counts.milestones}</span></div>
      <div class="fact"><span class="fact-k">MAM 연구</span><span class="fact-v n">{doc.$counts.mam}</span></div>
      <div class="fact"><span class="fact-k">싱크 상점</span><span class="fact-v n">{doc.$counts.shop}</span></div>
    </div>

    <nav class="jump">
      <a href="#hub">허브</a>
      <a href="#milestones">마일스톤</a>
      <a href="#mam">MAM</a>
      <a href="#shop">싱크 상점</a>
    </nav>

    <section class="section" id="hub">
      <p class="marker"><span class="num">01</span> 허브 업그레이드</p>
      <h2>직접 만드는 구간</h2>
      <div class="grid">
        {doc.hub.map((h) => (
          <article class="node">
            <h3>{h.ko}</h3>
            <p class="cost">
              {h.cost.map((c, i) => (
                <>
                  {i > 0 && <span class="sep">·</span>}
                  {c.ko} <span class="n">{c.amount}</span>
                </>
              ))}
            </p>
            <ul class="unlocks">
              {summarize(h.unlocks).map((u) => <li class="chip">{u}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="milestones">
      <p class="marker"><span class="num">02</span> 마일스톤</p>
      <h2>티어 1 – 9</h2>
      {tiers.map((t) => (
        <div class="tier-block">
          <p class="tier-head"><span class="n">티어 {t}</span></p>
          <div class="grid">
            {doc.milestones
              .filter((m) => m.tier === t)
              .map((m) => (
                <article class="node">
                  <h3>{m.ko}</h3>
                  <p class="cost">
                    {m.cost.map((c, i) => (
                      <>
                        {i > 0 && <span class="sep">·</span>}
                        {c.ko} <span class="n">{c.amount}</span>
                      </>
                    ))}
                  </p>
                  <ul class="unlocks">
                    {summarize(m.unlocks).map((u) => <li class="chip">{u}</li>)}
                  </ul>
                </article>
              ))}
          </div>
        </div>
      ))}
    </section>

    <section class="section" id="mam">
      <p class="marker"><span class="num">03</span> MAM 연구</p>
      <h2>표본을 주워야 열린다</h2>
      <p class="prose muted">
        MAM 트리는 마일스톤과 달리 <strong>표본을 주워 스캔해야</strong> 열립니다. 그래서
        탐험이 곧 해금입니다. 석영과 카테리움을 일찍 주우면 편의 장비가 그만큼 빨리 열립니다.
      </p>

      {mamByTree.map((tree) => (
        <div class="tree">
          <p class="tree-head">
            <span class="n">{tree.ko}</span>
            <span class="tree-open">{tree.opens}</span>
            <span class="tree-count n">{tree.count}건</span>
          </p>
          <div class="tree-body">
            {tree.rows.map((row, ri) => (
              <>
                {ri > 0 && <div class="tree-link" aria-hidden="true"></div>}
                <div class="tree-row">
                  {row.nodes.map((m) => (
                    <article class={`tnode${m.discontinued ? ' is-old' : ''}`}>
                      <div class="tnode-icons">
                        {m.unlocks.buildings.slice(0, 3).map((b) => (
                          <img
                            src={`${base}/assets/buildings-png/${b.id}.png`}
                            alt=""
                            width="34"
                            height="34"
                            loading="lazy"
                          />
                        ))}
                        {m.unlocks.buildings.length === 0 &&
                          m.unlocks.items.slice(0, 3).map((i) => (
                            <img
                              src={`${base}/assets/items/${i.id}.png`}
                              alt=""
                              width="34"
                              height="34"
                              loading="lazy"
                            />
                          ))}
                        {m.unlocks.buildings.length === 0 &&
                          m.unlocks.items.length === 0 &&
                          m.cost.slice(0, 3).map((c) => (
                            <img
                              src={`${base}/assets/items/${c.item}.png`}
                              alt=""
                              width="34"
                              height="34"
                              loading="lazy"
                            />
                          ))}
                      </div>
                      <h4>{m.ko}</h4>
                      <p class="tnode-cost">
                        {m.cost.length === 0
                          ? '비용 없음'
                          : m.cost.map((c) => `${c.ko} ${c.amount}`).join(' · ')}
                      </p>
                      {summarize(m.unlocks).length > 0 && (
                        <ul class="unlocks">
                          {summarize(m.unlocks).slice(0, 4).map((u) => (
                            <li class="chip">{u}</li>
                          ))}
                        </ul>
                      )}
                    </article>
                  ))}
                </div>
              </>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="section" id="shop">
      <p class="marker"><span class="num">04</span> A.W.E.S.O.M.E. 싱크 상점</p>
      <h2>쿠폰으로 바꾸는 것</h2>
      <p class="prose muted">
        남는 부품을 싱크에 넣으면 쿠폰이 나오고, 그 쿠폰으로 아래를 삽니다.
        대부분은 꾸미기용이지만 <strong>장비와 청사진</strong>도 여기 있습니다.
      </p>
      {shopTiers.map((c) => (
        <div class="shop-block">
          <p class="tree-head">
            <span class="n">쿠폰 {c}장</span>
            <span class="tree-count n">{shopCards.filter((x) => x.coupons === c).length}종</span>
          </p>
          <div class="shop-grid">
            {shopCards
              .filter((x) => x.coupons === c)
              .map((x) => (
                <article class="shop-card">
                  <div class="shop-thumb">
                    {x.icon ? (
                      <img
                        src={`${base}/assets/${x.icon.kind === 'building' ? 'buildings-png' : 'items'}/${x.icon.src}.png`}
                        alt=""
                        width="56"
                        height="56"
                        loading="lazy"
                      />
                    ) : (
                      <span class="shop-noimg" aria-hidden="true"></span>
                    )}
                  </div>
                  <p class="shop-name">{x.ko}</p>
                  <p class="shop-cost n">쿠폰 {x.coupons}</p>
                </article>
              ))}
          </div>
        </div>
      ))}
    </section>

    <p class="caption foot prose">
      MAM 의 선행 관계는 게임 배포 데이터에 들어 있지 않습니다(120건 전부 비어 있음).
      트리와 깊이는 내부 클래스명에서 뽑은 것이라 게임 화면의 배치와 다를 수 있습니다.
      비용과 해금 내용은 배포 데이터 그대로입니다.
    </p>
  </div>
</Base>
