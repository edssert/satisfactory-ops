---
/**
 * 도구 — 레퍼런스 표와 용어집. JS 0KB 정적 페이지.
 *
 * 표는 게임 배포 데이터에서 빌드타임에 렌더한다. 손으로 옮겨 적은 값이 없다.
 *
 * 표기 규칙 두 가지가 앞선 판본에서 문제가 됐다:
 *   - 컨베이어 벨트와 리프트는 등급별 처리량이 **같다**. 행을 두 벌 쓰지 않고 한 행에 합친다.
 *   - 고체 채굴기와 유체 추출기를 처리량 순으로 한 표에 섞으면 Mk.1/2/3 이 떨어져 읽을 수 없다.
 *     표를 나눈다.
 */
import Base from '../../layouts/Base.astro';
import { buildings, item, logistics } from '../../lib/gamedata';
import glossaryJson from '../../data/glossary.json';

const { belts, pipes: allPipes } = logistics();

/*
 * '깨끗한 파이프라인'은 유량 표시기만 뺀 외형 변종이라 처리량이 같다.
 * 표에 두 벌씩 나오면 등급 비교가 안 되므로 제외한다.
 */
const pipes = allPipes.filter((p) => !p.id.includes('NoIndicator'));

/** 벨트와 리프트를 등급으로 짝지어 한 행으로 만든다 */
const beltRows = belts
  .filter((b) => b.id.includes('ConveyorBelt'))
  .map((b) => {
    const mk = b.id.match(/Mk(\d)/)?.[1] ?? '?';
    const lift = belts.find((l) => l.id.includes('ConveyorLift') && l.id.includes(`Mk${mk}`));
    return {
      mk,
      ko: b.ko,
      en: b.en,
      rate: b.beltItemsPerMinute ?? 0,
      liftKo: lift?.ko ?? null,
      liftSame: (lift?.beltItemsPerMinute ?? 0) === (b.beltItemsPerMinute ?? 0),
      tier: b.unlockTier,
    };
  })
  .sort((a, b) => a.rate - b.rate);

const solidMiners = buildings
  .filter((b) => b.extraction?.allowedForms?.includes('RF_SOLID'))
  .sort((a, b) => (a.extraction!.perMinuteAtNormalPurity ?? 0) - (b.extraction!.perMinuteAtNormalPurity ?? 0));

const fluidExtractors = buildings
  .filter((b) => b.extraction && !b.extraction.allowedForms?.includes('RF_SOLID'))
  .sort((a, b) => (a.extraction!.perMinuteAtNormalPurity ?? 0) - (b.extraction!.perMinuteAtNormalPurity ?? 0));

const generators = buildings
  .filter((b) => (b.powerGenMW ?? 0) > 0)
  .sort((a, b) => (a.powerGenMW ?? 0) - (b.powerGenMW ?? 0));

const machines = buildings
  .filter((b) => b.category === 'manufacturer')
  .sort((a, b) => (a.powerMW ?? a.powerMaxMW ?? 0) - (b.powerMW ?? b.powerMaxMW ?? 0));

const beltCaps = beltRows.map((b) => b.rate);

const tierOf = (t: number | null) => (t == null ? '허브' : `T${t}`);
const num = (n: number) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100));

/** 채굴기 산출 — 순도 배율은 게임 데이터에 없다. 위키 검증치다 */
const PURITY = [
  { key: 'impure', ko: '불순', mul: 0.5 },
  { key: 'normal', ko: '보통', mul: 1 },
  { key: 'pure', ko: '순수', mul: 2 },
];

const terms = (
  Array.isArray(glossaryJson) ? glossaryJson : (glossaryJson as { terms: unknown[] }).terms
) as {
  id: string;
  term: string;
  en: string;
  unlock?: string;
  short: string;
  why: string;
  how: string;
  gotcha: string;
}[];
---

<Base
  title="도구 — 레퍼런스 표와 용어집"
  description="벨트·파이프 처리량, 채굴기 산출량, 발전기 출력, 생산 건물 전력. 게임 배포 데이터에서 직접 생성한 표."
  section="tools"
>
  <div class="wrap page">
    <header class="page-head">
      <p class="marker"><span class="num">도구</span></p>
      <h1>레퍼런스 표</h1>
      <p class="lede prose">게임 배포 데이터에서 그대로 생성합니다.</p>
    </header>

    <section class="section">
      <p class="marker"><span class="num">01</span> 물류</p>
      <h2>벨트 · 리프트 처리량</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th>등급</th>
              <th class="n">처리량 (개/분)</th>
              <th class="n">Mk.1 대비</th>
              <th class="n">해금</th>
            </tr>
          </thead>
          <tbody>
            {beltRows.map((b) => (
              <tr>
                <td>
                  <span class="n">Mk.{b.mk}</span>
                  <span class="rownote">벨트 · 리프트 공통</span>
                </td>
                <td class="n">{b.rate}</td>
                <td class="n">×{Math.round((b.rate / beltCaps[0]) * 10) / 10}</td>
                <td class="n">{tierOf(b.tier)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="caption">컨베이어 리프트는 같은 등급의 벨트와 처리량이 동일합니다.</p>
    </section>

    <section class="section">
      <p class="marker"><span class="num">02</span> 채굴기</p>
      <h2>순도별 산출량</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th>채굴기</th>
              {PURITY.map((p) => <th class="n">{p.ko}</th>)}
              <th class="n">전력 (MW)</th>
              <th class="n">해금</th>
            </tr>
          </thead>
          <tbody>
            {solidMiners.map((m) => {
              const b = m.extraction!.perMinuteAtNormalPurity ?? 0;
              return (
                <tr>
                  <td>{m.ko} <span class="en">{m.en}</span></td>
                  {PURITY.map((p) => <td class="n">{num(b * p.mul)}</td>)}
                  <td class="n">{m.powerMW ?? '—'}</td>
                  <td class="n">{tierOf(m.unlockTier)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="caption">
        순도 배율은 불순 ×0.5 · 보통 ×1 · 순수 ×2입니다. 채굴기 출력구는 하나이므로 실제로 받는 양은
        벨트 처리량이 상한입니다 — 순수 노드에 Mk.1 채굴기를 꽂아도 벨트가 Mk.1이면
        <span class="n">{beltCaps[0]}</span>개/분에서 잘립니다.
      </p>
    </section>

    <section class="section">
      <p class="marker"><span class="num">03</span> 유체</p>
      <h2>추출기와 파이프</h2>
      <div class="two">
        <div class="scroll-x">
          <table>
            <thead>
              <tr><th>추출기</th><th class="n">m³/분</th><th class="n">전력</th><th class="n">해금</th></tr>
            </thead>
            <tbody>
              {fluidExtractors.map((m) => (
                <tr>
                  <td>{m.ko}</td>
                  <td class="n">{m.extraction!.perMinuteAtNormalPurity}</td>
                  <td class="n">{m.powerMW ?? '—'}</td>
                  <td class="n">{tierOf(m.unlockTier)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="scroll-x">
          <table>
            <thead>
              <tr><th>파이프</th><th class="n">m³/분</th><th class="n">해금</th></tr>
            </thead>
            <tbody>
              {pipes.map((p) => (
                <tr>
                  <td>{p.ko}</td>
                  <td class="n">{p.pipeFlowM3PerMinute}</td>
                  <td class="n">{tierOf(p.unlockTier)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="caption">유체 노드에는 순도가 없습니다. 표의 값이 고정 산출량입니다.</p>
    </section>

    <section class="section">
      <p class="marker"><span class="num">04</span> 발전</p>
      <h2>발전기 출력</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr><th>발전기</th><th class="n">출력 (MW)</th><th class="n">해금</th><th>보조 자원</th></tr>
          </thead>
          <tbody>
            {generators.map((g) => (
              <tr>
                <td>{g.ko} <span class="en">{g.en}</span></td>
                <td class="n">{g.powerGenMW}</td>
                <td class="n">{tierOf(g.unlockTier)}</td>
                <td class="small muted">
                  {g.supplementalToPowerRatio ? `비율 ${g.supplementalToPowerRatio}` : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <p class="marker"><span class="num">05</span> 생산 건물</p>
      <h2>전력 소비</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th>건물</th>
              <th class="n">전력 (MW)</th>
              <th class="n">해금</th>
              <th>건설 비용</th>
            </tr>
          </thead>
          <tbody>
            {machines.map((b) => (
              <tr>
                <td>{b.ko} <span class="en">{b.en}</span></td>
                <td class="n">
                  {b.powerIsVariable
                    ? `${num(b.powerMinMW ?? 0)}~${num(b.powerMaxMW ?? 0)}`
                    : (b.powerMW ?? '—')}
                </td>
                <td class="n">{tierOf(b.unlockTier)}</td>
                <td>
                  {b.buildCost.map((c) => (
                    <span class="chip">{item(c.item).ko} <span class="n">{c.amount}</span></span>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="caption">
        클럭 100% 기준입니다. 오버클럭 시 전력은 지수(약 1.32)로 오릅니다. 범위로 적힌 건물은
        가동 상태에 따라 소비가 변합니다.
      </p>
    </section>

    <section class="section">
      <p class="marker"><span class="num">06</span> 용어집</p>
      <h2>처음 만나는 용어</h2>
      <div class="terms">
        {terms.map((t) => (
          <details class="term">
            <summary>
              <span class="term-ko">{t.term}</span>
              <span class="en">{t.en}</span>
              {t.unlock && <span class="term-unlock">{t.unlock}</span>}
            </summary>
            <div class="term-body">
              <p>{t.short}</p>
              <p class="term-l"><span class="term-k">왜</span>{t.why}</p>
              <p class="term-l"><span class="term-k">어떻게</span>{t.how}</p>
              <p class="term-l is-gotcha"><span class="term-k">함정</span>{t.gotcha}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>

  <style>
    .page { padding-block: var(--s16) 0; }
    .page-head { margin-bottom: var(--s12); }
    .page-head h1 { margin-bottom: var(--s4); }
    .lede { font-size: var(--t-body-l); color: var(--ink-2); }

    .section { padding-block: var(--s12) 0; }
    .section h2 { margin-bottom: var(--s5); }
    .section .caption { margin-top: var(--s3); max-width: var(--measure); }

    .two { display: grid; gap: var(--s6); }
    @media (min-width: 780px) { .two { grid-template-columns: 1fr 1fr; gap: var(--s8); } }

    .rownote { display: block; font-size: var(--t-caption); color: var(--ink-3); }
    td .chip { margin: 1px 2px 1px 0; }

    .terms { border-top: var(--hair) solid var(--line); }
    .term { border-bottom: var(--hair) solid var(--line); }
    .term summary {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--s2) var(--s3);
      padding-block: var(--s4);
      cursor: pointer;
      list-style: none;
    }
    .term summary::-webkit-details-marker { display: none; }
    .term summary::before {
      content: '+';
      font-family: var(--font-mono);
      color: var(--accent);
      width: 1rem;
    }
    .term[open] summary::before { content: '−'; }
    .term-ko { font-weight: 600; }
    .term-unlock {
      margin-left: auto;
      font-family: var(--font-mono);
      font-size: var(--t-caption);
      color: var(--ink-3);
    }
    .term-body { padding: 0 0 var(--s5) 1rem; max-width: var(--measure); }
    .term-body > p { font-size: var(--t-small); }
    .term-l { margin-bottom: var(--s2); color: var(--ink-2); }
    .term-k {
      display: inline-block;
      min-width: 3.2rem;
      font-family: var(--font-mono);
      font-size: var(--t-label);
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }
    .term-l.is-gotcha .term-k { color: var(--accent); }
  </style>
</Base>
