---
/**
 * 옛 주소. 「Codex」를 「도감」으로 바꾸면서 /dex/ 로 옮겼다.
 * 티어는 주소에 번호가 들어가므로 티어마다 한 장씩 만들어 준다.
 */
import { tiers } from '../../../lib/tech';

export function getStaticPaths() {
  return tiers().map((t) => ({ params: { tier: String(t.tier) } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/dex/tiers/${Astro.params.tier}/`;
---
<meta http-equiv="refresh" content={`0; url=${to}`} />
<link rel="canonical" href={to} />
<p><a href={to}>새 주소로 이동</a></p>
