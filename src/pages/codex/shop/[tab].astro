---
/** 옛 주소. 탭마다 한 장씩 만들어 /dex/shop/<탭>/ 으로 넘긴다 */
import { shopTabs } from '../../../lib/tech';

export function getStaticPaths() {
  return shopTabs().tabs.map((t) => ({ params: { tab: t.slug } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/dex/shop/${Astro.params.tab}/`;
---
<meta http-equiv="refresh" content={`0; url=${to}`} />
<link rel="canonical" href={to} />
<p><a href={to}>새 주소로 이동</a></p>
