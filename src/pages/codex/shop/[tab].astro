---
/**
 * 도감 · A.W.E.S.O.M.E. 싱크 상점 — 게임의 탭 구성 그대로.
 *
 * 쿠폰 값으로 묶던 것을 걷어냈다. 게임에서 상점을 그렇게 쓰지 않는다 —
 * FICSIT 스페셜 / 관리 / 조직화 / 커스터마이저 / 토대 / 벽 / 건축물 / 장비 / 부품 탭으로 고르고,
 * 그 안이 다시 구획으로 나뉜다.
 *
 * 탭 구성은 게임 배포 데이터에 없다(스키매틱에 분류 필드가 없다). 공식 위키에서 옮겼고
 * 쿠폰 값과 이름은 게임 데이터를 쓴다.
 */
import Base from '../../../layouts/Base.astro';
import TechNav from '../../../components/TechNav.astro';
import '../../../styles/fx.css';
import '../../../styles/tech.css';
import { SHOP_SOURCE, hasBuildingIcon, hasItemIcon, iconOf, shopTabs, summarize } from '../../../lib/tech';

export function getStaticPaths() {
  const { tabs } = shopTabs();
  return tabs.map((t) => ({ params: { tab: t.slug }, props: { tab: t, tabs } }));
}

const { tab, tabs } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title={`${tab.ko} — 싱크 상점 도감`}
  description={`어썸 싱크 상점의 ${tab.ko} 탭 ${tab.count}종을 게임과 같은 구성으로 봅니다.`}
  section="codex"
>
  <div class="wrap codex">
    <TechNav here="shop" />

    <header class="codex-head">
      <p class="marker"><span class="num">도감</span> A.W.E.S.O.M.E. 싱크 상점</p>
      <h1>{tab.ko}</h1>
      <p class="lede prose">
        남는 부품을 싱크에 넣으면 쿠폰이 나오고, 그 쿠폰으로 아래를 삽니다.
      </p>
    </header>

    <nav class="tabs" aria-label="상점 분류">
      {tabs.map((t) => (
        <a href={`${base}/codex/shop/${t.slug}/`} aria-current={t.slug === tab.slug ? 'page' : undefined}>
          <b style="font-size:var(--t-body-s)">{t.ko}</b>
          <span class="tab-n">{t.count}</span>
        </a>
      ))}
    </nav>

    {tab.groups.map((g) => (
      <section class="shop-group">
        <h2>{g.ko} <span class="n">{g.list.length}</span></h2>
        <div class="shop-grid">
          {g.list.map((s) => {
            const ic = iconOf(s.unlocks);
            const what = summarize(s.unlocks);
            return (
              <article class="shop-card">
                <div class="shop-thumb">
                  {ic ? (
                    <img
                      src={`${base}/assets/${ic.kind === 'building' ? 'buildings-png' : 'items'}/${ic.src}.png`}
                      alt=""
                      width="72"
                      height="72"
                      loading="lazy"
                    />
                  ) : (
                    <span class="shop-noimg" aria-hidden="true"></span>
                  )}
                </div>
                <p class="shop-name">{s.ko}</p>
                <p class="shop-cost">쿠폰 {s.coupons}</p>
                {what.length > 0 && <p class="shop-what">{what.slice(0, 3).join(' · ')}</p>}
              </article>
            );
          })}
        </div>
      </section>
    ))}

    <p class="codex-foot">
      탭과 구획 구성은 게임 배포 데이터에 없어 공식 위키의 상점 문서에서 옮겼습니다
      (<a href={SHOP_SOURCE}>출처</a>). 이름과 쿠폰 값은 게임 데이터 그대로입니다.
    </p>
  </div>
</Base>
