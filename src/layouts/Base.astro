---
/**
 * 문서 골격. 모든 페이지가 이것을 쓴다.
 *
 * 아일랜드를 쓰지 않는다(ADR-0009). 인라인 스크립트는 테마 토글 하나뿐이고,
 * 그것도 렌더 전에 실행돼 깜빡임을 막는 목적이다.
 */
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** 현재 위치 표시용 — 'guide' | 'tools' | 'versions' | null */
  section?: string | null;
}
const { title, description, section = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav = [
  { key: 'guide', href: `${base}/guide/`, ko: '가이드' },
  { key: 'builder', href: `${base}/builder/`, ko: '직접 만들기' },
  { key: 'recipes', href: `${base}/recipes/`, ko: '대체 제작법' },
  { key: 'tech', href: `${base}/tech/`, ko: '테크 사전' },
  { key: 'tools', href: `${base}/tools/`, ko: '도구' },
  { key: 'versions', href: `${base}/versions/`, ko: '연혁' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {/* 테마 선택을 렌더 전에 반영한다. 이게 없으면 새로고침마다 흰 화면이 번쩍인다 */}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>

    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href={`${base}/`}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">satisfactory<span class="brand-dim">-ops</span></span>
        </a>

        <nav aria-label="주요">
          <ul class="nav">
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.ko}</a>
              </li>
            ))}
          </ul>
        </nav>

        <button class="theme" type="button" data-theme-toggle aria-label="밝기 전환">
          <span class="theme-dot" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p class="caption">
          게임 수치는 Satisfactory 설치본의 배포 데이터에서 직접 생성합니다.
          아이콘과 게임 자산의 저작권은 Coffee Stain Studios 에 있습니다. 이 사이트는 팬 제작물이며
          공식 제품이 아닙니다.
        </p>
        <p class="caption">
          <a href="https://github.com/edssert/satisfactory-ops">소스 · GitHub</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', function () {
        var root = document.documentElement;
        var now =
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = now === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        z-index: 10;
        padding: var(--s3) var(--s4);
        background: var(--accent);
        color: var(--on-accent);
      }
      .skip:focus { left: var(--s4); top: var(--s4); }

      .site-head {
        position: sticky;
        top: 0;
        z-index: 5;
        border-bottom: var(--hair) solid var(--line);
        background: color-mix(in oklab, var(--bg) 72%, transparent);
        backdrop-filter: saturate(var(--glass-sat)) blur(var(--glass-blur));
        box-shadow: inset 0 -1px 0 color-mix(in oklab, var(--primary) 14%, transparent);
      }
      .head-inner {
        display: flex;
        align-items: center;
        gap: var(--s6);
        height: var(--head-h);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--s2);
        font-family: var(--font-mono);
        font-size: var(--t-small);
        font-weight: 500;
        letter-spacing: -0.01em;
        text-decoration: none;
      }
      /* 브랜드 마크 — 파운데이션 한 장을 위에서 본 모양. 8m 격자가 이 게임의 기본 단위다 */
      .brand-mark {
        width: 12px;
        height: 12px;
        border: 2px solid var(--primary);
        border-radius: 1px;
      }
      .brand-dim { color: var(--ink-3); }

      .nav {
        display: flex;
        gap: var(--s5);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .nav a {
        font-size: var(--t-small);
        font-weight: 500;
        text-decoration: none;
        color: var(--ink-2);
      }
      .nav a:hover { color: var(--ink); }
      .nav a[aria-current='page'] { color: var(--ink); }
      .nav a[aria-current='page']::after {
        content: '';
        display: block;
        height: 2px;
        margin-top: 0.35rem;
        background: var(--primary);
      }

      .theme {
        margin-left: auto;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: var(--hair) solid var(--line);
        border-radius: var(--radius);
        background: transparent;
        cursor: pointer;
      }
      .theme:hover { border-color: var(--line-strong); }
      .theme-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 2px solid var(--ink-2);
        border-right-color: transparent;
        border-bottom-color: transparent;
      }

      .site-foot {
        margin-top: var(--s24);
        border-top: var(--hair) solid var(--line);
        padding-block: var(--s8);
      }
      .foot-inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s4) var(--s8);
        justify-content: space-between;
      }
      .foot-inner .caption { max-width: 46em; }

      @media (max-width: 560px) {
        .head-inner { gap: var(--s4); }
        .nav { gap: var(--s4); }
      }
    </style>
  </body>
</html>
