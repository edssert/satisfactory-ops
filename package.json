{
  "name": "satisfactory-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Satisfactory 생산 계산·실축 공장 설계·검증·시공 도면 로컬 웹앱",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data:game": "node scripts/build-data.mjs",
    "data:game:ko": "node scripts/build-data.mjs --locale=ko --out=src/data/ko",
    "data:app": "node scripts/build-app-data.mjs",
    "data": "npm run data:game && npm run data:game:ko && npm run data:app && npm run tech && npm run icons:schematic && npm run assets",
    "data:check": "node scripts/build-app-data.mjs --check",
    "dev": "astro dev",
    "build": "npm run data:check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --max-old-space-size=1024 --test tests/solver.test.ts tests/planner.test.ts tests/planner-ui.test.ts tests/sw.test.ts tests/sw-runtime.test.ts tests/recipe-select.test.ts tests/layout.test.ts tests/floorplan.test.ts tests/module-plan.test.ts tests/diagnose.test.ts tests/factory-domain.test.ts tests/persist.test.ts tests/graph-core.test.ts",
    "verify": "npm run data:check && npm test && astro check --minimumSeverity error && npm run check:docs && npm run check:skills && npm run check:architecture && npm run check:hygiene && npm run check:tokens && npm run check:assets && npm run check:guide && npm run db:check && npm run build && npm run test:a11y && npm run test:nojs && npm run test:scroll && npm run test:theme && npm run test:guide-ui && npm run test:responsive && npm run check:coverage",
    "test:sw": "node --test tests/sw-runtime.test.ts",
    "test:planner-ui": "node scripts/verify-planner-ui.mjs",
    "test:nojs": "node .claude/skills/no-js-fallback/scripts/nojs.mjs \"\" && node .claude/skills/no-js-fallback/scripts/nojs.mjs guide",
    "test:scroll": "node scripts/verify-scroll.mjs",
    "test:theme": "node scripts/verify-theme.mjs",
    "test:guide-ui": "node scripts/verify-guide-ui.mjs",
    "test:responsive": "node scripts/verify-responsive.mjs",
    "test:a11y": "node scripts/verify-accessibility.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:guide": "node scripts/check-guide-content.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:skills": "node scripts/check-project-skills.mjs",
    "check:assets": "node scripts/check-topview-assets.mjs",
    "check:assets:strict": "node scripts/check-topview-assets.mjs --strict-visual",
    "game:assets:contracts": "node scripts/game-assets/build-scene-contracts.mjs",
    "game:assets:check": "node scripts/game-assets/check-factory-assets.mjs && node scripts/game-assets/check-scene-recipe.mjs",
    "game:assets:query": "node scripts/game-assets/query-factory-assets.mjs",
    "render": "astro build && node scripts/render-plan.mjs",
    "db": "node scripts/db.mjs",
    "db:check": "node scripts/db.mjs --check",
    "font": "node scripts/build-font.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "tech": "node scripts/build-tech.mjs",
    "assets": "node scripts/build-asset-index.mjs",
    "icons:schematic": "node scripts/fetch-schematic-icons.mjs",
    "test:save": "node scripts/test-save-import.mjs",
    "game:graph": "node scripts/game-assets/game-graph.mjs build",
    "game:graph:check": "node scripts/game-assets/game-graph.mjs check",
    "game:graph:query": "node scripts/game-assets/game-graph.mjs",
    "graph:check": "npm run test:graph && npm run check:architecture && npm run game:graph:check",
    "test:graph": "node --test tests/graph-core.test.ts",
    "check:architecture": "dependency-cruiser --config .dependency-cruiser.cjs --output-type err-long src",
    "check:hygiene": "node scripts/check-workspace-hygiene.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.3",
    "@preact/signals": "2.11.1",
    "astro": "7.2.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@etothepii/satisfactory-file-parser": "^4.1.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "axe-core": "^4.13.0",
    "dependency-cruiser": "18.2.0",
    "fast-check": "4.9.0",
    "happy-dom": "^20.11.6",
    "playwright": "^1.62.1",
    "pretendard": "^1.3.9",
    "typescript": "5.9.2",
    "wanted-sans": "^1.0.3",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
